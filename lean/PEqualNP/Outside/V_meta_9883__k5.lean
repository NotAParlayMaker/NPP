theorem tab : ∀ r < 16, PEqualNP.MetaComplexity.tableIndex (fun i : Fin 4 => r.testBit i) = r := by decide +kernel

theorem lower (t : ℕ) (h : PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (10986 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t) : 5 ≤ t := by
  by_contra hlt
  obtain ⟨D, hD, hs, hr⟩ := h
  have hv := valid_ofCirc 4 4 gg (· ∈ rows) D hD (by have h0 : D.gates.length ≤ t := hs; omega) (fun r hm => by
    have h16 : r < 16 := by clear hD hs hr hlt; revert r; decide
    show D.eval (List.ofFn fun i : Fin 4 => r.testBit i) = _
    refine (hr _).trans ?_
    show (10986 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex fun i : Fin 4 => r.testBit i) = (10986 : ℕ).testBit r
    rw [tab r h16])
  obtain ⟨M, hM, hnf, hlx⟩ := exists_nf2 ⟨_, hv⟩
  exact refuted ⟨val 4 4 M, enc2_sat (by decide) hM hnf hlx⟩

