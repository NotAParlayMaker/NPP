import Mathlib
import PEqualNP.Defs

-- For each of the 85 graphs, the cover circuit: for each vertex of a least vertex cover in
-- turn, the AND of it with the OR of its neighbours on edges not yet covered, and then the OR
-- of these terms. It has edges plus cover number minus one gates and is checked on all inputs.

namespace PEqualNP.Outside.L_meta_926_cover

open PEqualNP.CircuitLowerBounds

-- Whether an operation is one of AND, OR, NOT.
def okOp : GateOp → Bool
  | GateOp.and => true
  | GateOp.or => true
  | GateOp.not => true
  | _ => false

theorem fanInTwo_of (C : Circuit)
    (h : C.gates.all (fun g => okOp g.op && decide (g.inputs.length ≤ 2)) = true) :
    PEqualNP.MetaComplexity.FanInTwo C := by
  intro g hg
  have hg' := List.all_eq_true.1 h g hg
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hg'
  obtain ⟨h1, h2⟩ := hg'
  refine ⟨?_, h2⟩
  revert h1
  cases g.op <;> simp [okOp]

-- Conjunct 1: a least vertex cover [0], 1 gates.
def C1 : Circuit := ⟨[⟨GateOp.and, [0, 1]⟩], 2⟩

theorem h1 : PEqualNP.MetaComplexity.HasCircuitSize 2 (fun x : Fin 2 → Bool => (x 0 && x 1)) 1 :=
  ⟨C1, fanInTwo_of C1 (by decide), by decide, by decide +kernel⟩

