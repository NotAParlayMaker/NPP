  refine ⟨⟨[⟨GateOp.and, [0, 1]⟩], 2⟩, fan _ _ (by simp), by decide, fun x => ?_⟩
  rw [ofFn2 x]
  exact (show ∀ a b : Bool, Circuit.eval ⟨[⟨GateOp.and, [0, 1]⟩], 2⟩ [a, b] = ((a && b)) from by decide +kernel) (x 0) (x 1)

