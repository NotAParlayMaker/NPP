lemma fan (gates : List Gate) (out : ℕ)
    (h : ∀ g ∈ gates, (g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not) ∧
      g.inputs.length ≤ 2) :
    PEqualNP.MetaComplexity.FanInTwo ⟨gates, out⟩ := by
  intro g hg
  obtain ⟨h1, h2⟩ := h g hg
  refine ⟨?_, h2⟩
  rcases h1 with h1 | h1 | h1 <;> rw [h1] <;> simp

