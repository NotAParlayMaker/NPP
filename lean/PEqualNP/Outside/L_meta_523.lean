import Mathlib
import PEqualNP.Defs

namespace R523

def fN {α : Type} (n : Nat) (k : Nat → α) : α :=
  match n with
  | 0 => k 0
  | Nat.succ m => k (Nat.succ m)

def covFold : List Nat → Nat → Nat → Nat
  | [], one, two => one ^^^ two
  | m :: t, one, two => fN (one ||| m) fun o => fN (two ||| (one &&& m)) fun w => covFold t o w

def need (m u : Nat) : Nat :=
  fN (m &&& u) fun own => fN (own ||| (own >>> 8)) fun x1 => fN (x1 ||| (x1 >>> 16)) fun x2 =>
    fN (own ||| (own >>> 1)) fun y1 => fN (y1 ||| (y1 >>> 2)) fun y2 =>
    ((y2 ||| (y2 >>> 4)) &&& 282578800148737) * ((x2 ||| (x2 >>> 32)) &&& 255)

def rectGo (u : Nat) : List Nat → Nat → Bool
  | [], _ => false
  | m :: t, acc => fN (need m u) fun nd =>
      bif Nat.beq (nd &&& acc) 0 then fN (acc ||| nd) fun acc' => rectGo u t acc' else true

def rectDead (ms : List Nat) : Bool := fN (covFold ms 0 0) fun u => rectGo u ms 0

def msk (c : Nat) : Nat :=
  ((c / 2) >>> 7) * (((((c / 2) &&& 127) ^^^ 127) * 4432676798593) &&& 282578800148737)

def mk (conj : Bool) (a b : Nat) : Nat :=
  bif conj then 2 * ((a / 2) &&& (b / 2)) + 1 else 2 * ((a / 2) ||| (b / 2))

def kept (b : Bool) (x : Nat) (xs : List Nat) : List Nat := bif b then x :: xs else xs

def ins (c : Nat) : List Nat → List Nat
  | [] => [c]
  | d :: t => bif Nat.ble c d then c :: d :: t else d :: ins c t

def sortL (l : List Nat) : List Nat := l.foldr ins []

def packL : List Nat → Nat
  | [] => 0
  | c :: t => (c + 65536) + 131072 * packL t

def mkSt (flag : Bool) (ws : List Nat) : Nat := (bif flag then 1 else 0) + 2 * packL (sortL ws)

def unpackL : Nat → Nat → List Nat
  | 0, _ => []
  | fuel + 1, p => bif Nat.beq p 0 then [] else (p % 131072 - 65536) :: unpackL fuel (p / 131072)

def odd (c : Nat) : Bool := Nat.beq (c % 2) 1

def orM (l : List (Nat × Nat)) : Nat := l.foldl (fun acc c => acc ||| c.2) 0

def codes (l : List (Nat × Nat)) : List Nat := l.map Prod.fst
def masks (l : List (Nat × Nat)) : List Nat := l.map Prod.snd

def full (m : Nat) : Bool := Nat.beq m 72057594037927935

def emit2 (r : Nat) (flag conj : Bool) (a ma b mb mr n z mz : Nat) (rest : List (Nat × Nat))
    (ka kb : Bool) (acc : List Nat) : List Nat :=
  bif Nat.blt r (n + ka.toNat + kb.toNat) then acc else
  bif full (mr ||| (bif ka then ma else 0) ||| (bif kb then mb else 0) ||| mz) &&
      !(Nat.beq r (n + ka.toNat + kb.toNat) && rectDead (mz :: kept ka ma (kept kb mb (masks rest)))) then
    fN (mkSt (flag || (conj && (!(Nat.beq ((z / 2) &&& 127) 0) || odd a || odd b)) ||
        (ka && odd a) || (kb && odd b)) (z :: kept ka a (kept kb b (codes rest)))) (fun s => s :: acc)
  else acc

def op2 (r : Nat) (flag conj : Bool) (a ma b mb mr n z mz : Nat) (rest : List (Nat × Nat))
    (acc : List Nat) : List Nat :=
  bif full (mr ||| ma ||| mb ||| mz) then
    emit2 r flag conj a ma b mb mr n z mz rest true true
      (emit2 r flag conj a ma b mb mr n z mz rest true false
        (emit2 r flag conj a ma b mb mr n z mz rest false true
          (emit2 r flag conj a ma b mb mr n z mz rest false false acc)))
  else acc

def cand2 (r : Nat) (flag : Bool) (a ma b mb mr n : Nat) (rest : List (Nat × Nat)) (acc : List Nat) :
    List Nat :=
  fN (mk true a b) fun z1 => fN (msk z1) fun m1 => fN (mk false a b) fun z0 => fN (msk z0) fun m0 =>
  op2 r flag true a ma b mb mr n z1 m1 rest
    (op2 r flag false a ma b mb mr n z0 m0 rest acc)

def pick2 (r : Nat) (flag : Bool) (a ma mo n : Nat) (others : List (Nat × Nat)) :
    Nat → List (Nat × Nat) → List (Nat × Nat) → List Nat → List Nat
  | _, _, [], acc => acc
  | mmid, mid, b :: post, acc =>
    fN (mmid ||| b.2) fun mm => fN (mo ||| mmid ||| orM post) fun mr =>
    pick2 r flag a ma mo n others mm (b :: mid) post
      (cand2 r flag a ma b.1 b.2 mr n (others ++ mid ++ post) acc)

def pick1 (r : Nat) (flag : Bool) (n : Nat) :
    Nat → List (Nat × Nat) → List (Nat × Nat) → List Nat → List Nat
  | _, _, [], acc => acc
  | mpre, pre, a :: post, acc =>
    fN (mpre ||| a.2) fun mp =>
    pick1 r flag n mp (a :: pre) post
      (pick2 r flag a.1 a.2 mpre (n - 2) pre 0 [] post acc)

def withMasksK {α : Type} : List Nat → (List (Nat × Nat) → α) → α
  | [], k => k []
  | c :: t, k => fN c fun c' => fN (msk c') fun m => withMasksK t fun rs => k ((c', m) :: rs)

def withMasks (l : List Nat) : List (Nat × Nat) := l.map fun c => (c, msk c)

def succsInto (r : Nat) (p : Nat) (acc : List Nat) : List Nat :=
  withMasksK (unpackL 16 (p / 2)) fun wm => fN wm.length fun n =>
    pick1 r (odd p) n 0 [] wm acc

def merge : Nat → List Nat → List Nat → List Nat
  | 0, a, b => a ++ b
  | _ + 1, [], b => b
  | _ + 1, a, [] => a
  | fuel + 1, x :: a, y :: b =>
    bif Nat.blt x y then x :: merge fuel a (y :: b)
    else bif Nat.blt y x then y :: merge fuel (x :: a) b
    else x :: merge fuel a b

def mergePairs (fuel : Nat) : List (List Nat) → List (List Nat)
  | a :: b :: t => merge fuel a b :: mergePairs fuel t
  | l => l

def mergeAll (fuel : Nat) : Nat → List (List Nat) → List Nat
  | 0, l => l.flatten
  | k + 1, l => match l with
    | [] => []
    | [a] => a
    | _ => mergeAll fuel k (mergePairs fuel l)

def dedupSort (l : List Nat) : List Nat := mergeAll (2 * l.length + 2) 40 (l.map fun x => [x])

def level (r : Nat) (S : List Nat) : List Nat := dedupSort (S.foldl (fun acc p => succsInto r p acc) [])

def start : List Nat := [mkSt false [20760, 33542, 1648, 3212, 10290, 12484, 16614, 33016]]

def levels : Nat → Nat → List Nat → List Nat
  | 0, _, S => S
  | k + 1, r, S => levels k (r - 1) (level (r - 1) S)

def subS : List Nat → List Nat → Bool
  | [], _ => true
  | _ :: _, [] => false
  | x :: xs, y :: ys => bif Nat.beq x y then subS xs ys else bif Nat.blt y x then subS (x :: xs) ys else false

