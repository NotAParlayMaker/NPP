def feat2 (conj ka kb : Bool) (a b : Nat) : Bool :=
  (conj && (!(Nat.beq ((mk conj a b / 2) &&& 127) 0) || odd a || odd b)) || (ka && odd a) ||
    (kb && odd b)

inductive RunF : Bool → Nat → List Nat → Prop
  | done (c : Nat) : c / 2 = 32640 → RunF false 0 [c]
  | perm {f : Bool} {s : Nat} {xs zs : List Nat} : xs.Perm zs → RunF f s xs → RunF f s zs
  | two {f : Bool} {s : Nat} {a b : Nat} {rest : List Nat} (conj ka kb : Bool) :
      RunF f s (mk conj a b :: kept ka a (kept kb b rest)) →
      RunF (feat2 conj ka kb a b || f) (s + 1) (a :: b :: rest)

theorem mem_kept {b : Bool} {x c : Nat} {xs : List Nat} (h : c ∈ kept b x xs) : c = x ∨ c ∈ xs := by
  cases b <;> simp [kept] at h ⊢
  · exact Or.inr h
  · exact h

theorem kept_length (b : Bool) (x : Nat) (xs : List Nat) :
    (kept b x xs).length = xs.length + b.toNat := by
  cases b <;> simp [kept]

theorem mk_div (conj : Bool) (a b : Nat) :
    mk conj a b / 2 = bif conj then (a / 2) &&& (b / 2) else (a / 2) ||| (b / 2) := by
  cases conj
  · simp only [mk, Bool.cond_false]; omega
  · simp only [mk, Bool.cond_true]; omega

theorem mk_lt (conj : Bool) (a b : Nat) (ha : a < 65536) (hb : b < 65536) : mk conj a b < 65536 := by
  have h1 : a / 2 < 2 ^ 15 := by omega
  have h2 : b / 2 < 2 ^ 15 := by omega
  cases conj
  · have := Nat.or_lt_two_pow h1 h2
    simp only [mk, Bool.cond_false]
    omega
  · have : (a / 2) &&& (b / 2) ≤ a / 2 := Nat.and_le_left
    simp only [mk, Bool.cond_true]
    omega

theorem mk_comm (conj : Bool) (a b : Nat) : mk conj a b = mk conj b a := by
  cases conj <;> simp [mk, Nat.land_comm, Nat.lor_comm]

theorem feat2_comm (conj ka kb : Bool) (a b : Nat) :
    feat2 conj kb ka b a = feat2 conj ka kb a b := by
  simp only [feat2, mk_comm conj b a]
  cases conj <;> cases ka <;> cases kb <;> cases odd a <;> cases odd b <;> simp

def bitOK (c i : Nat) : Bool := (c / 2).testBit (7 + i % 8) && !(c / 2).testBit (i / 8)

def hor (o : Nat) : List Bool → Nat
  | [] => 0
  | b :: t => (bif b then o else 0) + 256 * hor o t

theorem hor_testBit (o : Nat) (ho : o < 256) : ∀ (bs : List Bool) (i : Nat),
    (hor o bs).testBit i = (bs.getD (i / 8) false && o.testBit (i % 8)) := by
  intro bs
  induction bs with
  | nil => intro i; simp [hor]
  | cons b t ih =>
    intro i
    have hx : (bif b then o else 0) < 2 ^ 8 := by
      cases b
      · simp
      · simp only [Bool.cond_true]; omega
    have e : hor o (b :: t) = 2 ^ 8 * hor o t + (bif b then o else 0) := by
      simp only [hor]; omega
    rw [e, Nat.testBit_two_pow_mul_add _ hx]
    by_cases hi : i < 8
    · have h0 : i / 8 = 0 := by omega
      have h1 : i % 8 = i := by omega
      rw [ite_eq_left hi, h0, h1]
      cases b <;> simp
    · have h0 : i / 8 = (i - 8) / 8 + 1 := by omega
      have h1 : i % 8 = (i - 8) % 8 := by omega
      rw [ite_eq_right hi, ih, h0, h1]
      simp

theorem hor_mul (c : Nat) (bs : List Bool) : hor 1 bs * c = hor c bs := by
  induction bs with
  | nil => simp [hor]
  | cons b t ih =>
    simp only [hor, ← ih]
    cases b <;> simp <;> ring

def spChk : Nat → Bool
  | 0 => true
  | x + 1 => Nat.beq (((x ^^^ 127) * 4432676798593) &&& 282578800148737)
      (hor 1 ((List.range 7).map fun y => !x.testBit y)) && spChk x

theorem spChk_spec : ∀ n : Nat, spChk n = true → ∀ x : Nat, x < n →
    ((x ^^^ 127) * 4432676798593) &&& 282578800148737 =
      hor 1 ((List.range 7).map fun y => !x.testBit y) := by
  intro n
  induction n with
  | zero => intro _ x hx; omega
  | succ n ih =>
    intro h x hx
    simp only [spChk, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.1 hx with h1 | rfl
    · exact ih h.2 x h1
    · exact Nat.eq_of_beq_eq_true h.1

set_option maxRecDepth 100000 in
theorem spChk_all : spChk 128 = true := by decide +kernel

theorem msk_hor (t : Nat) (_ht : t < 32768) :
    msk (2 * t) = hor (t >>> 7) ((List.range 7).map fun y => !t.testBit y) := by
  have h127 : t &&& 127 < 128 := Nat.lt_succ_of_le Nat.and_le_right
  have e : (List.range 7).map (fun y => !(t &&& 127).testBit y) =
      (List.range 7).map fun y => !t.testBit y := by
    apply List.map_congr_left
    intro y hy
    have hy7 : y < 7 := List.mem_range.1 hy
    have : Nat.testBit 127 y = true := by interval_cases y <;> decide
    rw [Nat.testBit_and, this, Bool.and_true]
  unfold msk
  rw [show 2 * t / 2 = t by omega, spChk_spec 128 spChk_all _ h127, e, Nat.mul_comm, hor_mul]

theorem msk_testBit (c : Nat) (hc : c < 65536) (i : Nat) :
    (msk c).testBit i = (decide (i < 56) && bitOK c i) := by
  have e : msk c = msk (2 * (c / 2)) := by
    simp only [msk]
    rw [show 2 * (c / 2) / 2 = c / 2 by omega]
  have ho : (c / 2) >>> 7 < 256 := by
    rw [Nat.shiftRight_eq_div_pow]
    omega
  rw [e, msk_hor (c / 2) (by omega), hor_testBit _ ho, Nat.testBit_shiftRight]
  simp only [bitOK]
  by_cases hi : i < 56
  · have h7 : i / 8 < 7 := by omega
    rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range h7]
    simp [hi, Bool.and_comm]
  · have h7 : ¬ i / 8 < 7 := by omega
    rw [List.getD_eq_default _ _ (by simp; omega)]
    simp [hi]

theorem msk_lt (c : Nat) (hc : c < 65536) : msk c < 2 ^ 56 := by
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  rw [msk_testBit c hc]
  simp
  omega

theorem bitOK_mk (conj : Bool) (a b i : Nat) (h : bitOK (mk conj a b) i = true) :
    bitOK a i = true ∨ bitOK b i = true := by
  simp only [bitOK, mk_div] at h ⊢
  cases conj
  · simp only [Bool.cond_false, Nat.testBit_or] at h
    revert h
    cases (a / 2).testBit (7 + i % 8) <;> cases (b / 2).testBit (7 + i % 8) <;>
      cases (a / 2).testBit (i / 8) <;> cases (b / 2).testBit (i / 8) <;> simp
  · simp only [Bool.cond_true, Nat.testBit_and] at h
    revert h
    cases (a / 2).testBit (7 + i % 8) <;> cases (b / 2).testBit (7 + i % 8) <;>
      cases (a / 2).testBit (i / 8) <;> cases (b / 2).testBit (i / 8) <;> simp

def Cov (ws : List Nat) : Prop := ∀ i, i < 56 → ∃ c ∈ ws, bitOK c i = true

theorem cov_final : ∀ i : Nat, i < 56 →
    (Nat.testBit 32640 (7 + i % 8) && !Nat.testBit 32640 (i / 8)) = true := by
  decide

theorem runF_prune {f : Bool} {s : Nat} {ws : List Nat} (h : RunF f s ws) :
    Cov ws ∧ ws.length ≤ s + 1 := by
  induction h with
  | done c hc =>
    refine ⟨fun i hi => ⟨c, by simp, ?_⟩, by simp⟩
    simp only [bitOK, hc]
    exact cov_final i hi
  | perm p _ ih =>
    refine ⟨fun i hi => ?_, by rw [← p.length_eq]; exact ih.2⟩
    obtain ⟨c, hc, hb⟩ := ih.1 i hi
    exact ⟨c, p.subset hc, hb⟩
  | @two f s a b rest conj ka kb _ ih =>
    refine ⟨fun i hi => ?_, ?_⟩
    · obtain ⟨c, hc, hb⟩ := ih.1 i hi
      rcases List.mem_cons.1 hc with rfl | hc
      · rcases bitOK_mk conj a b i hb with h | h
        · exact ⟨a, by simp, h⟩
        · exact ⟨b, by simp, h⟩
      · rcases mem_kept hc with rfl | hc
        · exact ⟨c, by simp, hb⟩
        · rcases mem_kept hc with rfl | hc
          · exact ⟨c, by simp, hb⟩
          · exact ⟨c, by simp [hc], hb⟩
    · have := ih.2
      simp only [List.length_cons, kept_length] at this ⊢
      omega

theorem orM_acc (l : List (Nat × Nat)) (acc : Nat) :
    l.foldl (fun acc c => acc ||| c.2) acc = acc ||| orM l := by
  induction l generalizing acc with
  | nil => simp [orM]
  | cons c l ih =>
    simp only [orM, List.foldl_cons]
    rw [ih, ih (0 ||| c.2)]
    simp [Nat.lor_assoc]

theorem orM_cons (c : Nat × Nat) (l : List (Nat × Nat)) : orM (c :: l) = c.2 ||| orM l := by
  simp only [orM, List.foldl_cons]
  rw [orM_acc]
  simp [orM]

theorem orM_append (l1 l2 : List (Nat × Nat)) : orM (l1 ++ l2) = orM l1 ||| orM l2 := by
  induction l1 with
  | nil => simp [orM]
  | cons c l ih => rw [List.cons_append, orM_cons, orM_cons, ih, Nat.lor_assoc]

theorem orM_reverse (l : List (Nat × Nat)) : orM l.reverse = orM l := by
  induction l with
  | nil => rfl
  | cons c l ih =>
    have e0 : orM ([] : List (Nat × Nat)) = 0 := rfl
    rw [List.reverse_cons, orM_append, ih, orM_cons c l, orM_cons c [], e0]
    simp [Nat.lor_comm]

theorem orM_wm_testBit (l : List Nat) (c : Nat) (hc : c ∈ l) (i : Nat)
    (h : (msk c).testBit i = true) : (orM (withMasks l)).testBit i = true := by
  induction l with
  | nil => simp at hc
  | cons d l ih =>
    simp only [withMasks, List.map_cons] at ih ⊢
    rw [orM_cons, Nat.testBit_or]
    rcases List.mem_cons.1 hc with rfl | hc
    · simp [h]
    · simp [ih hc]

theorem orM_wm_lt (l : List Nat) (hl : ∀ c ∈ l, c < 65536) : orM (withMasks l) < 2 ^ 56 := by
  induction l with
  | nil => simp [withMasks, orM]
  | cons d l ih =>
    simp only [withMasks, List.map_cons] at ih ⊢
    rw [orM_cons]
    exact Nat.or_lt_two_pow (msk_lt d (hl d (by simp))) (ih fun c hc => hl c (by simp [hc]))

theorem full_of (V : Nat) (hlt : V < 2 ^ 56) (h : ∀ i, i < 56 → V.testBit i = true) :
    full V = true := by
  have e : V = 72057594037927935 := by
    apply Nat.eq_of_testBit_eq
    intro i
    rw [show (72057594037927935 : Nat) = 2 ^ 56 - 1 by norm_num, Nat.testBit_two_pow_sub_one]
    by_cases hi : i < 56
    · simp [hi, h i hi]
    · simp only [hi, decide_false]
      exact Nat.testBit_lt_two_pow (lt_of_lt_of_le hlt (Nat.pow_le_pow_right (by norm_num) (by omega)))
  simp [full, e]

def Conf (ws : List Nat) : Prop :=
  ∃ a b k1 k2 k3 k4 : Nat, a ≠ b ∧ k1 < 56 ∧ k2 < 56 ∧ k3 < 56 ∧ k4 < 56 ∧
    k1 / 8 = k3 / 8 ∧ k2 % 8 = k4 % 8 ∧
    ws.filter (fun c => bitOK c k1) = [a] ∧ ws.filter (fun c => bitOK c k2) = [a] ∧
    ws.filter (fun c => bitOK c k3) = [b] ∧ ws.filter (fun c => bitOK c k4) = [b]

theorem cf_mem {l : List Nat} {k c : Nat} (h : l.filter (fun c => bitOK c k) = [c]) :
    c ∈ l ∧ bitOK c k = true := by
  have : c ∈ l.filter (fun c => bitOK c k) := by rw [h]; simp
  simpa [List.mem_filter] using this
theorem cf_cell {z a0 b0 c k : Nat} {rest : List Nat}
    (h : (a0 :: b0 :: rest).filter (fun c => bitOK c k) = [c])
    (hc : ∃ d ∈ z :: rest, bitOK d k = true)
    (hz : bitOK z k = true → bitOK a0 k = true ∨ bitOK b0 k = true) :
    (rest.filter (fun c => bitOK c k) = [c] ∧ (z :: rest).filter (fun c => bitOK c k) = [c] ∧
      bitOK a0 k = false ∧ bitOK b0 k = false) ∨
    (c = a0 ∧ bitOK a0 k = true ∧ bitOK b0 k = false ∧ rest.filter (fun c => bitOK c k) = [] ∧
      (z :: rest).filter (fun c => bitOK c k) = [z]) ∨
    (c = b0 ∧ bitOK b0 k = true ∧ bitOK a0 k = false ∧ rest.filter (fun c => bitOK c k) = [] ∧
      (z :: rest).filter (fun c => bitOK c k) = [z]) := by
  have key : rest.filter (fun c => bitOK c k) = [] → bitOK z k = true := by
    intro he
    obtain ⟨d, hd, hb⟩ := hc
    rcases List.mem_cons.1 hd with rfl | hd
    · exact hb
    · have : d ∈ rest.filter (fun c => bitOK c k) := List.mem_filter.2 ⟨hd, hb⟩
      rw [he] at this
      simp at this
  cases ha : bitOK a0 k <;> cases hb : bitOK b0 k <;>
    simp only [List.filter_cons, ha, hb, Bool.false_eq_true, ite_false, ite_true] at h
  · left
    have hzz : bitOK z k = false := by
      cases hq : bitOK z k
      · rfl
      · rcases hz hq with h' | h'
        · rw [ha] at h'; cases h'
        · rw [hb] at h'; cases h'
    exact ⟨h, by simp [hzz, h], rfl, rfl⟩
  · right; right
    have h := List.cons.inj h
    exact ⟨h.1.symm, rfl, rfl, h.2, by simp [key h.2, h.2]⟩
  · right; left
    have h := List.cons.inj h
    exact ⟨h.1.symm, rfl, rfl, h.2, by simp [key h.2, h.2]⟩
  · simp at h
theorem cf_wire {z a0 b0 c k k' : Nat} {rest : List Nat}
    (h : (a0 :: b0 :: rest).filter (fun c => bitOK c k) = [c])
    (h' : (a0 :: b0 :: rest).filter (fun c => bitOK c k') = [c])
    (hc : ∃ d ∈ z :: rest, bitOK d k = true) (hc' : ∃ d ∈ z :: rest, bitOK d k' = true)
    (hz : bitOK z k = true → bitOK a0 k = true ∨ bitOK b0 k = true)
    (hz' : bitOK z k' = true → bitOK a0 k' = true ∨ bitOK b0 k' = true) :
    (c ∈ rest ∧ (z :: rest).filter (fun c => bitOK c k) = [c] ∧
      (z :: rest).filter (fun c => bitOK c k') = [c]) ∨
    (c = a0 ∧ bitOK b0 k = false ∧ bitOK b0 k' = false ∧
      rest.filter (fun c => bitOK c k) = [] ∧
      (z :: rest).filter (fun c => bitOK c k) = [z] ∧
      (z :: rest).filter (fun c => bitOK c k') = [z]) ∨
    (c = b0 ∧ bitOK a0 k = false ∧ bitOK a0 k' = false ∧
      rest.filter (fun c => bitOK c k) = [] ∧
      (z :: rest).filter (fun c => bitOK c k) = [z] ∧
      (z :: rest).filter (fun c => bitOK c k') = [z]) := by
  have m := (cf_mem h).2
  have m' := (cf_mem h').2
  rcases cf_cell h hc hz with ⟨p1, p2, p3, p4⟩ | ⟨rfl, p1, p2, p3, p4⟩ | ⟨rfl, p1, p2, p3, p4⟩ <;>
    rcases cf_cell h' hc' hz' with ⟨q1, q2, q3, q4⟩ | ⟨q0, q1, q2, q3, q4⟩ | ⟨q0, q1, q2, q3, q4⟩
  · exact Or.inl ⟨(cf_mem p1).1, p2, q2⟩
  · subst q0; rw [p3] at m; cases m
  · subst q0; rw [p4] at m; cases m
  · rw [q3] at m'; cases m'
  · exact Or.inr (Or.inl ⟨rfl, p2, q2, p3, p4, q4⟩)
  · subst q0; rw [p2] at p1; cases p1
  · rw [q4] at m'; cases m'
  · subst q0; rw [p2] at p1; cases p1
  · exact Or.inr (Or.inr ⟨rfl, p2, q2, p3, p4, q4⟩)
theorem cf_merge (conj : Bool) {a b k1 k2 k3 k4 : Nat} (e1 : k1 / 8 = k3 / 8)
    (e2 : k2 % 8 = k4 % 8) (a1 : bitOK a k1 = true) (a2 : bitOK a k2 = true)
    (b3 : bitOK b k3 = true) (b4 : bitOK b k4 = true) (b1 : bitOK b k1 = false)
    (b2 : bitOK b k2 = false) (z1 : bitOK (mk conj a b) k1 = true)
    (z2 : bitOK (mk conj a b) k2 = true) : False := by
  simp only [bitOK, mk_div, ← e1, ← e2] at a1 a2 b3 b4 b1 b2 z1 z2
  cases conj
  · simp only [Bool.cond_false, Nat.testBit_or] at z1 z2
    revert a1 a2 b3 b4 b1 b2 z1 z2
    cases (a / 2).testBit (7 + k2 % 8) <;> cases (b / 2).testBit (7 + k2 % 8) <;>
      cases (a / 2).testBit (k2 / 8) <;> cases (b / 2).testBit (k2 / 8) <;> simp
  · simp only [Bool.cond_true, Nat.testBit_and] at z1 z2
    revert a1 a2 b3 b4 b1 b2 z1 z2
    cases (a / 2).testBit (7 + k1 % 8) <;> cases (b / 2).testBit (7 + k1 % 8) <;>
      cases (a / 2).testBit (k1 / 8) <;> cases (b / 2).testBit (k1 / 8) <;> simp
theorem cf_ne {z d k : Nat} {rest : List Nat} (hd : d ∈ rest)
    (he : rest.filter (fun c => bitOK c k) = [])
    (hz : (z :: rest).filter (fun c => bitOK c k) = [z]) : d ≠ z := by
  rintro rfl
  have : d ∈ rest.filter (fun c => bitOK c k) := List.mem_filter.2 ⟨hd, (cf_mem hz).2⟩
  rw [he] at this
  simp at this
theorem conf_dead {f : Bool} {s : Nat} {ws : List Nat} (h : RunF f s ws) :
    ws.length = s + 1 → Conf ws → False := by
  induction h with
  | done c hc =>
    rintro - ⟨a, b, k1, k2, k3, k4, hab, -, -, -, -, -, -, f1, -, f3, -⟩
    have h1 := (cf_mem f1).1
    have h3 := (cf_mem f3).1
    simp only [List.mem_singleton] at h1 h3
    exact hab (h1.trans h3.symm)
  | @perm f s xs zs p _ ih =>
    rintro hl ⟨a, b, k1, k2, k3, k4, hab, h1, h2, h3, h4, e1, e2, f1, f2, f3, f4⟩
    have q : ∀ (k c : Nat), zs.filter (fun c => bitOK c k) = [c] →
        xs.filter (fun c => bitOK c k) = [c] := by
      intro k c hf
      have := p.filter (fun c => bitOK c k)
      rw [hf] at this
      exact List.perm_singleton.1 this
    exact ih (by rw [p.length_eq]; exact hl)
      ⟨a, b, k1, k2, k3, k4, hab, h1, h2, h3, h4, e1, e2, q _ _ f1, q _ _ f2, q _ _ f3, q _ _ f4⟩
  | @two f s a0 b0 rest conj ka kb h ih =>
    rintro hl ⟨a, b, k1, k2, k3, k4, hab, h1, h2, h3, h4, e1, e2, f1, f2, f3, f4⟩
    have hp := runF_prune h
    have hlen := hp.2
    simp only [List.length_cons, kept_length] at hlen hl
    have hka : ka = false := by
      cases ka
      · rfl
      · simp at hlen; omega
    have hkb : kb = false := by
      cases kb
      · rfl
      · simp at hlen; omega
    subst hka hkb
    simp only [kept, Bool.cond_false] at ih hp
    have hc := hp.1
    refine ih (by simp only [List.length_cons]; omega) ?_
    rcases cf_wire f1 f2 (hc k1 h1) (hc k2 h2) (bitOK_mk conj a0 b0 k1) (bitOK_mk conj a0 b0 k2)
      with ⟨pm, p1, p2⟩ | ⟨pa, pb1, pb2, pe, p1, p2⟩ | ⟨pa, pb1, pb2, pe, p1, p2⟩ <;>
    rcases cf_wire f3 f4 (hc k3 h3) (hc k4 h4) (bitOK_mk conj a0 b0 k3) (bitOK_mk conj a0 b0 k4)
      with ⟨qm, q1, q2⟩ | ⟨qa, qb1, qb2, qe, q1, q2⟩ | ⟨qa, qb1, qb2, qe, q1, q2⟩
    · exact ⟨a, b, k1, k2, k3, k4, hab, h1, h2, h3, h4, e1, e2, p1, p2, q1, q2⟩
    · exact ⟨a, _, k1, k2, k3, k4, cf_ne pm qe q1, h1, h2, h3, h4, e1, e2, p1, p2, q1, q2⟩
    · exact ⟨a, _, k1, k2, k3, k4, cf_ne pm qe q1, h1, h2, h3, h4, e1, e2, p1, p2, q1, q2⟩
    · exact ⟨_, b, k1, k2, k3, k4, (cf_ne qm pe p1).symm, h1, h2, h3, h4, e1, e2, p1, p2, q1, q2⟩
    · exact (hab (pa.trans qa.symm)).elim
    · subst pa qa
      exact (cf_merge conj e1 e2 (cf_mem f1).2 (cf_mem f2).2 (cf_mem f3).2 (cf_mem f4).2 pb1 pb2
        (cf_mem p1).2 (cf_mem p2).2).elim
    · exact ⟨_, b, k1, k2, k3, k4, (cf_ne qm pe p1).symm, h1, h2, h3, h4, e1, e2, p1, p2, q1, q2⟩
    · subst pa qa
      refine (cf_merge conj e1 e2 (cf_mem f1).2 (cf_mem f2).2 (cf_mem f3).2 (cf_mem f4).2 pb1 pb2
        ?_ ?_).elim
      · rw [mk_comm]; exact (cf_mem p1).2
      · rw [mk_comm]; exact (cf_mem p2).2
    · exact (hab (pa.trans qa.symm)).elim

theorem fN_eq {α : Type} (n : Nat) (k : Nat → α) : fN n k = k n := by cases n <;> rfl
theorem covFold_bit (k : Nat) : ∀ (ms : List Nat) (one two : Nat),
    (two.testBit k = true → one.testBit k = true) → (covFold ms one two).testBit k = true →
    two.testBit k = false ∧ (one.testBit k).toNat + ms.countP (fun m => m.testBit k) = 1 := by
  intro ms
  induction ms with
  | nil =>
    intro one two h0 h
    simp only [covFold, Nat.testBit_xor] at h
    revert h0 h
    cases one.testBit k <;> cases two.testBit k <;> simp
  | cons m t ih =>
    intro one two h0 h
    simp only [covFold, fN_eq] at h
    have h1 := ih _ _ (by
      simp only [Nat.testBit_or, Nat.testBit_and]
      revert h0
      cases one.testBit k <;> cases two.testBit k <;> cases m.testBit k <;> simp) h
    simp only [Nat.testBit_or, Nat.testBit_and] at h1
    rw [List.countP_cons]
    revert h0 h1
    cases one.testBit k <;> cases two.testBit k <;> cases m.testBit k <;> simp
theorem smear (y s n : Nat) (h : (y ||| y >>> s).testBit n = true) :
    ∃ d, (d = 0 ∨ d = s) ∧ y.testBit (n + d) = true := by
  rw [Nat.testBit_or, Nat.testBit_shiftRight, Bool.or_eq_true] at h
  rcases h with h | h
  · exact ⟨0, Or.inl rfl, h⟩
  · exact ⟨s, Or.inr rfl, by rwa [Nat.add_comm]⟩
theorem maskR (n : Nat) (h : Nat.testBit 282578800148737 n = true) : n % 8 = 0 ∧ n < 56 := by
  have hn : n < 49 := by
    by_contra hn
    have := Nat.testBit_lt_two_pow (x := 282578800148737) (i := n)
      (lt_of_lt_of_le (by norm_num) (Nat.pow_le_pow_right (by norm_num) (not_lt.1 hn)))
    rw [this] at h
    cases h
  have h2 : ∀ n < 49, Nat.testBit 282578800148737 n = true → n % 8 = 0 := by decide
  exact ⟨h2 n hn h, by omega⟩
def nR (o : Nat) : Nat :=
  ((o ||| o >>> 1 ||| (o ||| o >>> 1) >>> 2) ||| (o ||| o >>> 1 ||| (o ||| o >>> 1) >>> 2) >>> 4) &&&
    282578800148737
def nC (o : Nat) : Nat :=
  ((o ||| o >>> 8 ||| (o ||| o >>> 8) >>> 16) ||| (o ||| o >>> 8 ||| (o ||| o >>> 8) >>> 16) >>> 32) &&&
    255
theorem need_eq (m u : Nat) : need m u = nR (m &&& u) * nC (m &&& u) := by
  simp only [need, fN_eq, nR, nC]
theorem nR_bit (o n : Nat) (h : (nR o).testBit n = true) :
    n % 8 = 0 ∧ n < 56 ∧ ∃ e, e < 8 ∧ o.testBit (n + e) = true := by
  rw [nR, Nat.testBit_and, Bool.and_eq_true] at h
  obtain ⟨d1, h1, g1⟩ := smear _ _ _ h.1
  obtain ⟨d2, h2, g2⟩ := smear _ _ _ g1
  obtain ⟨d3, h3, g3⟩ := smear _ _ _ g2
  have hm := maskR n h.2
  exact ⟨hm.1, hm.2, d1 + d2 + d3, by omega, by rwa [← Nat.add_assoc, ← Nat.add_assoc]⟩
theorem nC_bit (o i : Nat) (h : (nC o).testBit i = true) :
    i < 8 ∧ ∃ t, o.testBit (i + 8 * t) = true := by
  rw [nC, Nat.testBit_and, Bool.and_eq_true, show (255 : Nat) = 2 ^ 8 - 1 by norm_num,
    Nat.testBit_two_pow_sub_one, decide_eq_true_eq] at h
  obtain ⟨d1, h1, g1⟩ := smear _ _ _ h.1
  obtain ⟨d2, h2, g2⟩ := smear _ _ _ g1
  obtain ⟨d3, h3, g3⟩ := smear _ _ _ g2
  refine ⟨h.2, (d1 + d2 + d3) / 8, ?_⟩
  rw [show i + 8 * ((d1 + d2 + d3) / 8) = i + d1 + d2 + d3 by omega]
  exact g3
theorem nC_lt (o : Nat) : nC o < 256 := by
  rw [nC]
  exact lt_of_le_of_lt Nat.and_le_right (by norm_num)
theorem nR_hor (o : Nat) : nR o = hor 1 ((List.range 7).map fun j => (nR o).testBit (8 * j)) := by
  apply Nat.eq_of_testBit_eq
  intro i
  have h1 : ∀ j < 8, j ≠ 0 → Nat.testBit 1 j = false := by decide
  rw [hor_testBit 1 (by norm_num), List.getD_eq_getElem?_getD, List.getElem?_map]
  by_cases hb : (nR o).testBit i = true
  · obtain ⟨h0, h56, -⟩ := nR_bit o i hb
    rw [List.getElem?_range (by omega), Option.map_some, Option.getD_some,
      show 8 * (i / 8) = i by omega, h0, hb]
    rfl
  · rw [Bool.not_eq_true] at hb
    rw [hb]
    by_cases h0 : i % 8 = 0
    · by_cases h7 : i / 8 < 7
      · rw [List.getElem?_range h7, Option.map_some, Option.getD_some,
          show 8 * (i / 8) = i by omega, hb]
        rfl
      · rw [List.getElem?_eq_none (by simp; omega)]
        rfl
    · rw [h1 _ (by omega) h0, Bool.and_false]
theorem need_bit (m u k : Nat) (h : (need m u).testBit k = true) :
    k < 56 ∧ (∃ e, e < 8 ∧ (m &&& u).testBit (8 * (k / 8) + e) = true) ∧
      ∃ t, (m &&& u).testBit (k % 8 + 8 * t) = true := by
  rw [need_eq, nR_hor, hor_mul, hor_testBit _ (nC_lt _), Bool.and_eq_true,
    List.getD_eq_getElem?_getD, List.getElem?_map] at h
  obtain ⟨hr, hc⟩ := h
  by_cases h7 : k / 8 < 7
  · rw [List.getElem?_range h7, Option.map_some, Option.getD_some] at hr
    exact ⟨by omega, (nR_bit _ _ hr).2.2, (nC_bit _ _ hc).2⟩
  · rw [List.getElem?_eq_none (by simp; omega), Option.map_none, Option.getD_none] at hr
    cases hr
theorem rectGo_spec (u : Nat) : ∀ (ms : List Nat) (acc : Nat), rectGo u ms acc = true →
    (∃ m ∈ ms, ∃ k, (need m u).testBit k = true ∧ acc.testBit k = true) ∨
    ∃ l1 m1 l2 m2 l3, ms = l1 ++ m1 :: (l2 ++ m2 :: l3) ∧
      ∃ k, (need m1 u).testBit k = true ∧ (need m2 u).testBit k = true := by
  intro ms
  induction ms with
  | nil => intro acc h; cases h
  | cons m t ih =>
    intro acc h
    simp only [rectGo, fN_eq] at h
    by_cases hz : need m u &&& acc = 0
    · rw [hz] at h
      rcases ih _ h with ⟨m', hm', k, h1, h2⟩ | ⟨l1, m1, l2, m2, l3, e, hk⟩
      · rw [Nat.testBit_or, Bool.or_eq_true] at h2
        rcases h2 with h2 | h2
        · exact Or.inl ⟨m', List.mem_cons_of_mem _ hm', k, h1, h2⟩
        · obtain ⟨l2, l3, e⟩ := List.append_of_mem hm'
          exact Or.inr ⟨[], m, l2, m', l3, by rw [e]; rfl, k, h2, h1⟩
      · exact Or.inr ⟨m :: l1, m1, l2, m2, l3, by rw [e]; rfl, hk⟩
    · obtain ⟨k, hk⟩ := Nat.exists_testBit_of_ne_zero hz
      rw [Nat.testBit_and, Bool.and_eq_true] at hk
      exact Or.inl ⟨m, List.mem_cons_self, k, hk⟩
theorem filt_eq (ws : List Nat) (hc : ∀ c ∈ ws, c < 65536) (i : Nat) (hi : i < 56) :
    ws.filter ((fun m => m.testBit i) ∘ msk) = ws.filter (fun c => bitOK c i) := by
  apply List.filter_congr
  intro c hcm
  rw [Function.comp_apply, msk_testBit c (hc c hcm), decide_eq_true hi, Bool.true_and]
theorem sole_cnt (ws : List Nat) (i : Nat) (hu : (covFold (ws.map msk) 0 0).testBit i = true) :
    (ws.filter ((fun m => m.testBit i) ∘ msk)).length = 1 := by
  have h1 := (covFold_bit i (ws.map msk) 0 0 (fun h => h) hu).2
  rw [List.countP_map, List.countP_eq_length_filter, Nat.zero_testBit] at h1
  exact (Nat.zero_add _).symm.trans h1
theorem sole (ws : List Nat) (hc : ∀ c ∈ ws, c < 65536) (a i : Nat) (ha : a ∈ ws)
    (h : (msk a &&& covFold (ws.map msk) 0 0).testBit i = true) :
    i < 56 ∧ ws.filter (fun c => bitOK c i) = [a] := by
  rw [Nat.testBit_and, Bool.and_eq_true, msk_testBit a (hc a ha), Bool.and_eq_true,
    decide_eq_true_eq] at h
  obtain ⟨⟨hi, hb⟩, hu⟩ := h
  have h1 := sole_cnt ws i hu
  rw [filt_eq ws hc i hi] at h1
  obtain ⟨x, hx⟩ := List.length_eq_one_iff.1 h1
  have hm : a ∈ ws.filter (fun c => bitOK c i) := List.mem_filter.2 ⟨ha, hb⟩
  rw [hx, List.mem_singleton] at hm
  exact ⟨hi, by rw [hx, hm]⟩
theorem rectDead_conf (ws : List Nat) (hc : ∀ c ∈ ws, c < 65536)
    (h : rectDead (ws.map msk) = true) : Conf ws := by
  simp only [rectDead, fN_eq] at h
  rcases rectGo_spec _ _ _ h with ⟨_, _, k, _, hk⟩ | ⟨l1, m1, l2, m2, l3, e, k, ha, hb⟩
  · simp at hk
  · obtain ⟨w1, r1, rfl, rfl, e1⟩ := List.map_eq_append_iff.1 e
    obtain ⟨a, r2, rfl, rfl, e2⟩ := List.map_eq_cons_iff.1 e1
    obtain ⟨w2, r3, rfl, rfl, e3⟩ := List.map_eq_append_iff.1 e2
    obtain ⟨b, w3, rfl, rfl, rfl⟩ := List.map_eq_cons_iff.1 e3
    obtain ⟨hk, ⟨ea, hea, ha1⟩, ta, ha2⟩ := need_bit _ _ _ ha
    obtain ⟨-, ⟨eb, heb, hb1⟩, tb, hb2⟩ := need_bit _ _ _ hb
    obtain ⟨i1, f1⟩ := sole _ hc a _ (by simp) ha1
    obtain ⟨i2, f2⟩ := sole _ hc a _ (by simp) ha2
    obtain ⟨i3, f3⟩ := sole _ hc b _ (by simp) hb1
    obtain ⟨i4, f4⟩ := sole _ hc b _ (by simp) hb2
    refine ⟨a, b, _, _, _, _, ?_, i1, i2, i3, i4, by omega, by omega, f1, f2, f3, f4⟩
    rintro rfl
    have hm : a ∈ (w1 ++ a :: (w2 ++ a :: w3)).filter (fun c => bitOK c (8 * (k / 8) + ea)) := by
      rw [f1]; exact List.mem_singleton_self a
    have hbit := (List.mem_filter.1 hm).2
    have hl := congrArg List.length f1
    simp [hbit] at hl
    omega

theorem ins_perm (c : Nat) (l : List Nat) : (ins c l).Perm (c :: l) := by
  induction l with
  | nil => exact List.Perm.refl _
  | cons d t ih =>
    simp only [ins]
    cases Nat.ble c d
    · exact (List.Perm.cons d ih).trans (List.Perm.swap c d t)
    · exact List.Perm.refl _
theorem sortL_perm (l : List Nat) : (sortL l).Perm l := by
  induction l with
  | nil => exact List.Perm.refl _
  | cons c t ih => exact (ins_perm c (sortL t)).trans (List.Perm.cons c ih)
theorem ins_sorted (c : Nat) (l : List Nat) (h : l.Pairwise (· ≤ ·)) :
    (ins c l).Pairwise (· ≤ ·) := by
  induction l with
  | nil => simp [ins]
  | cons d t ih =>
    simp only [ins]
    cases hb : Nat.ble c d
    · have hdc : d ≤ c := by
        have : ¬ c ≤ d := by
          intro hle
          rw [Nat.ble_eq_true_of_le hle] at hb
          exact Bool.noConfusion hb
        omega
      rw [Bool.cond_false, List.pairwise_cons]
      refine ⟨fun x hx => ?_, ih (List.pairwise_cons.1 h).2⟩
      rcases List.mem_cons.1 ((ins_perm c t).subset hx) with rfl | hx
      · exact hdc
      · exact (List.pairwise_cons.1 h).1 x hx
    · have hcd : c ≤ d := Nat.le_of_ble_eq_true hb
      rw [Bool.cond_true, List.pairwise_cons]
      refine ⟨fun x hx => ?_, h⟩
      rcases List.mem_cons.1 hx with rfl | hx
      · exact hcd
      · exact le_trans hcd ((List.pairwise_cons.1 h).1 x hx)
theorem sortL_sorted (l : List Nat) : (sortL l).Pairwise (· ≤ ·) := by
  induction l with
  | nil => simp [sortL]
  | cons c t ih => exact ins_sorted c (sortL t) ih
theorem sortL_eq_of_perm {l l' : List Nat} (h : l.Perm l') : sortL l = sortL l' :=
  List.Perm.eq_of_pairwise (fun _ _ _ _ h1 h2 => le_antisymm h1 h2)
    (sortL_sorted l) (sortL_sorted l') ((sortL_perm l).trans (h.trans (sortL_perm l').symm))
theorem mkSt_perm (g : Bool) {l l' : List Nat} (h : l.Perm l') : mkSt g l = mkSt g l' := by
  simp only [mkSt, sortL_eq_of_perm h]
theorem unpack_pack : ∀ (l : List Nat), (∀ c ∈ l, c < 65536) → ∀ fuel : Nat, l.length ≤ fuel →
    unpackL fuel (packL l) = l := by
  intro l
  induction l with
  | nil =>
    intro _ fuel _
    cases fuel <;> simp [unpackL, packL]
  | cons c t ih =>
    intro hl fuel hf
    cases fuel with
    | zero => simp at hf
    | succ fuel =>
      have hc := hl c (by simp)
      have hne : Nat.beq (packL (c :: t)) 0 = false := by
        rw [Bool.eq_false_iff]
        intro h
        have := Nat.eq_of_beq_eq_true h
        simp only [packL] at this
        omega
      have h1 : packL (c :: t) % 131072 - 65536 = c := by simp only [packL]; omega
      have h2 : packL (c :: t) / 131072 = packL t := by simp only [packL]; omega
      simp only [unpackL, hne, Bool.cond_false, h1, h2]
      rw [ih (fun d hd => hl d (by simp [hd])) fuel (by simpa using hf)]
theorem odd_mkSt (g : Bool) (ws : List Nat) : odd (mkSt g ws) = g := by
  cases g
  · have h : (0 + 2 * packL (sortL ws)) % 2 = 0 := by omega
    simp only [mkSt, odd, Bool.cond_false]
    rw [h]
    rfl
  · have h : (1 + 2 * packL (sortL ws)) % 2 = 1 := by omega
    simp only [mkSt, odd, Bool.cond_true]
    rw [h]
    rfl
theorem div_mkSt (g : Bool) (ws : List Nat) : mkSt g ws / 2 = packL (sortL ws) := by
  cases g
  · simp only [mkSt, Bool.cond_false]; omega
  · simp only [mkSt, Bool.cond_true]; omega
theorem kept_perm (k : Bool) (x : Nat) {l l' : List Nat} (h : l.Perm l') :
    (kept k x l).Perm (kept k x l') := by
  cases k
  · simpa [kept] using h
  · simpa [kept] using List.Perm.cons x h
theorem kept_comm (k1 k2 : Bool) (x y : Nat) (l : List Nat) :
    (kept k1 x (kept k2 y l)).Perm (kept k2 y (kept k1 x l)) := by
  cases k1 <;> cases k2 <;> simp [kept]
  exact List.Perm.swap y x l
theorem mem_bif (c : Bool) {x : Nat} {l1 l2 : List Nat} (h1 : x ∈ l1) (h2 : x ∈ l2) :
    x ∈ (bif c then l1 else l2) := by
  cases c <;> assumption
theorem sub_emit2 (r : Nat) (flag conj : Bool) (a ma b mb mr n z mz : Nat) (rest : List (Nat × Nat))
    (ka kb : Bool) (acc : List Nat) {x : Nat} (h : x ∈ acc) :
    x ∈ emit2 r flag conj a ma b mb mr n z mz rest ka kb acc := by
  unfold emit2
  exact mem_bif _ h (mem_bif _ (by rw [fN_eq]; exact List.mem_cons_of_mem _ h) h)
theorem sub_op2 (r : Nat) (flag conj : Bool) (a ma b mb mr n z mz : Nat) (rest : List (Nat × Nat))
    (acc : List Nat) {x : Nat} (h : x ∈ acc) : x ∈ op2 r flag conj a ma b mb mr n z mz rest acc := by
  unfold op2
  exact mem_bif _ (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
      (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ h)))) h
theorem sub_cand2 (r : Nat) (flag : Bool) (a ma b mb mr n : Nat) (rest : List (Nat × Nat))
    (acc : List Nat) {x : Nat} (h : x ∈ acc) : x ∈ cand2 r flag a ma b mb mr n rest acc := by
  unfold cand2
  simp only [fN_eq]
  exact sub_op2 _ _ _ _ _ _ _ _ _ _ _ _ _ (sub_op2 _ _ _ _ _ _ _ _ _ _ _ _ _ h)
theorem sub_pick2 (r : Nat) (flag : Bool) (a ma mo n : Nat) (others : List (Nat × Nat)) :
    ∀ (post mid : List (Nat × Nat)) (mmid : Nat) (acc : List Nat) {x : Nat}, x ∈ acc →
      x ∈ pick2 r flag a ma mo n others mmid mid post acc := by
  intro post
  induction post with
  | nil => intro mid mmid acc x h; simpa [pick2] using h
  | cons b post ih =>
    intro mid mmid acc x h
    simp only [pick2, fN_eq]
    exact ih _ _ _ (sub_cand2 _ _ _ _ _ _ _ _ _ _ h)
theorem sub_pick1 (r : Nat) (flag : Bool) (n : Nat) :
    ∀ (post pre : List (Nat × Nat)) (mpre : Nat) (acc : List Nat) {x : Nat}, x ∈ acc →
      x ∈ pick1 r flag n mpre pre post acc := by
  intro post
  induction post with
  | nil => intro pre mpre acc x h; simpa [pick1] using h
  | cons a post ih =>
    intro pre mpre acc x h
    simp only [pick1, fN_eq]
    exact ih _ _ _ (sub_pick2 _ _ _ _ _ _ _ _ _ _ _ h)
theorem blt_false {r m : Nat} (h : m ≤ r) : Nat.blt r m = false := by
  rw [Bool.eq_false_iff]
  intro hb
  have := Nat.le_of_ble_eq_true hb
  omega
theorem testBit_bif (k : Bool) (m i : Nat) (h : (bif k then m else 0).testBit i = true) :
    m.testBit i = true := by
  cases k
  · simp at h
  · simpa using h
theorem bif_lt (k : Bool) (m : Nat) (h : m < 2 ^ 56) : (bif k then m else 0) < 2 ^ 56 := by
  cases k
  · simp
  · simpa using h
theorem cand2_mem (r : Nat) (flag conj ka kb : Bool) (a b mr n : Nat) (rest : List (Nat × Nat))
    (cs acc : List Nat) (hcs : codes rest = cs)
    (ha : a < 65536) (hb : b < 65536) (hmr : mr < 2 ^ 56) (hlen : n + ka.toNat + kb.toNat ≤ r)
    (hbits : ∀ i, i < 56 → (mr ||| (bif ka then msk a else 0) ||| (bif kb then msk b else 0) |||
      msk (mk conj a b)).testBit i = true)
    (hrd : n + ka.toNat + kb.toNat = r → rectDead (msk (mk conj a b) ::
      kept ka (msk a) (kept kb (msk b) (masks rest))) = false) :
    mkSt (flag || feat2 conj ka kb a b) (mk conj a b :: kept ka a (kept kb b cs)) ∈
      cand2 r flag a (msk a) b (msk b) mr n rest acc := by
  subst hcs
  have hz : msk (mk conj a b) < 2 ^ 56 := msk_lt _ (mk_lt conj a b ha hb)
  have hma := msk_lt a ha
  have hmb := msk_lt b hb
  have h1 : full (mr ||| (bif ka then msk a else 0) ||| (bif kb then msk b else 0) |||
      msk (mk conj a b)) = true :=
    full_of _ (Nat.or_lt_two_pow (Nat.or_lt_two_pow (Nat.or_lt_two_pow hmr (bif_lt ka _ hma))
      (bif_lt kb _ hmb)) hz) hbits
  have hcnd : (full (mr ||| (bif ka then msk a else 0) ||| (bif kb then msk b else 0) |||
      msk (mk conj a b)) && !(Nat.beq r (n + ka.toNat + kb.toNat) && rectDead (msk (mk conj a b) ::
      kept ka (msk a) (kept kb (msk b) (masks rest))))) = true := by
    rw [h1, Bool.true_and]
    cases hq : Nat.beq r (n + ka.toNat + kb.toNat)
    · rfl
    · rw [hrd (Nat.eq_of_beq_eq_true hq).symm]
      rfl
  have h0 : full (mr ||| msk a ||| msk b ||| msk (mk conj a b)) = true := by
    refine full_of _ (Nat.or_lt_two_pow (Nat.or_lt_two_pow (Nat.or_lt_two_pow hmr hma) hmb) hz) ?_
    intro i hi
    have := hbits i hi
    simp only [Nat.testBit_or, Bool.or_eq_true] at this ⊢
    rcases this with ((h | h) | h) | h
    · exact Or.inl (Or.inl (Or.inl h))
    · exact Or.inl (Or.inl (Or.inr (testBit_bif ka _ i h)))
    · exact Or.inl (Or.inr (testBit_bif kb _ i h))
    · exact Or.inr h
  have hfl : (flag || (conj && (!(Nat.beq ((mk conj a b / 2) &&& 127) 0) || odd a || odd b)) ||
      (ka && odd a) || (kb && odd b)) = (flag || feat2 conj ka kb a b) := by
    simp only [feat2, Bool.or_assoc]
  have key2 : ∀ acc' : List Nat,
      mkSt (flag || feat2 conj ka kb a b) (mk conj a b :: kept ka a (kept kb b (codes rest))) ∈
        op2 r flag conj a (msk a) b (msk b) mr n (mk conj a b) (msk (mk conj a b)) rest acc' := by
    intro acc'
    unfold op2
    rw [h0, Bool.cond_true]
    have hb0 := blt_false hlen
    have key : ∀ acc'' : List Nat,
        mkSt (flag || feat2 conj ka kb a b) (mk conj a b :: kept ka a (kept kb b (codes rest))) ∈
          emit2 r flag conj a (msk a) b (msk b) mr n (mk conj a b) (msk (mk conj a b)) rest ka kb
            acc'' := by
      intro acc''
      unfold emit2
      rw [hb0, Bool.cond_false, hcnd, Bool.cond_true, fN_eq, hfl]
      exact List.mem_cons_self
    cases ka <;> cases kb
    · exact sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
        (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (key _)))
    · exact sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (key _))
    · exact sub_emit2 _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ (key _)
    · exact key _
  unfold cand2
  simp only [fN_eq]
  cases conj
  · exact sub_op2 _ _ _ _ _ _ _ _ _ _ _ _ _ (key2 _)
  · exact key2 _
theorem pick2_mem (r : Nat) (flag : Bool) (a mo n : Nat) (others : List (Nat × Nat))
    (target : Nat) :
    ∀ (l2 : List (Nat × Nat)) (y : Nat × Nat) (l3 mid : List (Nat × Nat)) (mmid : Nat)
      (acc : List Nat), mmid = orM mid →
      (∀ acc' : List Nat, target ∈ cand2 r flag a (msk a) y.1 y.2
          (mo ||| orM (l2.reverse ++ mid) ||| orM l3) n
          (others ++ (l2.reverse ++ mid) ++ l3) acc') →
      target ∈ pick2 r flag a (msk a) mo n others mmid mid (l2 ++ y :: l3) acc := by
  intro l2
  induction l2 with
  | nil =>
    intro y l3 mid mmid acc hm h
    simp only [List.nil_append, pick2, fN_eq]
    apply sub_pick2
    have := h acc
    simpa [hm] using this
  | cons c l2 ih =>
    intro y l3 mid mmid acc hm h
    simp only [List.cons_append, pick2, fN_eq]
    apply ih y l3 (c :: mid) (mmid ||| c.2) _ (by rw [orM_cons, hm, Nat.lor_comm])
    intro acc'
    have := h acc'
    simpa [List.reverse_cons, List.append_assoc] using this
theorem pick1_mem (r : Nat) (flag : Bool) (n : Nat) (target : Nat) :
    ∀ (l1 : List (Nat × Nat)) (x : Nat × Nat) (post pre : List (Nat × Nat)) (mpre : Nat)
      (acc : List Nat), mpre = orM pre → x.2 = msk x.1 →
      (∀ acc' : List Nat, target ∈ pick2 r flag x.1 (msk x.1) (orM (l1.reverse ++ pre)) (n - 2)
          (l1.reverse ++ pre) 0 [] post acc') →
      target ∈ pick1 r flag n mpre pre (l1 ++ x :: post) acc := by
  intro l1
  induction l1 with
  | nil =>
    intro x post pre mpre acc hm hx h
    simp only [List.nil_append, pick1, fN_eq]
    apply sub_pick1
    have := h acc
    simpa [hm, hx] using this
  | cons c l1 ih =>
    intro x post pre mpre acc hm hx h
    simp only [List.cons_append, pick1, fN_eq]
    apply ih x post (c :: pre) (mpre ||| c.2) _ (by rw [orM_cons, hm, Nat.lor_comm]) hx
    intro acc'
    have := h acc'
    simpa [List.reverse_cons, List.append_assoc] using this
theorem codes_wm (l : List Nat) : codes (withMasks l) = l := by
  simp [codes, withMasks, Function.comp_def]
theorem wm_append (l1 l2 : List Nat) : withMasks (l1 ++ l2) = withMasks l1 ++ withMasks l2 := by
  simp [withMasks]
theorem wm_cons (c : Nat) (l : List Nat) : withMasks (c :: l) = (c, msk c) :: withMasks l := by
  simp [withMasks]
theorem wm_reverse (l : List Nat) : (withMasks l).reverse = withMasks l.reverse := by
  simp [withMasks]
theorem mem_kept' {b : Bool} {x c : Nat} {xs : List Nat} (h : c ∈ kept b x xs) :
    (b = true ∧ c = x) ∨ c ∈ xs := by
  cases b
  · exact Or.inr (by simpa [kept] using h)
  · simp only [kept, Bool.cond_true, List.mem_cons] at h
    rcases h with h | h
    · exact Or.inl ⟨rfl, h⟩
    · exact Or.inr h
theorem cov_perm {l l' : List Nat} (p : l.Perm l') (h : Cov l) : Cov l' := by
  intro i hi
  obtain ⟨c, hc, hb⟩ := h i hi
  exact ⟨c, p.subset hc, hb⟩
theorem masks_wm (l : List Nat) : masks (withMasks l) = l.map msk := by
  simp [masks, withMasks, Function.comp_def]
theorem kept_mapM (k : Bool) (x : Nat) (l : List Nat) :
    (kept k x l).map msk = kept k (msk x) (l.map msk) := by
  cases k <;> rfl
theorem conf_perm {l l' : List Nat} (p : l.Perm l') (h : Conf l) : Conf l' := by
  obtain ⟨a, b, k1, k2, k3, k4, hab, h1, h2, h3, h4, h5, h6, e1, e2, e3, e4⟩ := h
  exact ⟨a, b, k1, k2, k3, k4, hab, h1, h2, h3, h4, h5, h6,
    List.perm_singleton.1 ((p.filter _).symm.trans (by rw [e1])),
    List.perm_singleton.1 ((p.filter _).symm.trans (by rw [e2])),
    List.perm_singleton.1 ((p.filter _).symm.trans (by rw [e3])),
    List.perm_singleton.1 ((p.filter _).symm.trans (by rw [e4]))⟩
theorem lt_step (conj ka kb : Bool) (a b : Nat) (rest : List Nat) (ha : a < 65536)
    (hb : b < 65536) (hr : ∀ c ∈ rest, c < 65536) :
    ∀ c ∈ mk conj a b :: kept ka a (kept kb b rest), c < 65536 := by
  intro c h
  rcases List.mem_cons.1 h with rfl | h
  · exact mk_lt conj a b ha hb
  · rcases mem_kept h with rfl | h
    · exact ha
    · rcases mem_kept h with rfl | h
      · exact hb
      · exact hr c h
theorem gen_mem (r : Nat) (g conj k1 k2 : Bool) (l1 l2 l3 : List Nat) (x y : Nat)
    (acc : List Nat) (hc : ∀ c ∈ l1 ++ x :: l2 ++ y :: l3, c < 65536)
    (hlen : (l1 ++ l2 ++ l3).length + k1.toNat + k2.toNat ≤ r)
    (hcov : Cov (mk conj x y :: kept k1 x (kept k2 y (l1 ++ l2 ++ l3))))
    (hnc : (l1 ++ l2 ++ l3).length + k1.toNat + k2.toNat = r →
      ¬ Conf (mk conj x y :: kept k1 x (kept k2 y (l1 ++ l2 ++ l3)))) :
    mkSt (g || feat2 conj k1 k2 x y) (mk conj x y :: kept k1 x (kept k2 y (l1 ++ l2 ++ l3))) ∈
      pick1 r g (l1 ++ x :: l2 ++ y :: l3).length 0 []
        (withMasks (l1 ++ x :: l2 ++ y :: l3)) acc := by
  have hx : x < 65536 := hc x (by simp)
  have hy : y < 65536 := hc y (by simp)
  have h1 : ∀ c ∈ l1, c < 65536 := fun c h => hc c (by simp [h])
  have h2 : ∀ c ∈ l2, c < 65536 := fun c h => hc c (by simp [h])
  have h3 : ∀ c ∈ l3, c < 65536 := fun c h => hc c (by simp [h])
  have hp : (l1.reverse ++ l2.reverse ++ l3).Perm (l1 ++ l2 ++ l3) :=
    List.Perm.append (List.Perm.append (List.reverse_perm l1) (List.reverse_perm l2))
      (List.Perm.refl l3)
  have e : mkSt (g || feat2 conj k1 k2 x y)
      (mk conj x y :: kept k1 x (kept k2 y (l1 ++ l2 ++ l3))) =
      mkSt (g || feat2 conj k1 k2 x y)
        (mk conj x y :: kept k1 x (kept k2 y (l1.reverse ++ l2.reverse ++ l3))) :=
    mkSt_perm _ (List.Perm.cons _ (kept_perm _ _ (kept_perm _ _ hp.symm)))
  have eL : l1 ++ x :: l2 ++ y :: l3 = l1 ++ (x :: (l2 ++ (y :: l3))) := by simp
  rw [e, eL, wm_append, wm_cons, wm_append, wm_cons]
  refine pick1_mem r g _ _ (withMasks l1) (x, msk x) _ [] 0 acc rfl rfl ?_
  intro acc'
  refine pick2_mem r g x _ _ _ _ (withMasks l2) (y, msk y) (withMasks l3) [] 0 acc' rfl ?_
  intro acc''
  have hrest : (withMasks l1).reverse ++ [] ++ ((withMasks l2).reverse ++ []) ++ withMasks l3 =
      withMasks (l1.reverse ++ l2.reverse ++ l3) := by
    simp [withMasks]
  rw [hrest]
  have hmr : orM ((withMasks l1).reverse ++ []) ||| orM ((withMasks l2).reverse ++ []) |||
      orM (withMasks l3) < 2 ^ 56 := by
    simp only [List.append_nil, orM_reverse]
    exact Nat.or_lt_two_pow (Nat.or_lt_two_pow (orM_wm_lt l1 h1) (orM_wm_lt l2 h2)) (orM_wm_lt l3 h3)
  refine cand2_mem r g conj k1 k2 x y _ _ _ _ acc'' (codes_wm _) hx hy hmr ?_ ?_ ?_
  · simp only [List.length_append, List.length_cons] at hlen ⊢
    omega
  · intro i hi
    obtain ⟨c, hcm, hb⟩ := hcov i hi
    simp only [List.append_nil, orM_reverse, Nat.testBit_or, Bool.or_eq_true]
    rcases List.mem_cons.1 hcm with rfl | hcm
    · right
      rw [msk_testBit _ (mk_lt conj x y hx hy)]
      simp [hi, hb]
    · rcases mem_kept' hcm with ⟨hk, rfl⟩ | hcm
      · left; left; right
        rw [hk, Bool.cond_true, msk_testBit _ hx]
        simp [hi, hb]
      · rcases mem_kept' hcm with ⟨hk, rfl⟩ | hcm
        · left; right
          rw [hk, Bool.cond_true, msk_testBit _ hy]
          simp [hi, hb]
        · have hcl : c < 65536 := hc c (by
            simp only [List.mem_append, List.mem_cons] at hcm ⊢
            tauto)
          have hbit : (msk c).testBit i = true := by
            rw [msk_testBit _ hcl]
            simp [hi, hb]
          left; left; left
          simp only [List.mem_append] at hcm
          rcases hcm with (h | h) | h
          · exact Or.inl (Or.inl (orM_wm_testBit l1 c h i hbit))
          · exact Or.inl (Or.inr (orM_wm_testBit l2 c h i hbit))
          · exact Or.inr (orM_wm_testBit l3 c h i hbit)
  · intro hn
    rw [Bool.eq_false_iff]
    intro hd
    have em : (mk conj x y :: kept k1 x (kept k2 y (l1.reverse ++ l2.reverse ++ l3))).map msk =
        msk (mk conj x y) :: kept k1 (msk x) (kept k2 (msk y)
          (masks (withMasks (l1.reverse ++ l2.reverse ++ l3)))) := by
      simp only [List.map_cons, kept_mapM, masks_wm]
    rw [← em] at hd
    refine hnc ?_ (conf_perm (List.Perm.cons _ (kept_perm _ _ (kept_perm _ _ hp)))
      (rectDead_conf _ (lt_step conj k1 k2 x y _ hx hy fun c h => hc c (by
        simp only [List.mem_append, List.mem_cons, List.mem_reverse] at h ⊢
        tauto)) hd))
    simp only [List.length_append, List.length_cons] at hn ⊢
    omega
theorem perm_split {L : List Nat} {a b : Nat} {rest : List Nat} (h : L.Perm (a :: b :: rest)) :
    ∃ l1 l2 l3, (L = l1 ++ a :: l2 ++ b :: l3 ∨ L = l1 ++ b :: l2 ++ a :: l3) ∧
      (l1 ++ l2 ++ l3).Perm rest := by
  have ha : a ∈ L := h.symm.subset (by simp)
  obtain ⟨s, t, rfl⟩ := List.append_of_mem ha
  have h2 : (s ++ t).Perm (b :: rest) := List.Perm.cons_inv (List.perm_middle.symm.trans h)
  have hb : b ∈ s ++ t := h2.symm.subset (by simp)
  rcases List.mem_append.1 hb with hb | hb
  · obtain ⟨s1, s2, rfl⟩ := List.append_of_mem hb
    refine ⟨s1, s2, t, Or.inr (by simp), ?_⟩
    have h3 : (s1 ++ b :: (s2 ++ t)).Perm (b :: rest) := by simpa using h2
    have := List.Perm.cons_inv (List.perm_middle.symm.trans h3)
    simpa using this
  · obtain ⟨t1, t2, rfl⟩ := List.append_of_mem hb
    refine ⟨s, t1, t2, Or.inl (by simp), ?_⟩
    have h3 : ((s ++ t1) ++ b :: t2).Perm (b :: rest) := by simpa using h2
    exact List.Perm.cons_inv (List.perm_middle.symm.trans h3)
theorem withMasksK_eq {α : Type} : ∀ (l : List Nat) (k : List (Nat × Nat) → α),
    withMasksK l k = k (withMasks l) := by
  intro l
  induction l with
  | nil => intro k; rfl
  | cons c t ih => intro k; simp only [withMasksK, fN_eq, ih, withMasks, List.map_cons]
theorem succsInto_eq (r p : Nat) (acc : List Nat) : succsInto r p acc =
    pick1 r (odd p) (unpackL 16 (p / 2)).length 0 [] (withMasks (unpackL 16 (p / 2))) acc := by
  unfold succsInto
  rw [withMasksK_eq, fN_eq]
  simp [withMasks]
theorem sub_succs (r p : Nat) (acc : List Nat) {x : Nat} (h : x ∈ acc) :
    x ∈ succsInto r p acc := by
  rw [succsInto_eq]
  exact sub_pick1 _ _ _ _ _ _ _ h
theorem mem_foldl_acc (r : Nat) : ∀ (S acc : List Nat) {x : Nat}, x ∈ acc →
    x ∈ S.foldl (fun acc p => succsInto r p acc) acc := by
  intro S
  induction S with
  | nil => intro acc x h; simpa using h
  | cons q S ih => intro acc x h; exact ih _ (sub_succs r q acc h)
theorem mem_foldl_succs (r : Nat) {p x : Nat} (hx : ∀ acc, x ∈ succsInto r p acc) :
    ∀ (S acc : List Nat), p ∈ S → x ∈ S.foldl (fun acc p => succsInto r p acc) acc := by
  intro S
  induction S with
  | nil => intro acc h; simp at h
  | cons q S ih =>
    intro acc h
    rcases List.mem_cons.1 h with rfl | h
    · exact mem_foldl_acc r S _ (hx acc)
    · exact ih _ h
theorem le_of_blt_false {u v : Nat} (h : Nat.blt u v = false) : v ≤ u := by
  by_contra hc
  have hlt : u < v := by omega
  have ht : Nat.blt u v = true := by
    rw [Nat.blt_eq]
    exact hlt
  rw [ht] at h
  exact Bool.noConfusion h
theorem mem_merge : ∀ (fuel : Nat) (a b : List Nat) (x : Nat), x ∈ a ∨ x ∈ b →
    x ∈ merge fuel a b := by
  intro fuel
  induction fuel with
  | zero => intro a b x h; simpa [merge] using h
  | succ fuel ih =>
    intro a b x h
    cases a with
    | nil => simpa [merge] using h
    | cons u a =>
      cases b with
      | nil => simpa [merge] using h
      | cons v b =>
        simp only [merge]
        cases h1 : Nat.blt u v
        · cases h2 : Nat.blt v u
          · have huv : u = v := le_antisymm (le_of_blt_false h2) (le_of_blt_false h1)
            simp only [Bool.cond_false, List.mem_cons]
            rcases h with h | h
            · rcases List.mem_cons.1 h with rfl | h
              · exact Or.inl rfl
              · exact Or.inr (ih _ _ _ (Or.inl h))
            · rcases List.mem_cons.1 h with rfl | h
              · exact Or.inl huv.symm
              · exact Or.inr (ih _ _ _ (Or.inr h))
          · simp only [Bool.cond_false, Bool.cond_true, List.mem_cons]
            rcases h with h | h
            · exact Or.inr (ih _ _ _ (Or.inl h))
            · rcases List.mem_cons.1 h with rfl | h
              · exact Or.inl rfl
              · exact Or.inr (ih _ _ _ (Or.inr h))
        · simp only [Bool.cond_true, List.mem_cons]
          rcases h with h | h
          · rcases List.mem_cons.1 h with rfl | h
            · exact Or.inl rfl
            · exact Or.inr (ih _ _ _ (Or.inl h))
          · exact Or.inr (ih _ _ _ (Or.inr h))
theorem mem_mergePairs (fuel : Nat) : ∀ (n : Nat) (l : List (List Nat)), l.length ≤ n → ∀ x : Nat,
    (∃ a ∈ l, x ∈ a) → ∃ a ∈ mergePairs fuel l, x ∈ a := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro l hl x h
    match l, hl, h with
    | [], _, h => simp at h
    | [a], _, h => simpa [mergePairs] using h
    | a :: b :: t, hl, h =>
      obtain ⟨c, hc, hx⟩ := h
      simp only [mergePairs, List.mem_cons]
      rcases List.mem_cons.1 hc with rfl | hc
      · exact ⟨_, Or.inl rfl, mem_merge _ _ _ _ (Or.inl hx)⟩
      · rcases List.mem_cons.1 hc with rfl | hc
        · exact ⟨_, Or.inl rfl, mem_merge _ _ _ _ (Or.inr hx)⟩
        · obtain ⟨d, hd, hxd⟩ := ih t.length (by simp at hl; omega) t le_rfl x ⟨c, hc, hx⟩
          exact ⟨d, Or.inr hd, hxd⟩
theorem mem_mergeAll (fuel : Nat) : ∀ (k : Nat) (l : List (List Nat)) (x : Nat),
    (∃ a ∈ l, x ∈ a) → x ∈ mergeAll fuel k l := by
  intro k
  induction k with
  | zero =>
    intro l x h
    simpa [mergeAll, List.mem_flatten] using h
  | succ k ih =>
    intro l x h
    match l, h with
    | [], h => simp at h
    | [a], h => simpa [mergeAll] using h
    | a :: b :: t, h =>
      simp only [mergeAll]
      exact ih _ x (mem_mergePairs fuel _ _ le_rfl x h)
theorem mem_dedupSort {l : List Nat} {x : Nat} (h : x ∈ l) : x ∈ dedupSort l := by
  unfold dedupSort
  exact mem_mergeAll _ _ _ x ⟨[x], List.mem_map.2 ⟨x, h, rfl⟩, by simp⟩
theorem step_mem (r : Nat) (g conj ka kb : Bool) (a b : Nat) (rest : List Nat) (S : List Nat)
    (hc : ∀ c ∈ a :: b :: rest, c < 65536) (hl16 : (a :: b :: rest).length ≤ 16)
    (hS : mkSt g (a :: b :: rest) ∈ S)
    (hcov : Cov (mk conj a b :: kept ka a (kept kb b rest)))
    (hlen : rest.length + ka.toNat + kb.toNat ≤ r)
    (hnc : rest.length + ka.toNat + kb.toNat = r →
      ¬ Conf (mk conj a b :: kept ka a (kept kb b rest))) :
    mkSt (g || feat2 conj ka kb a b) (mk conj a b :: kept ka a (kept kb b rest)) ∈ level r S := by
  unfold level
  apply mem_dedupSort
  refine mem_foldl_succs r ?_ S [] hS
  intro acc
  have hperm := sortL_perm (a :: b :: rest)
  have hcs : ∀ c ∈ sortL (a :: b :: rest), c < 65536 := fun c h => hc c (hperm.subset h)
  rw [succsInto_eq, odd_mkSt, div_mkSt, unpack_pack _ hcs 16 (by rw [hperm.length_eq]; exact hl16)]
  obtain ⟨l1, l2, l3, hL, hrest⟩ := perm_split hperm
  rcases hL with hL | hL
  · rw [hL]
    have p : (mk conj a b :: kept ka a (kept kb b rest)).Perm
        (mk conj a b :: kept ka a (kept kb b (l1 ++ l2 ++ l3))) :=
      List.Perm.cons _ (kept_perm _ _ (kept_perm _ _ hrest.symm))
    rw [mkSt_perm _ p]
    refine gen_mem r g conj ka kb l1 l2 l3 a b acc (by rw [← hL]; exact hcs) ?_ (cov_perm p hcov) ?_
    · rw [hrest.length_eq]; exact hlen
    · rw [hrest.length_eq]
      exact fun h1 h2 => hnc h1 (conf_perm p.symm h2)
  · rw [hL]
    have p : (mk conj a b :: kept ka a (kept kb b rest)).Perm
        (mk conj b a :: kept kb b (kept ka a (l1 ++ l2 ++ l3))) := by
      rw [mk_comm conj b a]
      exact List.Perm.cons _ ((kept_perm _ _ (kept_perm _ _ hrest.symm)).trans (kept_comm _ _ _ _ _))
    have e : mkSt (g || feat2 conj ka kb a b) (mk conj a b :: kept ka a (kept kb b rest)) =
        mkSt (g || feat2 conj kb ka b a)
          (mk conj b a :: kept kb b (kept ka a (l1 ++ l2 ++ l3))) := by
      rw [feat2_comm]
      exact mkSt_perm _ p
    rw [e]
    refine gen_mem r g conj kb ka l1 l2 l3 b a acc (by rw [← hL]; exact hcs) ?_ (cov_perm p hcov) ?_
    · rw [hrest.length_eq]; omega
    · rw [hrest.length_eq]
      exact fun h1 h2 => hnc (by omega) (conf_perm p.symm h2)
theorem levels_succ (s : Nat) (S : List Nat) :
    levels (s + 1) (s + 1) S = levels s s (level s S) := by
  simp [levels]
theorem run_step {f : Bool} {s : Nat} {a b : Nat} {rest : List Nat} (conj ka kb : Bool)
    (hrun : RunF f s (mk conj a b :: kept ka a (kept kb b rest))) (g : Bool) (S : List Nat)
    (hc : ∀ c ∈ a :: b :: rest, c < 65536) (hs : s ≤ 14) (hS : mkSt g (a :: b :: rest) ∈ S) :
    mkSt (g || feat2 conj ka kb a b) (mk conj a b :: kept ka a (kept kb b rest)) ∈ level s S ∧
      ∀ c ∈ mk conj a b :: kept ka a (kept kb b rest), c < 65536 := by
  have hp := runF_prune hrun
  have hpp := runF_prune (RunF.two conj ka kb hrun)
  have hl := hp.2
  simp only [List.length_cons, kept_length] at hl
  refine ⟨step_mem s g conj ka kb a b rest S hc (by have := hpp.2; omega) hS hp.1 (by omega) ?_,
    lt_step conj ka kb a b rest (hc a (by simp)) (hc b (by simp)) fun c h => hc c (by simp [h])⟩
  intro ht hconf
  refine conf_dead hrun ?_ hconf
  simp only [List.length_cons, kept_length]
  omega
theorem bfs_sound {f : Bool} {r : Nat} {ws : List Nat} (h : RunF f r ws) :
    r ≤ 15 → (∀ c ∈ ws, c < 65536) → ∀ (S : List Nat) (g : Bool), mkSt g ws ∈ S →
      ∃ c, c / 2 = 32640 ∧ mkSt (g || f) [c] ∈ levels r r S := by
  induction h with
  | done c hc =>
    intro _ _ S g hS
    exact ⟨c, hc, by simpa [levels] using hS⟩
  | perm p _ ih =>
    intro hr hc S g hS
    exact ih hr (fun c h => hc c (p.subset h)) S g (by rwa [mkSt_perm g p])
  | @two f s a b rest conj ka kb hrun ih =>
    intro hr hc S g hS
    obtain ⟨hmem, hc'⟩ := run_step conj ka kb hrun g S hc (by omega) hS
    obtain ⟨c, hc1, hc2⟩ := ih (by omega) hc' (level s S) (g || feat2 conj ka kb a b) hmem
    exact ⟨c, hc1, by rw [levels_succ, ← Bool.or_assoc]; exact hc2⟩
theorem subS_sound : ∀ (ys xs : List Nat), subS xs ys = true → ∀ x ∈ xs, x ∈ ys := by
  intro ys
  induction ys with
  | nil =>
    intro xs h x hx
    cases xs with
    | nil => simp at hx
    | cons u xs => simp [subS] at h
  | cons y ys ih =>
    intro xs h x hx
    cases xs with
    | nil => simp at hx
    | cons u xs =>
      simp only [subS] at h
      cases hb : Nat.beq u y
      · rw [hb, Bool.cond_false] at h
        cases hb2 : Nat.blt y u
        · rw [hb2] at h
          exact Bool.noConfusion h
        · rw [hb2, Bool.cond_true] at h
          exact List.mem_cons_of_mem _ (ih _ h x hx)
      · rw [hb, Bool.cond_true] at h
        rcases List.mem_cons.1 hx with rfl | hx
        · rw [Nat.eq_of_beq_eq_true hb]
          exact List.mem_cons_self
        · exact List.mem_cons_of_mem _ (ih _ h x hx)
def Lv : Nat → List Nat
  | 0 => L0
  | 1 => L1
  | 2 => L2
  | 3 => L3
  | 4 => L4
  | 5 => L5
  | 6 => L6
  | 7 => L7
  | 8 => L8
  | 9 => L9
  | 10 => L10
  | 11 => L11
  | _ => []
theorem lv_closed (r : Nat) (hr : r < 11) (p : Nat) (hp : p ∈ Lv (r + 1)) :
    ∃ ch, p ∈ ch ∧ subS (level r ch) (Lv r) = true := by
  match r, hr, hp with
  | 0, _, hp => exact ⟨c1x0, hp, tc1x0⟩
  | 1, _, hp => exact ⟨c2x0, hp, tc2x0⟩
  | 2, _, hp => exact ⟨c3x0, hp, tc3x0⟩
  | 3, _, hp => exact ⟨c4x0, hp, tc4x0⟩
  | 4, _, hp => exact ⟨c5x0, hp, tc5x0⟩
  | 5, _, hp => exact ⟨c6x0, hp, tc6x0⟩
  | 6, _, hp =>
    have h : p ∈ L7 := hp
    simp only [L7, List.mem_append] at h
    rcases h with ((h | h) | h) | h
    · exact ⟨_, h, tc7x0⟩
    · exact ⟨_, h, tc7x1⟩
    · exact ⟨_, h, tc7x2⟩
    · exact ⟨_, h, tc7x3⟩
  | 7, _, hp =>
    have h : p ∈ L8 := hp
    simp only [L8, List.mem_append] at h
    rcases h with (((((((h | h) | h) | h) | h) | h) | h) | h) | h
    · exact ⟨_, h, tc8x0⟩
    · exact ⟨_, h, tc8x1⟩
    · exact ⟨_, h, tc8x2⟩
    · exact ⟨_, h, tc8x3⟩
    · exact ⟨_, h, tc8x4⟩
    · exact ⟨_, h, tc8x5⟩
    · exact ⟨_, h, tc8x6⟩
    · exact ⟨_, h, tc8x7⟩
    · exact ⟨_, h, tc8x8⟩
  | 8, _, hp =>
    have h : p ∈ L9 := hp
    simp only [L9, List.mem_append] at h
    rcases h with (((((h | h) | h) | h) | h) | h) | h
    · exact ⟨_, h, tc9x0⟩
    · exact ⟨_, h, tc9x1⟩
    · exact ⟨_, h, tc9x2⟩
    · exact ⟨_, h, tc9x3⟩
    · exact ⟨_, h, tc9x4⟩
    · exact ⟨_, h, tc9x5⟩
    · exact ⟨_, h, tc9x6⟩
  | 9, _, hp => exact ⟨c10x0, hp, tc10x0⟩
  | 10, _, hp => exact ⟨c11x0, hp, tc11x0⟩
  | n + 11, hr, _ => exact absurd hr (by omega)
theorem table_sound {f : Bool} {r : Nat} {ws : List Nat} (h : RunF f r ws) :
    r ≤ 11 → (∀ c ∈ ws, c < 65536) → ∀ g : Bool, mkSt g ws ∈ Lv r →
      ∃ c, c / 2 = 32640 ∧ mkSt (g || f) [c] ∈ L0 := by
  induction h with
  | done c hc =>
    intro _ _ g hS
    exact ⟨c, hc, by rw [Bool.or_false]; exact hS⟩
  | perm p _ ih =>
    intro hr hc g hS
    exact ih hr (fun c h => hc c (p.subset h)) g (by rwa [mkSt_perm g p])
  | @two f s a b rest conj ka kb hrun ih =>
    intro hr hc g hS
    obtain ⟨ch, hch, hsub⟩ := lv_closed s (by omega) _ hS
    obtain ⟨hmem, hc'⟩ := run_step conj ka kb hrun g ch hc (by omega) hch
    obtain ⟨c, hc1, hc2⟩ := ih (by omega) hc' (g || feat2 conj ka kb a b)
      (subS_sound _ _ hsub _ hmem)
    exact ⟨c, hc1, by rw [← Bool.or_assoc]; exact hc2⟩

open PEqualNP.MetaComplexity PEqualNP.CircuitLowerBounds

def wiresFrom (gs : List Gate) (w : List Bool) : List Bool :=
  gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) w

theorem wires_eq (C : Circuit) (x : List Bool) : C.wires x = wiresFrom C.gates x := rfl

theorem wiresFrom_append (gs gs' : List Gate) (w : List Bool) :
    wiresFrom (gs ++ gs') w = wiresFrom gs' (wiresFrom gs w) := by
  simp [wiresFrom, List.foldl_append]

theorem wiresFrom_start (gs : List Gate) : ∀ w : List Bool,
    ∃ t : List Bool, wiresFrom gs w = w ++ t ∧ t.length = gs.length := by
  induction gs with
  | nil => intro w; exact ⟨[], by simp [wiresFrom], rfl⟩
  | cons g gs ih =>
    intro w
    obtain ⟨t, ht, hl⟩ := ih (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
    refine ⟨g.op.eval (g.inputs.map fun i => w.getD i false) :: t, ?_, by simp [hl]⟩
    have : wiresFrom (g :: gs) w
        = wiresFrom gs (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) := rfl
    rw [this, ht]; simp

theorem length_wiresFrom (gs : List Gate) (w : List Bool) :
    (wiresFrom gs w).length = w.length + gs.length := by
  obtain ⟨t, ht, hl⟩ := wiresFrom_start gs w
  rw [ht]; simp [hl]

theorem getD_wiresFrom (gs : List Gate) (w : List Bool) (i : Nat) (h : i < w.length) :
    (wiresFrom gs w).getD i false = w.getD i false := by
  obtain ⟨t, ht, _⟩ := wiresFrom_start gs w
  rw [ht, List.getD_append _ _ _ _ h]

theorem getD_snoc_len {α : Type} (L : List α) (S d : α) (k : Nat) (h : L.length = k) :
    (L ++ [S]).getD k d = S := by
  subst h; simp

theorem split_at {α : Type} : ∀ (l : List α) (p : Nat) (g : α), l[p]? = some g →
    ∃ pre post, l = pre ++ g :: post ∧ pre.length = p := by
  intro l
  induction l with
  | nil => intro p g h; simp at h
  | cons x l ih =>
    intro p g h
    cases p with
    | zero =>
      simp at h
      subst h
      exact ⟨[], l, rfl, rfl⟩
    | succ p =>
      simp at h
      obtain ⟨pre, post, rfl, rfl⟩ := ih p g h
      exact ⟨x :: pre, post, rfl, rfl⟩

abbrev BFn : Type := (Fin 8 → Bool) → Bool

def val (gs : List Gate) (a : Nat) : BFn :=
  fun x => (wiresFrom gs (List.ofFn x)).getD a false

theorem val_input (gs : List Gate) (i : Fin 8) : val gs i = fun x => x i := by
  funext x
  unfold val
  rw [getD_wiresFrom _ _ _ (by rw [List.length_ofFn]; exact i.isLt), List.getD_eq_getElem?_getD,
    List.getElem?_ofFn]
  simp [i.isLt]

theorem val_beyond (gs : List Gate) (a : Nat) (h : 8 + gs.length ≤ a) (x : Fin 8 → Bool) :
    val gs a x = false := by
  unfold val
  rw [List.getD_eq_default _ _ (by rw [length_wiresFrom, List.length_ofFn]; exact h)]

theorem val_gate (gs : List Gate) (p : Nat) (g : Gate) (hp : gs[p]? = some g)
    (hlt : ∀ a ∈ g.inputs, a < 8 + p) (x : Fin 8 → Bool) :
    val gs (8 + p) x = g.op.eval (g.inputs.map fun a => val gs a x) := by
  obtain ⟨pre, post, rfl, hlen⟩ := split_at gs p g hp
  unfold val
  have h1 : wiresFrom (pre ++ g :: post) (List.ofFn x) = wiresFrom post
      (wiresFrom pre (List.ofFn x) ++
        [g.op.eval (g.inputs.map fun i => (wiresFrom pre (List.ofFn x)).getD i false)]) := by
    rw [wiresFrom_append]; rfl
  have hl : (wiresFrom pre (List.ofFn x)).length = 8 + p := by
    rw [length_wiresFrom, List.length_ofFn, hlen]
  rw [h1, getD_wiresFrom _ _ _ (by rw [List.length_append, hl]; simp), getD_snoc_len _ _ _ _ hl]
  congr 1
  apply List.map_congr_left
  intro a ha
  have hal := hlt a ha
  have e1 := getD_wiresFrom post (wiresFrom pre (List.ofFn x) ++
        [g.op.eval (g.inputs.map fun i => (wiresFrom pre (List.ofFn x)).getD i false)]) a
        (by rw [List.length_append, hl]; simp; omega)
  rw [e1, List.getD_append _ _ _ _ (by omega)]

def isAndOp : GateOp → Bool
  | GateOp.and => true
  | _ => false

def MGate (m : Nat) (g : Gate) : Prop :=
  (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ ∃ j k, j < m ∧ k < m ∧ g.inputs = [j, k]

def MClean (gs : List Gate) : Prop :=
  ∀ (p : Nat) (g : Gate), gs[p]? = some g → MGate (8 + p) g

theorem MGate.lt {m : Nat} {g : Gate} (h : MGate m g) : ∀ a ∈ g.inputs, a < m := by
  obtain ⟨_, j, k, hj, hk, hinp⟩ := h
  intro a ha
  rw [hinp] at ha
  simp at ha
  rcases ha with rfl | rfl <;> assumption

theorem val_m (gs : List Gate) (hcl : MClean gs) (p : Nat) (g : Gate) (hg : gs[p]? = some g)
    (j k : Nat) (hinp : g.inputs = [j, k]) (x : Fin 8 → Bool) :
    val gs (8 + p) x = (bif isAndOp g.op then val gs j x && val gs k x
      else val gs j x || val gs k x) := by
  rw [val_gate gs p g hg (hcl p g hg).lt x, hinp]
  rcases (hcl p g hg).1 with hop | hop <;> rw [hop] <;> simp [GateOp.eval, isAndOp]

def rows15 : List Nat := [82, 106, 137, 149, 212, 228, 232, 3, 6, 12, 24, 33, 48, 65, 130]

def pt (v : Nat) : Fin 8 → Bool := fun i => v.testBit i

def encL (a : BFn) : List Nat → Nat
  | [] => 0
  | v :: t => Nat.bit (a (pt v)) (encL a t)

theorem encL_testBit (a : BFn) : ∀ (l : List Nat) (j : Nat),
    (encL a l).testBit j = (l.map fun v => a (pt v)).getD j false
  | [], j => by simp [encL]
  | v :: t, 0 => by simp [encL]
  | v :: t, j + 1 => by simp [encL, Nat.testBit_bit_succ, encL_testBit a t j]

theorem encL_and (a b : BFn) (l : List Nat) :
    encL (fun x => a x && b x) l = encL a l &&& encL b l := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_and, encL_testBit, encL_testBit, encL_testBit]
  by_cases h : j < l.length
  · simp [h]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega),
      List.getD_eq_default _ _ (by simp; omega)]
    rfl

theorem encL_or (a b : BFn) (l : List Nat) :
    encL (fun x => a x || b x) l = encL a l ||| encL b l := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_or, encL_testBit, encL_testBit, encL_testBit]
  by_cases h : j < l.length
  · simp [h]
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega),
      List.getD_eq_default _ _ (by simp; omega)]
    rfl

theorem encL_lt (a : BFn) (l : List Nat) : encL a l < 2 ^ l.length := by
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  rw [encL_testBit, List.getD_eq_default _ _ (by simpa using hi)]

def enc (a : BFn) : Nat := encL a rows15

theorem enc_lt (a : BFn) : enc a < 32768 := by
  have := encL_lt a rows15
  simpa [enc, rows15] using this

def tagB (gs : List Gate) (w : Nat) : Bool :=
  match gs[w - 8]? with
  | some g => decide (8 ≤ w) && isAndOp g.op
  | none => false

def code (gs : List Gate) (w : Nat) : Nat := 2 * enc (val gs w) + (bif tagB gs w then 1 else 0)

theorem code_div (gs : List Gate) (w : Nat) : code gs w / 2 = enc (val gs w) := by
  unfold code
  cases tagB gs w
  · simp only [Bool.cond_false]; omega
  · simp only [Bool.cond_true]; omega

theorem code_odd (gs : List Gate) (w : Nat) : odd (code gs w) = tagB gs w := by
  unfold code odd
  cases tagB gs w
  · have h : (2 * enc (val gs w) + 0) % 2 = 0 := by omega
    simp only [Bool.cond_false]
    rw [h]
    rfl
  · have h : (2 * enc (val gs w) + 1) % 2 = 1 := by omega
    simp only [Bool.cond_true]
    rw [h]
    rfl

theorem code_lt (gs : List Gate) (w : Nat) : code gs w < 65536 := by
  have := enc_lt (val gs w)
  unfold code
  cases tagB gs w
  · simp only [Bool.cond_false]; omega
  · simp only [Bool.cond_true]; omega

theorem tagB_gate (gs : List Gate) (p : Nat) (g : Gate) (hg : gs[p]? = some g) :
    tagB gs (8 + p) = isAndOp g.op := by
  unfold tagB
  rw [show 8 + p - 8 = p by omega, hg]
  simp

theorem code_gate (gs : List Gate) (hcl : MClean gs) (p : Nat) (g : Gate) (hg : gs[p]? = some g)
    (j k : Nat) (hinp : g.inputs = [j, k]) :
    code gs (8 + p) = mk (isAndOp g.op) (code gs j) (code gs k) := by
  have hv : val gs (8 + p) = fun x => (bif isAndOp g.op then val gs j x && val gs k x
      else val gs j x || val gs k x) := funext (val_m gs hcl p g hg j k hinp)
  have hm : mk (isAndOp g.op) (code gs j) (code gs k) =
      bif isAndOp g.op then 2 * (enc (val gs j) &&& enc (val gs k)) + 1
      else 2 * (enc (val gs j) ||| enc (val gs k)) := by
    unfold mk
    rw [code_div, code_div]
  rw [hm]
  unfold code
  rw [tagB_gate gs p g hg, hv]
  cases isAndOp g.op
  · simp only [Bool.cond_false, enc, encL_or, Nat.add_zero]
  · simp only [Bool.cond_true, enc, encL_and]

def Live (gs : List Gate) (o p a : Nat) : Prop :=
  a = o ∨ ∃ q, p ≤ q ∧ ∃ g, gs[q]? = some g ∧ a ∈ g.inputs

open Classical in
noncomputable def liveList (gs : List Gate) (o p : Nat) : List Nat :=
  (List.range (8 + p)).filter (fun a => decide (Live gs o p a))

theorem mem_liveList (gs : List Gate) (o p a : Nat) :
    a ∈ liveList gs o p ↔ a < 8 + p ∧ Live gs o p a := by
  simp [liveList]

theorem nodup_liveList (gs : List Gate) (o p : Nat) : (liveList gs o p).Nodup :=
  List.Nodup.filter _ List.nodup_range

theorem kept_map (e : Nat → Nat) (b : Bool) (x : Nat) (xs : List Nat) :
    (kept b x xs).map e = kept b (e x) (xs.map e) := by
  cases b <;> simp [kept]

theorem mem_kept_iff (b : Bool) (x a : Nat) (xs : List Nat) :
    a ∈ kept b x xs ↔ (b = true ∧ a = x) ∨ a ∈ xs := by
  cases b <;> simp [kept]

theorem nodup_kept (b : Bool) (x : Nat) (xs : List Nat) (h : xs.Nodup) (hx : x ∉ xs) :
    (kept b x xs).Nodup := by
  cases b
  · simpa [kept] using h
  · simpa [kept] using And.intro hx h

theorem live_succ (gs : List Gate) (o : Nat) (hcl : MClean gs)
    (hnd : ∀ p, p < gs.length → 8 + p = o ∨ ∃ (q : Nat) (g : Gate), gs[q]? = some g ∧ 8 + p ∈ g.inputs)
    (p : Nat) (g : Gate) (hg : gs[p]? = some g) (a : Nat) :
    a ∈ liveList gs o (p + 1) ↔
      a = 8 + p ∨ (a ∈ liveList gs o p ∧ (a ∈ g.inputs → Live gs o (p + 1) a)) := by
  have hplt : p < gs.length := (List.getElem?_eq_some_iff.1 hg).1
  rw [mem_liveList, mem_liveList]
  constructor
  · rintro ⟨hlt, hl⟩
    by_cases ha : a = 8 + p
    · exact Or.inl ha
    · refine Or.inr ⟨⟨by omega, ?_⟩, fun _ => hl⟩
      rcases hl with h | ⟨q, hq, g', hg', hin⟩
      · exact Or.inl h
      · exact Or.inr ⟨q, by omega, g', hg', hin⟩
  · rintro (rfl | ⟨⟨hlt, hl⟩, himp⟩)
    · refine ⟨by omega, ?_⟩
      rcases hnd p hplt with h | ⟨q, g', hg', hin⟩
      · exact Or.inl h
      · refine Or.inr ⟨q, ?_, g', hg', hin⟩
        have := (hcl q g' hg').lt _ hin
        omega
    · refine ⟨by omega, ?_⟩
      rcases hl with h | ⟨q, hq, g', hg', hin⟩
      · exact Or.inl h
      · by_cases hqp : q = p
        · subst hqp
          rw [hg] at hg'
          cases hg'
          exact himp hin
        · exact Or.inr ⟨q, by omega, g', hg', hin⟩

noncomputable def gfeat (gs : List Gate) (o q : Nat) (g : Gate) (j k : Nat) : Bool :=
  open Classical in
  feat2 (isAndOp g.op) (decide (Live gs o (q + 1) j)) (decide (Live gs o (q + 1) k))
    (code gs j) (code gs k)

theorem run_of (gs : List Gate) (o : Nat) (hcl : MClean gs) (ho : o < 8 + gs.length)
    (hnd : ∀ p, p < gs.length → 8 + p = o ∨ ∃ (q : Nat) (g : Gate), gs[q]? = some g ∧ 8 + p ∈ g.inputs)
    (hdist : ∀ (p : Nat) (g : Gate) (j k : Nat), gs[p]? = some g → g.inputs = [j, k] → j ≠ k)
    (hF : enc (val gs o) = 32640) :
    ∀ d p, p + d = gs.length → ∃ f, RunF f d ((liveList gs o p).map (code gs)) ∧
      (f = false → ∀ (q : Nat) (g : Gate) (j k : Nat), p ≤ q → gs[q]? = some g →
        g.inputs = [j, k] → gfeat gs o q g j k = false) := by
  classical
  intro d
  induction d with
  | zero =>
    intro p hp
    have hperm : [o].Perm (liveList gs o p) := by
      refine (List.perm_ext_iff_of_nodup (List.nodup_singleton o) (nodup_liveList _ _ _)).2 ?_
      intro a
      rw [mem_liveList, List.mem_singleton]
      constructor
      · rintro rfl; exact ⟨by omega, Or.inl rfl⟩
      · rintro ⟨_, h | ⟨q, hq, g', hg', _⟩⟩
        · exact h
        · have := (List.getElem?_eq_some_iff.1 hg').1
          omega
    refine ⟨false, RunF.perm (hperm.map (code gs)) (RunF.done _ ?_), ?_⟩
    · rw [code_div, hF]
    · intro _ q g j k hq hg _
      have := (List.getElem?_eq_some_iff.1 hg).1
      omega
  | succ d ih =>
    intro p hp
    have hplt : p < gs.length := by omega
    obtain ⟨g, hg⟩ : ∃ g, gs[p]? = some g := ⟨gs[p], List.getElem?_eq_getElem hplt⟩
    obtain ⟨f, IH, IHf⟩ := ih (p + 1) (by omega)
    have hstep := live_succ gs o hcl hnd p g hg
    have hin : ∀ a ∈ g.inputs, a ∈ liveList gs o p := fun a ha =>
      (mem_liveList _ _ _ _).2 ⟨(hcl p g hg).lt a ha, Or.inr ⟨p, le_rfl, g, hg, ha⟩⟩
    have hnew : ∀ a ∈ liveList gs o p, a ≠ 8 + p := fun a ha =>
      Nat.ne_of_lt ((mem_liveList _ _ _ _).1 ha).1
    have hnd0 := nodup_liveList gs o p
    obtain ⟨hop, j, k, hj, hk, hinp⟩ := hcl p g hg
    have hjk : j ≠ k := hdist p g j k hg hinp
    have hjm := hin j (by simp [hinp])
    have hkm := hin k (by simp [hinp])
    have hke : k ∈ (liveList gs o p).erase j :=
      (hnd0.mem_erase_iff).2 ⟨fun e => hjk e.symm, hkm⟩
    have hnr : ((liveList gs o p).erase j).Nodup := hnd0.erase j
    have hnr2 : (((liveList gs o p).erase j).erase k).Nodup := hnr.erase k
    have hp1 : (liveList gs o p).Perm (j :: k :: ((liveList gs o p).erase j).erase k) :=
      (List.perm_cons_erase hjm).trans ((List.perm_cons_erase hke).cons j)
    have hmr : ∀ a, a ∈ ((liveList gs o p).erase j).erase k ↔
        a ≠ k ∧ a ≠ j ∧ a ∈ liveList gs o p := by
      intro a
      rw [hnr.mem_erase_iff, hnd0.mem_erase_iff]
    have hp2 : (liveList gs o (p + 1)).Perm
        ((8 + p) :: kept (decide (Live gs o (p + 1) j)) j
          (kept (decide (Live gs o (p + 1) k)) k (((liveList gs o p).erase j).erase k))) := by
      refine (List.perm_ext_iff_of_nodup (nodup_liveList _ _ _) ?_).2 ?_
      · refine List.nodup_cons.2 ⟨?_, nodup_kept _ _ _ (nodup_kept _ _ _ hnr2 ?_) ?_⟩
        · rw [mem_kept_iff, mem_kept_iff]
          rintro (⟨_, h⟩ | ⟨_, h⟩ | h)
          · exact hnew j hjm h.symm
          · exact hnew k hkm h.symm
          · exact hnew _ ((hmr _).1 h).2.2 rfl
        · rw [hmr]; simp
        · rw [mem_kept_iff, hmr]
          rintro (⟨_, h⟩ | h)
          · exact hjk h
          · exact h.2.1 rfl
      · intro a
        rw [hstep a, List.mem_cons, mem_kept_iff, mem_kept_iff, hmr a]
        simp only [decide_eq_true_eq, hinp, List.mem_cons, List.not_mem_nil, or_false]
        constructor
        · rintro (h | ⟨h1, h2⟩)
          · exact Or.inl h
          · by_cases haj : a = j
            · exact Or.inr (Or.inl ⟨haj ▸ h2 (Or.inl haj), haj⟩)
            · by_cases hak : a = k
              · exact Or.inr (Or.inr (Or.inl ⟨hak ▸ h2 (Or.inr hak), hak⟩))
              · exact Or.inr (Or.inr (Or.inr ⟨hak, haj, h1⟩))
        · rintro (h | ⟨h1, rfl⟩ | ⟨h1, rfl⟩ | ⟨h1, h2, h3⟩)
          · exact Or.inl h
          · exact Or.inr ⟨hjm, fun _ => h1⟩
          · exact Or.inr ⟨hkm, fun _ => h1⟩
          · exact Or.inr ⟨h3, fun h => by rcases h with h | h <;> contradiction⟩
    have IH' := RunF.perm (hp2.map (code gs)) IH
    rw [List.map_cons, kept_map, kept_map, code_gate gs hcl p g hg j k hinp] at IH'
    refine ⟨gfeat gs o p g j k || f, RunF.perm (hp1.map (code gs)).symm (RunF.two _ _ _ IH'), ?_⟩
    intro hff q g' j' k' hq hg' hinp'
    have hf1 : gfeat gs o p g j k = false := by
      cases h : gfeat gs o p g j k
      · rfl
      · rw [h] at hff; simp at hff
    have hf2 : f = false := by
      cases h : f
      · rfl
      · rw [h] at hff; simp at hff
    by_cases hqp : q = p
    · subst hqp
      rw [hg] at hg'
      cases hg'
      rw [hinp] at hinp'
      cases hinp'
      exact hf1
    · exact IHf hf2 q g' j' k' (by omega) hg' hinp'

def shift (K a : Nat) : Nat := if a < K then a else a - 1

def shGate (K : Nat) (g : Gate) : Gate := ⟨g.op, g.inputs.map (shift K)⟩

def RelD (K : Nat) (W W' : List Bool) : Prop :=
  W.length = W'.length + 1 ∧ K ≤ W'.length ∧
    ∀ a, a ≠ K → W'.getD (shift K a) false = W.getD a false

theorem getD_snoc_eq' {α : Type} (L : List α) (S d : α) : (L ++ [S]).getD L.length d = S := by
  simp

theorem relD_wires (K : Nat) (post : List Gate) : ∀ W W' : List Bool,
    (∀ g ∈ post, K ∉ g.inputs) → RelD K W W' →
    RelD K (wiresFrom post W) (wiresFrom (post.map (shGate K)) W') := by
  induction post with
  | nil => intro W W' _ h; exact h
  | cons g post ih =>
    intro W W' hno h
    obtain ⟨h1, h2, h3⟩ := h
    have hv : (shGate K g).op.eval ((shGate K g).inputs.map fun i => W'.getD i false)
        = g.op.eval (g.inputs.map fun i => W.getD i false) := by
      simp only [shGate, List.map_map]
      congr 1
      apply List.map_congr_left
      intro a ha
      exact h3 a (fun e => hno g List.mem_cons_self (e ▸ ha))
    have s1 : wiresFrom (g :: post) W
        = wiresFrom post (W ++ [g.op.eval (g.inputs.map fun i => W.getD i false)]) := rfl
    have s2 : wiresFrom ((g :: post).map (shGate K)) W'
        = wiresFrom (post.map (shGate K))
          (W' ++ [(shGate K g).op.eval ((shGate K g).inputs.map fun i => W'.getD i false)]) := rfl
    rw [s1, s2, hv]
    apply ih _ _ (fun g' hg' => hno g' (List.mem_cons_of_mem _ hg'))
    refine ⟨by simp; omega, by simp; omega, ?_⟩
    intro a haK
    rcases Nat.lt_trichotomy a W.length with hw | hw | hw
    · have hlt : shift K a < W'.length := by
        unfold shift; split <;> omega
      rw [List.getD_append _ _ _ _ hlt, List.getD_append _ _ _ _ hw]
      exact h3 a haK
    · have he : shift K a = W'.length := by
        unfold shift; split <;> omega
      rw [he, hw, getD_snoc_eq', getD_snoc_eq']
    · have hge : W'.length + 1 ≤ shift K a := by
        unfold shift; split <;> omega
      rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega)]

theorem del_m (pre : List Gate) (g : Gate) (post : List Gate) (o : Nat)
    (hcl : MClean (pre ++ g :: post))
    (hno : ∀ g' ∈ post, 8 + pre.length ∉ g'.inputs) (ho : o ≠ 8 + pre.length) :
    MClean (pre ++ post.map (shGate (8 + pre.length))) ∧
      ∀ x, val (pre ++ post.map (shGate (8 + pre.length))) (shift (8 + pre.length) o) x =
        val (pre ++ g :: post) o x := by
  constructor
  · intro q g' hg'
    by_cases hq : q < pre.length
    · rw [List.getElem?_append_left hq] at hg'
      exact hcl q g' (by rw [List.getElem?_append_left hq]; exact hg')
    · rw [List.getElem?_append_right (by omega), List.getElem?_map] at hg'
      cases hpost : post[q - pre.length]? with
      | none => rw [hpost] at hg'; simp at hg'
      | some g0 =>
        rw [hpost] at hg'
        simp only [Option.map_some, Option.some.injEq] at hg'
        subst hg'
        have hg0 : (pre ++ g :: post)[q + 1]? = some g0 := by
          rw [List.getElem?_append_right (by omega)]
          have e : q + 1 - pre.length = (q - pre.length) + 1 := by omega
          rw [e]
          simpa using hpost
        obtain ⟨hop, j, k, hj, hk, hinp⟩ := hcl (q + 1) g0 hg0
        have hmem : g0 ∈ post := List.mem_of_getElem? hpost
        have hnj : j ≠ 8 + pre.length := fun e => hno g0 hmem (by rw [hinp, e]; simp)
        have hnk : k ≠ 8 + pre.length := fun e => hno g0 hmem (by rw [hinp, e]; simp)
        refine ⟨hop, shift (8 + pre.length) j, shift (8 + pre.length) k, ?_, ?_, ?_⟩
        · unfold shift; split <;> omega
        · unfold shift; split <;> omega
        · simp [shGate, hinp]
  · intro x
    show (wiresFrom (pre ++ post.map (shGate (8 + pre.length))) (List.ofFn x)).getD
      (shift (8 + pre.length) o) false = (wiresFrom (pre ++ g :: post) (List.ofFn x)).getD o false
    have h1 : wiresFrom (pre ++ g :: post) (List.ofFn x) = wiresFrom post
        (wiresFrom pre (List.ofFn x) ++
          [g.op.eval (g.inputs.map fun i => (wiresFrom pre (List.ofFn x)).getD i false)]) := by
      rw [wiresFrom_append]; rfl
    have hl : (wiresFrom pre (List.ofFn x)).length = 8 + pre.length := by
      rw [length_wiresFrom, List.length_ofFn]
    rw [h1, wiresFrom_append]
    refine (relD_wires (8 + pre.length) post _ _ hno ⟨by rw [List.length_append, hl]; simp,
      by omega, ?_⟩).2.2 o ho
    intro a ha
    by_cases hlt : a < 8 + pre.length
    · have : shift (8 + pre.length) a = a := by simp [shift, hlt]
      rw [this, List.getD_append _ _ _ _ (by omega)]
    · have : shift (8 + pre.length) a = a - 1 := by simp [shift, hlt]
      rw [this, List.getD_eq_default _ _ (by omega),
        List.getD_eq_default _ _ (by rw [List.length_append, hl]; simp; omega)]

def rho (K j a : Nat) : Nat := if a = K then j else a

def rdGate (K j : Nat) (g : Gate) : Gate := ⟨g.op, g.inputs.map (rho K j)⟩

theorem redirect (gs : List Gate) (hcl : MClean gs) (p : Nat) (g : Gate) (j : Nat)
    (hg : gs[p]? = some g) (hinp : g.inputs = [j, j]) :
    MClean (gs.map (rdGate (8 + p) j)) ∧
      (∀ w x, val (gs.map (rdGate (8 + p) j)) w x = val gs w x) ∧
      (∀ g' ∈ gs.map (rdGate (8 + p) j), 8 + p ∉ g'.inputs) := by
  have hjp : j < 8 + p := (hcl p g hg).lt j (by simp [hinp])
  have hvp : ∀ x, val gs (8 + p) x = val gs j x := by
    intro x
    rw [val_m gs hcl p g hg j j hinp x]
    cases isAndOp g.op <;> simp
  have hcl' : MClean (gs.map (rdGate (8 + p) j)) := by
    intro q g' hg'
    rw [List.getElem?_map] at hg'
    cases hq : gs[q]? with
    | none => rw [hq] at hg'; simp at hg'
    | some g0 =>
      rw [hq] at hg'
      simp only [Option.map_some, Option.some.injEq] at hg'
      subst hg'
      obtain ⟨hop, a, b, ha, hb, hi⟩ := hcl q g0 hq
      refine ⟨hop, rho (8 + p) j a, rho (8 + p) j b, ?_, ?_, by simp [rdGate, hi]⟩
      · unfold rho; split <;> omega
      · unfold rho; split <;> omega
  refine ⟨hcl', ?_, ?_⟩
  · intro w
    induction w using Nat.strong_induction_on with
    | _ w ih =>
      intro x
      by_cases hw8 : w < 8
      · have e1 := congrFun (val_input (gs.map (rdGate (8 + p) j)) ⟨w, hw8⟩) x
        have e2 := congrFun (val_input gs ⟨w, hw8⟩) x
        simp only at e1 e2
        rw [e1, e2]
      · by_cases hwl : w < 8 + gs.length
        · obtain ⟨q, rfl⟩ : ∃ q, w = 8 + q := ⟨w - 8, by omega⟩
          have hql : q < gs.length := by omega
          obtain ⟨g0, hq⟩ : ∃ g0, gs[q]? = some g0 := ⟨gs[q], List.getElem?_eq_getElem hql⟩
          have hq' : (gs.map (rdGate (8 + p) j))[q]? = some (rdGate (8 + p) j g0) := by
            rw [List.getElem?_map, hq]; rfl
          rw [val_gate _ q _ hq' (hcl' q _ hq').lt x, val_gate gs q g0 hq (hcl q g0 hq).lt x]
          simp only [rdGate, List.map_map]
          congr 1
          apply List.map_congr_left
          intro a ha
          have hal := (hcl q g0 hq).lt a ha
          simp only [Function.comp]
          by_cases hap : a = 8 + p
          · rw [show rho (8 + p) j a = j by simp [rho, hap], ih j (by omega) x, hap, hvp x]
          · rw [show rho (8 + p) j a = a by simp [rho, hap], ih a (by omega) x]
        · rw [val_beyond _ w (by simp; omega) x, val_beyond gs w (by omega) x]
  · intro g' hg' hmem
    obtain ⟨g0, _, rfl⟩ := List.mem_map.1 hg'
    simp only [rdGate, List.mem_map] at hmem
    obtain ⟨a, _, ha⟩ := hmem
    unfold rho at ha
    split at ha <;> omega

def fF : BFn := fun x : Fin 8 → Bool => (x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) ||
  (x 3 && x 4) || (x 4 && x 5) || (x 0 && x 5) || (x 0 && x 6) || (x 1 && x 7)

def MC (t : Nat) : Prop :=
  ∃ (gs : List Gate) (o : Nat), MClean gs ∧ gs.length = t ∧ ∀ x, val gs o x = fF x

theorem mc_dead {gs : List Gate} {o : Nat} (hcl : MClean gs) (hev : ∀ x, val gs o x = fF x)
    (p : Nat) (hp : p < gs.length) (hpo : 8 + p ≠ o)
    (hno : ∀ (q : Nat) (g : Gate), gs[q]? = some g → 8 + p ∉ g.inputs) : MC (gs.length - 1) := by
  obtain ⟨g, hg⟩ : ∃ g, gs[p]? = some g := ⟨gs[p], List.getElem?_eq_getElem hp⟩
  obtain ⟨pre, post, rfl, hpl⟩ := split_at gs p g hg
