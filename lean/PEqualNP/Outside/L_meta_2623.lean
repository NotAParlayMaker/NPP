import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_2623

def differences : Finset (Fin 13) := {0, 1, 3, 9}

def incidence (p l : Fin 13) : Prop := ∃ d ∈ differences, p = l + d

def incidenceDec (p l : Fin 13) : Decidable (incidence p l) := by unfold incidence; infer_instance

def pointSet (m : ℕ) : Finset (Fin 13) :=
  Finset.univ.filter fun p => m.testBit p.val

def lineClear (m : ℕ) (l : Fin 13) : Prop :=
  ∀ p : Fin 13, m.testBit p.val = true → ¬ incidence p l

def lineClearDec (m : ℕ) (l : Fin 13) : Decidable (lineClear m l) := by
  letI := incidenceDec
  unfold lineClear
  infer_instance

def maximal (m : ℕ) : Prop :=
  ∀ p : Fin 13, m.testBit p.val = false → ∃ l : Fin 13, lineClear m l ∧ incidence p l

def generic (m : ℕ) : Prop :=
  (¬∃ l : Fin 13, ∀ p : Fin 13, m.testBit p.val = true → incidence p l) ∧
  (¬∃ p : Fin 13, ∀ l : Fin 13, lineClear m l → incidence p l)

def representatives : List (ℕ × ℕ) :=
  [(7, 904), (13, 2848), (19, 708), (21, 2720), (25, 2656), (37, 2440), (41, 2370), (133, 808)]

def multipliers : List (Fin 13) := [1, 3, 9]

def transformed (r : ℕ × ℕ) (a b : Fin 13) (dual : Bool) : Fin (13 + 13) → Bool :=
  let block (s t : ℕ) (i : Fin 13) :=
    if dual = true then t.testBit (-(a * i + b)).val else s.testBit (a * i + b).val
  Fin.append (block r.1 r.2) (block r.2 r.1)

def inputVector (m : ℕ) : Fin (13 + 13) → Bool :=
  letI := lineClearDec
  fun i => decide ((∃ p ∈ pointSet m, i = Fin.castAdd 13 p) ∨
    ∃ l : Fin 13, i = Fin.natAdd 13 l ∧ lineClear m l)

def witness (code : ℕ) : (ℕ × ℕ) × Fin 13 × Fin 13 × Bool :=
  (representatives.getD (code / 78) (7, 904),
    multipliers.getD ((code / 26) % 3) 1, Fin.ofNat 13 (code / 2), code % 2 == 1)

def checked (m code : ℕ) : Prop :=
  maximal m → generic m →
    let (r, a, b, dual) := witness code
    r ∈ representatives ∧ a ∈ multipliers ∧ ∀ i, inputVector m i = transformed r a b dual i


def maskOf (xs : List (Fin 13)) : ℕ :=
  xs.foldr (fun i m => (2 ^ i.val) ||| m) 0

theorem maskOf_bound (xs : List (Fin 13)) : maskOf xs < 8192 := by
  induction xs with
  | nil => decide
  | cons i xs ih =>
    change (2 ^ i.val) ||| (maskOf xs) < 2 ^ 13
    exact Nat.or_lt_two_pow (Nat.pow_lt_pow_right (by decide) i.isLt) ih

theorem maskOf_test (xs : List (Fin 13)) (i : Fin 13) :
    (maskOf xs).testBit i.val = true ↔ i ∈ xs := by
  induction xs with
  | nil => simp [maskOf]
  | cons j xs ih =>
    change (((2 ^ j.val) ||| maskOf xs).testBit i.val = true) ↔ i ∈ j :: xs
    rw [Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq, ih, List.mem_cons]
    exact or_congr (Fin.ext_iff.symm.trans eq_comm) Iff.rfl


-- Packed incidence rows and columns, checked against the difference-set definition below.
def lineMask (l : Fin 13) : ℕ := ([
  523, 1046, 2092, 4184, 177, 354, 708, 1416, 2832, 5664, 3137, 6274, 4357
  ] : List ℕ).getD l.val 0

def pointMask (p : Fin 13) : ℕ := ([
  5137, 2083, 4166, 141, 282, 564, 1128, 2256, 4512, 833, 1666, 3332, 6664
  ] : List ℕ).getD p.val 0

theorem lineMask_bit : ∀ p l : Fin 13,
    (lineMask l).testBit p.val = @decide (incidence p l) (incidenceDec p l) := by
  decide +kernel

theorem pointMask_bit : ∀ p l : Fin 13,
    (pointMask p).testBit l.val = @decide (incidence p l) (incidenceDec p l) := by
  decide +kernel

theorem lineMask_bound : ∀ l : Fin 13, lineMask l < 8192 := by decide +kernel

theorem pointMask_bound : ∀ p : Fin 13, pointMask p < 8192 := by decide +kernel

def lineCode (m : ℕ) : ℕ :=
  maskOf ((List.finRange 13).filter fun l => (m &&& lineMask l) == 0)

theorem disjoint_iff (m n : ℕ) (hn : n < 8192) :
    (m &&& n) = 0 ↔ ∀ p : Fin 13, m.testBit p.val = true → n.testBit p.val = false := by
  constructor
  · intro h p hp
    have h0 := congrArg (fun x : ℕ => x.testBit p.val) h
    simpa only [Nat.testBit_and, Nat.zero_testBit, hp, Bool.true_and] using h0
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_and, Nat.zero_testBit]
    by_cases hi : i < 13
    · cases hbit : m.testBit i
      · simp
      · have h0 := h ⟨i, hi⟩ hbit
        simp [h0]
    · have hpow : 2 ^ 13 ≤ 2 ^ i := Nat.pow_le_pow_right (by decide) (by omega)
      simp [Nat.testBit_lt_two_pow (lt_of_lt_of_le hn hpow)]

theorem lineCode_bit (m : ℕ) (l : Fin 13) :
    (lineCode m).testBit l.val = true ↔ lineClear m l := by
  rw [lineCode, maskOf_test, List.mem_filter]
  simp only [List.mem_finRange, true_and, beq_iff_eq]
  rw [disjoint_iff m (lineMask l) (lineMask_bound l)]
  unfold lineClear
  simp only [lineMask_bit, decide_eq_false_iff_not]

def maxTest (m n : ℕ) : Bool :=
  (List.finRange 13).all fun p => m.testBit p.val || !((n &&& pointMask p) == 0)

def genericTest (m n : ℕ) : Bool :=
  !(List.finRange 13).any (fun l => (m &&& lineMask l) == m) &&
  !(List.finRange 13).any (fun p => (n &&& pointMask p) == n)

def fastCheck (m code : ℕ) : Bool :=
  let n := lineCode m
  if maxTest m n && genericTest m n then
    let (r, a, b, dual) := witness code
    decide (r ∈ representatives ∧ a ∈ multipliers) &&
    (List.finRange 26).all (fun i =>
      Fin.append (fun p : Fin 13 => m.testBit p.val) (fun l : Fin 13 => n.testBit l.val) i ==
        transformed r a b dual i)
  else true

theorem maxTest_of_maximal {m : ℕ} (h : maximal m) : maxTest m (lineCode m) = true := by
  apply List.all_eq_true.mpr
  intro p _
  cases hp : m.testBit p.val
  · obtain ⟨l, hclear, hinc⟩ := h p hp
    rw [Bool.false_or, Bool.not_eq_true_eq_eq_false, beq_eq_false_iff_ne]
    intro hz
    have h0 := (disjoint_iff (lineCode m) (pointMask p) (pointMask_bound p)).mp hz l
      ((lineCode_bit m l).mpr hclear)
    rw [pointMask_bit, @decide_eq_true (incidence p l) (incidenceDec p l) hinc] at h0
    contradiction
  · simp

theorem genericTest_of_generic {m : ℕ} (h : generic m) :
    genericTest m (lineCode m) = true := by
  simp only [genericTest, Bool.and_eq_true, Bool.not_eq_true_eq_eq_false, List.any_eq_false]
  constructor
  · intro l _ he
    apply h.1
    refine ⟨l, ?_⟩
    intro p hp
    have he' : m &&& lineMask l = m := by simpa only [beq_iff_eq] using he
    have hb := congrArg (fun z : ℕ => z.testBit p.val) he'
    rw [Nat.testBit_and, hp, Bool.true_and, lineMask_bit] at hb
    exact @of_decide_eq_true (incidence p l) (incidenceDec p l) hb
  · intro p _ he
    apply h.2
    refine ⟨p, ?_⟩
    intro l hl
    have he' : lineCode m &&& pointMask p = lineCode m := by simpa only [beq_iff_eq] using he
    have hb := congrArg (fun z : ℕ => z.testBit l.val) he'
    rw [Nat.testBit_and, (lineCode_bit m l).mpr hl, Bool.true_and, pointMask_bit] at hb
    exact @of_decide_eq_true (incidence p l) (incidenceDec p l) hb

theorem inputVector_spec (m : ℕ) (i : Fin 26) :
    inputVector m i = true ↔
      (∃ p ∈ pointSet m, i = Fin.castAdd 13 p) ∨ ∃ l : Fin 13, i = Fin.natAdd 13 l ∧ lineClear m l := by
  letI := lineClearDec
  exact ⟨of_decide_eq_true, decide_eq_true⟩

theorem inputVector_append (m : ℕ) :
    inputVector m =
      Fin.append (fun p : Fin 13 => m.testBit p.val) (fun l : Fin 13 => (lineCode m).testBit l.val) := by
  funext i
  induction i using Fin.addCases with
  | left p =>
    rw [Fin.append_left]
    apply Bool.eq_iff_iff.mpr
    simp only [inputVector_spec, pointSet, Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro (⟨r, hr, he⟩ | ⟨l, he, _⟩)
      · have hEq : p = r := Fin.ext (congrArg (fun i : Fin 26 => i.val) he)
        simpa [hEq] using hr
      · have hval := congrArg Fin.val he
        simp at hval
        omega
    · intro hp
      exact Or.inl ⟨p, hp, rfl⟩
  | right l =>
    rw [Fin.append_right]
    apply Bool.eq_iff_iff.mpr
    simp only [inputVector_spec, pointSet, Finset.mem_filter, Finset.mem_univ, true_and,
      lineCode_bit]
    constructor
    · rintro (⟨p, _, he⟩ | ⟨r, he, hr⟩)
      · have hval := congrArg Fin.val he
        simp at hval
        omega
      · have hEq : l = r := by
          apply Fin.ext
          have hval := congrArg Fin.val he
          simp at hval
          omega
        simpa [hEq] using hr
    · intro hl
      exact Or.inr ⟨l, rfl, hl⟩

theorem checked_of_fastCheck {m code : ℕ} (hc : fastCheck m code = true) : checked m code := by
  intro hmax hgen
  unfold fastCheck at hc
  dsimp only at hc
  rw [maxTest_of_maximal hmax, genericTest_of_generic hgen] at hc
  simp only [Bool.and_self, ite_true] at hc
  generalize witness code = w at hc ⊢
  rcases w with ⟨r, a, b, dual⟩
  simp only [Bool.and_eq_true] at hc
  obtain ⟨hm, hv⟩ := hc
  obtain ⟨hr, ha⟩ := of_decide_eq_true hm
  refine ⟨hr, ha, ?_⟩
  rw [inputVector_append]
  intro i
  simpa only [beq_iff_eq] using (List.all_eq_true.mp hv) i (List.mem_finRange i)

