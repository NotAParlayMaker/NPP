def transform (r : ℕ × ℕ) (a b : Fin 13) (dual : Bool) : Fin (13 + 13) → Bool :=
  let part := fun (m n : ℕ) (p : Fin 13) =>
    if dual = true then n.testBit (-(a * p + b)).val else m.testBit (a * p + b).val
  Fin.append (part r.1 r.2) (part r.2 r.1)

def actual (S : Finset (Fin 13)) (i : Fin (13 + 13)) : Bool :=
  decide ((∃ p ∈ S, i = Fin.castAdd 13 p) ∨ ∃ l, i = Fin.natAdd 13 l ∧ free S l)

