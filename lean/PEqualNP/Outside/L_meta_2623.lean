theorem checkForMask (m : ℕ) (hm : m < 8192) :
    checked m ((certificate.getD (m / 64) []).getD (m % 64) 0) := by
  apply checked_of_fastCheck
  have hb := allBlocks ⟨m / 64, by omega⟩ ⟨m % 64, by omega⟩
  have he : m / 64 * 64 + m % 64 = m := by omega
  simpa only [Fin.val_mk, he] using hb

def vectorForSet (S : Finset (Fin 13)) : Fin (13 + 13) → Bool :=
  letI := incidenceDec
  fun i => decide ((∃ p ∈ S, i = Fin.castAdd 13 p) ∨
    ∃ l : Fin 13, i = Fin.natAdd 13 l ∧ (∀ y ∈ S, ¬ incidence y l))

theorem classification (S : Finset (Fin 13)) :
    (∀ p ∉ S, ∃ l : Fin 13, (∀ y ∈ S, ¬ incidence y l) ∧ incidence p l) →
    ((¬∃ l : Fin 13, ∀ p ∈ S, incidence p l) ∧
      (¬∃ p : Fin 13, ∀ l : Fin 13, (∀ y ∈ S, ¬ incidence y l) → incidence p l)) →
    ∃ r ∈ representatives, ∃ a ∈ multipliers, ∃ (b : Fin 13) (dual : Bool),
      vectorForSet S = transformed r a b dual := by
  intro hmax hgeneric
  let m := maskOf S.toList
  have hm : m < 8192 := maskOf_bound _
  have hpoint (p : Fin 13) : m.testBit p.val = true ↔ p ∈ S := by simp [m, maskOf_test]
  have hpointSet : pointSet m = S := by
    ext p
    exact (Finset.mem_filter.trans (by simp only [Finset.mem_univ, true_and])).trans (hpoint p)
  have hline (l : Fin 13) : lineClear m l ↔ ∀ y ∈ S, ¬ incidence y l := by
    unfold lineClear
    simp only [hpoint]
  have hmaxm : maximal m := by
    intro p hp
    have hpS : p ∉ S := fun hm => by
      have hh := (hpoint p).mpr hm
