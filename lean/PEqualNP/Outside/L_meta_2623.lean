def offsets : Finset (Fin 13) := {0, 1, 3, 9}
abbrev incident (p l : Fin 13) : Prop := ∃ d ∈ offsets, p = l + d
abbrev free (S : Finset (Fin 13)) (l : Fin 13) : Prop := ∀ p ∈ S, ¬ incident p l

abbrev Closed (S : Finset (Fin 13)) : Prop :=
  ∀ p ∉ S, ∃ l, free S l ∧ incident p l

abbrev Generic (S : Finset (Fin 13)) : Prop :=
  (¬ ∃ l, ∀ p ∈ S, incident p l) ∧ ¬ ∃ p, ∀ l, free S l → incident p l

