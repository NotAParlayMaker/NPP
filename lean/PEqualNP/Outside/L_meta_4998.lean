def natMem (x : Nat) : List Nat → Bool
  | [] => false
  | y :: ys => match Nat.beq x y with | true => true | false => natMem x ys

def natErase (x : Nat) : List Nat → List Nat
  | [] => []
  | y :: ys => match Nat.beq x y with | true => ys | false => y :: natErase x ys

def natEraseOpt (x : Nat) : List Nat → Option (List Nat)
  | [] => none
  | y :: ys =>
    match Nat.beq x y with
    | true => some ys
    | false =>
      match natEraseOpt x ys with
      | none => none
      | some rest => some (y :: rest)

def natPerm : List Nat → List Nat → Bool
  | [], [] => true
  | [], _ :: _ => false
  | x :: xs, ys => match natEraseOpt x ys with | none => false | some ys' => natPerm xs ys'

def bloomBit (w : Nat) : Nat := Nat.shiftLeft 1 (Nat.mod w 127)

def nodupBLoop (seen : List Nat) (bl : Nat) : List Nat → Bool
  | [] => true
  | x :: xs =>
    let b := bloomBit x
    match Nat.beq (Nat.land bl b) 0 with
    | true => nodupBLoop (x :: seen) (Nat.lor bl b) xs
    | false =>
      match natMem x seen with
      | true => false
      | false => nodupBLoop (x :: seen) bl xs

def natNodup (ws : List Nat) : Bool := nodupBLoop [] 0 ws

