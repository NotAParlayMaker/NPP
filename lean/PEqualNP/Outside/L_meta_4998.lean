private theorem slice_props : ∀ v : Fin 9,
    slicePm v.val < 4096 ∧ sliceNm v.val < 4096 ∧ slicePm v.val ≠ 0 ∧ sliceNm v.val ≠ 0 ∧
    gOfV v.val < 12 ∧
    natAll (fun w => Nat.beq (Nat.land w (dmOf (slicePm v.val) (sliceNm v.val))) w) (sliceBase v.val) = true ∧
    ((act (gOfV v.val) (slicePm v.val) = slicePm 0 ∧
      act (gOfV v.val) (dmOf (slicePm v.val) (sliceNm v.val)) = dmOf (slicePm 0) (sliceNm 0) ∧
      natPerm (mapAct (gOfV v.val) (sliceBase v.val)) B0_raw = true) ∨
     (act (gOfV v.val) (slicePm v.val) = slicePm 4 ∧
      act (gOfV v.val) (dmOf (slicePm v.val) (sliceNm v.val)) = dmOf (slicePm 4) (sliceNm 4) ∧
      natPerm (mapAct (gOfV v.val) (sliceBase v.val)) B4_raw = true)) := by
  decide +kernel

private lemma slice_lower {v : Nat} (hv : v < 9) :
    ∀ S ⊆ (sliceBase v).toFinset, ∀ k ≤ 11, ¬ MLive (slicePm v) (sliceNm v) k S := by
  have hp := slice_props ⟨v, hv⟩
  intro S hsub k hk hlive
  rcases hp.2.2.2.2.2.2 with ⟨hp0, hd0, hperm0⟩ | ⟨hp4, hd4, hperm4⟩
  · have hact := mlive_act hp.2.2.2.2.1 hp.1 hp.2.1 hp0 hd0 hlive
    have hsub' : S.image (act (gOfV v)) ⊆ B0_raw.toFinset := by
      rw [← perm_toFinset (natPerm_sound hperm0), mapAct_toFinset]
      exact Finset.image_subset_image hsub
    exact B0_dead _ hsub' k hk hact
  · have hact := mlive_act hp.2.2.2.2.1 hp.1 hp.2.1 hp4 hd4 hlive
    have hsub' : S.image (act (gOfV v)) ⊆ B4_raw.toFinset := by
      rw [← perm_toFinset (natPerm_sound hperm4), mapAct_toFinset]
      exact Finset.image_subset_image hsub
    exact B4_dead _ hsub' k hk hact

private lemma poolCut_sound {s : Nat} {ws : List Nat} {pc : Nat}
    (hchk : checkPoolCut s ws pc = true) :
    ∀ m ≤ s, ¬ MLive 0xfff 0xfff m ws.toFinset := by
  unfold checkPoolCut at hchk
  dsimp only at hchk
  cases hndB : natNodup ws
  · rw [hndB] at hchk; cases hchk
  set v := Nat.land pc 15
  cases hvB : Nat.blt v 9
  · rw [hndB, hvB] at hchk; cases hchk
  set p := Nat.land (Nat.shiftRight pc 4) 7
  set pmv := slicePm v
  set nmv := sliceNm v
  set dmv := dmOf pmv nmv
  set c := natCountP (isConstB pmv nmv) ws
  cases hcB : Nat.blt (Nat.add s p) (Nat.add 12 c)
  · rw [hndB, hvB, hcB] at hchk; cases hchk
  rw [hndB, hvB, hcB] at hchk
  cases hbp : buildPool p (Nat.shiftRight pc 7) (sliceBase v) with
  | none => rw [hbp] at hchk; cases hchk
  | some pool =>
    rw [hbp] at hchk
    have hnd := natNodup_sound hndB
    have hv : v < 9 := natLt_of_blt hvB
    have hsp := slice_props ⟨v, hv⟩
    dsimp only at hsp
    have hbase : ∀ w ∈ sliceBase v, (w &&& dmv) = w := fun w hw =>
      (natBeq_iff _ _).mp (natAll_sound hsp.2.2.2.2.2.1 w hw)
    have hreach : Reach dmv (sliceBase v) p pool := by
      simpa using buildPool_reach p (Nat.shiftRight pc 7) 0 (sliceBase v) pool rfl hbp
    have hall := natAll_sound hchk
    intro m hm hlive
    have hinv : ∀ w ∈ ws.toFinset, isConstB pmv nmv w = true ∨ ∃ u ∈ pool, Dom pmv nmv u w := by
      intro w hw
      have h1 := hall w (List.mem_toFinset.mp hw)
      cases hc1 : isConstB pmv nmv w
      · rw [hc1] at h1
        exact Or.inr ⟨w &&& dmv, (natMem_iff _ pool).mp h1, dom_mask pmv nmv w⟩
      · exact Or.inl rfl
    obtain ⟨q, bank', hr', hpm', hle⟩ := proj_bound hsp.1 hsp.2.1 hsp.2.2.1 hsp.2.2.2.1 hbase m ws.toFinset p pool hreach hlive hinv
    have hc_eq : c = (ws.toFinset.filter (fun w => isConstB pmv nmv w = true)).card :=
      natCountP_eq (isConstB pmv nmv) hnd
    have hlt_sc : s + p < 12 + c := natLt_of_blt hcB
    dsimp only [pmv, nmv] at hc_eq
    have hq11 : q ≤ 11 := by omega
    have hproper_pm : properS dmv pmv := by
      refine ⟨?_, hsp.2.2.1, ?_⟩
      · apply Nat.eq_of_testBit_eq; intro k
        simp only [dmv, dmOf, natLor_eq, Nat.testBit_and, Nat.testBit_or]
        cases pmv.testBit k <;> simp
      · intro heq
        have hlt1 : pmv < 4096 := hsp.1
        have hge : 4096 ≤ dmv := by
          have hnm1 : 1 ≤ nmv := by omega
          have hsh : 4096 ≤ nmv <<< 12 := by rw [Nat.shiftLeft_eq]; omega
          have hle_or : nmv <<< 12 ≤ dmv := Nat.right_le_or
          omega
        omega
    obtain ⟨k', S', hk', hlive', hsub'⟩ := reach_extract hr' hbase hproper_pm hpm'
    exact slice_lower hv S' (fun w hw => List.mem_toFinset.mpr (hsub' w hw)) k' (by omega) hlive'

private lemma BF_dead : ∀ j ∈ ([1, 2, 4, 6] : List Nat),
    ∀ S ⊆ (rootBase j).toFinset, ∀ m ≤ 13, ¬ MLive 0xfff 0xfff m S := by
  have hlev := level_ind (pm := 0xfff) (nm := 0xfff) (K := 13) (nSym := 12)
    (symG := BF_symG) (stepCnt := BF_stepCnt) (totCnt := BF_totCnt) (salt := BF_salt)
    (getState := BF_getState) (getHintHdr := BF_getHintHdr) (lookupH := BF_lookupH)
