    (fun s hs1 hs2 i hi1 hi2 => poolCut_sound (BF_pcs_ok s hs1 hs2 i hi1 hi2))
  have hrun : ∀ (j : Nat), (rootBase j).length = 11 →
      span (checkRootMask 0xfff 0xfff 12 (BF_totCnt 13) (BF_salt 13)
        BF_symG (BF_getState 13) (BF_lookupH 13) (rootBase j)) 0 2048 = true →
      ∀ S ⊆ (rootBase j).toFinset, ∀ m ≤ 13, ¬ MLive 0xfff 0xfff m S := by
    intro j hlen hspan
    exact checkRootMask_sound (pm := 0xfff) (nm := 0xfff) (s := 13) (nSym := 12)
      (totS := BF_totCnt 13) (saltS := BF_salt 13) (symG := BF_symG) (getStS := BF_getState 13)
      (lookupS := BF_lookupH 13) (base := rootBase j)
      (by decide) (by decide) (by omega) (fun k hk => BF_sym_ok ⟨k, hk⟩) (hlev 13 (Nat.le_refl 13))
      (fun mask hm => span_sound hspan mask (Nat.zero_le _) (by rw [hlen] at hm; omega))
  intro j hj
  rcases List.mem_cons.mp hj with rfl | hj
  · exact hrun 1 rfl BF_roots_ok.1
  rcases List.mem_cons.mp hj with rfl | hj
  · exact hrun 2 rfl BF_roots_ok.2.1
  rcases List.mem_cons.mp hj with rfl | hj
  · exact hrun 4 rfl BF_roots_ok.2.2.1
  rw [List.mem_singleton.mp hj]
  exact hrun 6 rfl BF_roots_ok.2.2.2

