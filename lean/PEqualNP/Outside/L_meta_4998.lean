def actWithTab (tab w : Nat) : Nat :=
  let r0 := Nat.land (Nat.shiftRight tab (Nat.mul 24 (Nat.land w 15))) 0xffffff
  let r1 := Nat.land (Nat.shiftRight tab (Nat.mul 24 (Nat.add 16 (Nat.land (Nat.shiftRight w 4) 15)))) 0xffffff
  let r2 := Nat.land (Nat.shiftRight tab (Nat.mul 24 (Nat.add 32 (Nat.land (Nat.shiftRight w 8) 15)))) 0xffffff
  let r3 := Nat.land (Nat.shiftRight tab (Nat.mul 24 (Nat.add 48 (Nat.land (Nat.shiftRight w 12) 15)))) 0xffffff
  let r4 := Nat.land (Nat.shiftRight tab (Nat.mul 24 (Nat.add 64 (Nat.land (Nat.shiftRight w 16) 15)))) 0xffffff
  let r5 := Nat.land (Nat.shiftRight tab (Nat.mul 24 (Nat.add 80 (Nat.land (Nat.shiftRight w 20) 15)))) 0xffffff
  Nat.lor r0 (Nat.lor r1 (Nat.lor r2 (Nat.lor r3 (Nat.lor r4 r5))))

def act (g w : Nat) : Nat := actWithTab (actNibG g) w

def mapActLoop (tab : Nat) : List Nat → List Nat
  | [] => []
  | w :: ws => actWithTab tab w :: mapActLoop tab ws

def mapAct (g : Nat) (ws : List Nat) : List Nat := mapActLoop (actNibG g) ws

def childList (ws : List Nat) (a b z : Nat) (ka kb : Bool) : List Nat :=
  let l1 := match ka with | true => ws | false => natErase a ws
  let l2 := match kb with | true => l1 | false => natErase b l1
  z :: l2

-- Primitive Nat bridge lemmas
private lemma natAdd_eq (a b : Nat) : Nat.add a b = a + b := rfl
private lemma natSub_eq (a b : Nat) : Nat.sub a b = a - b := rfl
private lemma natMul_eq (a b : Nat) : Nat.mul a b = a * b := rfl
private lemma natMod_eq (a b : Nat) : Nat.mod a b = a % b := rfl
private lemma natLand_eq (a b : Nat) : Nat.land a b = a &&& b := rfl
private lemma natLor_eq (a b : Nat) : Nat.lor a b = a ||| b := rfl
private lemma natXor_eq (a b : Nat) : Nat.xor a b = a ^^^ b := rfl
private lemma natShr_eq (a b : Nat) : Nat.shiftRight a b = a >>> b := rfl
private lemma natShl_eq (a b : Nat) : Nat.shiftLeft a b = a <<< b := rfl
private lemma natBeq_refl (a : Nat) : Nat.beq a a = true := Nat.beq_refl a
private lemma natBeq_false {a b : Nat} (h : a ≠ b) : Nat.beq a b = false := by
  cases hb : Nat.beq a b
  · rfl
  · exact absurd (Nat.eq_of_beq_eq_true hb) h
private lemma natBeq_iff (a b : Nat) : Nat.beq a b = true ↔ a = b :=
  ⟨Nat.eq_of_beq_eq_true, fun h => h ▸ Nat.beq_refl a⟩
private lemma natLt_of_blt {a b : Nat} (h : Nat.blt a b = true) : a < b := Nat.blt_eq.mp h
private lemma binOp_false (a b : Nat) : binOp false a b = a &&& b := rfl
private lemma binOp_true (a b : Nat) : binOp true a b = a ||| b := rfl
private lemma testBit_false_of_lt_pow {x m k : Nat} (hx : x < 2 ^ m) (hk : m ≤ k) :
    x.testBit k = false :=
  Nat.testBit_lt_two_pow (Nat.lt_of_lt_of_le hx (Nat.pow_le_pow_right (by decide) hk))
private lemma perm_toFinset {l1 l2 : List Nat} (hp : l1.Perm l2) : l1.toFinset = l2.toFinset := by
  ext x; simp [hp.mem_iff]

-- Soundness of primitive list helpers
private lemma natMem_iff (x : Nat) (l : List Nat) : natMem x l = true ↔ x ∈ l := by
  induction l with
  | nil => simp [natMem]
  | cons y ys ih =>
    simp only [natMem, List.mem_cons]
    by_cases h : x = y
    · subst h; simp
    · simp [natBeq_false h, ih, h]

private lemma natErase_perm {x : Nat} {l : List Nat} (hx : x ∈ l) : (x :: natErase x l).Perm l := by
  induction l with
  | nil => cases hx
  | cons y ys ih =>
    simp only [natErase]
    by_cases h : x = y
    · subst h; simp
    · simp only [natBeq_false h]
      have hx' : x ∈ ys := (List.mem_cons.mp hx).resolve_left h
      exact (List.Perm.swap y x _).trans ((ih hx').cons y)

private lemma natErase_mem_of_ne {x y : Nat} {l : List Nat} (hne : y ≠ x) (hy : y ∈ l) :
    y ∈ natErase x l := by
  induction l with
  | nil => cases hy
  | cons a as ih =>
    simp only [natErase]
    by_cases h : x = a
    · subst h
      simp only [natBeq_refl]
      exact (List.mem_cons.mp hy).resolve_left hne
    · simp only [natBeq_false h, List.mem_cons]
      rcases List.mem_cons.mp hy with rfl | h'
      · exact Or.inl rfl
      · exact Or.inr (ih h')

private lemma natErase_notMem {x : Nat} {l : List Nat} (hnd : l.Nodup) : x ∉ natErase x l := by
  induction l with
  | nil => simp [natErase]
  | cons a as ih =>
    rw [List.nodup_cons] at hnd
    simp only [natErase]
    by_cases h : x = a
    · subst h; simp [hnd.1]
    · simp only [natBeq_false h, List.mem_cons, not_or]
      exact ⟨h, ih hnd.2⟩

private lemma natErase_sub {x : Nat} {l : List Nat} {y : Nat} (hy : y ∈ natErase x l) : y ∈ l := by
  induction l with
  | nil => simp [natErase] at hy
  | cons a as ih =>
    simp only [natErase] at hy
    by_cases h : x = a
    · subst h; simp only [natBeq_refl] at hy; exact List.mem_cons_of_mem _ hy
    · simp only [natBeq_false h, List.mem_cons] at hy
      rcases hy with rfl | hy'
      · exact List.mem_cons_self
      · exact List.mem_cons_of_mem _ (ih hy')

private lemma natErase_nodup {x : Nat} {l : List Nat} (hnd : l.Nodup) : (natErase x l).Nodup := by
  induction l with
  | nil => simp [natErase]
  | cons a as ih =>
    rw [List.nodup_cons] at hnd
    simp only [natErase]
    by_cases h : x = a
    · subst h; simp [hnd.2]
    · simp only [natBeq_false h, List.nodup_cons]
      exact ⟨fun hm => hnd.1 (natErase_sub hm), ih hnd.2⟩

private lemma natErase_toFinset {x : Nat} {l : List Nat} (hnd : l.Nodup) :
    (natErase x l).toFinset = l.toFinset.erase x := by
  ext y
  simp only [List.mem_toFinset, Finset.mem_erase]
  constructor
  · intro hy
    refine ⟨?_, natErase_sub hy⟩
    rintro rfl
    exact natErase_notMem hnd hy
  · rintro ⟨hne, hy⟩
    exact natErase_mem_of_ne hne hy

private lemma natEraseOpt_perm {x : Nat} {l l' : List Nat} (h : natEraseOpt x l = some l') :
    (x :: l').Perm l := by
  induction l generalizing l' with
  | nil => simp [natEraseOpt] at h
  | cons y ys ih =>
    simp only [natEraseOpt] at h
    cases hxy : Nat.beq x y
    · rw [hxy] at h
      cases ho : natEraseOpt x ys with
      | none => rw [ho] at h; cases h
      | some rest =>
        rw [ho] at h; cases h
        exact (List.Perm.swap y x rest).trans ((ih ho).cons y)
    · rw [hxy] at h; cases h
      rw [Nat.eq_of_beq_eq_true hxy]

private lemma natPerm_sound {l1 l2 : List Nat} (h : natPerm l1 l2 = true) : l1.Perm l2 := by
  induction l1 generalizing l2 with
  | nil =>
    cases l2 with
    | nil => exact List.Perm.nil
    | cons _ _ => simp [natPerm] at h
  | cons x xs ih =>
    simp only [natPerm] at h
    cases ho : natEraseOpt x l2 with
    | none => rw [ho] at h; cases h
    | some l2' =>
      rw [ho] at h
      exact ((ih h).cons x).trans (natEraseOpt_perm ho)

private lemma bloomBit_testBit (w : Nat) : (bloomBit w).testBit (w % 127) = true := by
  unfold bloomBit
  rw [natShl_eq, natMod_eq, Nat.testBit_shiftLeft]
  simp

private lemma testBit_of_land_bloom_ne_zero {bl x : Nat}
    (h : Nat.beq (Nat.land bl (bloomBit x)) 0 = false) : bl.testBit (x % 127) = true := by
  cases htb : bl.testBit (x % 127)
  · exfalso
    have h0 : Nat.land bl (bloomBit x) = 0 := by
      rw [natLand_eq]
      apply Nat.eq_of_testBit_eq; intro k
      rw [Nat.testBit_and, Nat.zero_testBit]
      by_cases hk : k = x % 127
      · subst hk; simp [htb]
      · unfold bloomBit
        rw [natShl_eq, natMod_eq, Nat.testBit_shiftLeft]
        by_cases hle : x % 127 ≤ k
        · have h1 := testBit_false_of_lt_pow (x := 1) (m := 1) (by decide) (by omega : 1 ≤ k - x % 127)
          simp [hle, h1]
        · simp [hle]
    rw [h0] at h; cases h
  · rfl

private lemma nodupBLoop_sound (l seen : List Nat) (bl : Nat)
    (hbl : ∀ y ∈ seen, bl.testBit (y % 127) = true)
    (h : nodupBLoop seen bl l = true) :
    (∀ y ∈ seen, y ∉ l) ∧ l.Nodup := by
  induction l generalizing seen bl with
  | nil => exact ⟨fun _ _ hm => False.elim (List.not_mem_nil hm), List.nodup_nil⟩
  | cons x xs ih =>
    simp only [nodupBLoop] at h
    cases hland : Nat.beq (Nat.land bl (bloomBit x)) 0
    · rw [hland] at h
      cases hmem : natMem x seen
      · rw [hmem] at h
        have hxnot : x ∉ seen := fun hm => by rw [(natMem_iff x seen).mpr hm] at hmem; cases hmem
        have hbl' : ∀ y ∈ x :: seen, bl.testBit (y % 127) = true := by
          intro y hy
          rcases List.mem_cons.mp hy with rfl | hy'
          · exact testBit_of_land_bloom_ne_zero hland
          · exact hbl y hy'
        obtain ⟨hdisj, hnd⟩ := ih (x :: seen) bl hbl' h
        refine ⟨fun y hy hm => ?_, List.nodup_cons.mpr ⟨hdisj x List.mem_cons_self, hnd⟩⟩
        rcases List.mem_cons.mp hm with rfl | hm'
        · exact hxnot hy
        · exact hdisj y (List.mem_cons_of_mem _ hy) hm'
      · rw [hmem] at h; cases h
    · rw [hland] at h
      have hxnot : x ∉ seen := by
        intro hx
        have h0 : (bl &&& bloomBit x) = 0 := (natBeq_iff _ _).mp hland
        have ht := congrArg (fun v => v.testBit (x % 127)) h0
        rw [Nat.testBit_and, Nat.zero_testBit, hbl x hx, bloomBit_testBit x] at ht
        cases ht
      have hbl' : ∀ y ∈ x :: seen, (Nat.lor bl (bloomBit x)).testBit (y % 127) = true := by
        intro y hy
        rw [natLor_eq, Nat.testBit_or]
        rcases List.mem_cons.mp hy with rfl | hy'
        · rw [bloomBit_testBit y, Bool.or_true]
        · rw [hbl y hy', Bool.true_or]
      obtain ⟨hdisj, hnd⟩ := ih (x :: seen) (Nat.lor bl (bloomBit x)) hbl' h
      refine ⟨fun y hy hm => ?_, List.nodup_cons.mpr ⟨hdisj x List.mem_cons_self, hnd⟩⟩
      rcases List.mem_cons.mp hm with rfl | hm'
      · exact hxnot hy
      · exact hdisj y (List.mem_cons_of_mem _ hy) hm'

private lemma natNodup_sound {l : List Nat} (h : natNodup l = true) : l.Nodup :=
  (nodupBLoop_sound l [] 0 (by intro _ hm; cases hm) h).2

private lemma natAll_sound {p : Nat → Bool} {l : List Nat} (h : natAll p l = true) :
    ∀ x ∈ l, p x = true := by
  induction l with
  | nil => intro x hx; cases hx
  | cons a as ih =>
    simp only [natAll] at h
    cases hp : p a
    · rw [hp] at h; cases h
    · rw [hp] at h
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hx'
      · exact hp
      · exact ih h x hx'

private lemma natCountPLoop_add (p : Nat → Bool) (l : List Nat) (acc : Nat) :
    natCountPLoop p l acc = acc + natCountPLoop p l 0 := by
  induction l generalizing acc with
  | nil => simp [natCountPLoop]
  | cons x xs ih =>
    simp only [natCountPLoop, natAdd_eq]
    cases p x
    · exact ih acc
    · rw [ih (acc + 1), ih 1]; omega

private lemma natCountP_eq (p : Nat → Bool) {l : List Nat} (hnd : l.Nodup) :
    natCountP p l = (l.toFinset.filter (fun w => p w = true)).card := by
  unfold natCountP
  induction l with
  | nil => simp [natCountPLoop]
  | cons x xs ih =>
    rw [List.nodup_cons] at hnd
    simp only [natCountPLoop, List.toFinset_cons, natAdd_eq]
    have hnot : x ∉ xs.toFinset := by simpa using hnd.1
    cases hp : p x
    · rw [ih hnd.2, Finset.filter_insert]
      simp [hp]
    · rw [natCountPLoop_add, ih hnd.2, Finset.filter_insert]
      simp only [hp, ↓reduceIte]
      rw [Finset.card_insert_of_notMem (by simp [hnot])]
      omega

private lemma span_sound {f : Nat → Bool} {lo n : Nat} (h : span f lo n = true) :
    ∀ i, lo ≤ i → i < lo + n → f i = true := by
  induction n generalizing lo with
  | zero => intro i h1 h2; omega
  | succ n ih =>
    simp only [span, natAdd_eq] at h
    cases hf : f lo
    · rw [hf] at h; cases h
    · rw [hf] at h
      intro i h1 h2
      by_cases heq : i = lo
      · subst heq; exact hf
      · exact ih h i (by omega) (by omega)

-- MLive definition (recursive def, no custom inductive!)
def properS (dm w : Nat) : Prop := (w &&& dm) = w ∧ w ≠ 0 ∧ w ≠ dm

def MLive (pm nm : Nat) : Nat → Finset Nat → Prop
  | 0, S => S = {pm} ∧ properS (dmOf pm nm) pm
  | k + 1, S =>
    ∃ (U : Finset Nat) (a b : Nat) (op : Bool),
      S = insert a (insert b U) ∧
      properS (dmOf pm nm) a ∧ properS (dmOf pm nm) b ∧ a ≠ b ∧
      properS (dmOf pm nm) (binOp op a b) ∧
      binOp op a b ∉ insert a (insert b U) ∧
      MLive pm nm k (insert (binOp op a b) U)

private lemma binOp_comm (op : Bool) (a b : Nat) : binOp op a b = binOp op b a := by
  cases op
  · exact Nat.and_comm a b
  · exact Nat.or_comm a b

private lemma mlive_proper {pm nm k S} (h : MLive pm nm k S) : ∀ w ∈ S, properS (dmOf pm nm) w := by
  induction k generalizing S with
  | zero =>
    obtain ⟨rfl, hp⟩ := h
    intro w hw
    simp only [Finset.mem_singleton] at hw
    exact hw ▸ hp
  | succ k ih =>
    obtain ⟨U, a, b, op, rfl, ha, hb, _, _, _, tail⟩ := h
    intro w hw
    rcases Finset.mem_insert.mp hw with rfl | hw
    · exact ha
    rcases Finset.mem_insert.mp hw with rfl | hw
    · exact hb
    · exact ih tail w (Finset.mem_insert_of_mem hw)

private lemma mlive_card {pm nm k S} (h : MLive pm nm k S) : S.card ≤ k + 1 := by
  induction k generalizing S with
  | zero =>
    obtain ⟨rfl, _⟩ := h
    simp
  | succ k ih =>
    obtain ⟨U, a, b, op, rfl, _, _, _, _, hfresh, tail⟩ := h
    have hnotU : binOp op a b ∉ U := fun hm =>
      hfresh (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hm))
    have hc := ih tail
    rw [Finset.card_insert_of_notMem hnotU] at hc
    have h1 := Finset.card_insert_le a (insert b U)
    have h2 := Finset.card_insert_le b U
    omega

-- 144-bit Separation Coverage
private lemma or_shiftLeft_eq_add {a b k : Nat} (ha : a < 2 ^ k) :
    (a ||| (b <<< k)) = a + b * 2 ^ k := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_or, Nat.testBit_shiftLeft]
  by_cases hi : i < k
  · have hpow : 2 ^ k = 2 ^ i * (2 * 2 ^ (k - i - 1)) := by
      rw [← Nat.pow_succ', ← Nat.pow_add]; congr 1; omega
    have hdiv : (a + b * 2 ^ k) / 2 ^ i = a / 2 ^ i + 2 * (b * 2 ^ (k - i - 1)) := by
      have hmul : b * 2 ^ k = 2 ^ i * (2 * (b * 2 ^ (k - i - 1))) := by
        rw [hpow]; ac_rfl
      rw [hmul]
      exact Nat.add_mul_div_left a _ (Nat.two_pow_pos i)
    have hmod : ∀ u v : Nat, (1 &&& (u + 2 * v)) = (1 &&& u) := fun u v => by
      rw [Nat.and_comm 1, Nat.and_comm 1 u, show (1 : Nat) = 2 ^ 1 - 1 by rfl,
        Nat.and_two_pow_sub_one_eq_mod, Nat.and_two_pow_sub_one_eq_mod]
      exact Nat.add_mul_mod_self_left u 2 v
    have htb : (a + b * 2 ^ k).testBit i = a.testBit i := by
      rw [Nat.testBit, Nat.testBit, Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow,
        hdiv, hmod]
    rw [htb]
    simp [Nat.not_le.mpr hi]
  · have hpow : 2 ^ i = 2 ^ k * 2 ^ (i - k) := by rw [← Nat.pow_add]; congr 1; omega
    have hdiv : (a + b * 2 ^ k) / 2 ^ i = b / 2 ^ (i - k) := by
      rw [hpow, ← Nat.div_div_eq_div_mul, Nat.add_mul_div_right a b (Nat.two_pow_pos k),
        Nat.div_eq_of_lt ha, Nat.zero_add]
    have htb : (a + b * 2 ^ k).testBit i = b.testBit (i - k) := by
      rw [Nat.testBit, Nat.testBit, Nat.shiftRight_eq_div_pow, Nat.shiftRight_eq_div_pow, hdiv]
    have ha0 : a.testBit i = false := testBit_false_of_lt_pow ha (by omega)
    rw [htb, ha0]
    simp [(by omega : k ≤ i)]

private lemma spr4_mul_lt (d q : Nat) (hd : d < 16) (hq : q < 4096) :
    spr4 d * q < 2 ^ 48 := by
  have hle : spr4 d ≤ 0x1001001001 := by
    interval_cases d <;> decide
  have h1 : spr4 d * q ≤ 0x1001001001 * 4095 := Nat.mul_le_mul hle (by omega)
  omega

private theorem spr4_spec : ∀ d : Fin 16,
    spr4 d.val = (if d.val.testBit 0 then 1 else 0) +
      (if d.val.testBit 1 then 1 else 0) * 2 ^ 12 +
      (if d.val.testBit 2 then 1 else 0) * 2 ^ 24 +
      (if d.val.testBit 3 then 1 else 0) * 2 ^ 36 := by decide

private lemma spr4_block (d k q : Nat) (hd : d < 16) (hk : k < 4) (hq : q < 4096) :
    (spr4 d * q) / 2 ^ (12 * k) % 4096 = if d.testBit k then q else 0 := by
  have hs := spr4_spec ⟨d, hd⟩
  dsimp only at hs
  rw [hs]
  set b0 := if d.testBit 0 then q else 0
  set b1 := if d.testBit 1 then q else 0
  set b2 := if d.testBit 2 then q else 0
  set b3 := if d.testBit 3 then q else 0
  have hmul : ∀ (c : Bool) (m : Nat), (if c then 1 else 0) * m * q = (if c then q else 0) * m := by
    intro c m; cases c <;> simp [Nat.mul_comm]
  have hmul0 : (if d.testBit 0 then 1 else 0) * q = b0 := by
    dsimp [b0]; cases d.testBit 0 <;> simp
  have heq : ((if d.testBit 0 then 1 else 0) + (if d.testBit 1 then 1 else 0) * 2 ^ 12 +
      (if d.testBit 2 then 1 else 0) * 2 ^ 24 + (if d.testBit 3 then 1 else 0) * 2 ^ 36) * q =
      b0 + b1 * 2 ^ 12 + b2 * 2 ^ 24 + b3 * 2 ^ 36 := by
    simp only [Nat.add_mul, hmul0, hmul]; rfl
  have hb0 : b0 < 4096 := by dsimp [b0]; split <;> omega
  have hb1 : b1 < 4096 := by dsimp [b1]; split <;> omega
  have hb2 : b2 < 4096 := by dsimp [b2]; split <;> omega
  have hb3 : b3 < 4096 := by dsimp [b3]; split <;> omega
  rw [heq]
  interval_cases k <;> omega

private lemma spread_eq_sum (p : Nat) :
    spread p = spr4 (p % 16) + spr4 (p / 16 % 16) * 2 ^ 48 + spr4 (p / 256 % 16) * 2 ^ 96 := by
  unfold spread
  simp only [natLand_eq, natLor_eq, natShr_eq, natShl_eq]
  have hp0 : p &&& 15 = p % 16 := by
    rw [show (15 : Nat) = 2 ^ 4 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]
  have hp1 : (p >>> 4) &&& 15 = p / 16 % 16 := by
    rw [Nat.shiftRight_eq_div_pow, show (15 : Nat) = 2 ^ 4 - 1 by rfl,
      Nat.and_two_pow_sub_one_eq_mod]
  have hp2 : (p >>> 8) &&& 15 = p / 256 % 16 := by
    rw [Nat.shiftRight_eq_div_pow, show (15 : Nat) = 2 ^ 4 - 1 by rfl,
      Nat.and_two_pow_sub_one_eq_mod]
  rw [hp0, hp1, hp2]
  have hs0 : spr4 (p % 16) < 2 ^ 48 := by
    have := spr4_mul_lt (p % 16) 1 (Nat.mod_lt _ (by omega)) (by omega); omega
  have hs1 : spr4 (p / 16 % 16) < 2 ^ 48 := by
    have := spr4_mul_lt (p / 16 % 16) 1 (Nat.mod_lt _ (by omega)) (by omega); omega
  have hinner : (spr4 (p / 16 % 16) <<< 48) ||| (spr4 (p / 256 % 16) <<< 96) =
      (spr4 (p / 16 % 16) + spr4 (p / 256 % 16) * 2 ^ 48) <<< 48 := by
    rw [← or_shiftLeft_eq_add hs1]
    apply Nat.eq_of_testBit_eq
    intro m
    simp only [Nat.testBit_or, Nat.testBit_shiftLeft]
    by_cases h48 : 48 ≤ m
    · simp only [h48, decide_true, Bool.true_and]
      by_cases h96 : 96 ≤ m
      · have hm48 : 48 ≤ m - 48 := by omega
        have hsub : m - 48 - 48 = m - 96 := by omega
        simp [h96, hm48, hsub]
      · have hm48 : ¬(48 ≤ m - 48) := by omega
        simp [h96, hm48]
    · have h96 : ¬(96 ≤ m) := by omega
      simp [h48, h96]
  rw [hinner, or_shiftLeft_eq_add hs0, Nat.add_mul, Nat.mul_assoc,
    show (2 ^ 48 : Nat) * 2 ^ 48 = 2 ^ 96 by rw [← Nat.pow_add], Nat.add_assoc]

private lemma spread_mul_lt (p q : Nat) (hq : q < 4096) : spread p * q < 2 ^ 144 := by
  rw [spread_eq_sum]
  have h0 := spr4_mul_lt (p % 16) q (Nat.mod_lt _ (by omega)) hq
  have h1 := spr4_mul_lt (p / 16 % 16) q (Nat.mod_lt _ (by omega)) hq
  have h2 := spr4_mul_lt (p / 256 % 16) q (Nat.mod_lt _ (by omega)) hq
  have heq : (spr4 (p % 16) + spr4 (p / 16 % 16) * 2 ^ 48 + spr4 (p / 256 % 16) * 2 ^ 96) * q =
      spr4 (p % 16) * q + spr4 (p / 16 % 16) * q * 2 ^ 48 + spr4 (p / 256 % 16) * q * 2 ^ 96 := by
    simp only [Nat.add_mul, Nat.mul_right_comm]
  rw [heq]
  omega

private lemma spread_mul_testBit (p q i j : Nat) (hq : q < 4096) (hi : i < 12) (hj : j < 12) :
    (spread p * q).testBit (12 * i + j) = (p.testBit i && q.testBit j) := by
  have hblock : (spread p * q) / 2 ^ (12 * i) % 4096 = if p.testBit i then q else 0 := by
    rw [spread_eq_sum]
    have h0 := spr4_mul_lt (p % 16) q (Nat.mod_lt _ (by omega)) hq
    have h1 := spr4_mul_lt (p / 16 % 16) q (Nat.mod_lt _ (by omega)) hq
    have h2 := spr4_mul_lt (p / 256 % 16) q (Nat.mod_lt _ (by omega)) hq
    have heq : (spr4 (p % 16) + spr4 (p / 16 % 16) * 2 ^ 48 + spr4 (p / 256 % 16) * 2 ^ 96) * q =
        spr4 (p % 16) * q + spr4 (p / 16 % 16) * q * 2 ^ 48 + spr4 (p / 256 % 16) * q * 2 ^ 96 := by
      simp only [Nat.add_mul, Nat.mul_right_comm]
    rw [heq]
    by_cases hi4 : i < 4
    · have hb := spr4_block (p % 16) i q (Nat.mod_lt _ (by omega)) hi4 hq
      have htb : (p % 16).testBit i = p.testBit i := by
        rw [show (16 : Nat) = 2 ^ 4 by rfl, Nat.testBit_mod_two_pow]; simp [hi4]
      rw [htb] at hb
      have hpow : 2 ^ 48 = 2 ^ (12 * i) * (4096 * 2 ^ (36 - 12 * i)) := by
        rw [show (4096 : Nat) = 2 ^ 12 by rfl, ← Nat.pow_add, ← Nat.pow_add]
        congr 1; omega
      have hpow96 : 2 ^ 96 = 2 ^ (12 * i) * (4096 * 2 ^ (84 - 12 * i)) := by
        rw [show (4096 : Nat) = 2 ^ 12 by rfl, ← Nat.pow_add, ← Nat.pow_add]
        congr 1; omega
      have hrew : spr4 (p % 16) * q + spr4 (p / 16 % 16) * q * 2 ^ 48 + spr4 (p / 256 % 16) * q * 2 ^ 96 =
          spr4 (p % 16) * q + 2 ^ (12 * i) * (4096 * (spr4 (p / 16 % 16) * q * 2 ^ (36 - 12 * i) + spr4 (p / 256 % 16) * q * 2 ^ (84 - 12 * i))) := by
        rw [Nat.add_assoc, hpow, hpow96, Nat.mul_add, Nat.mul_add]
        congr 1; congr 1 <;> ac_rfl
      rw [hrew, Nat.add_mul_div_left _ _ (Nat.two_pow_pos _), Nat.add_mul_mod_self_left, hb]
    · by_cases hi8 : i < 8
      · have hb := spr4_block (p / 16 % 16) (i - 4) q (Nat.mod_lt _ (by omega)) (by omega) hq
        have htb : (p / 16 % 16).testBit (i - 4) = p.testBit i := by
          rw [show (16 : Nat) = 2 ^ 4 by rfl, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]
          have hlt4 : i - 4 < 4 := by omega
          have heq4 : i - 4 + 4 = i := by omega
          simp [hlt4, heq4]
        rw [htb] at hb
        have h12 : 12 * i = 48 + 12 * (i - 4) := by omega
        have hdiv0 : (spr4 (p % 16) * q + spr4 (p / 16 % 16) * q * 2 ^ 48 + spr4 (p / 256 % 16) * q * 2 ^ 96) / 2 ^ (12 * i) =
            (spr4 (p / 16 % 16) * q + spr4 (p / 256 % 16) * q * 2 ^ 48) / 2 ^ (12 * (i - 4)) := by
          rw [h12, Nat.pow_add, ← Nat.div_div_eq_div_mul]
          have hgrp : spr4 (p % 16) * q + spr4 (p / 16 % 16) * q * 2 ^ 48 + spr4 (p / 256 % 16) * q * 2 ^ 96 =
              spr4 (p % 16) * q + (spr4 (p / 16 % 16) * q + spr4 (p / 256 % 16) * q * 2 ^ 48) * 2 ^ 48 := by
            rw [Nat.add_mul, Nat.add_assoc, show (2 ^ 96 : Nat) = 2 ^ 48 * 2 ^ 48 by rw [← Nat.pow_add], ← Nat.mul_assoc]
          rw [hgrp, Nat.add_mul_div_right _ _ (Nat.two_pow_pos 48), Nat.div_eq_of_lt h0, Nat.zero_add]
        rw [hdiv0]
        have hpow : 2 ^ 48 = 2 ^ (12 * (i - 4)) * (4096 * 2 ^ (36 - 12 * (i - 4))) := by
          rw [show (4096 : Nat) = 2 ^ 12 by rfl, ← Nat.pow_add, ← Nat.pow_add]
          congr 1; omega
        have hrew : spr4 (p / 16 % 16) * q + spr4 (p / 256 % 16) * q * 2 ^ 48 =
            spr4 (p / 16 % 16) * q + 2 ^ (12 * (i - 4)) * (4096 * (spr4 (p / 256 % 16) * q * 2 ^ (36 - 12 * (i - 4)))) := by
          rw [hpow]; congr 1; ac_rfl
        rw [hrew, Nat.add_mul_div_left _ _ (Nat.two_pow_pos _), Nat.add_mul_mod_self_left, hb]
      · have hb := spr4_block (p / 256 % 16) (i - 8) q (Nat.mod_lt _ (by omega)) (by omega) hq
        have htb : (p / 256 % 16).testBit (i - 8) = p.testBit i := by
          rw [show (16 : Nat) = 2 ^ 4 by rfl, show (256 : Nat) = 2 ^ 8 by rfl,
            Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]
          have hlt4 : i - 8 < 4 := by omega
          have heq8 : i - 8 + 8 = i := by omega
          simp [hlt4, heq8]
        rw [htb] at hb
        have h12 : 12 * i = 96 + 12 * (i - 8) := by omega
        have hlt96 : spr4 (p % 16) * q + spr4 (p / 16 % 16) * q * 2 ^ 48 < 2 ^ 96 := by omega
        rw [h12, Nat.pow_add, ← Nat.div_div_eq_div_mul,
          Nat.add_mul_div_right _ _ (Nat.two_pow_pos 96), Nat.div_eq_of_lt hlt96, Nat.zero_add, hb]
  have htb : ((spread p * q) / 2 ^ (12 * i) % 4096).testBit j = (spread p * q).testBit (12 * i + j) := by
    rw [show (4096 : Nat) = 2 ^ 12 by rfl, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow, Nat.add_comm j (12 * i)]
    simp [hj]
  rw [← htb, hblock]
  cases p.testBit i <;> simp

private lemma sep_testBit (w i j : Nat) (hi : i < 12) (hj : j < 12) :
    (sep w).testBit (12 * i + j) = (w.testBit i && !(w.testBit (12 + j))) := by
  unfold sep
  simp only [natMul_eq, natLand_eq, natXor_eq, natShr_eq]
  have hq : ((w >>> 12) ^^^ 0xfff) &&& 0xfff < 4096 := by
    rw [show (0xfff : Nat) = 2 ^ 12 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]
    exact Nat.mod_lt _ (by omega)
  rw [spread_mul_testBit _ _ i j hq hi hj]
  have hp : (w &&& 0xfff).testBit i = w.testBit i := by
    rw [Nat.testBit_and]
    have : (0xfff : Nat).testBit i = true := by interval_cases i <;> decide
    simp [this]
  have hn : (((w >>> 12) ^^^ 0xfff) &&& 0xfff).testBit j = !(w.testBit (12 + j)) := by
    rw [Nat.testBit_and, Nat.testBit_xor, Nat.testBit_shiftRight]
    have : (0xfff : Nat).testBit j = true := by interval_cases j <;> decide
    simp [this]
  rw [hp, hn]

private lemma unionSep_testBit (ws : List Nat) (m : Nat) :
    (unionSep ws).testBit m = true ↔ ∃ w ∈ ws, (sep w).testBit m = true := by
  induction ws with
  | nil => simp [unionSep]
  | cons a as ih =>
    simp only [unionSep, natLor_eq, Nat.testBit_or, Bool.or_eq_true, ih, List.mem_cons]
    constructor
    · rintro (h | ⟨w, hw, hm⟩)
      · exact ⟨a, Or.inl rfl, h⟩
      · exact ⟨w, Or.inr hw, hm⟩
    · rintro ⟨w, rfl | hw, hm⟩
      · exact Or.inl hm
      · exact Or.inr ⟨w, hw, hm⟩

private lemma mlive_cov_pair {pm nm k S} (h : MLive pm nm k S) (hpm : pm < 4096) :
    ∀ i < 12, ∀ j < 12, pm.testBit i = true → nm.testBit j = true →
      ∃ w ∈ S, w.testBit i = true ∧ w.testBit (12 + j) = false := by
  induction k generalizing S with
  | zero =>
    obtain ⟨rfl, _⟩ := h
    intro i _ j _ hpi _
    exact ⟨pm, Finset.mem_singleton_self pm, hpi, testBit_false_of_lt_pow (m := 12) (by omega) (by omega)⟩
  | succ k ih =>
    obtain ⟨U, a, b, op, rfl, _, _, _, _, _, tail⟩ := h
    intro i hi j hj hpi hnj
    obtain ⟨w, hw, hwi, hwj⟩ := ih tail i hi j hj hpi hnj
    rcases Finset.mem_insert.mp hw with rfl | hwU
    · cases op
      · rw [binOp_false, Nat.testBit_and, Bool.and_eq_true] at hwi
        rw [binOp_false, Nat.testBit_and, Bool.and_eq_false_iff] at hwj
        rcases hwj with ha | hb
        · exact ⟨a, Finset.mem_insert_self _ _, hwi.1, ha⟩
        · exact ⟨b, Finset.mem_insert_of_mem (Finset.mem_insert_self _ _), hwi.2, hb⟩
      · rw [binOp_true, Nat.testBit_or, Bool.or_eq_true] at hwi
        rw [binOp_true, Nat.testBit_or, Bool.or_eq_false_iff] at hwj
        rcases hwi with ha | hb
        · exact ⟨a, Finset.mem_insert_self _ _, ha, hwj.1⟩
        · exact ⟨b, Finset.mem_insert_of_mem (Finset.mem_insert_self _ _), hb, hwj.2⟩
    · exact ⟨w, Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hwU), hwi, hwj⟩

private lemma mlive_cov {pm nm k} {ws : List Nat} (h : MLive pm nm k ws.toFinset)
    (hpm : pm < 4096) (hnm : nm < 4096) :
    Nat.land (unionSep ws) (reqCov pm nm) = reqCov pm nm := by
  rw [natLand_eq]
  apply Nat.eq_of_testBit_eq
  intro m
  rw [Nat.testBit_and]
  cases hr : (reqCov pm nm).testBit m
  · simp
  · simp only [Bool.and_true]
    have hlt : reqCov pm nm < 2 ^ 144 := spread_mul_lt pm nm hnm
    have hm144 : m < 144 := by
      by_contra hge
      have h0 := testBit_false_of_lt_pow hlt (by omega : 144 ≤ m)
      rw [h0] at hr; cases hr
    have hm_eq : m = 12 * (m / 12) + m % 12 := by omega
    rw [hm_eq] at hr ⊢
    unfold reqCov at hr
    rw [natMul_eq, spread_mul_testBit pm nm (m / 12) (m % 12) hnm (by omega) (by omega), Bool.and_eq_true] at hr
    obtain ⟨w, hw, hwi, hwj⟩ := mlive_cov_pair h hpm (m / 12) (by omega) (m % 12) (by omega) hr.1 hr.2
    rw [unionSep_testBit]
    exact ⟨w, List.mem_toFinset.mp hw, by rw [sep_testBit w (m / 12) (m % 12) (by omega) (by omega), hwi, hwj]; rfl⟩

-- VF Potential Function
def vf6 (ba bb bc bd be bf : Bool) : Nat :=
  let x := (if bb then 1 else 0) + (if bc then 1 else 0)
  let y := (if be then 0 else 1) + (if bf then 0 else 1)
  if ba then
    if bd then y
    else if x == 0 then y
    else if y == 0 then x
    else x + y - 1
  else
    if bd then 0 else x

private theorem vf6_and : ∀ a1 b1 c1 d1 e1 f1 a2 b2 c2 d2 e2 f2 : Bool,
    vf6 (a1 && a2) (b1 && b2) (c1 && c2) (d1 && d2) (e1 && e2) (f1 && f2) ≤
    vf6 a1 b1 c1 d1 e1 f1 + vf6 a2 b2 c2 d2 e2 f2 := by decide +kernel

private theorem vf6_or : ∀ a1 b1 c1 d1 e1 f1 a2 b2 c2 d2 e2 f2 : Bool,
    vf6 (a1 || a2) (b1 || b2) (c1 || c2) (d1 || d2) (e1 || e2) (f1 || f2) ≤
    vf6 a1 b1 c1 d1 e1 f1 + vf6 a2 b2 c2 d2 e2 f2 := by decide +kernel

private lemma bitN_eq (w k : Nat) : bitN w k = if w.testBit k then 1 else 0 := by
  unfold bitN
  rw [natLand_eq, natShr_eq, Nat.testBit, Nat.and_comm 1]
  have hlt : (w >>> k) &&& 1 < 2 := by
    rw [show (1 : Nat) = 2 ^ 1 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]
    exact Nat.mod_lt _ (by omega)
  cases h : (w >>> k) &&& 1 with
  | zero => simp
  | succ n =>
    have hn : n = 0 := by omega
    subst hn; simp

private lemma yz_eq_vf6 (a b c d12 e12 f12 w : Nat) :
    yz a b c d12 e12 f12 w =
    vf6 (w.testBit a) (w.testBit b) (w.testBit c) (w.testBit d12) (w.testBit e12) (w.testBit f12) := by
  unfold yz vf6
  rw [bitN_eq, bitN_eq, bitN_eq, bitN_eq, bitN_eq, bitN_eq]
  cases w.testBit a <;> cases w.testBit b <;> cases w.testBit c <;>
    cases w.testBit d12 <;> cases w.testBit e12 <;> cases w.testBit f12 <;> rfl

private lemma yz_binOp (a b c d12 e12 f12 : Nat) (op : Bool) (u v : Nat) :
    yz a b c d12 e12 f12 (binOp op u v) ≤
    yz a b c d12 e12 f12 u + yz a b c d12 e12 f12 v := by
  rw [yz_eq_vf6, yz_eq_vf6, yz_eq_vf6]
  cases op
  · simp only [binOp_false, Nat.testBit_and]; exact vf6_and ..
  · simp only [binOp_true, Nat.testBit_or]; exact vf6_or ..

private lemma mlive_tight_sum {pm nm k S} (a b c d12 e12 f12 : Nat)
    (h : MLive pm nm k S) (hcard : S.card = k + 1) (hpm : pm < 4096)
    (ha : pm.testBit a = true) (hb : pm.testBit b = true) (hc : pm.testBit c = true)
    (hd : 12 ≤ d12) (he : 12 ≤ e12) (hf : 12 ≤ f12) :
    3 ≤ S.sum (yz a b c d12 e12 f12) := by
  induction k generalizing S with
  | zero =>
    obtain ⟨rfl, _⟩ := h
    rw [Finset.sum_singleton, yz_eq_vf6, ha, hb, hc,
      testBit_false_of_lt_pow (m := 12) (by omega) hd,
      testBit_false_of_lt_pow (m := 12) (by omega) he,
      testBit_false_of_lt_pow (m := 12) (by omega) hf]
    decide
  | succ k ih =>
    obtain ⟨U, u, v, op, rfl, _, _, huv, _, hfresh, tail⟩ := h
    have hzU : binOp op u v ∉ U := fun hm =>
      hfresh (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hm))
    have hctail := mlive_card tail
    rw [Finset.card_insert_of_notMem hzU] at hctail
    have huU : u ∉ U := by
      intro hmem
      have : insert u (insert v U) = insert v U := by
        rw [Finset.insert_comm, Finset.insert_eq_of_mem hmem]
      rw [this] at hcard
      have := Finset.card_insert_le v U
      omega
    have hvU : v ∉ U := by
      intro hmem
      have : insert v U = U := Finset.insert_eq_of_mem hmem
      rw [this] at hcard
      have := Finset.card_insert_le u U
      omega
    have hcardU : U.card = k := by
      rw [Finset.card_insert_of_notMem (by simp [huv, huU]), Finset.card_insert_of_notMem hvU] at hcard
      omega
    have hih := ih tail (by rw [Finset.card_insert_of_notMem hzU, hcardU])
    rw [Finset.sum_insert hzU] at hih
    rw [Finset.sum_insert (by simp [huv, huU]), Finset.sum_insert hvU]
    have hbin := yz_binOp a b c d12 e12 f12 op u v
    omega

-- Automorphism action properties
def actNibSpec (g k nib : Nat) : Nat :=
  (if Nat.beq (Nat.land nib 1) 1 then Nat.shiftLeft 1 (bitPerm g (4 * k)) else 0) |||
  (if Nat.beq (Nat.land nib 2) 2 then Nat.shiftLeft 1 (bitPerm g (4 * k + 1)) else 0) |||
  (if Nat.beq (Nat.land nib 4) 4 then Nat.shiftLeft 1 (bitPerm g (4 * k + 2)) else 0) |||
  (if Nat.beq (Nat.land nib 8) 8 then Nat.shiftLeft 1 (bitPerm g (4 * k + 3)) else 0)

private theorem actNib_eq_spec : ∀ g : Fin 12, ∀ k : Fin 6, ∀ nib : Fin 16,
    actNibAt g.val k.val nib.val = actNibSpec g.val k.val nib.val := by decide +kernel

private theorem bitPerm_props : ∀ g : Fin 12, ∀ i : Fin 24,
    bitPerm g.val i.val < 24 ∧ bitPermInv g.val i.val < 24 ∧
    bitPerm g.val (bitPermInv g.val i.val) = i.val ∧
    bitPermInv g.val (bitPerm g.val i.val) = i.val := by decide +kernel

private lemma actNibAt_testBit (g k w j : Nat) (hg : g < 12) (hk : k < 6) (hj : j < 24) :
    (actNibAt g k ((w >>> (4 * k)) &&& 15)).testBit j =
    (decide (4 * k ≤ bitPermInv g j ∧ bitPermInv g j < 4 * k + 4) && w.testBit (bitPermInv g j)) := by
  set nib := (w >>> (4 * k)) &&& 15
  have hnib : nib < 16 := by
    show (w >>> (4 * k)) &&& 15 < 16
    rw [show (15 : Nat) = 2 ^ 4 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]
    exact Nat.mod_lt _ (by omega)
  rw [actNib_eq_spec ⟨g, hg⟩ ⟨k, hk⟩ ⟨nib, hnib⟩]
  unfold actNibSpec
  simp only [Nat.testBit_or]
  have hbi := bitPerm_props ⟨g, hg⟩ ⟨j, hj⟩
  have hbit : ∀ r < 4,
      (if Nat.beq (Nat.land nib (2 ^ r)) (2 ^ r) then Nat.shiftLeft 1 (bitPerm g (4 * k + r)) else 0).testBit j =
      (decide (bitPermInv g j = 4 * k + r) && w.testBit (4 * k + r)) := by
    intro r hr
    have hcond : Nat.beq (Nat.land nib (2 ^ r)) (2 ^ r) = w.testBit (4 * k + r) := by
      have hnb : nib.testBit r = w.testBit (4 * k + r) := by
        show ((w >>> (4 * k)) &&& 15).testBit r = _
        rw [Nat.testBit_and, Nat.testBit_shiftRight]
        have h15 : (15 : Nat).testBit r = true := by interval_cases r <;> decide
        simp [h15]
      have hpow : Nat.beq (Nat.land nib (2 ^ r)) (2 ^ r) = nib.testBit r := by
        have hn16 : nib < 16 := hnib
        interval_cases r <;> interval_cases nib <;> decide
      rw [hpow, hnb]
    rw [hcond]
    cases hw : w.testBit (4 * k + r)
    · simp
    · simp only [↓reduceIte, Bool.and_true, natShl_eq, Nat.testBit_shiftLeft]
      by_cases he : bitPermInv g j = 4 * k + r
      · have hje : bitPerm g (4 * k + r) = j := by rw [← he, hbi.2.2.1]
        simp [he, hje]
      · have hjne : j ≠ bitPerm g (4 * k + r) := by
          intro hjj
          apply he
          rw [hjj, (bitPerm_props ⟨g, hg⟩ ⟨4 * k + r, by omega⟩).2.2.2]
        have hlt : ¬(bitPerm g (4 * k + r) ≤ j ∧ (1 : Nat).testBit (j - bitPerm g (4 * k + r)) = true) := by
          rintro ⟨hle, h1⟩
          have : j - bitPerm g (4 * k + r) = 0 := by
            by_contra hne0
            have h1lt := testBit_false_of_lt_pow (x := 1) (m := 1) (by decide) (by omega : 1 ≤ j - bitPerm g (4 * k + r))
            rw [h1lt] at h1; cases h1
          omega
        have hfls : (decide (bitPerm g (4 * k + r) ≤ j) && (1 : Nat).testBit (j - bitPerm g (4 * k + r))) = false := by
          by_cases h1 : bitPerm g (4 * k + r) ≤ j
          · simp [h1] at hlt ⊢; exact hlt
          · simp [h1]
        simp [he, hfls]
  have hb0 := hbit 0 (by omega)
  have hb1 := hbit 1 (by omega)
  have hb2 := hbit 2 (by omega)
  have hb3 := hbit 3 (by omega)
  simp only [Nat.pow_zero, Nat.pow_one, Nat.add_zero, show (2 ^ 2 : Nat) = 4 by rfl,
    show (2 ^ 3 : Nat) = 8 by rfl] at hb0 hb1 hb2 hb3
  rw [hb0, hb1, hb2, hb3]
  set p := bitPermInv g j
  by_cases h0 : p = 4 * k
  · rw [h0]; simp
  by_cases h1 : p = 4 * k + 1
  · rw [h1]; simp [(by omega : 4 * k ≤ 4 * k + 1), (by omega : 4 * k + 1 < 4 * k + 4)]
  by_cases h2 : p = 4 * k + 2
  · rw [h2]; simp [(by omega : 4 * k ≤ 4 * k + 2), (by omega : 4 * k + 2 < 4 * k + 4)]
  by_cases h3 : p = 4 * k + 3
  · rw [h3]; simp [(by omega : 4 * k ≤ 4 * k + 3), (by omega : 4 * k + 3 < 4 * k + 4)]
  have hout : ¬(4 * k ≤ p ∧ p < 4 * k + 4) := by omega
  simp [h0, h1, h2, h3, hout]

private lemma act_eq_nibs (g w : Nat) :
    act g w =
    Nat.lor (actNibAt g 0 (Nat.land w 15))
      (Nat.lor (actNibAt g 1 (Nat.land (Nat.shiftRight w 4) 15))
        (Nat.lor (actNibAt g 2 (Nat.land (Nat.shiftRight w 8) 15))
          (Nat.lor (actNibAt g 3 (Nat.land (Nat.shiftRight w 12) 15))
            (Nat.lor (actNibAt g 4 (Nat.land (Nat.shiftRight w 16) 15))
              (actNibAt g 5 (Nat.land (Nat.shiftRight w 20) 15)))))) := by
  unfold act actWithTab actNibAt
  simp only [show Nat.add (Nat.mul 16 0) (Nat.land w 15) = Nat.land w 15 by rw [natAdd_eq, natMul_eq]; simp,
    show Nat.mul 16 1 = 16 by rfl, show Nat.mul 16 2 = 32 by rfl, show Nat.mul 16 3 = 48 by rfl,
    show Nat.mul 16 4 = 64 by rfl, show Nat.mul 16 5 = 80 by rfl]

private lemma act_testBit_lt (g w j : Nat) (hg : g < 12) (hj : j < 24) :
    (act g w).testBit j = w.testBit (bitPermInv g j) := by
  rw [act_eq_nibs]
  simp only [natLor_eq, natLand_eq, natShr_eq, Nat.testBit_or]
  have h0 := actNibAt_testBit g 0 w j hg (by omega) hj
  have h1 := actNibAt_testBit g 1 w j hg (by omega) hj
  have h2 := actNibAt_testBit g 2 w j hg (by omega) hj
  have h3 := actNibAt_testBit g 3 w j hg (by omega) hj
  have h4 := actNibAt_testBit g 4 w j hg (by omega) hj
  have h5 := actNibAt_testBit g 5 w j hg (by omega) hj
  simp only [Nat.mul_zero, Nat.shiftRight_zero, Nat.zero_add] at h0
  rw [h0, h1, h2, h3, h4, h5]
  have hp : bitPermInv g j < 24 := (bitPerm_props ⟨g, hg⟩ ⟨j, hj⟩).2.1
  set p := bitPermInv g j
  interval_cases p <;> simp

private lemma act_testBit_ge (g w j : Nat) (hj : 24 ≤ j) : (act g w).testBit j = false := by
  have hnib : ∀ k nib, (actNibAt g k nib).testBit j = false := by
    intro k nib
    unfold actNibAt
    rw [natLand_eq, Nat.testBit_and]
    have h0 : (0xffffff : Nat).testBit j = false := testBit_false_of_lt_pow (m := 24) (by decide) hj
    simp [h0]
  rw [act_eq_nibs]
  simp only [natLor_eq, Nat.testBit_or, hnib, Bool.or_false]

private lemma act_and {g : Nat} (hg : g < 12) (a b : Nat) :
    act g (a &&& b) = act g a &&& act g b := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_and]
  by_cases hj : j < 24
  · rw [act_testBit_lt g _ j hg hj, act_testBit_lt g a j hg hj, act_testBit_lt g b j hg hj, Nat.testBit_and]
  · rw [act_testBit_ge g _ j (by omega), act_testBit_ge g a j (by omega), act_testBit_ge g b j (by omega)]; rfl

private lemma act_or {g : Nat} (hg : g < 12) (a b : Nat) :
    act g (a ||| b) = act g a ||| act g b := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_or]
  by_cases hj : j < 24
  · rw [act_testBit_lt g _ j hg hj, act_testBit_lt g a j hg hj, act_testBit_lt g b j hg hj, Nat.testBit_or]
  · rw [act_testBit_ge g _ j (by omega), act_testBit_ge g a j (by omega), act_testBit_ge g b j (by omega)]; rfl

private lemma act_binOp {g : Nat} (hg : g < 12) (op : Bool) (a b : Nat) :
    act g (binOp op a b) = binOp op (act g a) (act g b) := by
  cases op
  · exact act_and hg a b
  · exact act_or hg a b

private lemma act_zero {g : Nat} (hg : g < 12) : act g 0 = 0 := by
  apply Nat.eq_of_testBit_eq
  intro j
  by_cases hj : j < 24
  · rw [act_testBit_lt g 0 j hg hj]; simp
  · rw [act_testBit_ge g 0 j (by omega)]; simp

private lemma dmOf_lt {pm nm : Nat} (hpm : pm < 4096) (hnm : nm < 4096) : dmOf pm nm < 2 ^ 24 := by
  unfold dmOf
  rw [natLor_eq, natShl_eq]
  have h1 : pm < 2 ^ 24 := by omega
  have h2 : nm <<< 12 < 2 ^ 24 := by rw [Nat.shiftLeft_eq]; omega
  exact Nat.or_lt_two_pow h1 h2

private lemma land_eq_lt {w dm : Nat} (h : (w &&& dm) = w) (hdm : dm < 2 ^ 24) : w < 2 ^ 24 := by
  rw [← h]
  have hle : w &&& dm ≤ dm := Nat.and_le_right
  omega

private lemma act_inj {g : Nat} (hg : g < 12) {a b : Nat} (ha : a < 2 ^ 24) (hb : b < 2 ^ 24)
    (heq : act g a = act g b) : a = b := by
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 24
  · have hp := bitPerm_props ⟨g, hg⟩ ⟨i, hi⟩
    have ht := congrArg (fun x => x.testBit (bitPerm g i)) heq
    rw [act_testBit_lt g a _ hg hp.1, act_testBit_lt g b _ hg hp.1, hp.2.2.2] at ht
    exact ht
  · rw [testBit_false_of_lt_pow ha (by omega), testBit_false_of_lt_pow hb (by omega)]

private lemma properS_act {g pm nm pm' nm' w : Nat} (hg : g < 12)
    (hpm : pm < 4096) (hnm : nm < 4096)
    (hdm : act g (dmOf pm nm) = dmOf pm' nm') (hw : properS (dmOf pm nm) w) :
    properS (dmOf pm' nm') (act g w) := by
  obtain ⟨hmask, h0, h1⟩ := hw
  have hdmlt := dmOf_lt hpm hnm
  have hwlt := land_eq_lt hmask hdmlt
  refine ⟨?_, ?_, ?_⟩
  · rw [← hdm, ← act_and hg]
    exact congrArg (act g) hmask
  · intro hz
    apply h0
    exact act_inj hg hwlt (by omega) (hz.trans (act_zero hg).symm)
  · intro he
    apply h1
    exact act_inj hg hwlt hdmlt (he.trans hdm.symm)

private lemma mlive_act {g pm nm pm' nm' k S} (hg : g < 12)
    (hpm : pm < 4096) (hnm : nm < 4096)
    (hmap_p : act g pm = pm') (hmap_d : act g (dmOf pm nm) = dmOf pm' nm')
    (h : MLive pm nm k S) : MLive pm' nm' k (S.image (act g)) := by
  have hdmlt := dmOf_lt hpm hnm
  induction k generalizing S with
  | zero =>
    obtain ⟨rfl, hp⟩ := h
    have hp' := properS_act hg hpm hnm hmap_d hp
    rw [hmap_p] at hp'
    exact ⟨by simp [hmap_p], hp'⟩
  | succ k ih =>
    obtain ⟨U, a, b, op, rfl, ha, hb, hab, hz, hfresh, tail⟩ := h
    have hSprop := mlive_proper (pm := pm) (nm := nm) (k := k + 1) (S := insert a (insert b U))
      ⟨U, a, b, op, rfl, ha, hb, hab, hz, hfresh, tail⟩
    have halt := land_eq_lt ha.1 hdmlt
    have hblt := land_eq_lt hb.1 hdmlt
    have hzlt := land_eq_lt hz.1 hdmlt
    refine ⟨U.image (act g), act g a, act g b, op, ?_,
      properS_act hg hpm hnm hmap_d ha,
      properS_act hg hpm hnm hmap_d hb, ?_, ?_, ?_, ?_⟩
    · simp [Finset.image_insert]
    · intro heq; exact hab (act_inj hg halt hblt heq)
    · rw [← act_binOp hg]; exact properS_act hg hpm hnm hmap_d hz
    · rw [← act_binOp hg]
      intro hmem
      rw [← Finset.image_insert, ← Finset.image_insert, Finset.mem_image] at hmem
      obtain ⟨u, hu, heq⟩ := hmem
      have hult := land_eq_lt (hSprop u hu).1 hdmlt
      have hzu := act_inj hg hult hzlt heq
      exact hfresh (hzu ▸ hu)
    · rw [← act_binOp hg, ← Finset.image_insert]
      exact ih tail

private lemma mapAct_toFinset (g : Nat) (l : List Nat) :
    (mapAct g l).toFinset = l.toFinset.image (act g) := by
  unfold mapAct
  induction l with
  | nil => simp [mapActLoop]
  | cons a as ih => simp [mapActLoop, act, ih]

-- Reach, Dom, proj_bound, reach_extract, poolCut
def Dom (pm nm u w : Nat) : Prop :=
  (∀ i < 12, pm.testBit i = true → w.testBit i = true → u.testBit i = true) ∧
  (∀ j < 12, nm.testBit j = true → u.testBit (12 + j) = true → w.testBit (12 + j) = true)

private lemma dom_mask (pm nm w : Nat) : Dom pm nm (w &&& dmOf pm nm) w := by
  refine ⟨fun i _ hpi hwi => ?_, fun j _ _ huj => ?_⟩
  · rw [Nat.testBit_and, hwi, Bool.true_and]
    unfold dmOf
    rw [natLor_eq, Nat.testBit_or, hpi]; rfl
  · rw [Nat.testBit_and, Bool.and_eq_true] at huj
    exact huj.1

private lemma dom_binOp {pm nm u1 w1 u2 w2 : Nat} (op : Bool)
    (h1 : Dom pm nm u1 w1) (h2 : Dom pm nm u2 w2) :
    Dom pm nm (binOp op u1 u2) (binOp op w1 w2) := by
  cases op
  · refine ⟨fun i hi hpi hwi => ?_, fun j hj hnj huj => ?_⟩
    · simp only [binOp_false, Nat.testBit_and, Bool.and_eq_true] at hwi ⊢
      exact ⟨h1.1 i hi hpi hwi.1, h2.1 i hi hpi hwi.2⟩
    · simp only [binOp_false, Nat.testBit_and, Bool.and_eq_true] at huj ⊢
      exact ⟨h1.2 j hj hnj huj.1, h2.2 j hj hnj huj.2⟩
  · refine ⟨fun i hi hpi hwi => ?_, fun j hj hnj huj => ?_⟩
    · simp only [binOp_true, Nat.testBit_or, Bool.or_eq_true] at hwi ⊢
      exact hwi.imp (h1.1 i hi hpi) (h2.1 i hi hpi)
    · simp only [binOp_true, Nat.testBit_or, Bool.or_eq_true] at huj ⊢
      exact huj.imp (h1.2 j hj hnj) (h2.2 j hj hnj)

private lemma isZeroB_iff (pm w : Nat) :
    isZeroB pm w = true ↔ ∀ i, pm.testBit i = true → w.testBit i = false := by
  unfold isZeroB
  rw [natBeq_iff, natLand_eq]
  constructor
  · intro h i hpi
    have ht := congrArg (fun x => x.testBit i) h
    rw [Nat.testBit_and, Nat.zero_testBit, hpi, Bool.and_true] at ht
    exact ht
  · intro h
    apply Nat.eq_of_testBit_eq
    intro i
    rw [Nat.testBit_and, Nat.zero_testBit]
    cases hp : pm.testBit i
    · simp
    · simp [h i hp]

private lemma isOneB_iff (nm w : Nat) :
    isOneB nm w = true ↔ ∀ j, nm.testBit j = true → w.testBit (12 + j) = true := by
  unfold isOneB
  rw [natBeq_iff, natLand_eq, natShr_eq]
  constructor
  · intro h j hnj
    have ht := congrArg (fun x => x.testBit j) h
    rw [Nat.testBit_and, Nat.testBit_shiftRight, hnj, Bool.and_true] at ht
    exact ht
  · intro h
    apply Nat.eq_of_testBit_eq
    intro j
    rw [Nat.testBit_and, Nat.testBit_shiftRight]
    cases hn : nm.testBit j
    · simp
    · simp [h j hn]

private lemma isConstB_iff (pm nm w : Nat) :
    isConstB pm nm w = true ↔ isZeroB pm w = true ∨ isOneB nm w = true := by
  unfold isConstB
  cases isZeroB pm w <;> simp

private lemma const_bin_cases (pm nm a b : Nat) (op : Bool) (ha : isConstB pm nm a = true) :
    isConstB pm nm (binOp op a b) = true ∨
    (isConstB pm nm b = false ∧ ∀ u, Dom pm nm u b → Dom pm nm u (binOp op a b)) := by
  rw [isConstB_iff] at ha
  rcases ha with ha0 | ha1
  · rw [isZeroB_iff] at ha0
    cases op
    · left
      rw [isConstB_iff]; left; rw [isZeroB_iff]
      intro i hpi; simp [binOp_false, Nat.testBit_and, ha0 i hpi]
    · by_cases hbc : isConstB pm nm b = true
      · left
        rw [isConstB_iff] at hbc ⊢
        rcases hbc with hb0 | hb1
        · left; rw [isZeroB_iff] at hb0 ⊢
          intro i hpi; simp [binOp_true, Nat.testBit_or, ha0 i hpi, hb0 i hpi]
        · right; rw [isOneB_iff] at hb1 ⊢
          intro j hnj; simp [binOp_true, Nat.testBit_or, hb1 j hnj]
      · right
        refine ⟨Bool.eq_false_iff.mpr hbc, fun u hu => ⟨fun i hi hpi hwi => ?_, fun j hj hnj huj => ?_⟩⟩
        · rw [binOp_true, Nat.testBit_or, ha0 i hpi, Bool.false_or] at hwi
          exact hu.1 i hi hpi hwi
        · rw [binOp_true, Nat.testBit_or, hu.2 j hj hnj huj, Bool.or_true]
  · rw [isOneB_iff] at ha1
    cases op
    · by_cases hbc : isConstB pm nm b = true
      · left
        rw [isConstB_iff] at hbc ⊢
        rcases hbc with hb0 | hb1
        · left; rw [isZeroB_iff] at hb0 ⊢
          intro i hpi; simp [binOp_false, Nat.testBit_and, hb0 i hpi]
        · right; rw [isOneB_iff] at hb1 ⊢
          intro j hnj; simp [binOp_false, Nat.testBit_and, ha1 j hnj, hb1 j hnj]
      · right
        refine ⟨Bool.eq_false_iff.mpr hbc, fun u hu => ⟨fun i hi hpi hwi => ?_, fun j hj hnj huj => ?_⟩⟩
        · rw [binOp_false, Nat.testBit_and, Bool.and_eq_true] at hwi
          exact hu.1 i hi hpi hwi.2
        · rw [binOp_false, Nat.testBit_and, ha1 j hnj, hu.2 j hj hnj huj]; rfl
    · left
      rw [isConstB_iff]; right; rw [isOneB_iff]
      intro j hnj; simp [binOp_true, Nat.testBit_or, ha1 j hnj]

private lemma dom_target {pm nm u : Nat} (hpm : pm < 4096) (hnm : nm < 4096)
    (hmask : (u &&& dmOf pm nm) = u) (hdom : Dom pm nm u 0xfff) : u = pm := by
  apply Nat.eq_of_testBit_eq
  intro k
  by_cases hk12 : k < 12
  · cases hp : pm.testBit k
    · have hdm0 : (dmOf pm nm).testBit k = false := by
        unfold dmOf
        rw [natLor_eq, natShl_eq, Nat.testBit_or, hp, Nat.testBit_shiftLeft]
        simp [Nat.not_le.mpr hk12]
      rw [← hmask, Nat.testBit_and, hdm0, Bool.and_false]
    · have hf : (0xfff : Nat).testBit k = true := by interval_cases k <;> decide
      exact hdom.1 k hk12 hp hf
  · have hpm0 : pm.testBit k = false := testBit_false_of_lt_pow (m := 12) (by omega) (by omega)
    rw [hpm0]
    by_cases hk24 : k < 24
    · set j := k - 12
      have hk_eq : k = 12 + j := by omega
      rw [hk_eq]
      cases hn : nm.testBit j
      · have hdm0 : (dmOf pm nm).testBit (12 + j) = false := by
          unfold dmOf
          rw [natLor_eq, natShl_eq, Nat.testBit_or, Nat.testBit_shiftLeft]
          have hp0 : pm.testBit (12 + j) = false := testBit_false_of_lt_pow (m := 12) (by omega) (by omega)
          simp [hp0, hn]
        rw [← hmask, Nat.testBit_and, hdm0, Bool.and_false]
      · cases hu : u.testBit (12 + j)
        · rfl
        · have hf := hdom.2 j (by omega) hn hu
          have hf0 : (0xfff : Nat).testBit (12 + j) = false :=
            testBit_false_of_lt_pow (m := 12) (by decide) (by omega)
          rw [hf0] at hf; cases hf
    · exact testBit_false_of_lt_pow (land_eq_lt hmask (dmOf_lt hpm hnm)) (by omega)

def Reach (dm : Nat) (base : List Nat) : Nat → List Nat → Prop
  | 0, bank => bank = base
  | p + 1, bank =>
    ∃ bank0 a b op, Reach dm base p bank0 ∧ a ∈ bank0 ∧ b ∈ bank0 ∧
      bank = bank0 ++ [binOp op a b]

private lemma reach_mask {dm base p bank} (hr : Reach dm base p bank)
    (hbase : ∀ w ∈ base, (w &&& dm) = w) : ∀ w ∈ bank, (w &&& dm) = w := by
  induction p generalizing bank with
  | zero =>
    subst hr; exact hbase
  | succ p ih =>
    obtain ⟨bank0, a, b, op, hr0, ha, hb, rfl⟩ := hr
    have ih0 := ih hr0
    intro w hw
    simp only [List.mem_append, List.mem_singleton] at hw
    rcases hw with hw | rfl
    · exact ih0 w hw
    · apply Nat.eq_of_testBit_eq
      intro k
      have hma := congrArg (fun x => x.testBit k) (ih0 a ha)
      have hmb := congrArg (fun x => x.testBit k) (ih0 b hb)
      rw [Nat.testBit_and] at hma hmb ⊢
      cases op
      · rw [binOp_false, Nat.testBit_and]
        cases hd : dm.testBit k
        · simp [hd] at hma hmb ⊢; simp [hma]
        · simp
      · rw [binOp_true, Nat.testBit_or]
        cases hd : dm.testBit k
        · simp [hd] at hma hmb ⊢; simp [hma, hmb]
        · simp

private lemma pull_bin {pm nm k S} {bank0 : List Nat} {a b : Nat} {op : Bool}
    (h : MLive pm nm k S)
    (hsub : ∀ w ∈ S, w ∈ bank0 ++ [binOp op a b])
    (ha : a ∈ bank0) (hb : b ∈ bank0)
    (hmask : ∀ w ∈ bank0, (w &&& dmOf pm nm) = w) :
    ∃ k' S', k' ≤ k + 1 ∧ MLive pm nm k' S' ∧ ∀ w ∈ S', w ∈ bank0 := by
  set z := binOp op a b
  set dm := dmOf pm nm
  by_cases hzS : z ∈ S
  · by_cases hzB : z ∈ bank0
    · refine ⟨k, S, by omega, h, fun w hw => ?_⟩
      rcases List.mem_append.mp (hsub w hw) with hw0 | hwz
      · exact hw0
      · rw [List.mem_singleton.mp hwz]; exact hzB
    · have hzp : properS dm z := mlive_proper h z hzS
      have hma := hmask a ha
      have hmb := hmask b hb
      have lor_dm : ∀ x, (x &&& dm) = x → (x ||| dm) = dm := fun x hx => by
        apply Nat.eq_of_testBit_eq; intro i
        have hi := congrArg (fun v => v.testBit i) hx
        rw [Nat.testBit_and] at hi
        rw [Nat.testBit_or]
        cases hd : dm.testBit i
        · simp [hd] at hi ⊢; exact hi
        · simp
      have hap : properS dm a := by
        refine ⟨hma, ?_, ?_⟩
        · intro ha0
          have hz1 : z = binOp op 0 b := by simp [z, ha0]
          cases op
          · exact hzp.2.1 (by simp [hz1, binOp_false])
          · exact hzB (by simpa [hz1, binOp_true] using hb)
        · intro had
          have hz1 : z = binOp op dm b := by simp [z, had]
          cases op
          · exact hzB (by simpa [hz1, binOp_false, Nat.and_comm, hmb] using hb)
          · exact hzp.2.2 (by simp [hz1, binOp_true, Nat.or_comm, lor_dm b hmb])
      have hbp : properS dm b := by
        refine ⟨hmb, ?_, ?_⟩
        · intro hb0
          have hz1 : z = binOp op a 0 := by simp [z, hb0]
          cases op
          · exact hzp.2.1 (by simp [hz1, binOp_false])
          · exact hzB (by simpa [hz1, binOp_true] using ha)
        · intro hbd
          have hz1 : z = binOp op a dm := by simp [z, hbd]
          cases op
          · exact hzB (by simpa [hz1, binOp_false, hma] using ha)
          · exact hzp.2.2 (by simp [hz1, binOp_true, lor_dm a hma])
      have hab : a ≠ b := by
        intro heq
        have hz1 : z = binOp op a a := by simp [z, heq]
        cases op
        · exact hzB (by simpa [hz1, binOp_false] using ha)
        · exact hzB (by simpa [hz1, binOp_true] using ha)
      let U := S.erase z
      have hUsub : ∀ w ∈ U, w ∈ bank0 := by
        intro w hw
        obtain ⟨hne, hwS⟩ := Finset.mem_erase.mp hw
        rcases List.mem_append.mp (hsub w hwS) with hw0 | hwz
        · exact hw0
        · exact absurd (List.mem_singleton.mp hwz) hne
      have hfresh : z ∉ insert a (insert b U) := by
        intro hm
        rcases Finset.mem_insert.mp hm with hza | hm
        · exact hzB (hza ▸ ha)
        rcases Finset.mem_insert.mp hm with hzb | hm
        · exact hzB (hzb ▸ hb)
        · exact hzB (hUsub z hm)
      have htail : MLive pm nm k (insert z U) := by
        have hEq : insert z U = S := Finset.insert_erase hzS
        rw [hEq]
        exact h
      refine ⟨k + 1, insert a (insert b U), Nat.le_refl _,
        ⟨U, a, b, op, rfl, hap, hbp, hab, hzp, hfresh, htail⟩, ?_⟩
      intro w hw
      rcases Finset.mem_insert.mp hw with rfl | hw
      · exact ha
      rcases Finset.mem_insert.mp hw with rfl | hw
      · exact hb
      · exact hUsub w hw
  · refine ⟨k, S, by omega, h, fun w hw => ?_⟩
    rcases List.mem_append.mp (hsub w hw) with hw0 | hwz
    · exact hw0
    · exact absurd (List.mem_singleton.mp hwz ▸ hw) hzS

private lemma reach_extract {pm nm base q bank} (hr : Reach (dmOf pm nm) base q bank)
    (hbase : ∀ w ∈ base, (w &&& dmOf pm nm) = w)
    (hp : properS (dmOf pm nm) pm) (hout : pm ∈ bank) :
    ∃ k S, k ≤ q ∧ MLive pm nm k S ∧ ∀ w ∈ S, w ∈ base := by
  have hgen : ∀ p b, Reach (dmOf pm nm) base p b →
      ∀ k S, MLive pm nm k S → (∀ w ∈ S, w ∈ b) →
      ∃ k' S', k' ≤ p + k ∧ MLive pm nm k' S' ∧ ∀ w ∈ S', w ∈ base := by
    intro p
    induction p with
    | zero =>
      intro b hr0 k S hS hsub
      subst hr0
      exact ⟨k, S, by omega, hS, hsub⟩
    | succ p ih =>
      intro b hr1 k S hS hsub
      obtain ⟨bank0, a, b0, op, hr0, ha, hb, rfl⟩ := hr1
      obtain ⟨k1, S1, hk1, hS1, hsub1⟩ := pull_bin hS hsub ha hb (reach_mask hr0 hbase)
      obtain ⟨k2, S2, hk2, hS2, hsub2⟩ := ih bank0 hr0 k1 S1 hS1 hsub1
      exact ⟨k2, S2, by omega, hS2, hsub2⟩
  obtain ⟨k, S, hk, hS, hsub⟩ := hgen q bank hr 0 {pm} ⟨rfl, hp⟩ (by simpa using hout)
  exact ⟨k, S, by omega, hS, hsub⟩

private lemma proj_bound {pm nm base} (hpm : pm < 4096) (hnm : nm < 4096)
    (hpm0 : pm ≠ 0) (hnm0 : nm ≠ 0)
    (hbase : ∀ w ∈ base, (w &&& dmOf pm nm) = w) :
    ∀ k S p bank,
      Reach (dmOf pm nm) base p bank →
      MLive 0xfff 0xfff k S →
      (∀ w ∈ S, isConstB pm nm w = true ∨ ∃ u ∈ bank, Dom pm nm u w) →
      ∃ q bank', Reach (dmOf pm nm) base q bank' ∧ pm ∈ bank' ∧
        q + (S.filter (fun w => isConstB pm nm w = true)).card ≤ p + k := by
  intro k
  induction k with
  | zero =>
    intro S p bank hr hS hinv
    obtain ⟨rfl, _⟩ := hS
    have hnc : isConstB pm nm 0xfff = false := by
      unfold isConstB
      have hz : isZeroB pm 0xfff = false := by
        unfold isZeroB
        apply natBeq_false
        rw [natLand_eq, Nat.and_comm, show (0xfff : Nat) = 2 ^ 12 - 1 by rfl,
          Nat.and_two_pow_sub_one_eq_mod, Nat.mod_eq_of_lt hpm]
        exact hpm0
      have ho : isOneB nm 0xfff = false := by
        unfold isOneB
        apply natBeq_false
        rw [natLand_eq, natShr_eq, show (0xfff >>> 12 : Nat) = 0 by decide, Nat.zero_and]
        exact hnm0.symm
      simp [hz, ho]
    have hfilt : ({0xfff} : Finset Nat).filter (fun w => isConstB pm nm w = true) = ∅ := by
      simp [hnc]
    rcases hinv 0xfff (Finset.mem_singleton_self _) with hc | ⟨u, hu, hdom⟩
    · rw [hnc] at hc; cases hc
    · have hupm : u = pm := dom_target hpm hnm (reach_mask hr hbase u hu) hdom
      exact ⟨p, bank, hr, hupm ▸ hu, by simp [hfilt]⟩
  | succ k ih =>
    intro S p bank hr hS hinv
    obtain ⟨U, a, b, op, rfl, _, _, _, _, hfresh, tail⟩ := hS
    set z := binOp op a b
    have hzU : z ∉ U := fun hm =>
      hfresh (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hm))
    have hTcard_t : isConstB pm nm z = true →
        ((insert z U).filter (fun w => isConstB pm nm w = true)).card =
        1 + (U.filter (fun w => isConstB pm nm w = true)).card := by
      intro hzC
      rw [Finset.filter_insert]
      simp only [hzC, ↓reduceIte]
      rw [Finset.card_insert_of_notMem (fun hm => hzU (Finset.mem_filter.mp hm).1)]
      omega
    have hTcard_ge : (U.filter (fun w => isConstB pm nm w = true)).card ≤
        ((insert z U).filter (fun w => isConstB pm nm w = true)).card := by
      rw [Finset.filter_insert]
      by_cases hzC : isConstB pm nm z = true
      · simp only [hzC, ↓reduceIte]
        rw [Finset.card_insert_of_notMem (fun hm => hzU (Finset.mem_filter.mp hm).1)]; omega
      · simp [hzC]
    have hfilt_le : ∀ x (T : Finset Nat),
        ((insert x T).filter (fun w => isConstB pm nm w = true)).card ≤
        (if isConstB pm nm x = true then 1 else 0) + (T.filter (fun w => isConstB pm nm w = true)).card := by
      intro x T
      rw [Finset.filter_insert]
      by_cases hx : isConstB pm nm x = true
      · simp only [hx, ↓reduceIte]
        have := Finset.card_insert_le x (T.filter (fun w => isConstB pm nm w = true))
        omega
      · simp [hx]
    have hScard_le : ((insert a (insert b U)).filter (fun w => isConstB pm nm w = true)).card ≤
        (if isConstB pm nm a = true then 1 else 0) +
        (if isConstB pm nm b = true then 1 else 0) +
        (U.filter (fun w => isConstB pm nm w = true)).card := by
      have c1 := hfilt_le a (insert b U)
      have c2 := hfilt_le b U
      omega
    by_cases haC : isConstB pm nm a = true
    · rcases const_bin_cases pm nm a b op haC with hzC | ⟨hbF, hdomB⟩
      · have hinv' : ∀ w ∈ insert z U, isConstB pm nm w = true ∨ ∃ u ∈ bank, Dom pm nm u w := by
          intro w hw
          rcases Finset.mem_insert.mp hw with rfl | hwU
          · exact Or.inl hzC
          · exact hinv w (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hwU))
        obtain ⟨q, bank', hr', hpm', hle⟩ := ih (insert z U) p bank hr tail hinv'
        have ht := hTcard_t hzC
        refine ⟨q, bank', hr', hpm', ?_⟩
        have ha1 : (if isConstB pm nm a = true then 1 else 0) ≤ 1 := by split <;> omega
        have hb1 : (if isConstB pm nm b = true then 1 else 0) ≤ 1 := by split <;> omega
        omega
      · have hinv' : ∀ w ∈ insert z U, isConstB pm nm w = true ∨ ∃ u ∈ bank, Dom pm nm u w := by
          intro w hw
          rcases Finset.mem_insert.mp hw with rfl | hwU
          · rcases hinv b (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)) with hc | ⟨ub, hub, hdb⟩
            · rw [hbF] at hc; cases hc
            · exact Or.inr ⟨ub, hub, hdomB ub hdb⟩
          · exact hinv w (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hwU))
        obtain ⟨q, bank', hr', hpm', hle⟩ := ih (insert z U) p bank hr tail hinv'
        refine ⟨q, bank', hr', hpm', ?_⟩
        have ha1 : (if isConstB pm nm a = true then 1 else 0) = 1 := by simp [haC]
        have hb0 : (if isConstB pm nm b = true then 1 else 0) = 0 := by simp [hbF]
        omega
    · by_cases hbC : isConstB pm nm b = true
      · have hcomm : z = binOp op b a := binOp_comm op a b
        rcases const_bin_cases pm nm b a op hbC with hzC | ⟨haF, hdomA⟩
        · have hzC' : isConstB pm nm z = true := hcomm ▸ hzC
          have hinv' : ∀ w ∈ insert z U, isConstB pm nm w = true ∨ ∃ u ∈ bank, Dom pm nm u w := by
            intro w hw
            rcases Finset.mem_insert.mp hw with rfl | hwU
            · exact Or.inl hzC'
            · exact hinv w (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hwU))
          obtain ⟨q, bank', hr', hpm', hle⟩ := ih (insert z U) p bank hr tail hinv'
          have ht := hTcard_t hzC'
          refine ⟨q, bank', hr', hpm', ?_⟩
          have ha1 : (if isConstB pm nm a = true then 1 else 0) ≤ 1 := by split <;> omega
          have hb1 : (if isConstB pm nm b = true then 1 else 0) ≤ 1 := by split <;> omega
          omega
        · have hinv' : ∀ w ∈ insert z U, isConstB pm nm w = true ∨ ∃ u ∈ bank, Dom pm nm u w := by
            intro w hw
            rcases Finset.mem_insert.mp hw with rfl | hwU
            · rcases hinv a (Finset.mem_insert_self _ _) with hc | ⟨ua, hua, hda⟩
              · rw [haF] at hc; cases hc
              · exact Or.inr ⟨ua, hua, hcomm ▸ hdomA ua hda⟩
            · exact hinv w (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hwU))
          obtain ⟨q, bank', hr', hpm', hle⟩ := ih (insert z U) p bank hr tail hinv'
          refine ⟨q, bank', hr', hpm', ?_⟩
          have ha0 : (if isConstB pm nm a = true then 1 else 0) = 0 := by simp [haF]
          have hb1 : (if isConstB pm nm b = true then 1 else 0) = 1 := by simp [hbC]
          omega
      · rcases hinv a (Finset.mem_insert_self _ _) with hc | ⟨ua, hua, hda⟩
        · exact absurd hc haC
        rcases hinv b (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)) with hc | ⟨ub, hub, hdb⟩
        · exact absurd hc hbC
        let bank1 := bank ++ [binOp op ua ub]
        have hr1 : Reach (dmOf pm nm) base (p + 1) bank1 := ⟨bank, ua, ub, op, hr, hua, hub, rfl⟩
        have hinv' : ∀ w ∈ insert z U, isConstB pm nm w = true ∨ ∃ u ∈ bank1, Dom pm nm u w := by
          intro w hw
          rcases Finset.mem_insert.mp hw with rfl | hwU
          · exact Or.inr ⟨binOp op ua ub, by simp [bank1], dom_binOp op hda hdb⟩
          · rcases hinv w (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hwU)) with hc | ⟨u, hu, hdu⟩
            · exact Or.inl hc
            · exact Or.inr ⟨u, by simp [bank1, hu], hdu⟩
        obtain ⟨q, bank', hr', hpm', hle⟩ := ih (insert z U) (p + 1) bank1 hr1 tail hinv'
        refine ⟨q, bank', hr', hpm', ?_⟩
        have ha0 : (if isConstB pm nm a = true then 1 else 0) = 0 := by simp [haC]
        have hb0 : (if isConstB pm nm b = true then 1 else 0) = 0 := by simp [hbC]
        omega

def natNth : List Nat → Nat → Option Nat
  | [], _ => none
  | x :: _, 0 => some x
  | _ :: xs, Nat.succ n => natNth xs n

private lemma natNth_mem : ∀ (l : List Nat) (i a : Nat), natNth l i = some a → a ∈ l
  | [], _, _, h => by cases h
  | x :: _, 0, a, h => by cases h; exact List.mem_cons_self
  | _ :: xs, Nat.succ n, a, h => List.mem_cons_of_mem _ (natNth_mem xs n a h)

def buildPoolStep (pool : List Nat) (gc : Nat) : Option (List Nat) :=
  let op := Nat.beq (Nat.land gc 1) 1
  let ia := Nat.land (Nat.shiftRight gc 1) 15
  let ib := Nat.land (Nat.shiftRight gc 5) 15
  match natNth pool ia, natNth pool ib with
  | some a, some b => some (pool ++ [binOp op a b])
  | _, _ => none

def buildPool : Nat → Nat → List Nat → Option (List Nat)
  | 0, _, pool => some pool
  | Nat.succ k, bits, pool =>
    match buildPoolStep pool (Nat.land bits 511) with
    | some pool' => buildPool k (Nat.shiftRight bits 9) pool'
    | none => none

private lemma buildPool_reach {dm base} : ∀ k bits p0 pool0 pool,
    Reach dm base p0 pool0 → buildPool k bits pool0 = some pool →
    Reach dm base (p0 + k) pool := by
  intro k
  induction k with
  | zero =>
    intro bits p0 pool0 pool hr hb
    simp only [buildPool, Option.some.injEq] at hb
    subst hb; exact hr
  | succ k ih =>
    intro bits p0 pool0 pool hr hb
    unfold buildPool at hb
    cases hs : buildPoolStep pool0 (Nat.land bits 511) with
    | none => rw [hs] at hb; cases hb
    | some pool1 =>
      rw [hs] at hb
      unfold buildPoolStep at hs
      dsimp only at hs
      cases ha : natNth pool0 (Nat.land (Nat.shiftRight (Nat.land bits 511) 1) 15) with
      | none => rw [ha] at hs; cases hs
      | some a =>
        cases hbb : natNth pool0 (Nat.land (Nat.shiftRight (Nat.land bits 511) 5) 15) with
        | none => rw [ha, hbb] at hs; cases hs
        | some b =>
          rw [ha, hbb] at hs
          cases hs
          have hr1 : Reach dm base (p0 + 1) (pool0 ++ [binOp (Nat.beq (Nat.land (Nat.land bits 511) 1) 1) a b]) :=
            ⟨pool0, a, b, _, hr, natNth_mem _ _ _ ha, natNth_mem _ _ _ hbb, rfl⟩
          have hr2 := ih (Nat.shiftRight bits 9) (p0 + 1) _ pool hr1 hb
          simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using hr2

def checkPoolCut (s : Nat) (ws : List Nat) (pc : Nat) : Bool :=
  match natNodup ws with
  | false => false
  | true =>
    let v := Nat.land pc 15
    match Nat.blt v 9 with
    | false => false
    | true =>
      let p := Nat.land (Nat.shiftRight pc 4) 7
      let pmv := slicePm v
      let nmv := sliceNm v
      let dmv := dmOf pmv nmv
      let c := natCountP (isConstB pmv nmv) ws
      match Nat.blt (Nat.add s p) (Nat.add 12 c) with
      | false => false
      | true =>
        match buildPool p (Nat.shiftRight pc 7) (sliceBase v) with
        | none => false
        | some pool => natAll (fun w => match isConstB pmv nmv w with | true => true | false => natMem (Nat.land w dmv) pool) ws

-- Step Checker (with O(1) incremental sep, vf, bloom, and lazy hash!)
abbrev HintRec := Nat × Nat × Nat × Nat × Nat × Nat × Nat
abbrev WRec := Nat × Nat × Nat × Nat × List Nat

def sumYzList (a b c d12 e12 f12 : Nat) : List Nat → Nat
  | [] => 0
  | w :: ws => Nat.add (yz a b c d12 e12 f12 w) (sumYzList a b c d12 e12 f12 ws)

def loadHints (pm : Nat) (ws : List Nat) (start : Nat) : Nat → List HintRec
  | 0 => []
  | Nat.succ k =>
    let tc := getTup (getFlatHint start)
    let a := Nat.land tc 15
    let b := Nat.land (Nat.shiftRight tc 4) 15
    let c := Nat.land (Nat.shiftRight tc 8) 15
    let d12 := Nat.add 12 (Nat.land (Nat.shiftRight tc 12) 15)
    let e12 := Nat.add 12 (Nat.land (Nat.shiftRight tc 16) 15)
    let f12 := Nat.add 12 (Nat.land (Nat.shiftRight tc 20) 15)
    let rest := loadHints pm ws (Nat.add start 1) k
    match Nat.beq (bitN pm a) 1 with
    | false => rest
    | true =>
      match Nat.beq (bitN pm b) 1 with
      | false => rest
      | true =>
        match Nat.beq (bitN pm c) 1 with
        | false => rest
        | true => (a, b, c, d12, e12, f12, sumYzList a b c d12 e12 f12 ws) :: rest

def evalHintsW : List HintRec → Nat → List Nat
  | [], _ => []
  | (a, b, c, d12, e12, f12, _) :: hr, w => yz a b c d12 e12 f12 w :: evalHintsW hr w

def buildWRecs (salt : Nat) (hints : List HintRec) : List Nat → List WRec × Nat × Nat × Nat
  | [] => ([], 0, 0, 0)
  | w :: rest =>
    let (recs, sufS, sufH, bl) := buildWRecs salt hints rest
    let sw := sep w
    let hw := hashTerm salt w
    let yw := evalHintsW hints w
    ((w, sw, hw, sufS, yw) :: recs, Nat.lor sw sufS, Nat.add hw sufH, Nat.lor (bloomBit w) bl)

def checkHintsInc : List HintRec → List Nat → List Nat → Bool → Bool → Nat → Bool
  | [], _, _, _, _, _ => false
  | (a, b, c, d12, e12, f12, yTot) :: hr, ya :: yar, yb :: ybr, ka, kb, z =>
    let y1 := match ka with | true => yTot | false => Nat.sub yTot ya
    let y2 := match kb with | true => y1 | false => Nat.sub y1 yb
    let tot := Nat.add y2 (yz a b c d12 e12 f12 z)
    match Nat.blt tot 3 with
    | true => true
    | false => checkHintsInc hr yar ybr ka kb z
  | _, _, _, _, _, _ => false

def checkChild (req saltPrev nSym totPrev : Nat)
    (symG : Nat → Nat) (getStPrev : Nat → List Nat) (lookupPrev : Nat → Nat)
    (ws : List Nat) (hints : List HintRec)
    (a sa ha : Nat) (ya : List Nat) (b sb hb : Nat) (yb : List Nat)
    (uRest hRest z sz : Nat) (ka kb isTight : Bool) : Bool :=
  let u1 := match ka with | true => Nat.lor uRest sa | false => uRest
  let u2 := match kb with | true => Nat.lor u1 sb | false => u1
  let u := Nat.lor u2 sz
  match Nat.beq (Nat.land u req) req with
  | false => true
  | true =>
    match (match isTight with | true => checkHintsInc hints ya yb ka kb z | false => false) with
    | true => true
    | false =>
      let h1 := match ka with | true => Nat.add hRest ha | false => hRest
      let h2 := match kb with | true => Nat.add h1 hb | false => h1
      let h := Nat.mod (Nat.add h2 (hashTerm saltPrev z)) 1073741789
      let val := lookupPrev h
      let cidx := Nat.div val nSym
      let g := symG (Nat.mod val nSym)
      match Nat.blt cidx totPrev with
      | false => false
      | true =>
        let nxt := childList ws a b z ka kb
        natPerm (match Nat.beq g 0 with | true => nxt | false => mapAct g nxt) (getStPrev cidx)

def checkOp (dm req saltPrev nSym totPrev slack : Nat)
    (symG : Nat → Nat) (getStPrev : Nat → List Nat) (lookupPrev : Nat → Nat)
    (ws : List Nat) (hints : List HintRec) (bl : Nat)
    (a sa ha : Nat) (ya : List Nat) (b sb hb : Nat) (yb : List Nat)
    (uRest hRest : Nat) (op : Bool) : Bool :=
  let z := binOp op a b
  match Nat.beq z 0 with
  | true => true
  | false =>
    match Nat.beq z dm with
    | true => true
    | false =>
      let inWs := match Nat.beq (Nat.land bl (bloomBit z)) 0 with | true => false | false => natMem z ws
      match inWs with
      | true => true
      | false =>
        let sz := sep z
        let cc := checkChild req saltPrev nSym totPrev symG getStPrev lookupPrev
          ws hints a sa ha ya b sb hb yb uRest hRest z sz
        match slack with
        | 0 => cc false false true
        | 1 =>
          match cc false false false with
          | false => false
          | true =>
            match cc true false true with
            | false => false
            | true => cc false true true
        | 2 =>
          match cc false false false with
          | false => false
          | true =>
            match cc true false false with
            | false => false
            | true =>
              match cc false true false with
              | false => false
              | true => cc true true true
        | _ =>
          match cc false false false with
          | false => false
          | true =>
            match cc true false false with
            | false => false
            | true =>
              match cc false true false with
              | false => false
              | true => cc true true false

def loopInner (dm req saltPrev nSym totPrev slack : Nat)
    (symG : Nat → Nat) (getStPrev : Nat → List Nat) (lookupPrev : Nat → Nat)
    (ws : List Nat) (hints : List HintRec) (bl : Nat)
    (a sa ha : Nat) (ya : List Nat) (uPre hTot : Nat) : Nat → List WRec → Bool
  | _, [] => true
  | uMid, (b, sb, hb, sufSepB, yb) :: rest =>
    let uRest := Nat.lor uPre (Nat.lor uMid sufSepB)
    let hRest := Nat.sub (Nat.sub hTot ha) hb
    match checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
          ws hints bl a sa ha ya b sb hb yb uRest hRest false with
    | false => false
    | true =>
      match checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya b sb hb yb uRest hRest true with
      | false => false
      | true => loopInner dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya uPre hTot (Nat.lor uMid sb) rest

def loopOuter (dm req saltPrev nSym totPrev slack : Nat)
    (symG : Nat → Nat) (getStPrev : Nat → List Nat) (lookupPrev : Nat → Nat)
    (ws : List Nat) (hints : List HintRec) (bl hTot : Nat) : Nat → List WRec → Bool
  | _, [] => true
  | uPre, (a, sa, ha, _, ya) :: rest =>
    match loopInner dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
          ws hints bl a sa ha ya uPre hTot 0 rest with
    | false => false
    | true => loopOuter dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
          ws hints bl hTot (Nat.lor uPre sa) rest

def checkStep (pm nm s saltPrev nSym totPrev : Nat)
    (symG : Nat → Nat) (getStPrev : Nat → List Nat) (lookupPrev : Nat → Nat)
    (ws : List Nat) (hHdr : Nat) : Bool :=
  match natNodup ws with
  | false => false
  | true =>
    match natMem pm ws with
    | true => false
    | false =>
      let m := ws.length
      match Nat.blt (Nat.add s 1) m with
      | true => false
      | false =>
        let slack := Nat.sub (Nat.add s 1) m
        let dm := dmOf pm nm
        let req := reqCov pm nm
        let hints := loadHints pm ws (Nat.shiftRight hHdr 4) (Nat.land hHdr 15)
        let (recs, _, hTot, bl) := buildWRecs saltPrev hints ws
        loopOuter dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev ws hints bl hTot 0 recs

-- Soundness of incremental helpers & checkStep
private lemma sumYzList_eq_sum (a b c d12 e12 f12 : Nat) {ws : List Nat} (hnd : ws.Nodup) :
    sumYzList a b c d12 e12 f12 ws = ws.toFinset.sum (yz a b c d12 e12 f12) := by
  induction ws with
  | nil => simp [sumYzList]
  | cons w rest ih =>
    rw [List.nodup_cons] at hnd
    simp only [sumYzList, natAdd_eq, List.toFinset_cons]
    rw [Finset.sum_insert (by simpa using hnd.1), ih hnd.2]

private lemma sumYzList_erase (a b c d12 e12 f12 x : Nat) {ws : List Nat} (hx : x ∈ ws) :
    sumYzList a b c d12 e12 f12 (natErase x ws) + yz a b c d12 e12 f12 x =
    sumYzList a b c d12 e12 f12 ws := by
  induction ws with
  | nil => cases hx
  | cons w rest ih =>
    simp only [natErase, sumYzList, natAdd_eq]
    by_cases h : x = w
    · subst h; simp only [natBeq_refl]; omega
    · simp only [natBeq_false h, sumYzList, natAdd_eq]
      have hx' : x ∈ rest := (List.mem_cons.mp hx).resolve_left h
      have := ih hx'
      omega

private lemma loadHints_valid (pm : Nat) (ws : List Nat) (start len : Nat) :
    ∀ hr ∈ loadHints pm ws start len,
      pm.testBit hr.1 = true ∧ pm.testBit hr.2.1 = true ∧ pm.testBit hr.2.2.1 = true ∧
      12 ≤ hr.2.2.2.1 ∧ 12 ≤ hr.2.2.2.2.1 ∧ 12 ≤ hr.2.2.2.2.2.1 ∧
      hr.2.2.2.2.2.2 = sumYzList hr.1 hr.2.1 hr.2.2.1 hr.2.2.2.1 hr.2.2.2.2.1 hr.2.2.2.2.2.1 ws := by
  induction len generalizing start with
  | zero => intro hr hm; simp [loadHints] at hm
  | succ k ih =>
    intro hr hm
    simp only [loadHints] at hm
    set tc := getTup (getFlatHint start)
    set a := Nat.land tc 15
    set b := Nat.land (Nat.shiftRight tc 4) 15
    set c := Nat.land (Nat.shiftRight tc 8) 15
    set d12 := Nat.add 12 (Nat.land (Nat.shiftRight tc 12) 15)
    set e12 := Nat.add 12 (Nat.land (Nat.shiftRight tc 16) 15)
    set f12 := Nat.add 12 (Nat.land (Nat.shiftRight tc 20) 15)
    have hb_imp : ∀ x, Nat.beq (bitN pm x) 1 = true → pm.testBit x = true := by
      intro x hx
      rw [bitN_eq] at hx
      cases ht : pm.testBit x <;> simp [ht] at hx ⊢
    cases ha : Nat.beq (bitN pm a) 1
    · rw [ha] at hm; exact ih (Nat.add start 1) hr hm
    · rw [ha] at hm
      cases hb : Nat.beq (bitN pm b) 1
      · rw [hb] at hm; exact ih (Nat.add start 1) hr hm
      · rw [hb] at hm
        cases hc : Nat.beq (bitN pm c) 1
        · rw [hc] at hm; exact ih (Nat.add start 1) hr hm
        · rw [hc] at hm
          rcases List.mem_cons.mp hm with rfl | hm'
          · refine ⟨hb_imp a ha, hb_imp b hb, hb_imp c hc, ?_, ?_, ?_, rfl⟩ <;>
              (dsimp only [d12, e12, f12]; rw [natAdd_eq]; omega)
          · exact ih (Nat.add start 1) hr hm'

private lemma checkHintsInc_sound (pm : Nat) {ws : List Nat} {a b z : Nat} {ka kb : Bool}
    (ha : a ∈ ws) (hb : b ∈ ws) (hab : a ≠ b)
    (hints : List HintRec)
    (hvalid : ∀ hr ∈ hints,
      pm.testBit hr.1 = true ∧ pm.testBit hr.2.1 = true ∧ pm.testBit hr.2.2.1 = true ∧
      12 ≤ hr.2.2.2.1 ∧ 12 ≤ hr.2.2.2.2.1 ∧ 12 ≤ hr.2.2.2.2.2.1 ∧
      hr.2.2.2.2.2.2 = sumYzList hr.1 hr.2.1 hr.2.2.1 hr.2.2.2.1 hr.2.2.2.2.1 hr.2.2.2.2.2.1 ws)
    (hchk : checkHintsInc hints (evalHintsW hints a) (evalHintsW hints b) ka kb z = true) :
    ∃ (ta tb tc td te tf : Nat),
      pm.testBit ta = true ∧ pm.testBit tb = true ∧ pm.testBit tc = true ∧
      12 ≤ td ∧ 12 ≤ te ∧ 12 ≤ tf ∧
      sumYzList ta tb tc td te tf (childList ws a b z ka kb) < 3 := by
  induction hints with
  | nil => simp [checkHintsInc] at hchk
  | cons hr rest ih =>
    rcases hr with ⟨ta, tb, tc, td, te, tf, yTot⟩
    simp only [evalHintsW, checkHintsInc] at hchk
    have hv := hvalid _ (List.mem_cons_self)
    dsimp only at hv
    have hblt : Nat.blt (Nat.add (match (generalizing := false) kb with | true => (match (generalizing := false) ka with | true => yTot | false => Nat.sub yTot (yz ta tb tc td te tf a)) | false => Nat.sub (match (generalizing := false) ka with | true => yTot | false => Nat.sub yTot (yz ta tb tc td te tf a)) (yz ta tb tc td te tf b)) (yz ta tb tc td te tf z)) 3 = true ∨
        checkHintsInc rest (evalHintsW rest a) (evalHintsW rest b) ka kb z = true := by
      cases h1 : Nat.blt _ 3
      · rw [h1] at hchk
        exact Or.inr hchk
      · exact Or.inl rfl
    rcases hblt with hlt | hrest
    · refine ⟨ta, tb, tc, td, te, tf, hv.1, hv.2.1, hv.2.2.1, hv.2.2.2.1, hv.2.2.2.2.1, hv.2.2.2.2.2.1, ?_⟩
      have hlt' : (match (generalizing := false) kb with | true => (match (generalizing := false) ka with | true => yTot | false => yTot - yz ta tb tc td te tf a) | false => (match (generalizing := false) ka with | true => yTot | false => yTot - yz ta tb tc td te tf a) - yz ta tb tc td te tf b) +
          yz ta tb tc td te tf z < 3 := natLt_of_blt hlt
      have hyTot : yTot = sumYzList ta tb tc td te tf ws := hv.2.2.2.2.2.2
      have heq1 : sumYzList ta tb tc td te tf (match (generalizing := false) ka with | true => ws | false => natErase a ws) =
          (match (generalizing := false) ka with | true => yTot | false => yTot - yz ta tb tc td te tf a) := by
        cases ka
        · dsimp only
          have hs := sumYzList_erase ta tb tc td te tf a ha
          omega
        · exact hyTot.symm
      have hb_in : b ∈ (match (generalizing := false) ka with | true => ws | false => natErase a ws) := by
        cases ka
        · exact natErase_mem_of_ne hab.symm hb
        · exact hb
      have heq2 : sumYzList ta tb tc td te tf (let l1 := match (generalizing := false) ka with | true => ws | false => natErase a ws; match (generalizing := false) kb with | true => l1 | false => natErase b l1) =
          (match (generalizing := false) kb with | true => (match (generalizing := false) ka with | true => yTot | false => yTot - yz ta tb tc td te tf a) | false => (match (generalizing := false) ka with | true => yTot | false => yTot - yz ta tb tc td te tf a) - yz ta tb tc td te tf b) := by
        cases kb
        · dsimp only
          have hs := sumYzList_erase ta tb tc td te tf b hb_in
          omega
        · exact heq1
      simp only [childList, sumYzList, natAdd_eq]
      dsimp only at heq2
      omega
    · exact ih (fun x hx => hvalid x (List.mem_cons_of_mem _ hx)) hrest

private lemma unionSep_perm {l1 l2 : List Nat} (hp : l1.Perm l2) : unionSep l1 = unionSep l2 := by
  induction hp with
  | nil => rfl
  | cons x _ ih => simp [unionSep, ih]
  | swap x y l =>
    simp only [unionSep, natLor_eq]
    rw [← Nat.or_assoc, Nat.or_comm (sep y) (sep x), Nat.or_assoc]
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

private lemma buildWRecs_sep (salt : Nat) (hints : List HintRec) (l : List Nat) :
    (buildWRecs salt hints l).2.1 = unionSep l := by
  induction l with
  | nil => rfl
  | cons y ys ih => simp [buildWRecs, unionSep, ih]

private lemma loopOuter_pair {dm req saltPrev nSym totPrev slack : Nat}
    {symG : Nat → Nat} {getStPrev : Nat → List Nat} {lookupPrev : Nat → Nat}
    {ws : List Nat} {hints : List HintRec} {bl hTot : Nat} :
    ∀ (l : List Nat) (uPre : Nat),
      loopOuter dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev ws hints bl hTot uPre (buildWRecs saltPrev hints l).1 = true →
      ∀ (l1 l2 l3 : List Nat) (a b : Nat),
        l = l1 ++ a :: (l2 ++ b :: l3) →
        ∀ (op : Bool),
          checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a (sep a) (hashTerm saltPrev a) (evalHintsW hints a)
            b (sep b) (hashTerm saltPrev b) (evalHintsW hints b)
            ((uPre ||| unionSep l1) ||| (unionSep l2 ||| unionSep l3))
            (hTot - hashTerm saltPrev a - hashTerm saltPrev b) op = true := by
  have hinner : ∀ (l : List Nat) (a sa ha : Nat) (ya : List Nat) (uPre uMid : Nat),
      loopInner dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev ws hints bl a sa ha ya uPre hTot uMid (buildWRecs saltPrev hints l).1 = true →
      ∀ (l2 l3 : List Nat) (b : Nat), l = l2 ++ b :: l3 →
        ∀ (op : Bool),
          checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya b (sep b) (hashTerm saltPrev b) (evalHintsW hints b)
            (uPre ||| ((uMid ||| unionSep l2) ||| unionSep l3))
            (hTot - ha - hashTerm saltPrev b) op = true := by
    intro l
    induction l with
    | nil =>
      intro _ _ _ _ _ _ _ l2 l3 b hnil
      cases l2 <;> simp at hnil
    | cons x rest ih =>
      intro a sa ha ya uPre uMid hloop l2 l3 b hcons op
      unfold buildWRecs at hloop
      unfold loopInner at hloop
      simp only [natLor_eq, natSub_eq] at hloop
      have hf : checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya x (sep x) (hashTerm saltPrev x) (evalHintsW hints x)
            (uPre ||| (uMid ||| (buildWRecs saltPrev hints rest).2.1))
            (hTot - ha - hashTerm saltPrev x) false = true ∧
          checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya x (sep x) (hashTerm saltPrev x) (evalHintsW hints x)
            (uPre ||| (uMid ||| (buildWRecs saltPrev hints rest).2.1))
            (hTot - ha - hashTerm saltPrev x) true = true ∧
          loopInner dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya uPre hTot (uMid ||| sep x) (buildWRecs saltPrev hints rest).1 = true := by
        cases c0 : checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya x (sep x) (hashTerm saltPrev x) (evalHintsW hints x)
            (uPre ||| (uMid ||| (buildWRecs saltPrev hints rest).2.1))
            (hTot - ha - hashTerm saltPrev x) false
        · rw [c0] at hloop; cases hloop
        cases c1 : checkOp dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
            ws hints bl a sa ha ya x (sep x) (hashTerm saltPrev x) (evalHintsW hints x)
            (uPre ||| (uMid ||| (buildWRecs saltPrev hints rest).2.1))
            (hTot - ha - hashTerm saltPrev x) true
        · rw [c0, c1] at hloop; cases hloop
        rw [c0, c1] at hloop
        exact ⟨rfl, rfl, hloop⟩
      cases l2 with
      | nil =>
        simp only [List.nil_append, List.cons.injEq] at hcons
        rcases hcons with ⟨rfl, rfl⟩
        rw [buildWRecs_sep] at hf
        simp only [unionSep, Nat.or_zero]
        cases op
        · exact hf.1
        · exact hf.2.1
      | cons y l2' =>
        simp only [List.cons_append, List.cons.injEq] at hcons
        rcases hcons with ⟨rfl, hrest⟩
        have hrec := ih a sa ha ya uPre (uMid ||| sep x) hf.2.2 l2' l3 b hrest op
        simpa only [unionSep, natLor_eq, Nat.or_assoc] using hrec
  intro l
  induction l with
  | nil =>
    intro _ _ l1 _ _ _ _ hnil
    cases l1 <;> simp at hnil
  | cons x rest ih =>
    intro uPre hloop l1 l2 l3 a b hcons op
    unfold buildWRecs at hloop
    unfold loopOuter at hloop
    simp only [natLor_eq] at hloop
    have hf : loopInner dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
          ws hints bl x (sep x) (hashTerm saltPrev x) (evalHintsW hints x) uPre hTot 0 (buildWRecs saltPrev hints rest).1 = true ∧
        loopOuter dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
          ws hints bl hTot (uPre ||| sep x) (buildWRecs saltPrev hints rest).1 = true := by
      cases c0 : loopInner dm req saltPrev nSym totPrev slack symG getStPrev lookupPrev
          ws hints bl x (sep x) (hashTerm saltPrev x) (evalHintsW hints x) uPre hTot 0 (buildWRecs saltPrev hints rest).1
      · rw [c0] at hloop; cases hloop
      rw [c0] at hloop
      exact ⟨rfl, hloop⟩
    cases l1 with
    | nil =>
      simp only [List.nil_append, List.cons.injEq] at hcons
      rcases hcons with ⟨rfl, rfl⟩
      have hres := hinner (l2 ++ b :: l3) x (sep x) (hashTerm saltPrev x) (evalHintsW hints x) uPre 0 hf.1 l2 l3 b rfl op
      simpa only [unionSep, Nat.or_zero, Nat.zero_or] using hres
    | cons y l1' =>
      simp only [List.cons_append, List.cons.injEq] at hcons
      rcases hcons with ⟨rfl, hrest⟩
      have hres := ih (uPre ||| sep x) hf.2 l1' l2 l3 a b hrest op
      simpa only [unionSep, natLor_eq, Nat.or_assoc] using hres

private lemma mem_split_pair {l : List Nat} {a b : Nat} (ha : a ∈ l) (hb : b ∈ l) (hab : a ≠ b) :
    (∃ l1 l2 l3, l = l1 ++ a :: (l2 ++ b :: l3)) ∨ (∃ l1 l2 l3, l = l1 ++ b :: (l2 ++ a :: l3)) := by
  induction l with
  | nil => cases ha
  | cons x xs ih =>
    rcases List.mem_cons.mp ha with rfl | ha'
    · rcases List.mem_cons.mp hb with hba | hb'
      · exact absurd hba.symm hab
      · obtain ⟨l2, l3, rfl⟩ := List.append_of_mem hb'
        exact Or.inl ⟨[], l2, l3, rfl⟩
    · rcases List.mem_cons.mp hb with rfl | hb'
      · obtain ⟨l2, l3, rfl⟩ := List.append_of_mem ha'
        exact Or.inr ⟨[], l2, l3, rfl⟩
      · rcases ih ha' hb' with ⟨l1, l2, l3, rfl⟩ | ⟨l1, l2, l3, rfl⟩
        · exact Or.inl ⟨x :: l1, l2, l3, rfl⟩
        · exact Or.inr ⟨x :: l1, l2, l3, rfl⟩

private lemma unionSep_append (l1 l2 : List Nat) :
    unionSep (l1 ++ l2) = unionSep l1 ||| unionSep l2 := by
  induction l1 with
  | nil => simp [unionSep]
  | cons x xs ih => simp [unionSep, ih, Nat.or_assoc]

private lemma childList_perm_split {l1 l2 l3 : List Nat} {a b z : Nat} {ka kb : Bool}
    (hnd : (l1 ++ a :: (l2 ++ b :: l3)).Nodup) :
    (childList (l1 ++ a :: (l2 ++ b :: l3)) a b z ka kb).Perm
      (z :: ((if ka then [a] else []) ++ (if kb then [b] else []) ++ l1 ++ l2 ++ l3)) := by
  set ws := l1 ++ a :: (l2 ++ b :: l3)
  have hp0 : ws.Perm (a :: b :: (l1 ++ l2 ++ l3)) := by
    have p1 : ws.Perm (a :: (l1 ++ (l2 ++ b :: l3))) := List.perm_middle
    have p2 : (l1 ++ (l2 ++ b :: l3)).Perm (b :: (l1 ++ l2 ++ l3)) := by
      rw [← List.append_assoc]; exact List.perm_middle
    exact p1.trans (p2.cons a)
  have hnd0 : (a :: b :: (l1 ++ l2 ++ l3)).Nodup := hp0.nodup_iff.mp hnd
  have ha_in : a ∈ ws := by simp [ws]
  have hb_in : b ∈ ws := by simp [ws]
  have hab : a ≠ b := by
    rw [List.nodup_cons] at hnd0
    intro h; subst h; exact hnd0.1 (List.mem_cons_self)
  have hl1 : (match ka with | true => ws | false => natErase a ws).Perm ((if ka then [a] else []) ++ b :: (l1 ++ l2 ++ l3)) := by
    cases ka
    · simp only [Bool.false_eq_true, ↓reduceIte, List.nil_append]
      have h1 := natErase_perm ha_in
      exact List.Perm.cons_inv (h1.trans hp0)
    · simpa using hp0
  have hb_in1 : b ∈ (match ka with | true => ws | false => natErase a ws) := by
    cases ka
    · exact natErase_mem_of_ne hab.symm hb_in
    · exact hb_in
  have hl2 : (let l1' := match ka with | true => ws | false => natErase a ws; match kb with | true => l1' | false => natErase b l1').Perm
      ((if ka then [a] else []) ++ (if kb then [b] else []) ++ l1 ++ l2 ++ l3) := by
    cases kb
    · simp only [Bool.false_eq_true, ↓reduceIte]
      have h1 := natErase_perm hb_in1
      have hp_b : ((if ka then [a] else []) ++ b :: (l1 ++ l2 ++ l3)).Perm (b :: ((if ka then [a] else []) ++ (l1 ++ l2 ++ l3))) :=
        List.perm_middle
      have h2 := List.Perm.cons_inv (h1.trans (hl1.trans hp_b))
      simpa [List.append_assoc] using h2
    · simpa [List.append_assoc] using hl1
  exact hl2.cons z

private lemma childList_toFinset {ws : List Nat} {U : Finset Nat} {a b z : Nat}
    (hnd : ws.Nodup) (hS : ws.toFinset = insert a (insert b U)) (hab : a ≠ b) :
    (childList ws a b z (decide (a ∈ U)) (decide (b ∈ U))).toFinset = insert z U := by
  have h1 : (match decide (a ∈ U) with | true => ws | false => natErase a ws).toFinset = insert b U := by
    by_cases haU : a ∈ U
    · simp only [decide_eq_true_eq.mpr haU, hS]
      rw [Finset.insert_eq_of_mem (Finset.mem_insert_of_mem haU)]
    · simp only [decide_eq_false haU, natErase_toFinset hnd, hS]
      rw [Finset.erase_insert (by simp [hab, haU])]
  have hnd1 : (match decide (a ∈ U) with | true => ws | false => natErase a ws).Nodup := by
    cases decide (a ∈ U)
    · exact natErase_nodup hnd
    · exact hnd
  have h2 : (let l1 := match decide (a ∈ U) with | true => ws | false => natErase a ws; match decide (b ∈ U) with | true => l1 | false => natErase b l1).toFinset = U := by
    by_cases hbU : b ∈ U
    · simp only [decide_eq_true_eq.mpr hbU, h1]
      exact Finset.insert_eq_of_mem hbU
    · simp only [decide_eq_false hbU, natErase_toFinset hnd1, h1]
      exact Finset.erase_insert hbU
  simp only [childList, List.toFinset_cons, h2]

private lemma childList_nodup {ws : List Nat} {a b z : Nat} {ka kb : Bool}
    (hnd : ws.Nodup) (hz : z ∉ ws) :
    (childList ws a b z ka kb).Nodup := by
  have hnd1 : (match ka with | true => ws | false => natErase a ws).Nodup := by
    cases ka
    · exact natErase_nodup hnd
    · exact hnd
  have hz1 : z ∉ (match ka with | true => ws | false => natErase a ws) := by
    cases ka
    · intro hm; exact hz (natErase_sub hm)
    · exact hz
  have hnd2 : (let l1 := match ka with | true => ws | false => natErase a ws; match kb with | true => l1 | false => natErase b l1).Nodup := by
    cases kb
    · exact natErase_nodup hnd1
    · exact hnd1
  have hz2 : z ∉ (let l1 := match ka with | true => ws | false => natErase a ws; match kb with | true => l1 | false => natErase b l1) := by
    cases kb
    · intro hm; exact hz1 (natErase_sub hm)
    · exact hz1
  exact List.nodup_cons.mpr ⟨hz2, hnd2⟩

private lemma stepOk_sound {pm nm s saltPrev nSym totPrev : Nat}
    {symG : Nat → Nat} {getStPrev : Nat → List Nat} {lookupPrev : Nat → Nat}
    {ws : List Nat} {hHdr : Nat}
    (hpm : pm < 4096) (hnm : nm < 4096)
    (hsym : ∀ k < nSym, symG k < 12 ∧ act (symG k) pm = pm ∧ act (symG k) (dmOf pm nm) = dmOf pm nm)
    (hprev : ∀ i < totPrev, ∀ m ≤ s - 1, ¬ MLive pm nm m (getStPrev i).toFinset)
    (hchk : checkStep pm nm s saltPrev nSym totPrev symG getStPrev lookupPrev ws hHdr = true)
    (hnSym : 0 < nSym) :
    ∀ m ≤ s, ¬ MLive pm nm m ws.toFinset := by
  unfold checkStep at hchk
  dsimp only at hchk
  cases hndB : natNodup ws
  · rw [hndB] at hchk; cases hchk
  cases hpmM : natMem pm ws
  swap
  · rw [hndB, hpmM] at hchk; cases hchk
  cases hlenB : Nat.blt (Nat.add s 1) ws.length
  swap
  · rw [hndB, hpmM, hlenB] at hchk; cases hchk
  rw [hndB, hpmM, hlenB] at hchk
  have hnd : ws.Nodup := natNodup_sound hndB
  have hpmNot : pm ∉ ws := fun hm => by rw [(natMem_iff pm ws).mpr hm] at hpmM; cases hpmM
  have hlenLe : ws.length ≤ s + 1 := by
    have : ¬ (s + 1 < ws.length) := fun h => by
      have : Nat.blt (Nat.add s 1) ws.length = true := Nat.blt_eq.mpr h
      rw [this] at hlenB; cases hlenB
    omega
  intro m hm hlive
  cases m with
  | zero =>
    obtain ⟨hS, _⟩ := hlive
    have : pm ∈ ws.toFinset := by rw [hS]; exact Finset.mem_singleton_self pm
    exact hpmNot (List.mem_toFinset.mp this)
  | succ m' =>
    obtain ⟨U, a0, b0, op, hS, ha0p, hb0p, hab0, hzp, hfresh, tail⟩ := hlive
    have ha0 : a0 ∈ ws := List.mem_toFinset.mp (by rw [hS]; exact Finset.mem_insert_self _ _)
    have hb0 : b0 ∈ ws := List.mem_toFinset.mp (by rw [hS]; exact Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
    have hsplit : ∃ a b l1 l2 l3, ws = l1 ++ a :: (l2 ++ b :: l3) ∧
        ws.toFinset = insert a (insert b U) ∧ a ≠ b ∧ binOp op a b = binOp op a0 b0 := by
      rcases mem_split_pair ha0 hb0 hab0 with ⟨l1, l2, l3, hws⟩ | ⟨l1, l2, l3, hws⟩
      · exact ⟨a0, b0, l1, l2, l3, hws, hS, hab0, rfl⟩
      · exact ⟨b0, a0, l1, l2, l3, hws, by rw [hS, Finset.insert_comm], hab0.symm, binOp_comm op b0 a0⟩
    obtain ⟨a, b, l1, l2, l3, hws, hSab, hab, hzeq⟩ := hsplit
    set z := binOp op a b
    have hzp' : properS (dmOf pm nm) z := hzeq ▸ hzp
    have hfresh' : z ∉ ws := by
      intro hm
      have : z ∈ insert a0 (insert b0 U) := by rw [← hS]; exact List.mem_toFinset.mpr hm
      exact hfresh (hzeq ▸ this)
    set slack := Nat.sub (Nat.add s 1) ws.length
    set hints := loadHints pm ws (Nat.shiftRight hHdr 4) (Nat.land hHdr 15)
    have hpair := loopOuter_pair ws 0 hchk l1 l2 l3 a b hws op
    unfold checkOp at hpair
    dsimp only at hpair
    have hz0 : Nat.beq z 0 = false := natBeq_false hzp'.2.1
    have hzd : Nat.beq z (dmOf pm nm) = false := natBeq_false hzp'.2.2
    have hzm : natMem z ws = false := by
      cases hm : natMem z ws
      · rfl
      · exact absurd ((natMem_iff z ws).mp hm) hfresh'
    have hinWs : (match Nat.beq (Nat.land (buildWRecs saltPrev hints ws).2.2.2 (bloomBit z)) 0 with | true => false | false => natMem z ws) = false := by
      cases Nat.beq (Nat.land (buildWRecs saltPrev hints ws).2.2.2 (bloomBit z)) 0 <;> simp [hzm]
    rw [hz0, hzd, hinWs] at hpair
    set ka := decide (a ∈ U)
    set kb := decide (b ∈ U)
    set nxt := childList ws a b z ka kb
    have hnxt_fin : nxt.toFinset = insert z U := childList_toFinset hnd hSab hab
    have hnxt_nd : nxt.Nodup := childList_nodup hnd hfresh'
    have htail' : MLive pm nm m' nxt.toFinset := by rw [hnxt_fin, hzeq]; exact tail
    have hcard_nxt : nxt.length = ws.length - 1 + (if ka then 1 else 0) + (if kb then 1 else 0) := by
      have hp := childList_perm_split (l1 := l1) (l2 := l2) (l3 := l3) (a := a) (b := b) (z := z) (ka := ka) (kb := kb) (hws ▸ hnd)
      rw [← hws] at hp
      have hl_nxt := hp.length_eq
      have hl_ws : ws.length = l1.length + l2.length + l3.length + 2 := by
        rw [hws]; simp; omega
      simp only [List.length_cons, List.length_append] at hl_nxt
      have hlen_ite : ∀ (c : Bool) (v : Nat), (if c then [v] else ([] : List Nat)).length = if c then 1 else 0 := by
        intro c v; cases c <;> rfl
      rw [hlen_ite ka a, hlen_ite kb b] at hl_nxt
      change (childList ws a b z ka kb).length = _
      omega
    have hcard_le : nxt.length ≤ m' + 1 := by
      have hc := mlive_card htail'
      rw [List.toFinset_card_of_nodup hnxt_nd] at hc
      exact hc
    have hksum_le : (if ka then 1 else 0) + (if kb then 1 else 0) ≤ slack := by
      have hws2 : 2 ≤ ws.length := by rw [hws]; simp; omega
      change (if ka then 1 else 0) + (if kb then 1 else 0) ≤ s + 1 - ws.length
      omega
    set uRest := (0 ||| unionSep l1) ||| (unionSep l2 ||| unionSep l3)
    set hRest := (buildWRecs saltPrev hints ws).2.2.1 - hashTerm saltPrev a - hashTerm saltPrev b
    set cc := checkChild (reqCov pm nm) saltPrev nSym totPrev symG getStPrev lookupPrev
      ws hints a (sep a) (hashTerm saltPrev a) (evalHintsW hints a)
      b (sep b) (hashTerm saltPrev b) (evalHintsW hints b) uRest hRest z (sep z)
    set isTight := decide ((if ka then 1 else 0) + (if kb then 1 else 0) = slack)
    have hcc : cc ka kb isTight = true := by
      have hks : ∀ (ca cb : Bool), (if ca then 1 else 0) + (if cb then 1 else 0) ≤ slack →
          cc ca cb (decide ((if ca then 1 else 0) + (if cb then 1 else 0) = slack)) = true := by
        intro ca cb hle
        cases hsk : slack with
        | zero =>
          rw [hsk] at hpair hle
          cases ca <;> cases cb
          · exact hpair
          · simp at hle
          · simp at hle
          · simp at hle
        | succ n1 =>
          cases n1 with
          | zero =>
            rw [hsk] at hpair hle
            cases ca <;> cases cb
            · change cc false false false = true
              cases c00 : cc false false false
              · rw [c00] at hpair; cases hpair
              · rfl
            · change cc false true true = true
              cases c00 : cc false false false
              · rw [c00] at hpair; cases hpair
              cases c10 : cc true false true
              · rw [c00, c10] at hpair; cases hpair
              rw [c00, c10] at hpair; exact hpair
            · change cc true false true = true
