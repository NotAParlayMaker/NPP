-- Generic level induction
private lemma level_ind {pm nm K nSym : Nat}
    {symG : Nat → Nat} {stepCnt totCnt salt : Nat → Nat}
    {getState : Nat → Nat → List Nat} {getHintHdr : Nat → Nat → Nat} {lookupH : Nat → Nat → Nat}
    (hpm : pm < 4096) (hnm : nm < 4096) (hnSym : 0 < nSym)
    (hsym : ∀ k < nSym, symG k < 12 ∧ act (symG k) pm = pm ∧ act (symG k) (dmOf pm nm) = dmOf pm nm)
    (hzero : totCnt 0 = 0)
    (hstep : ∀ s, 1 ≤ s → s ≤ K → ∀ i < stepCnt s,
      checkStep pm nm s (salt (s - 1)) nSym (totCnt (s - 1)) symG (getState (s - 1)) (lookupH (s - 1))
        (getState s i) (getHintHdr s i) = true)
    (hpc : ∀ s, 1 ≤ s → s ≤ K → ∀ i, stepCnt s ≤ i → i < totCnt s →
      ∀ m ≤ s, ¬ MLive pm nm m (getState s i).toFinset) :
    ∀ s ≤ K, ∀ i < totCnt s, ∀ m ≤ s, ¬ MLive pm nm m (getState s i).toFinset := by
  intro s
  induction s with
  | zero =>
    intro _ i hi
    rw [hzero] at hi; omega
  | succ s ih =>
    intro hsK i hi m hm
    by_cases hist : i < stepCnt (s + 1)
    · exact stepOk_sound hpm hnm hsym (ih (by omega))
        (hstep (s + 1) (by omega) hsK i hist) hnSym m hm
    · exact hpc (s + 1) (by omega) hsK i (by omega) hi m hm

-- Subset -> decodeRaw
private lemma subset_decodeRaw (L : List Nat) (S : Finset Nat) (hsub : S ⊆ L.toFinset) :
    ∃ mask < 2 ^ L.length, S = (decodeRaw L mask).toFinset := by
  induction L generalizing S with
  | nil =>
    refine ⟨0, by simp, ?_⟩
    simp only [List.toFinset_nil, Finset.subset_empty] at hsub
    simp [hsub, decodeRaw]
  | cons a rest ih =>
    have hsub' : S.erase a ⊆ rest.toFinset := by
      intro x hx
      obtain ⟨hne, hxS⟩ := Finset.mem_erase.mp hx
      have hm := hsub hxS
      simp only [List.toFinset_cons, Finset.mem_insert] at hm
      exact hm.resolve_left hne
    obtain ⟨m', hm', heq⟩ := ih (S.erase a) hsub'
    by_cases ha : a ∈ S
    · refine ⟨2 * m' + 1, by simp [Nat.pow_succ]; omega, ?_⟩
      simp only [decodeRaw, natLand_eq, natShr_eq]
      have h1 : (2 * m' + 1) &&& 1 = 1 := by
        rw [show (1 : Nat) = 2 ^ 1 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]; omega
      have h2 : (2 * m' + 1) >>> 1 = m' := by
        rw [Nat.shiftRight_eq_div_pow]; omega
      rw [h1, h2]
      simp only [List.toFinset_cons, ← heq, Finset.insert_erase ha]
    · refine ⟨2 * m', by simp [Nat.pow_succ]; omega, ?_⟩
      simp only [decodeRaw, natLand_eq, natShr_eq]
      have h1 : (2 * m') &&& 1 = 0 := by
        rw [show (1 : Nat) = 2 ^ 1 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod]; omega
      have h2 : (2 * m') >>> 1 = m' := by
        rw [Nat.shiftRight_eq_div_pow]; omega
      rw [h1, h2]
      simp only [← heq, Finset.erase_eq_of_notMem ha]

-- Root checker helper
def checkRootMask (pm nm nSym totS saltS : Nat) (symG : Nat → Nat)
    (getStS : Nat → List Nat) (lookupS : Nat → Nat) (base : List Nat) (mask : Nat) : Bool :=
  let ws := decodeRaw base mask
  let req := reqCov pm nm
  match Nat.beq (Nat.land (unionSep ws) req) req with
  | false => true
  | true =>
    let val := lookupS (hashState saltS ws)
    let cidx := Nat.div val nSym
    let g := symG (Nat.mod val nSym)
    match Nat.blt cidx totS with
    | false => false
    | true => natPerm (mapAct g ws) (getStS cidx)

private lemma checkRootMask_sound {pm nm s nSym totS saltS : Nat}
    {symG : Nat → Nat} {getStS : Nat → List Nat} {lookupS : Nat → Nat} {base : List Nat}
    (hpm : pm < 4096) (hnm : nm < 4096) (hnSym : 0 < nSym)
    (hsym : ∀ k < nSym, symG k < 12 ∧ act (symG k) pm = pm ∧ act (symG k) (dmOf pm nm) = dmOf pm nm)
    (hdead : ∀ i < totS, ∀ m ≤ s, ¬ MLive pm nm m (getStS i).toFinset)
    (hchk : ∀ mask < 2 ^ base.length, checkRootMask pm nm nSym totS saltS symG getStS lookupS base mask = true) :
    ∀ S ⊆ base.toFinset, ∀ m ≤ s, ¬ MLive pm nm m S := by
  intro S hsub m hm hlive
  obtain ⟨mask, hmask, rfl⟩ := subset_decodeRaw base S hsub
  have hc := hchk mask hmask
  unfold checkRootMask at hc
  dsimp only at hc
  set ws := decodeRaw base mask
  have hcov : Nat.beq (Nat.land (unionSep ws) (reqCov pm nm)) (reqCov pm nm) = true :=
    (natBeq_iff _ _).mpr (mlive_cov hlive hpm hnm)
  rw [hcov] at hc
  set val := lookupS (hashState saltS ws)
  set cidx := Nat.div val nSym
  set gidx := Nat.mod val nSym
  cases hlt : Nat.blt cidx totS
  · rw [hlt] at hc; cases hc
  · rw [hlt] at hc
    obtain ⟨hg12, hgp, hgd⟩ := hsym gidx (Nat.mod_lt val hnSym)
    have hact := mlive_act hg12 hpm hnm hgp hgd hlive
    have hperm := natPerm_sound hc
    have hfe : (getStS cidx).toFinset = ws.toFinset.image (act (symG gidx)) := by
      rw [← mapAct_toFinset]; exact perm_toFinset hperm.symm
    rw [← hfe] at hact
    exact hdead cidx (natLt_of_blt hlt) m hm hact

