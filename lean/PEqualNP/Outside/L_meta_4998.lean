def rows24 : List Nat :=
  [3, 6, 12, 24, 17, 33, 66, 132, 264, 160, 320, 288,
   42, 50, 69, 104, 116, 138, 201, 208, 261, 276, 385, 402]

def initWires : List Nat := BF_raw ++ [0x56d13d]

def gvN (w : List Nat) (g : Gate) : Nat :=
  let xs := g.inputs.map (fun i => w.getD i 0)
  match g.op with
  | GateOp.and => xs.foldr Nat.land 0xffffff
  | GateOp.or => xs.foldr Nat.lor 0
  | _ => 0

def execN (gs : List Gate) (w : List Nat) : List Nat :=
  gs.foldl (fun l g => l ++ [gvN l g]) w

private lemma bit_allN (k : Nat) (hk : k < 24) (l : List Nat) :
    (l.map fun v => v.testBit k).all id = (l.foldr Nat.land 0xffffff).testBit k := by
  induction l with
  | nil =>
    simp only [List.map_nil, List.all_nil, List.foldr_nil]
    have : (0xffffff : Nat).testBit k = true := by interval_cases k <;> decide
    exact this.symm
  | cons a as ih =>
    simp only [List.map_cons, List.all_cons, id_eq, List.foldr_cons, natLand_eq, Nat.testBit_and, ih]

private lemma bit_anyN (k : Nat) (l : List Nat) :
    (l.map fun v => v.testBit k).any id = (l.foldr Nat.lor 0).testBit k := by
  induction l with
  | nil => simp
  | cons a as ih =>
    simp only [List.map_cons, List.any_cons, id_eq, List.foldr_cons, natLor_eq, Nat.testBit_or, ih]

private lemma bit_getDN (W : List Nat) (k i : Nat) :
    (W.map fun v => v.testBit k).getD i false = (W.getD i 0).testBit k := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
  cases W[i]? <;> simp

private lemma bit_gateN (g : Gate) (hop : g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp))
    (k : Nat) (hk : k < 24) (W : List Nat) :
    g.op.eval (g.inputs.map fun i => (W.map fun v => v.testBit k).getD i false) =
    (gvN W g).testBit k := by
  rcases g with ⟨op, ins⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
  rcases hop with rfl | rfl
  · simp only [GateOp.eval, gvN, bit_getDN]
    rw [← bit_allN k hk, List.map_map]; rfl
  · simp only [GateOp.eval, gvN, bit_getDN]
    rw [← bit_anyN k, List.map_map]; rfl

private lemma bit_foldN (k : Nat) (hk : k < 24) : ∀ (gs : List Gate),
    (∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp)) → ∀ W : List Nat,
    gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
      (W.map fun v => v.testBit k) = (execN gs W).map fun v => v.testBit k := by
  intro gs
  induction gs with
  | nil => intro _ W; rfl
  | cons g gs ih =>
    intro hm W
    rw [List.foldl_cons, bit_gateN g (hm g List.mem_cons_self) k hk W]
    have e : (W.map fun v => v.testBit k) ++ [(gvN W g).testBit k] =
        (W ++ [gvN W g]).map fun v => v.testBit k := by simp
    rw [e, ih (fun g1 hg1 => hm g1 (List.mem_cons_of_mem _ hg1)) (W ++ [gvN W g])]
    rfl

private lemma gvN_lt {W : List Nat} {g : Gate} (hW : ∀ v ∈ W, v < 2 ^ 24)
    (hop : g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp)) : gvN W g < 2 ^ 24 := by
  have hget : ∀ i, W.getD i 0 < 2 ^ 24 := fun i => by
    simp only [List.getD_eq_getElem?_getD]
    cases h : W[i]? with
    | none => simp
    | some a => exact hW a (List.mem_of_getElem? h)
  rcases g with ⟨op, ins⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
  rcases hop with rfl | rfl
  · simp only [gvN]
    induction ins with
    | nil => simp only [List.map_nil, List.foldr_nil]; decide
    | cons a as ih =>
      simp only [List.map_cons, List.foldr_cons, natLand_eq]
      have hle : W.getD a 0 &&& ((as.map fun i => W.getD i 0).foldr Nat.land 0xffffff) ≤
          (as.map fun i => W.getD i 0).foldr Nat.land 0xffffff := Nat.and_le_right
      omega
  · simp only [gvN]
    induction ins with
    | nil => simp only [List.map_nil, List.foldr_nil]; decide
    | cons a as ih =>
      simp only [List.map_cons, List.foldr_cons, natLor_eq]
      exact Nat.or_lt_two_pow (hget a) ih

private lemma execN_lt {gs : List Gate} {W : List Nat}
    (hW : ∀ v ∈ W, v < 2 ^ 24)
    (hgs : ∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp)) :
    ∀ v ∈ execN gs W, v < 2 ^ 24 := by
  induction gs generalizing W with
  | nil => exact hW
  | cons g gs ih =>
    apply ih
    · intro v hv
      simp only [List.mem_append, List.mem_singleton] at hv
      rcases hv with hv | rfl
      · exact hW v hv
      · exact gvN_lt hW (hgs g List.mem_cons_self)
    · exact fun g1 hg1 => hgs g1 (List.mem_cons_of_mem _ hg1)

private lemma land_all24 {x : Nat} (hx : x < 2 ^ 24) : (x &&& 0xffffff) = x := by
  rw [show (0xffffff : Nat) = 2 ^ 24 - 1 by rfl, Nat.and_two_pow_sub_one_eq_mod, Nat.mod_eq_of_lt hx]

private lemma pull_gateN {W : List Nat} {g : Gate} {k S}
    (h : MLive 0xfff 0xfff k S)
    (hsub : ∀ w ∈ S, w ∈ W ++ [gvN W g])
    (hW : ∀ v ∈ W, v < 2 ^ 24)
    (hg : g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp) ∧ g.inputs.length ≤ 2) :
    ∃ k' S', k' ≤ k + 1 ∧ MLive 0xfff 0xfff k' S' ∧ ∀ w ∈ S', w ∈ W := by
  have hWmask : ∀ v ∈ W, (v &&& dmOf 0xfff 0xfff) = v := fun v hv => by
    show (v &&& 0xffffff) = v; exact land_all24 (hW v hv)
  have hget : ∀ i, W.getD i 0 = 0 ∨ W.getD i 0 ∈ W := fun i => by
    simp only [List.getD_eq_getElem?_getD]
    cases hq : W[i]? with
    | none => exact Or.inl rfl
    | some a => exact Or.inr (List.mem_of_getElem? hq)
  have hskip : (gvN W g = 0 ∨ gvN W g = 0xffffff ∨ gvN W g ∈ W) →
      ∃ k' S', k' ≤ k + 1 ∧ MLive 0xfff 0xfff k' S' ∧ ∀ w ∈ S', w ∈ W := by
    intro htriv
    refine ⟨k, S, by omega, h, fun w hw => ?_⟩
    rcases List.mem_append.mp (hsub w hw) with hw0 | hwg
    · exact hw0
    · rw [List.mem_singleton.mp hwg] at hw ⊢
      rcases htriv with hz | ho | hm
      · exact absurd hz (mlive_proper h _ hw).2.1
      · exact absurd ho (mlive_proper h _ hw).2.2
      · exact hm
  rcases g with ⟨op, ins⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  obtain ⟨hop, hlen⟩ := hg
  cases ins with
  | nil =>
    apply hskip
    rcases hop with rfl | rfl
    · exact Or.inr (Or.inl rfl)
    · exact Or.inl rfl
  | cons i1 ins1 =>
    cases ins1 with
    | nil =>
      apply hskip
      rcases hop with rfl | rfl
      · simp only [gvN, List.map_cons, List.map_nil, List.foldr_cons, List.foldr_nil, natLand_eq]
        rcases hget i1 with h0 | hm
        · left; rw [h0]; decide
        · right; right; rw [land_all24 (hW _ hm)]; exact hm
      · simp only [gvN, List.map_cons, List.map_nil, List.foldr_cons, List.foldr_nil, natLor_eq, Nat.or_zero]
        rcases hget i1 with h0 | hm
        · exact Or.inl h0
        · exact Or.inr (Or.inr hm)
    | cons i2 ins2 =>
      cases ins2 with
      | cons _ _ => simp at hlen
      | nil =>
        rcases hop with rfl | rfl
        · have heq : gvN W ⟨GateOp.and, [i1, i2]⟩ = binOp false (W.getD i1 0) (W.getD i2 0) := by
            simp only [gvN, List.map_cons, List.map_nil, List.foldr_cons, List.foldr_nil, binOp_false, natLand_eq]
            rcases hget i2 with h0 | hm
            · rw [h0]; simp
            · rw [land_all24 (hW _ hm)]
          rw [heq] at hsub hskip
          rcases hget i1 with h1 | hm1
          · apply hskip; left; rw [h1]; simp [binOp_false]
          rcases hget i2 with h2 | hm2
          · apply hskip; left; rw [h2]; simp [binOp_false]
          exact pull_bin h hsub hm1 hm2 hWmask
        · have heq : gvN W ⟨GateOp.or, [i1, i2]⟩ = binOp true (W.getD i1 0) (W.getD i2 0) := by
            simp only [gvN, List.map_cons, List.map_nil, List.foldr_cons, List.foldr_nil, natLor_eq, Nat.or_zero, binOp_true]
          rw [heq] at hsub hskip
          rcases hget i1 with h1 | hm1
          · apply hskip
            rcases hget i2 with h2 | hm2
            · left; rw [h1, h2]; rfl
            · right; right; rw [h1]; simpa [binOp_true] using hm2
          rcases hget i2 with h2 | hm2
          · apply hskip; right; right; rw [h2]; simpa [binOp_true] using hm1
          exact pull_bin h hsub hm1 hm2 hWmask

private lemma extractN (gs : List Gate) (W : List Nat)
    (hW : ∀ v ∈ W, v < 2 ^ 24)
    (hgs : ∀ g ∈ gs, g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp) ∧ g.inputs.length ≤ 2)
    (hout : 0xfff ∈ execN gs W) :
    ∃ k S, k ≤ gs.length ∧ MLive 0xfff 0xfff k S ∧ ∀ w ∈ S, w ∈ W := by
  induction gs generalizing W with
  | nil =>
    refine ⟨0, {0xfff}, Nat.le_refl 0, ⟨rfl, by unfold properS dmOf; decide⟩, ?_⟩
    simpa [execN] using hout
  | cons g gs ih =>
    have hW1 : ∀ v ∈ W ++ [gvN W g], v < 2 ^ 24 := by
      intro v hv
      simp only [List.mem_append, List.mem_singleton] at hv
      rcases hv with hv | rfl
      · exact hW v hv
      · exact gvN_lt hW (hgs g List.mem_cons_self).1
    obtain ⟨k, S, hk, hlive, hsub⟩ := ih (W ++ [gvN W g]) hW1 (fun g1 hg1 => hgs g1 (List.mem_cons_of_mem _ hg1)) hout
    obtain ⟨k', S', hk', hlive', hsub'⟩ := pull_gateN hlive hsub hW (hgs g List.mem_cons_self)
    exact ⟨k', S', by simp; omega, hlive', hsub'⟩

private theorem initWires_spec : ∀ k : Fin 24,
    initWires.map (fun w => w.testBit k.val) =
    (List.ofFn fun (x4 : Fin 9) => (rows24.getD k.val 0).testBit x4.val) ++
    [(rows24.getD k.val 0).testBit 0 || (rows24.getD k.val 0).testBit 3] := by
  decide +kernel

private theorem initWires_lt : natAll (fun w => Nat.blt w 16777216) initWires = true := by
  decide +kernel

private theorem first_gate_orbits : ∀ u : Fin 2, ∀ v : Fin 10,
    let a := if u.val == 0 then 0 else 3
    let w := Nat.lor (initWires.getD a 0) (initWires.getD v.val 0)
    ∃ g ∈ ([0, 1, 6, 7] : List Nat), ∃ j ∈ ([1, 2, 4, 6] : List Nat),
      natAll (fun x => natMem (act g x) (rootBase j)) (initWires ++ [w]) = true := by
  decide +kernel

private theorem initWires_in_root1 :
    natAll (fun x => natMem x (rootBase 1)) initWires = true := by
  decide +kernel

private lemma getD_mem_of_ne_zero {l : List Nat} {i : Nat} (h : l.getD i 0 ≠ 0) : l.getD i 0 ∈ l := by
  rw [List.getD_eq_getElem?_getD] at h ⊢
  cases hq : l[i]? with
  | none => rw [hq] at h; exact absurd rfl h
  | some a => exact List.mem_of_getElem? hq

private lemma getD_lt_of_all_lt {l : List Nat} {i B : Nat} (hB : 0 < B) (hl : ∀ x ∈ l, x < B) :
    l.getD i 0 < B := by
  rw [List.getD_eq_getElem?_getD]
  cases hq : l[i]? with
  | none => exact hB
  | some a => exact hl a (List.mem_of_getElem? hq)

private theorem main :
    have x1 : PEqualNP.CircuitLowerBounds.Circuit → Prop := fun (x1 : PEqualNP.CircuitLowerBounds.Circuit) => (∃ x2 ∈ [(3 : ℕ), (12 : ℕ), (24 : ℕ), (17 : ℕ), (33 : ℕ), (264 : ℕ)], x1.eval ((List.ofFn fun (x3 : Fin (9 : ℕ)) => x2.testBit ↑x3) ++ [Bool.false]) = Bool.false) ∧ ∃ x2 ∈ [(50 : ℕ), (116 : ℕ), (208 : ℕ), (276 : ℕ), (402 : ℕ)], x1.eval ((List.ofFn fun (x3 : Fin (9 : ℕ)) => x2.testBit ↑x3) ++ [Bool.true]) = Bool.true;
    have x2 : PEqualNP.CircuitLowerBounds.Circuit → ℕ → Bool := fun (x2 : PEqualNP.CircuitLowerBounds.Circuit) (x3 : ℕ) => x2.eval ((List.ofFn fun (x4 : Fin (9 : ℕ)) => x3.testBit ↑x4) ++ [x3.testBit (0 : ℕ) || x3.testBit (3 : ℕ)]);
    ∀ (x3 : PEqualNP.CircuitLowerBounds.Circuit), x3.gates.length = (14 : ℕ) → PEqualNP.MetaComplexity.Monotone2 x3 → x3.output = (23 : ℕ) → x1 x3 → (∃ (x8 : PEqualNP.CircuitLowerBounds.Gate) (x9 : List PEqualNP.CircuitLowerBounds.Gate), x3.gates = x8 :: x9 ∧ x8.op = PEqualNP.CircuitLowerBounds.GateOp.or ∧ ((0 : ℕ) ∈ x8.inputs ∨ (3 : ℕ) ∈ x8.inputs)) → (∀ x9 ∈ [(3 : ℕ), (6 : ℕ), (12 : ℕ), (24 : ℕ), (17 : ℕ), (33 : ℕ), (66 : ℕ), (132 : ℕ), (264 : ℕ), (160 : ℕ), (320 : ℕ), (288 : ℕ)], x2 x3 x9 = Bool.true) → ¬∀ x10 ∈ [(42 : ℕ), (50 : ℕ), (69 : ℕ), (104 : ℕ), (116 : ℕ), (138 : ℕ), (201 : ℕ), (208 : ℕ), (261 : ℕ), (276 : ℕ), (385 : ℕ), (402 : ℕ)], x2 x3 x10 = Bool.false := by
  dsimp only
  intro x3 hlen hmono hout _ hfirst hpos hneg
  obtain ⟨x8, x9, hgates, hx8op, hx8in⟩ := hfirst
  have hx9len : x9.length = 13 := by rw [hgates] at hlen; simp at hlen; omega
  have hmono_all : ∀ g ∈ x3.gates, g.op ∈ ({GateOp.and, GateOp.or} : Set GateOp) ∧ g.inputs.length ≤ 2 := hmono
  have hinit_lt : ∀ v ∈ initWires, v < 2 ^ 24 := fun v hv =>
    natLt_of_blt (natAll_sound initWires_lt v hv)
  let outW := (execN x3.gates initWires).getD 23 0
  have heval_bit : ∀ k : Fin 24, outW.testBit k.val =
      x3.eval ((List.ofFn fun (x4 : Fin 9) => (rows24.getD k.val 0).testBit x4.val) ++
        [(rows24.getD k.val 0).testBit 0 || (rows24.getD k.val 0).testBit 3]) := by
    intro k
    unfold Circuit.eval Circuit.wires
    rw [hout, ← initWires_spec k, bit_foldN k.val k.isLt x3.gates (fun g hg => (hmono_all g hg).1) initWires, bit_getDN]
  have hout_eq : outW = 0xfff := by
    apply Nat.eq_of_testBit_eq
    intro k
    by_cases hk12 : k < 12
    · have h12 : (0xfff : Nat).testBit k = true := by interval_cases k <;> decide
      rw [h12, heval_bit ⟨k, by omega⟩]
      have hmem : rows24.getD k 0 ∈ [(3 : ℕ), 6, 12, 24, 17, 33, 66, 132, 264, 160, 320, 288] := by
        interval_cases k <;> decide
      exact hpos _ hmem
    · by_cases hk24 : k < 24
      · have h0 : (0xfff : Nat).testBit k = false :=
          testBit_false_of_lt_pow (m := 12) (by decide) (by omega)
        rw [h0, heval_bit ⟨k, hk24⟩]
        have hmem : rows24.getD k 0 ∈ [(42 : ℕ), 50, 69, 104, 116, 138, 201, 208, 261, 276, 385, 402] := by
          interval_cases k <;> decide
        exact hneg _ hmem
      · have h0 : (0xfff : Nat).testBit k = false :=
          testBit_false_of_lt_pow (m := 12) (by decide) (by omega)
        have hout_lt : outW < 2 ^ 24 :=
          getD_lt_of_all_lt (by decide) (execN_lt hinit_lt (fun g hg => (hmono_all g hg).1))
        rw [h0, testBit_false_of_lt_pow hout_lt (by omega)]
  have hout_mem : 0xfff ∈ execN x9 (initWires ++ [gvN initWires x8]) := by
    have hmem : outW ∈ execN x3.gates initWires :=
      getD_mem_of_ne_zero (by change outW ≠ 0; rw [hout_eq]; decide)
    rw [hout_eq, hgates] at hmem
    exact hmem
  have hW1_lt : ∀ v ∈ initWires ++ [gvN initWires x8], v < 2 ^ 24 := by
    intro v hv
    simp only [List.mem_append, List.mem_singleton] at hv
    rcases hv with hv | rfl
    · exact hinit_lt v hv
    · exact gvN_lt hinit_lt (hmono_all x8 (hgates ▸ List.mem_cons_self)).1
  obtain ⟨k, S, hk, hlive, hsub⟩ := extractN x9 (initWires ++ [gvN initWires x8]) hW1_lt
    (fun g hg => hmono_all g (hgates ▸ List.mem_cons_of_mem _ hg)) hout_mem
  have hk13 : k ≤ 13 := by omega
  have hx8len : x8.inputs.length ≤ 2 := (hmono_all x8 (hgates ▸ List.mem_cons_self)).2
  have hreduce : ∃ g ∈ ([0, 1, 6, 7] : List Nat), ∃ j ∈ ([1, 2, 4, 6] : List Nat),
      ∀ w ∈ initWires ++ [gvN initWires x8], act g w ∈ rootBase j := by
    have htriv : gvN initWires x8 ∈ initWires →
        ∃ g ∈ ([0, 1, 6, 7] : List Nat), ∃ j ∈ ([1, 2, 4, 6] : List Nat),
          ∀ w ∈ initWires ++ [gvN initWires x8], act g w ∈ rootBase j := by
      intro hm
      refine ⟨0, by simp, 1, by simp, fun w hw => ?_⟩
      have hwin : w ∈ initWires := by
        simp only [List.mem_append, List.mem_singleton] at hw
        exact hw.elim id (fun he => he ▸ hm)
      have hact0 : act 0 w = w := by
        apply Nat.eq_of_testBit_eq; intro i
        by_cases hi : i < 24
        · rw [act_testBit_lt 0 w i (by omega) hi]
          have : bitPermInv 0 i = i := by interval_cases i <;> decide
          rw [this]
        · rw [act_testBit_ge 0 w i (by omega), testBit_false_of_lt_pow (hinit_lt w hwin) (by omega)]
      rw [hact0]
      exact (natMem_iff w (rootBase 1)).mp (natAll_sound initWires_in_root1 w hwin)
    rcases x8 with ⟨op, ins⟩
    simp only at hx8op hx8in hx8len
    subst hx8op
    cases ins with
    | nil => simp at hx8in
    | cons a ins1 =>
      cases ins1 with
      | nil =>
        have hgv : gvN initWires ⟨GateOp.or, [a]⟩ = initWires.getD a 0 := by simp [gvN]
        have ha03 : 0 = a ∨ 3 = a := by simpa using hx8in
        apply htriv
        rw [hgv]
        rcases ha03 with rfl | rfl <;> decide
      | cons b ins2 =>
        cases ins2 with
        | cons _ _ => simp at hx8len
        | nil =>
          have hgv : gvN initWires ⟨GateOp.or, [a, b]⟩ = Nat.lor (initWires.getD a 0) (initWires.getD b 0) := by
            simp [gvN]
          have hor_ab : ∃ u v, (u = 0 ∨ u = 3) ∧ gvN initWires ⟨GateOp.or, [a, b]⟩ = Nat.lor (initWires.getD u 0) (initWires.getD v 0) := by
            simp only [List.mem_cons, List.not_mem_nil, or_false] at hx8in
            rcases hx8in with (rfl | rfl) | (rfl | rfl)
            · exact ⟨0, b, Or.inl rfl, hgv⟩
            · exact ⟨0, a, Or.inl rfl, by rw [hgv, natLor_eq, Nat.or_comm]; rfl⟩
            · exact ⟨3, b, Or.inr rfl, hgv⟩
            · exact ⟨3, a, Or.inr rfl, by rw [hgv, natLor_eq, Nat.or_comm]; rfl⟩
          obtain ⟨u, v, hu03, hgv_uv⟩ := hor_ab
          by_cases hv10 : v < 10
          · have hfu : ∃ u' : Fin 2, u = if u'.val == 0 then 0 else 3 := by
              rcases hu03 with rfl | rfl
              · exact ⟨⟨0, by omega⟩, rfl⟩
              · exact ⟨⟨1, by omega⟩, rfl⟩
            obtain ⟨u', rfl⟩ := hfu
            obtain ⟨g, hg, j, hj, hall⟩ := first_gate_orbits u' ⟨v, hv10⟩
            refine ⟨g, hg, j, hj, fun w hw => ?_⟩
            rw [hgv_uv] at hw
            exact (natMem_iff _ _).mp (natAll_sound hall w hw)
          · apply htriv
            have hv0 : initWires.getD v 0 = 0 := by
              rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by show initWires.length ≤ v; have : initWires.length = 10 := rfl; omega)]
              rfl
            rw [hgv_uv, hv0, natLor_eq, Nat.or_zero]
            rcases hu03 with rfl | rfl <;> decide
  obtain ⟨g, hg, j, hj, hmap⟩ := hreduce
  have hg12 : g < 12 := by
    rcases List.mem_cons.mp hg with rfl | hg
    · omega
    rcases List.mem_cons.mp hg with rfl | hg
    · omega
    rcases List.mem_cons.mp hg with rfl | hg
    · omega
    rw [List.mem_singleton.mp hg]; omega
  have hsym := BF_sym_ok ⟨g, hg12⟩
  have hlive' := mlive_act hg12 (by decide) (by decide) hsym.2.1 hsym.2.2 hlive
  have hsub' : S.image (act g) ⊆ (rootBase j).toFinset := by
    intro y hy
    obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hy
    exact List.mem_toFinset.mpr (hmap w (hsub w hw))
  exact BF_dead j hj _ hsub' k hk13 hlive'

