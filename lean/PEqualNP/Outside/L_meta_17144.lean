private def MM : ℕ := 2 ^ 1024 - 1

private def gv (w : List ℕ) (g : Gate) : ℕ :=
  match g.op, g.inputs with
  | .and, [i, j] => w.getD i 0 &&& w.getD j 0
  | .or, [i, j] => w.getD i 0 ||| w.getD j 0
  | .not, [i] => w.getD i 0 ^^^ MM
  | _, _ => 0

private def ex (gs : List Gate) (w : List ℕ) : List ℕ :=
  gs.foldl (fun w g => w ++ [gv w g]) w

private lemma getD_map (w : List ℕ) (b i : ℕ) :
    (w.map (fun x => x.testBit b)).getD i false = (w.getD i 0).testBit b := by
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases w[i]? <;> simp

private lemma MM_bit {b : ℕ} (hb : b < 1024) : MM.testBit b = true := by
  unfold MM
  rw [Nat.testBit_two_pow_sub_one]
  exact decide_eq_true hb

private def gateShapeOk (g : Gate) : Bool :=
  match g.op, g.inputs with
  | .and, [_, _] => true
  | .or, [_, _] => true
  | .not, [_] => true
  | _, _ => false

private lemma gv_bit {b : ℕ} (hb : b < 1024) (w : List ℕ) (g : Gate) (hg : gateShapeOk g = true) :
    (gv w g).testBit b = g.op.eval (g.inputs.map fun i => (w.map (fun x => x.testBit b)).getD i false) := by
  obtain ⟨op, ins⟩ := g
  cases op with
  | and =>
    match ins with
    | [i, j] => simp only [gv, GateOp.eval, List.map_cons, List.map_nil, List.all_cons, List.all_nil, List.any_cons, List.any_nil, id_eq, getD_map, Nat.testBit_and, Nat.testBit_or, Bool.and_true, Bool.or_false]
    | [] | [_] | _ :: _ :: _ :: _ => simp [gateShapeOk] at hg
  | or =>
    match ins with
    | [i, j] => simp only [gv, GateOp.eval, List.map_cons, List.map_nil, List.all_cons, List.all_nil, List.any_cons, List.any_nil, id_eq, getD_map, Nat.testBit_and, Nat.testBit_or, Bool.and_true, Bool.or_false]
    | [] | [_] | _ :: _ :: _ :: _ => simp [gateShapeOk] at hg
  | not =>
    match ins with
    | [i] => simp only [gv, GateOp.eval, List.map_cons, List.map_nil, List.headD_cons, getD_map, Nat.testBit_xor, MM_bit hb, Bool.bne_true]
    | [] | _ :: _ :: _ => simp [gateShapeOk] at hg
  | mod _ => simp [gateShapeOk] at hg
  | maj => simp [gateShapeOk] at hg

private lemma ex_bit {b : ℕ} (hb : b < 1024) (gs : List Gate) : ∀ w : List ℕ,
    gs.all gateShapeOk = true →
    (ex gs w).map (fun x => x.testBit b) =
      gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (w.map (fun x => x.testBit b)) := by
  induction gs with
  | nil => intro w _; rfl
  | cons g gs ih =>
    intro w hg
    simp only [List.all_cons, Bool.and_eq_true] at hg
    rw [ex, List.foldl_cons, List.foldl_cons, ← gv_bit hb w g hg.1]
    have h := ih (w ++ [gv w g]) hg.2
    rw [List.map_append] at h
    exact h


