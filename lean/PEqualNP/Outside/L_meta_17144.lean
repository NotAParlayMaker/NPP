private lemma c_mono : Monotone2 c := by
  intro g hg
  have h := List.all_eq_true.1 mono_ok g hg
  obtain ⟨op, ins⟩ := g
  cases op with
  | and => match ins with | [_, _] => simp | [] | [_] | _ :: _ :: _ :: _ => simp [isMonoGate] at h
  | or => match ins with | [_, _] => simp | [] | [_] | _ :: _ :: _ :: _ => simp [isMonoGate] at h
  | not | mod _ | maj => simp [isMonoGate] at h

private lemma init_row_u (i : Fin 32) (u v : Fin 32) :
    (init.getD i.val 0).testBit (32 * u.val + v.val) = decide (i = u) := by
