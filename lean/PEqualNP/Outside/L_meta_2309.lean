  change (!(bit s i raw0)) :: _ = bit s i (neg raw0) :: _
  rw [bit_neg _ _ (raw_valid raw0 (by simp [PEqualNP.Outside.L_meta_2309_bound.Main2331.raw]))]
  rfl

lemma signed_target (C : Circuit) (h : PEqualNP.MetaComplexity.FanInTwo C)
