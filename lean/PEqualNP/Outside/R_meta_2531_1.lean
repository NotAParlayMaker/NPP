import Mathlib
import PEqualNP.Defs

-- A cut of L-meta-2531: the twelve-gate list is separated by how many gates it uses.
theorem PEqualNP.Outside.R_meta_2531_1
    (h1 : ∀ (x2 : List PEqualNP.CircuitLowerBounds.Gate) (x3 : PEqualNP.CircuitLowerBounds.Gate) (x4 : ℕ),   x2.length ≤ 10 →     x4 ≤ 21 →       PEqualNP.MetaComplexity.FanInTwo { gates := x2 ++ [x3], output := 0 : PEqualNP.CircuitLowerBounds.Circuit } →         (∀ x8 ∈ x2 ++ [x3], ∀ x10 ∈ x8.inputs, x10 ≤ 21) →           (∀ (x11 : Fin 9 → Bool), (fun (x1 : Fin 9 → Bool) => [1, 12, 23, 34, 40, 5, 16, 27, 38, 57, 68, 85].any fun (x2 : ℕ) => x1 (Fin.ofNat 9 (x2 / 10)) && x1 (Fin.ofNat 9 (x2 % 10))) x11 = Bool.false → (fun (x10 : Fin 9 → Bool) => x3.op.eval (List.map (fun (x11 : ℕ) => ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x10).getD x11 Bool.false) x3.inputs)) x11 = Bool.false ∧ ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x11).getD x4 Bool.false = Bool.true) → ∃ (x12 : Fin 9 → Bool), (fun (x1 : Fin 9 → Bool) => [1, 12, 23, 34, 40, 5, 16, 27, 38, 57, 68, 85].any fun (x2 : ℕ) => x1 (Fin.ofNat 9 (x2 / 10)) && x1 (Fin.ofNat 9 (x2 % 10))) x12 = Bool.true ∧ (fun (x10 : Fin 9 → Bool) => x3.op.eval (List.map (fun (x11 : ℕ) => ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x10).getD x11 Bool.false) x3.inputs)) x12 = Bool.false ∧ ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x12).getD x4 Bool.false = Bool.true)
    (h2 : ∀ (x2 : List PEqualNP.CircuitLowerBounds.Gate) (x3 : PEqualNP.CircuitLowerBounds.Gate) (x4 : ℕ),   x2.length = 11 →     x4 ≤ 21 →       PEqualNP.MetaComplexity.FanInTwo { gates := x2 ++ [x3], output := 0 : PEqualNP.CircuitLowerBounds.Circuit } →         (∀ x8 ∈ x2 ++ [x3], ∀ x10 ∈ x8.inputs, x10 ≤ 21) →           (∀ (x11 : Fin 9 → Bool), (fun (x1 : Fin 9 → Bool) => [1, 12, 23, 34, 40, 5, 16, 27, 38, 57, 68, 85].any fun (x2 : ℕ) => x1 (Fin.ofNat 9 (x2 / 10)) && x1 (Fin.ofNat 9 (x2 % 10))) x11 = Bool.false → (fun (x10 : Fin 9 → Bool) => x3.op.eval (List.map (fun (x11 : ℕ) => ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x10).getD x11 Bool.false) x3.inputs)) x11 = Bool.false ∧ ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x11).getD x4 Bool.false = Bool.true) → ∃ (x12 : Fin 9 → Bool), (fun (x1 : Fin 9 → Bool) => [1, 12, 23, 34, 40, 5, 16, 27, 38, 57, 68, 85].any fun (x2 : ℕ) => x1 (Fin.ofNat 9 (x2 / 10)) && x1 (Fin.ofNat 9 (x2 % 10))) x12 = Bool.true ∧ (fun (x10 : Fin 9 → Bool) => x3.op.eval (List.map (fun (x11 : ℕ) => ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x10).getD x11 Bool.false) x3.inputs)) x12 = Bool.false ∧ ((fun (x9 : Fin 9 → Bool) => { gates := x2, output := 0 : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 0 && x9 6])) x12).getD x4 Bool.false = Bool.true)
    : (have x1 : (Fin (9 : ℕ) → Bool) → Bool := fun (x1 : Fin (9 : ℕ) → Bool) => [(1 : ℕ), (12 : ℕ), (23 : ℕ), (34 : ℕ), (40 : ℕ), (5 : ℕ), (16 : ℕ), (27 : ℕ), (38 : ℕ), (57 : ℕ), (68 : ℕ), (85 : ℕ)].any fun (x2 : ℕ) => x1 (Fin.ofNat (9 : ℕ) (x2 / (10 : ℕ))) && x1 (Fin.ofNat (9 : ℕ) (x2 % (10 : ℕ))); ∀ (x2 : List PEqualNP.CircuitLowerBounds.Gate) (x3 : PEqualNP.CircuitLowerBounds.Gate) (x4 : ℕ),   x2.length ≤ (11 : ℕ) →     x4 ≤ (21 : ℕ) →       PEqualNP.MetaComplexity.FanInTwo { gates := x2 ++ [x3], output := (0 : ℕ) : PEqualNP.CircuitLowerBounds.Circuit } →         (∀ x8 ∈ x2 ++ [x3], ∀ x10 ∈ x8.inputs, x10 ≤ (21 : ℕ)) →           have x9 : (Fin (9 : ℕ) → Bool) → List Bool := fun (x9 : Fin (9 : ℕ) → Bool) => { gates := x2, output := (0 : ℕ) : PEqualNP.CircuitLowerBounds.Circuit }.wires (List.ofFn x9 ++ [x9 (0 : Fin (9 : ℕ)) && x9 (6 : Fin (9 : ℕ))]);           have x10 : (Fin (9 : ℕ) → Bool) → Bool := fun (x10 : Fin (9 : ℕ) → Bool) => x3.op.eval (List.map (fun (x11 : ℕ) => (x9 x10).getD x11 Bool.false) x3.inputs);           (∀ (x11 : Fin (9 : ℕ) → Bool), x1 x11 = Bool.false → x10 x11 = Bool.false ∧ (x9 x11).getD x4 Bool.false = Bool.true) → ∃ (x12 : Fin (9 : ℕ) → Bool), x1 x12 = Bool.true ∧ x10 x12 = Bool.false ∧ (x9 x12).getD x4 Bool.false = Bool.true) := by
  intro x1h x2 x3 x4 hlen hx4 hfan hbound x9h x10h hpos
  by_cases h : x2.length ≤ 10
  · exact h1 x2 x3 x4 h hx4 hfan hbound hpos
  · have h11 : x2.length = 11 := by omega
    exact h2 x2 x3 x4 h11 hx4 hfan hbound hpos
