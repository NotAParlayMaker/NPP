private def valid (r : Fin 2048) : Prop :=
  let z := (certificate[r.val]?).getD (0, 0)
  let l := packing z.2
  edges.all (fun e => e &&& z.1 != 0) = true ∧
  l.Pairwise (fun a b => a &&& b = 0) ∧
  l.all (fun a => pieces.contains a && (a &&& r.val == 0)) = true ∧
  (decode z.1 \ decode r.val).card ≤ weight l

private instance (r : Fin 2048) : Decidable (valid r) := by
  unfold valid
  infer_instance

