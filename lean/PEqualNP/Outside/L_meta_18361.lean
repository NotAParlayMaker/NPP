private theorem validAll (r : Fin 2048) : valid r := by
  let b := r.val/64
  let i : Fin 64 := ⟨r.val % 64, by omega⟩
  have hb : b < 32 := by dsimp [b]; have := r.isLt; omega
  have hr : 64*b+i.val=r.val := by dsimp [b,i]; omega
