private theorem maskExists {n : ℕ} (f : Fin n → Bool) :
    ∃ r : Fin (2^n), ∀ i : Fin n, r.val.testBit i.val = f i := by
  induction n with
  | zero =>
    exact ⟨0, fun i => Fin.elim0 i⟩
  | succ n ih =>
    obtain ⟨r, h⟩ := ih (fun i => f i.succ)
    let b : ℕ := if f 0 then 1 else 0
    have hb : b < 2 := by cases e : f 0 <;> simp [b,e]
    have hr : r.val < 2^n := r.isLt
    refine ⟨⟨2*r.val+b, by rw [Nat.pow_succ]; omega⟩, ?_⟩
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · change (2*r.val+b).testBit 0 = f 0
      rw [Nat.testBit_zero, show (2*r.val+b)%2=b by omega]
      cases e : f 0 <;> simp [b,e]
    · change (2*r.val+b).testBit (j.val+1) = f j.succ
      rw [Nat.testBit_succ, show (2*r.val+b)/2=r.val by omega]
      exact h j

private theorem codeExists (S : Finset (Fin 11)) :
    ∃ r : Fin 2048, decode r.val = S := by
  obtain ⟨r,h⟩ := maskExists (fun i : Fin 11 => decide (i ∈ S))
  refine ⟨r, ?_⟩
  ext i
  simp [decode, h i]

private instance : DecidableRel G.Adj := by
  unfold G
  infer_instance

private theorem edgeMem : ∀ a b : Fin 11, G.Adj a b →
    (2 ^ a.val ||| 2 ^ b.val) ∈ edges := by decide +kernel

private theorem coverFrom (r : ℕ) (h : edges.all (fun e => e &&& r != 0) = true) :
    G.IsVertexCover (↑(decode r) : Set (Fin 11)) := by
  intro a b hab
  by_contra! hn
  have ha : r.testBit a.val = false := by simpa [decode] using hn.1
  have hb : r.testBit b.val = false := by simpa [decode] using hn.2
  have hneq : ((2 ^ a.val ||| 2 ^ b.val) &&& r) ≠ 0 := by
    simpa using List.all_eq_true.mp h _ (edgeMem a b hab)
  apply hneq
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases ai : a.val = i
  · subst i
    simp [ha]
  by_cases bi : b.val = i
  · subst i
    simp [hb]
  simp [ai, bi]

