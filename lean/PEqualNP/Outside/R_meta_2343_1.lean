  intro x1 x2 hlen hmon hlt x6 x7 x8 x9 x10 hpos hneg
  rcases x2 with _ | ⟨a, _ | ⟨b, _ | ⟨c, rest⟩⟩⟩
  · exact h1 x1 hmon hlt (by simpa only [x10, List.any_nil] using hpos) (by simpa only [x10, List.any_nil] using hneg)
  · exact h2 x1 a hmon hlt (by simpa only [x10, List.any_cons, List.any_nil, Bool.or_false] using hpos) (by simpa only [x10, List.any_cons, List.any_nil, Bool.or_false] using hneg)
  · exact h3 x1 a b hmon hlt (by simpa only [x10, List.any_cons, List.any_nil, Bool.or_false] using hpos) (by simpa only [x10, List.any_cons, List.any_nil, Bool.or_false] using hneg)
  · simp at hlen
