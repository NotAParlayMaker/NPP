-- A cover by all-1 rectangles gives a cover of the 1-entries (numbered along `cells`) by the listed
-- maximal rectangles `rects`. The branch-and-bound certificate `cert` is replayed by `chk`: a token below
-- 1000 branches on an entry, a token 1000 + i closes a node by the weight vector `pool[i]`.

def wsum : List Nat → Nat → Nat
  | [], _ => 0
  | w :: ws, u => (bif u.testBit 0 then w else 0) + wsum ws (u / 2)

def Cov (L : List Nat) (u : Nat) : Prop :=
  ∀ e, u.testBit e = true → ∃ r ∈ L, r.testBit e = true

theorem sum_split (w : Nat) (ws : List Nat) (L : List Nat) :
    (L.map (wsum (w :: ws))).sum =
      (L.map fun r => bif r.testBit 0 then w else 0).sum + ((L.map (· / 2)).map (wsum ws)).sum := by
  induction L with
  | nil => rfl
  | cons r L ih =>
    have e : wsum (w :: ws) r = (bif r.testBit 0 then w else 0) + wsum ws (r / 2) := rfl
    simp only [List.map_cons, List.sum_cons]
    rw [ih, e]
    omega

theorem head_le (w : Nat) (L : List Nat) (h : ∃ r ∈ L, r.testBit 0 = true) :
    w ≤ (L.map fun r => bif r.testBit 0 then w else 0).sum := by
  induction L with
  | nil => simp at h
  | cons r L ih =>
    obtain ⟨s, hs, hb⟩ := h
    rcases List.mem_cons.mp hs with rfl | hs
    · simp only [List.map_cons, List.sum_cons, hb, Bool.cond_true]; omega
    · have := ih ⟨s, hs, hb⟩
      simp only [List.map_cons, List.sum_cons]; omega

theorem wsum_le (ws : List Nat) : ∀ (L : List Nat) (u : Nat), Cov L u →
    wsum ws u ≤ (L.map (wsum ws)).sum := by
  induction ws with
  | nil => intro L u _; simp [wsum]
  | cons w ws ih =>
    intro L u h
    have h2 : Cov (L.map (· / 2)) (u / 2) := by
      intro e he
      obtain ⟨r, hr, hb⟩ := h (e + 1) (by rw [Nat.testBit_succ]; exact he)
      exact ⟨r / 2, List.mem_map_of_mem hr, by rw [Nat.testBit_succ] at hb; exact hb⟩
    have a := ih _ _ h2
    rw [sum_split]
    unfold wsum
    cases hu : u.testBit 0
    · simp only [Bool.cond_false]; omega
    · have := head_le w L (h 0 hu)
      simp only [Bool.cond_true]; omega

def good (rects : List Nat) (ps : List (List Nat × Nat)) : Bool :=
  ps.all fun p => rects.all fun r => Nat.ble (wsum p.1 r) p.2

theorem sum_le {rects : List Nat} {pool : List (List Nat × Nat)} (G : good rects pool = true)
    (p : List Nat × Nat) (hp : p ∈ pool) (L : List Nat) (hL : ∀ r ∈ L, r ∈ rects) :
    (L.map (wsum p.1)).sum ≤ L.length * p.2 := by
  induction L with
  | nil => simp
  | cons r L ih =>
    have h1 := ih fun s hs => hL s (List.mem_cons_of_mem _ hs)
    have h2 := Nat.le_of_ble_eq_true
      (List.all_eq_true.mp (List.all_eq_true.mp G p hp) r (hL r List.mem_cons_self))
    simp only [List.map_cons, List.sum_cons, List.length_cons, Nat.add_mul, Nat.one_mul]
    omega

def kids (f : Nat → List Nat → Option (List Nat)) (u : Nat) : List Nat → List Nat → Option (List Nat)
  | [], ts => some ts
  | r :: rs, ts =>
    match f (u ^^^ (u &&& r)) ts with
    | none => none
    | some t => kids f u rs t

theorem kids_ok (f : Nat → List Nat → Option (List Nat)) (u : Nat) :
    ∀ (rs ts out : List Nat), kids f u rs ts = some out →
      ∀ r ∈ rs, ∃ t t', f (u ^^^ (u &&& r)) t = some t' := by
  intro rs
  induction rs with
  | nil => intro _ _ _ r hr; simp at hr
  | cons r rs ih =>
    intro ts out h s hs
    unfold kids at h
    cases hf : f (u ^^^ (u &&& r)) ts with
    | none => rw [hf] at h; simp at h
    | some t =>
      rw [hf] at h
      rcases List.mem_cons.mp hs with rfl | hs
      · exact ⟨ts, t, hf⟩
      · exact ih t out h s hs

def leaf (pool : List (List Nat × Nat)) (k u t : Nat) (ts : List Nat) : Option (List Nat) :=
  match pool[t - 1000]? with
  | none => none
  | some p => bif decide (k * p.2 < wsum p.1 u) then some ts else none

def chk (rects : List Nat) (pool : List (List Nat × Nat)) : Nat → Nat → List Nat → Option (List Nat)
  | _, _, [] => none
  | 0, u, t :: ts => bif decide (1000 ≤ t) then leaf pool 0 u t ts else none
  | k + 1, u, t :: ts =>
    bif decide (1000 ≤ t) then leaf pool (k + 1) u t ts else
      bif u.testBit t then kids (chk rects pool k) u (rects.filter fun r => r.testBit t) ts else none

theorem leaf_ok {rects : List Nat} {pool : List (List Nat × Nat)} (G : good rects pool = true)
    {k u t : Nat} {ts out : List Nat} (h : leaf pool k u t ts = some out)
    (L : List Nat) (hL : ∀ r ∈ L, r ∈ rects) (hk : L.length ≤ k) : ¬ Cov L u := by
  intro hc
  unfold leaf at h
  cases hp : pool[t - 1000]? with
  | none => rw [hp] at h; simp at h
  | some p =>
    rw [hp] at h
    simp only at h
    cases hd : decide (k * p.2 < wsum p.1 u)
    · rw [hd] at h; simp at h
    · have h1 : k * p.2 < wsum p.1 u := of_decide_eq_true hd
      have h2 := wsum_le p.1 L u hc
      have h3 := sum_le G p (List.mem_of_getElem? hp) L hL
      have h4 := Nat.mul_le_mul_right p.2 hk
      omega

theorem chk_ok {rects : List Nat} {pool : List (List Nat × Nat)} (G : good rects pool = true) :
    ∀ (k u : Nat) (ts out : List Nat), chk rects pool k u ts = some out →
    ∀ L : List Nat, (∀ r ∈ L, r ∈ rects) → L.length ≤ k → ¬ Cov L u := by
  intro k
  induction k with
  | zero =>
    intro u ts out h L hL hk
    cases ts with
    | nil => simp [chk] at h
    | cons t ts =>
      unfold chk at h
      cases hd : decide (1000 ≤ t)
      · rw [hd] at h; simp at h
      · rw [hd] at h; exact leaf_ok G h L hL hk
  | succ k ih =>
    intro u ts out h L hL hk
    cases ts with
    | nil => simp [chk] at h
    | cons t ts =>
      unfold chk at h
      cases hd : decide (1000 ≤ t)
      · rw [hd] at h
        simp only [Bool.cond_false] at h
        cases hu : u.testBit t
        · rw [hu] at h; simp at h
        · rw [hu] at h
          simp only [Bool.cond_true] at h
          intro hc
          obtain ⟨r, hr, hb⟩ := hc t hu
          obtain ⟨a, b, hf⟩ := kids_ok _ u _ _ _ h r (List.mem_filter.mpr ⟨hL r hr, hb⟩)
          refine ih _ _ _ hf (L.erase r) (fun s hs => hL s (List.mem_of_mem_erase hs)) ?_ ?_
          · rw [List.length_erase_of_mem hr]; omega
          · intro e he
            rw [Nat.testBit_xor, Nat.testBit_and] at he
            cases hx : u.testBit e
            · rw [hx] at he; simp at he
            · cases hy : r.testBit e
              · obtain ⟨s, hs, hse⟩ := hc e hx
                refine ⟨s, (List.mem_erase_of_ne ?_).mpr hs, hse⟩
                rintro rfl
                rw [hy] at hse; exact Bool.noConfusion hse
              · rw [hx, hy] at he; simp at he
      · rw [hd] at h; exact leaf_ok G h L hL hk

