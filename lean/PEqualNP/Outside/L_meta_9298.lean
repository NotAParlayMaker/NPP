  | [], e => by simp [enc]
  | c :: cs, 0 => by simp [enc]
  | c :: cs, e + 1 => by simp [enc, Nat.testBit_bit_succ, enc_bit p cs e]

theorem enc_lt (p : Nat × Nat → Bool) : ∀ cs : List (Nat × Nat), enc p cs < 2 ^ cs.length
  | [] => by simp [enc]
  | c :: cs => by
    have := enc_lt p cs
    have e2 : 2 ^ (c :: cs).length = 2 * 2 ^ cs.length := by rw [List.length_cons, Nat.pow_succ, Nat.mul_comm]
    rw [e2, enc, Nat.bit_val]
    cases p c <;> simp <;> omega

def com (S j : Nat) : Bool := (List.range 10).all fun i => !S.testBit i || (rowsN.getD i 0).testBit j
def clo (S : Nat) : Nat := enc (fun c => S.testBit c.1 && com S c.2) cells

def cloAt (a : Nat) : Bool := (List.range 64).all fun t =>
    rects.any fun q => Nat.beq (clo (64 * a + t) &&& q) (clo (64 * a + t))
theorem c0 : cloAt 0 = true := by decide +kernel
theorem c1 : cloAt 1 = true := by decide +kernel
theorem c2 : cloAt 2 = true := by decide +kernel
theorem c3 : cloAt 3 = true := by decide +kernel
theorem c4 : cloAt 4 = true := by decide +kernel
theorem c5 : cloAt 5 = true := by decide +kernel
theorem c6 : cloAt 6 = true := by decide +kernel
theorem c7 : cloAt 7 = true := by decide +kernel
theorem c8 : cloAt 8 = true := by decide +kernel
theorem c9 : cloAt 9 = true := by decide +kernel
theorem c10 : cloAt 10 = true := by decide +kernel
theorem c11 : cloAt 11 = true := by decide +kernel
theorem c12 : cloAt 12 = true := by decide +kernel
theorem c13 : cloAt 13 = true := by decide +kernel
theorem c14 : cloAt 14 = true := by decide +kernel
theorem c15 : cloAt 15 = true := by decide +kernel
theorem clo_ok : ∀ a, a < 16 → cloAt a = true := by
  intro a ha
  interval_cases a
  · exact c0
  · exact c1
  · exact c2
  · exact c3
  · exact c4
  · exact c5
  · exact c6
  · exact c7
  · exact c8
  · exact c9
  · exact c10
  · exact c11
  · exact c12
  · exact c13
  · exact c14
  · exact c15

theorem clo_all (S : Nat) (hS : S < 2 ^ 10) : (rects.any fun q => Nat.beq (clo S &&& q) (clo S)) = true := by
  have h := clo_ok (S / 64) (by omega)
  have h2 := List.all_eq_true.mp h (S % 64) (List.mem_range.mpr (Nat.mod_lt _ (by omega)))
  rw [Nat.div_add_mod S 64] at h2
  exact h2

theorem cells_ok : (cells.all fun c => decide (c.1 < 10) && decide (c.2 < 10) &&
    (rowsN.getD c.1 0).testBit c.2) = true := by decide +kernel

def idx : List (Nat × Nat) := (List.range 10).map fun i => (i, 0)

theorem toRect (I : Finset (Fin 10)) (J : Finset (Fin 10))
    (h : ∀ i ∈ I, ∀ j ∈ J, ((rowsN.getD i.val 0).testBit j.val) = true) :
    ∃ q ∈ rects, ∀ (e : Nat) (c : Nat × Nat), cells[e]? = some c →
      (∃ i ∈ I, i.val = c.1) → (∃ j ∈ J, j.val = c.2) → q.testBit e = true := by
  let S := enc (fun c => decide (∃ i ∈ I, i.val = c.1)) idx
  have hS : S < 2 ^ 10 := by
    have := enc_lt (fun c => decide (∃ i ∈ I, i.val = c.1)) idx
    have l : idx.length = 10 := by simp [idx]
    rw [l] at this
    exact this
  have bitS : ∀ i, i < 10 → S.testBit i = decide (∃ a ∈ I, a.val = i) := by
    intro i hi
    change (enc _ idx).testBit i = _
    rw [enc_bit]
    simp [idx, List.getElem?_range hi]
  obtain ⟨q, hq, hs⟩ := List.any_eq_true.mp (clo_all S hS)
  refine ⟨q, hq, ?_⟩
  intro e c hc hi hj
  have hin := List.all_eq_true.mp cells_ok c (List.mem_of_getElem? hc)
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hin
  have hb : (clo S).testBit e = true := by
    unfold clo
    rw [enc_bit, hc]
    simp only [Option.map_some, Option.getD_some, Bool.and_eq_true]
    refine ⟨by rw [bitS _ hin.1.1]; exact decide_eq_true hi, ?_⟩
    unfold com
    rw [List.all_eq_true]
    intro a ha
    rw [List.mem_range] at ha
    rw [bitS a ha]
    by_cases hx : ∃ b ∈ I, b.val = a
    · obtain ⟨b, hbI, rfl⟩ := hx
      obtain ⟨j, hjJ, hjc⟩ := hj
      have := h b hbI j hjJ
      rw [hjc] at this
      rw [this]; simp
    · simp [hx]
  have heq : clo S &&& q = clo S := Nat.eq_of_beq_eq_true hs
  have : (clo S &&& q).testBit e = true := by rw [heq]; exact hb
  rw [Nat.testBit_and, hb] at this
  simpa using this

theorem none (L : List (Finset (Fin 10) × Finset (Fin 10))) (hl : L.length ≤ 9)
    (hr : ∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, ((rowsN.getD i.val 0).testBit j.val) = true)
    (hc : ∀ (i : Fin 10) (j : Fin 10), ((rowsN.getD i.val 0).testBit j.val) = true →
      ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) : False := by
  have hex : ∀ r : Finset (Fin 10) × Finset (Fin 10), ∃ q : Nat, r ∈ L → q ∈ rects ∧
      ∀ (e : Nat) (c : Nat × Nat), cells[e]? = some c →
        (∃ i ∈ r.1, i.val = c.1) → (∃ j ∈ r.2, j.val = c.2) → q.testBit e = true := by
    intro r
    by_cases hm : r ∈ L
    · obtain ⟨q, h1, h2⟩ := toRect r.1 r.2 (hr r hm)
      exact ⟨q, fun _ => ⟨h1, h2⟩⟩
    · exact ⟨0, fun h => absurd h hm⟩
  choose f hf using hex
  obtain ⟨out, ho⟩ := Option.isSome_iff_exists.mp cert_ok
  refine chk_ok pool_ok _ _ _ _ ho (L.map f) ?_ (by simpa using hl) ?_
  · intro q hq
    obtain ⟨r, hrL, rfl⟩ := List.mem_map.mp hq
    exact (hf r hrL).1
  · intro e he
    rw [Nat.testBit_two_pow_sub_one] at he
    have hlen : cells.length = 60 := by decide
    have hlt : e < cells.length := by rw [hlen]; exact of_decide_eq_true he
    have hget : cells[e]? = some cells[e] := List.getElem?_eq_getElem hlt
    have hin := List.all_eq_true.mp cells_ok cells[e] (List.getElem_mem hlt)
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hin
    obtain ⟨r, hrL, hi, hj⟩ := hc ⟨cells[e].1, hin.1.1⟩ ⟨cells[e].2, hin.1.2⟩ hin.2
    exact ⟨f r, List.mem_map_of_mem hrL, (hf r hrL).2 e _ hget ⟨_, hi, rfl⟩ ⟨_, hj, rfl⟩⟩

end PEqualNP.Outside.L_meta_9298

theorem PEqualNP.Outside.L_meta_9298 : ¬ (∃ L : List (Finset (Fin 10) × Finset (Fin 10)), L.length ≤ 9 ∧ (∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (([126, 413, 683, 839, 483, 725, 825, 822, 730, 492] : List ℕ).getD i.val 0).testBit j.val = true) ∧ ∀ (i : Fin 10) (j : Fin 10), (([126, 413, 683, 839, 483, 725, 825, 822, 730, 492] : List ℕ).getD i.val 0).testBit j.val = true → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) := by
  rintro ⟨L, hl, hr, hc⟩
  exact PEqualNP.Outside.L_meta_9298.none L hl hr hc
