namespace PEqualNP.Outside.L_meta_929

def okB (C : PEqualNP.CircuitLowerBounds.Circuit) : Bool :=
  C.gates.all fun g => (match g.op with
    | PEqualNP.CircuitLowerBounds.GateOp.and => true
    | PEqualNP.CircuitLowerBounds.GateOp.or => true
    | _ => false) && decide (g.inputs.length ≤ 2)

theorem mono_of_okB (C : PEqualNP.CircuitLowerBounds.Circuit) (h : okB C = true) :
    PEqualNP.MetaComplexity.Monotone2 C := by
  intro g hg
  have h1 := List.all_eq_true.mp h g hg
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
  obtain ⟨hop, hlen⟩ := h1
  refine ⟨?_, hlen⟩
  rcases g with ⟨op, ins⟩
  cases op <;> simp_all

