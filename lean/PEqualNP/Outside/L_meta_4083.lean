theorem mix_small (s a q : Nat) (h : s<1024) : mix s a q<1024 := by
  apply Nat.or_lt_two_pow (n:=10)
  · exact lt_of_le_of_lt Nat.and_le_left h
  · exact lt_of_le_of_lt Nat.and_le_left (Nat.xor_lt_two_pow (n:=10) (by decide) h)

theorem mix_row (s a q : Nat) : blend (leftSet s) (row a) (row q) = row (mix s a q) := by
  funext i
  have all' : (1023 : Nat).testBit i.val=true := by
    change (2^10-1 : Nat).testBit i.val=true
    rw [Nat.testBit_two_pow_sub_one,decide_eq_true i.isLt]
  have mem : i∈leftSet s ↔ s.testBit i.val=true := by
    change i∈Finset.univ.filter (fun j : Fin 10 => s.testBit j.val=true) ↔ _
    simp only [Finset.mem_filter,Finset.mem_univ,true_and]
  cases h : s.testBit i.val <;>
    simp only [blend,mem,row,mix,
      Nat.testBit_or,Nat.testBit_and,Nat.testBit_xor,all',h] <;> simp

theorem code_profile (table : ∀ m<1024, graph (row m)=truth.testBit m)
    (s a : Nat) (hs : s<1024) :
    code s a=List.ofFn (fun q : Fin 11 => graph (blend (leftSet s) (row a) (row (probeMask q)))) := by
  apply List.ext_getElem
  · simp [code]
  · intro i h₁ h₂
    have hi : i<11 := by simpa [code] using h₁
    simp only [code,List.getElem_map,List.getElem_range,List.getElem_ofFn,probeMask,mix_row]
    exact (table _ (mix_small s a _ hs)).symm

theorem finish (table : ∀ m<1024, graph (row m)=truth.testBit m)
    (count : ∀ m<1024, (leftSet m).card=width m)
    (cert : ∀ m<1024, valid m=true)
    (C : Circuit) (spec : ∀ x, C.eval (inputs x)=graph x)
    (s : Finset (Fin 10)) (L B : Finset Nat)
    (hs : ∀ i : Fin 10, i.val ∈ L ↔ i∈s) (hn : 10∈L ↔ (0 : Fin 10)∈s)
    (cut : cutCondition C L B) (out : C.output∈L → C.output∈B) :
    bound s.card ≤ (Finset.univ.image (signature C B)).card := by
  classical
  let m := mask s
  have hm : m<1024 := mask_lt s
  have hset : leftSet m=s := mask_set s
  have hw : s.card=width m := hset ▸ count m hm
  have hv : bound (width m) ≤ (reps m).length ∧ ((reps m).map (code m)).Nodup :=
    of_decide_eq_true (cert m hm)
  let keys := (reps m).map (code m)
  have hlen : keys.toFinset.card=(reps m).length := by
    rw [List.toFinset_card_of_nodup hv.2,List.length_map]
  rw [hw]
  apply hv.1.trans
  rw [←hlen]
  let sig := signature C B
  let decode (v : B → Bool) := List.ofFn (fun q : Fin 11 => graph (blend s
    (Function.invFun sig v) (row (probeMask q))))
  apply Finset.card_le_card_of_surjOn decode
  intro k hk
  obtain ⟨a,ha,rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hk)
  refine ⟨sig (row a), Finset.mem_image.mpr ⟨row a,Finset.mem_univ _,rfl⟩,?_⟩
  rw [code_profile table m a hm,hset]
  apply congrArg List.ofFn
  funext q
  rw [←spec,←spec]
  exact separates C s L B hs hn cut out _ _ _ (Function.invFun_eq ⟨row a,rfl⟩)

