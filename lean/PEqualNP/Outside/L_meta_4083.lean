import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_4083

open PEqualNP.CircuitLowerBounds

/-! Wires of a circuit. -/

/-- One evaluation step of `Circuit.wires`. -/
def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem wires_eq (C : Circuit) (x : List Bool) : C.wires x = C.gates.foldl step x := rfl

theorem foldl_length (gs : List Gate) (w : List Bool) :
    (gs.foldl step w).length = w.length + gs.length := by
  induction gs generalizing w with
  | nil => simp
  | cons g gs ih => rw [List.foldl_cons, ih]; simp [step]; omega

theorem wires_length (C : Circuit) (w : List Bool) :
    (C.wires w).length = w.length + C.gates.length := by
  rw [wires_eq, foldl_length]

theorem keep (gs : List Gate) (w : List Bool) (i : ℕ) (hi : i < w.length) :
    (gs.foldl step w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    rw [List.foldl_cons, ih]
    · simp only [step, List.getD_eq_getElem?_getD, List.getElem?_append_left hi]
    · simp only [step, List.length_append, List.length_cons, List.length_nil]; omega

theorem past (l : List Bool) (i : ℕ) (hi : l.length ≤ i) : l.getD i false = false := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_none hi]

theorem gate_step (gs : List Gate) (w : List Bool) (j : ℕ) (hj : j < gs.length) :
    (gs.foldl step w).getD (w.length + j) false =
      gs[j].op.eval (gs[j].inputs.map fun i => ((gs.take j).foldl step w).getD i false) := by
  induction gs generalizing w j with
  | nil => simp at hj
  | cons g gs ih =>
    rcases j with _ | j
    · rw [List.foldl_cons, keep _ _ _ (by simp [step])]
      simp [step, List.getD_eq_getElem?_getD]
    · rw [List.foldl_cons]
      have hl : (step w g).length = w.length + 1 := by simp [step]
      have := ih (step w g) j (by simpa using hj)
      rw [hl, show w.length + 1 + j = w.length + (j + 1) by omega] at this
      rw [this]
      simp [List.take_succ_cons, List.foldl_cons]

theorem gate_val (C : Circuit) (w : List Bool) (k : ℕ) (hk : k < C.gates.length) :
    (C.wires w).getD (w.length + k) false =
      (C.gates[k]).op.eval ((C.gates[k]).inputs.map fun i =>
        if i < w.length + k then (C.wires w).getD i false else false) := by
  rw [wires_eq, gate_step C.gates w k hk]
  congr 1
  apply List.map_congr_left
  intro i _
  have hmid : ((C.gates.take k).foldl step w).length = w.length + k := by
    rw [foldl_length, List.length_take]; omega
  split_ifs with h
  · have hsplit : C.gates.foldl step w =
        (C.gates.drop k).foldl step ((C.gates.take k).foldl step w) := by
      rw [← List.foldl_append, List.take_append_drop]
    rw [hsplit]
    exact (keep (C.gates.drop k) _ i (by omega)).symm
  · exact past _ _ (by omega)

/-- Two runs agree on every wire of a set closed under reading, except where the reading
already agrees. -/
theorem agree (C : Circuit) (w w' : List Bool) (hl : w'.length = w.length) (P : ℕ → Prop)
    (hbase : ∀ j < w.length, P j → w.getD j false = w'.getD j false)
    (hgate : ∀ k (hk : k < C.gates.length), P (w.length + k) → ∀ i ∈ (C.gates[k]).inputs,
      i < w.length + k → P i ∨ (C.wires w).getD i false = (C.wires w').getD i false) :
    ∀ j, P j → (C.wires w).getD j false = (C.wires w').getD j false := by
  intro j
  induction j using Nat.strong_induction_on with
  | _ j ih =>
  intro hj
  by_cases h1 : j < w.length
  · rw [wires_eq, wires_eq, keep _ _ _ h1, keep _ _ _ (by omega)]
    exact hbase j h1 hj
  by_cases h2 : j < w.length + C.gates.length
  · obtain ⟨k, rfl⟩ : ∃ k, j = w.length + k := ⟨j - w.length, by omega⟩
    have hk : k < C.gates.length := by omega
    rw [gate_val C w k hk]
    have e := gate_val C w' k hk
    rw [hl] at e
    rw [e]
    congr 1
    apply List.map_congr_left
    intro i hi
    split_ifs with h3
    · rcases hgate k hk hj i hi h3 with h4 | h4
      · exact ih i h3 h4
      · exact h4
    · rfl
  · rw [past _ _ (by rw [wires_length]; omega), past _ _ (by rw [wires_length]; omega)]

/-! The input of the statement: ten bits, then the negation of bit `0`. -/

def xs (x : Fin 10 → Bool) : List Bool := List.ofFn x ++ [!x 0]

theorem xs_len (x : Fin 10 → Bool) : (xs x).length = 11 := by simp [xs]

theorem xs_lt (x : Fin 10 → Bool) (j : ℕ) (hj : j < 10) : (xs x).getD j false = x ⟨j, hj⟩ := by
  simp only [xs, List.getD_eq_getElem?_getD]
  rw [List.getElem?_append_left (by rw [List.length_ofFn]; exact hj), List.getElem?_ofFn]
  simp [hj]

theorem xs_10 (x : Fin 10 → Bool) : (xs x).getD 10 false = !x 0 := by
  simp [xs, List.getD_eq_getElem?_getD]

/-- Wires inside the closed set depend only on the bits inside it. -/
theorem inner (C : Circuit) (x3 : Finset (Fin 10)) (x4 : Finset ℕ)
    (h4 : ∀ i : Fin 10, (i : ℕ) ∈ x4 ↔ i ∈ x3) (h10 : 10 ∈ x4 ↔ (0 : Fin 10) ∈ x3)
    (hg : ∀ k (hk : k < C.gates.length), 11 + k ∈ x4 → ∀ i ∈ (C.gates[k]).inputs, i ∈ x4)
    (x x' : Fin 10 → Bool) (hx : ∀ i ∈ x3, x i = x' i) :
    ∀ j ∈ x4, (C.wires (xs x)).getD j false = (C.wires (xs x')).getD j false := by
  intro j hj
  refine agree C (xs x) (xs x') (by rw [xs_len, xs_len]) (fun j => j ∈ x4) ?_ ?_ j hj
  · intro j hjl hj4
    rw [xs_len] at hjl
    by_cases h : j < 10
    · rw [xs_lt x j h, xs_lt x' j h]
      exact hx _ ((h4 ⟨j, h⟩).1 hj4)
    · obtain rfl : j = 10 := by omega
      rw [xs_10, xs_10, hx 0 (h10.1 hj4)]
  · intro k hk hk4 i hi _
    rw [xs_len] at hk4
    exact Or.inl (hg k hk hk4 i hi)

/-- Wires outside the closed set agree when the outside bits and the boundary agree. -/
theorem outer (C : Circuit) (x3 : Finset (Fin 10)) (x4 x5 : Finset ℕ)
    (h4 : ∀ i : Fin 10, (i : ℕ) ∈ x4 ↔ i ∈ x3) (h10 : 10 ∈ x4 ↔ (0 : Fin 10) ∈ x3)
    (hg : ∀ k (hk : k < C.gates.length), 11 + k ∉ x4 → ∀ i ∈ (C.gates[k]).inputs,
      i ∈ x4 → i ∈ x5)
    (x x' : Fin 10 → Bool) (hx : ∀ i, i ∉ x3 → x i = x' i)
    (hb : ∀ j ∈ x4, j ∈ x5 → (C.wires (xs x)).getD j false = (C.wires (xs x')).getD j false) :
    ∀ j, j ∉ x4 → (C.wires (xs x)).getD j false = (C.wires (xs x')).getD j false := by
  intro j hj
  refine agree C (xs x) (xs x') (by rw [xs_len, xs_len]) (fun j => j ∉ x4) ?_ ?_ j hj
  · intro j hjl hj4
    rw [xs_len] at hjl
    by_cases h : j < 10
    · rw [xs_lt x j h, xs_lt x' j h]
      exact hx _ (fun h' => hj4 ((h4 ⟨j, h⟩).2 h'))
    · obtain rfl : j = 10 := by omega
      rw [xs_10, xs_10, hx 0 (fun h' => hj4 (h10.2 h'))]
  · intro k hk hk4 i hi _
    rw [xs_len] at hk4
    by_cases hi4 : i ∈ x4
    · exact Or.inr (hb i hi4 (hg k hk hk4 i hi hi4))
    · exact Or.inl hi4

/-- Equal boundary values on two inputs give equal outputs after any change outside. -/
theorem key (C : Circuit) (x3 : Finset (Fin 10)) (x4 x5 : Finset ℕ)
    (h4 : ∀ i : Fin 10, (i : ℕ) ∈ x4 ↔ i ∈ x3) (h10 : 10 ∈ x4 ↔ (0 : Fin 10) ∈ x3)
    (hg : ∀ k (hk : k < C.gates.length), ∀ i ∈ (C.gates[k]).inputs,
      (11 + k ∈ x4 → i ∈ x4) ∧ (11 + k ∉ x4 → i ∈ x4 → i ∈ x5))
    (hout : C.output ∈ x4 → C.output ∈ x5)
    (a a' : Fin 10 → Bool)
    (hB : ∀ j ∈ x5, (C.wires (xs a)).getD j false = (C.wires (xs a')).getD j false)
    (x x' : Fin 10 → Bool) (hxa : ∀ i ∈ x3, x i = a i) (hxa' : ∀ i ∈ x3, x' i = a' i)
    (hxx : ∀ i, i ∉ x3 → x i = x' i) :
    C.eval (xs x) = C.eval (xs x') := by
  have hin := inner C x3 x4 h4 h10 (fun k hk hk4 i hi => (hg k hk i hi).1 hk4)
  have hb : ∀ j ∈ x4, j ∈ x5 →
      (C.wires (xs x)).getD j false = (C.wires (xs x')).getD j false := by
    intro j hj4 hj5
    rw [hin x a hxa j hj4, hB j hj5, hin x' a' hxa' j hj4]
  have hout' := outer C x3 x4 x5 h4 h10 (fun k hk hk4 i hi => (hg k hk i hi).2 hk4) x x' hxx hb
  unfold Circuit.eval
  by_cases ho : C.output ∈ x4
  · exact hb _ ho (hout ho)
  · exact hout' _ ho

/-! The edge function, on bit masks. -/

def adjL : List ℕ := [(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)]

def f (x3 : Fin (10 : ℕ) → Bool) : Bool := Decidable.decide (∃ (x4 : Fin (10 : ℕ)) (x5 : Fin (10 : ℕ)), x3 x4 = Bool.true ∧ x3 x5 = Bool.true ∧ ([(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)].getD ↑x4 (0 : ℕ)).testBit ↑x5 = Bool.true)

def fN (M : ℕ) : Bool := (List.range 10).any fun u => M.testBit u && (adjL.getD u 0 &&& M != 0)

theorem adj_lt : ∀ u < 10, adjL.getD u 0 < 2 ^ 10 := by decide

theorem f_fN (M : ℕ) : f (fun i => M.testBit i) = fN M := by
  have e : ∀ u : ℕ, [(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)].getD u 0 = adjL.getD u 0 := fun _ => rfl
  unfold f fN
  simp only [e]
  rw [Bool.eq_iff_iff]
  simp only [decide_eq_true_eq, List.any_eq_true, List.mem_range, Bool.and_eq_true, bne_iff_ne,
    ne_eq]
  constructor
  · rintro ⟨u, v, hu, hv, huv⟩
    refine ⟨u, u.isLt, hu, fun h0 => ?_⟩
    have h1 : (adjL.getD u 0 &&& M).testBit v = true := by
      rw [Nat.testBit_and, huv, hv]; rfl
    rw [h0, Nat.zero_testBit] at h1
    exact Bool.false_ne_true h1
  · rintro ⟨u, hu, hMu, hne⟩
    obtain ⟨v, hv⟩ := Nat.exists_testBit_of_ne_zero hne
    rw [Nat.testBit_and, Bool.and_eq_true] at hv
    have hv10 : v < 10 := by
      by_contra hc
      have h2 : adjL.getD u 0 < 2 ^ v :=
        lt_of_lt_of_le (adj_lt u hu) (Nat.pow_le_pow_right (by norm_num) (by omega))
      rw [Nat.testBit_eq_false_of_lt h2] at hv
      exact Bool.false_ne_true hv.1
    exact ⟨⟨u, hu⟩, ⟨v, hv10⟩, hMu, hv.2, hv.1⟩

/-- Bits of `t` from `m`, the other bits from `y`. -/
def mix (t m y : ℕ) : ℕ := (m &&& t) ||| (y &&& (1023 ^^^ t))

theorem b1023 : ∀ i < 10, (1023 : ℕ).testBit i = true := by decide

theorem mix_bit (t m y i : ℕ) (hi : i < 10) :
    (mix t m y).testBit i = if t.testBit i then m.testBit i else y.testBit i := by
  simp only [mix, Nat.testBit_or, Nat.testBit_and, Nat.testBit_xor, b1023 i hi]
  cases t.testBit i <;> simp

/-! The finite check: for every cut `t`, a list of masks with pairwise different answers. -/

def sigb (t m v : ℕ) : Bool := if v < 10 then fN (mix t m (2 ^ v)) else fN (mix t m 0)

def sigL (t m : ℕ) : List Bool := (List.range 11).map (sigb t m)

def tab : List ℕ := [(1 : ℕ), (2 : ℕ), (4 : ℕ), (6 : ℕ), (9 : ℕ), (12 : ℕ), (9 : ℕ), (9 : ℕ), (5 : ℕ), (3 : ℕ), (2 : ℕ)]

def pc (t : ℕ) : ℕ := (Finset.univ.filter fun i : Fin 10 => t.testBit i.val = true).card

def dec (c : ℕ) : List ℕ := (List.range (c % 16)).map fun j => (c >>> (4 + 10 * j)) % 1024

def distinct : List (List Bool) → Bool
  | [] => true
  | a :: l => !(l.contains a) && distinct l

theorem distinct_nodup : ∀ l : List (List Bool), distinct l = true → l.Nodup
  | [], _ => List.nodup_nil
  | a :: l, h => by
    simp only [distinct, Bool.and_eq_true, Bool.not_eq_true'] at h
    refine List.nodup_cons.2 ⟨fun ha => ?_, distinct_nodup l h.2⟩
    have : l.contains a = true := List.elem_iff.2 ha
    rw [h.1] at this
    exact Bool.false_ne_true this

def check1 (t c : ℕ) : Bool :=
  decide (tab.getD (pc t) 0 ≤ (dec c).length) && distinct ((dec c).map (sigL t))

def checkFrom : ℕ → List ℕ → Bool
  | _, [] => true
  | t, c :: rest => check1 t c && checkFrom (t + 1) rest

theorem checkFrom_get : ∀ (l : List ℕ) (t0 : ℕ), checkFrom t0 l = true →
    ∀ i < l.length, check1 (t0 + i) (l.getD i 0) = true
  | [], _, _, i, hi => by simp at hi
  | c :: rest, t0, h, i, hi => by
    simp only [checkFrom, Bool.and_eq_true] at h
    rcases i with _ | i
    · simpa using h.1
    · have := checkFrom_get rest (t0 + 1) h.2 i (by simpa using hi)
      simpa [show t0 + 1 + i = t0 + (i + 1) by omega] using this

