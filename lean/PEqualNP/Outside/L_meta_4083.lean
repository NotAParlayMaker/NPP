def width (m : Nat) := ((List.range 10).filter (fun i => m.testBit i)).length
def probeMask (q : Fin 11) : Nat := (2^q.val)/2
def mix (s a q : Nat) : Nat := (s &&& a) ||| ((1023 ^^^ s) &&& q)
def code (s a : Nat) : List Bool :=
  (List.range 11).map fun q => truth.testBit (mix s a ((2^q)/2))

