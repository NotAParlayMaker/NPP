-- The wire fold preserves its prefix, including the value of each previously computed gate.
def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem wires_eq (C : Circuit) (x : List Bool) : C.wires x = C.gates.foldl step x := rfl

theorem fold_prefix (gs : List Gate) : ∀ w : List Bool,
    ∃ t : List Bool, gs.foldl step w = w ++ t ∧ t.length = gs.length := by
  induction gs with
  | nil => intro w; exact ⟨[], by simp, rfl⟩
  | cons g gs ih =>
    intro w
    obtain ⟨t, ht, hl⟩ := ih (step w g)
    refine ⟨g.op.eval (g.inputs.map fun i => w.getD i false) :: t, ?_, by simp [hl]⟩
    rw [List.foldl_cons, ht]; simp [step]

theorem fold_length (gs : List Gate) (w : List Bool) :
    (gs.foldl step w).length = w.length + gs.length := by
  obtain ⟨t, ht, hl⟩ := fold_prefix gs w
  rw [ht]; simp [hl]

theorem fold_getD_lt (gs : List Gate) (w : List Bool) (i : ℕ) (h : i < w.length) :
    (gs.foldl step w).getD i false = w.getD i false := by
  obtain ⟨t, ht, _⟩ := fold_prefix gs w
  rw [ht, List.getD_append _ _ _ _ h]

theorem fold_getD_ge (gs : List Gate) (w : List Bool) (i : ℕ)
    (h : w.length + gs.length ≤ i) : (gs.foldl step w).getD i false = false := by
  rw [List.getD_eq_default]; rw [fold_length]; exact h


def rd (C : Circuit) (x : List Bool) (g i : ℕ) : Bool :=
  if i < g then (C.wires x).getD i false else false

theorem wires_length (C : Circuit) (x : List Bool) :
    (C.wires x).length = x.length + C.gates.length := fold_length _ _

theorem wires_input (C : Circuit) (x : List Bool) (i : ℕ) (h : i < x.length) :
    (C.wires x).getD i false = x.getD i false := fold_getD_lt _ _ _ h

theorem wires_gate (C : Circuit) (x : List Bool) (j : ℕ) (hj : j < C.gates.length) :
    (C.wires x).getD (x.length + j) false
      = C.gates[j].op.eval (C.gates[j].inputs.map fun i => rd C x (x.length + j) i) := by
  have hsplit : C.gates = C.gates.take j ++ C.gates[j] :: C.gates.drop (j + 1) := by
    simp
  set A := (C.gates.take j).foldl step x with hA
  have hAl : A.length = x.length + j := by
    rw [hA, fold_length]; simp; omega
  have hw : C.wires x = (C.gates.drop (j + 1)).foldl step (step A C.gates[j]) := by
    rw [wires_eq]
    conv_lhs => rw [hsplit]
    rw [List.foldl_append, List.foldl_cons]
  have hreadA : ∀ i, A.getD i false = rd C x (x.length + j) i := by
    intro i
    unfold rd
    by_cases hi : i < x.length + j
    · rw [if_pos hi, hw, fold_getD_lt _ (step A C.gates[j]) i (by simp [step]; omega), step,
        List.getD_append _ _ _ _ (by omega)]
    · rw [if_neg hi, List.getD_eq_default]; omega
  rw [hw, fold_getD_lt _ _ _ (by simp [step]; omega), step,
    List.getD_append_right _ _ _ _ (by omega)]
  simp only [hAl, Nat.sub_self]
  simp only [List.getD_cons_zero]
  congr 1
  exact List.map_congr_left (fun i _ => hreadA i)

-- Equal boundary signals give equal outputs after fixing the right side of a cut.
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

abbrev Input := Fin 10 → Bool
def inputs (x : Input) := List.ofFn x ++ [!x 0]
def wire (C : Circuit) (x : Input) (i : Nat) := (C.wires (inputs x)).getD i false

@[local simp] theorem inputs_length (x : Input) : (inputs x).length = 11 := by simp [inputs]

theorem agree (C : Circuit) (x y : Input) (region : Nat → Prop)
    (raw : ∀ i<11, region i → (inputs x).getD i false = (inputs y).getD i false)
    (cross : ∀ j : Fin C.size, region (11+j.val) → ∀ i ∈ (C.gates.get j).inputs,
      ¬region i → wire C x i=wire C y i) :
    ∀ k, region k → wire C x k=wire C y k := by
  intro k
  induction k using Nat.strong_induction_on with
  | ind k ih =>
    intro hk
    by_cases small : k<11
    · unfold wire
      rw [wires_input _ _ _ (by simpa using small),
        wires_input _ _ _ (by simpa using small)]
      exact raw k small hk
    by_cases big : 11+C.size ≤ k
    · unfold wire
      rw [List.getD_eq_default _ _ (by simpa [wires_length,Circuit.size] using big),
        List.getD_eq_default _ _ (by simpa [wires_length,Circuit.size] using big)]
    let j : Fin C.size := ⟨k-11,by omega⟩
    have eq : 11+j.val=k := by dsimp [j]; omega
    have step (z : Input) : wire C z k=(C.gates.get j).op.eval
        ((C.gates.get j).inputs.map fun i => if i<k then wire C z i else false) := by
      have h := wires_gate C (inputs z) j.val j.isLt
      change wire C z ((inputs z).length+j.val) = (C.gates.get j).op.eval
        ((C.gates.get j).inputs.map fun i => if i<(inputs z).length+j.val then wire C z i else false) at h
      rw [inputs_length,eq] at h
      exact h
    rw [step x,step y]
    congr 1
    apply List.map_congr_left
    intro i hi
    by_cases lt : i<k
    · simp only [lt,ite_true]
      by_cases r : region i
      · exact ih i lt r
      · exact cross j (eq ▸ hk) i hi r
    · simp only [lt,ite_false]

def blend (s : Finset (Fin 10)) (x y : Input) : Input := fun i => if i∈s then x i else y i

theorem inputs_eq (x y : Input) (s : Finset (Fin 10)) (L : Finset Nat)
    (hs : ∀ i : Fin 10, i.val ∈ L ↔ i∈s) (hn : 10∈L ↔ (0 : Fin 10)∈s)
    (inside : Bool) (agree' : ∀ i : Fin 10, decide (i∈s)=inside → x i=y i)
    (i : Nat) (hi : i<11) (side : decide (i∈L)=inside) :
    (inputs x).getD i false=(inputs y).getD i false := by
  by_cases h : i<10
  · let j : Fin 10 := ⟨i,h⟩
    have e := agree' j (by simpa only [← hs j] using side)
    have val (z : Input) : (inputs z).getD i false = z j := by
      unfold inputs
      rw [List.getD_append _ _ _ _ (by simpa using h)]
      simp only [List.getD_eq_getElem?_getD,List.getElem?_ofFn,h,↓reduceDIte,Option.getD_some,j]
    rwa [val x,val y]
  · have e : i=10 := by omega
    subst i
    have z := agree' 0 (by simpa only [← hn] using side)
    have val (a : Input) : (inputs a).getD 10 false = !a 0 := by
      unfold inputs
      rw [List.getD_append_right _ _ _ _ (by simp)]
      simp
    rw [val x,val y,z]

def signature (C : Circuit) (B : Finset Nat) (x : Input) (i : B) := wire C x i.val
def cutCondition (C : Circuit) (L B : Finset Nat) :=
  ∀ j : Fin C.size, ∀ i ∈ (C.gates.get j).inputs,
    (11+j.val ∈ L → i∈L) ∧ (11+j.val ∉ L → i∈L → i∈B)

theorem separates (C : Circuit) (s : Finset (Fin 10)) (L B : Finset Nat)
    (hs : ∀ i : Fin 10, i.val ∈ L ↔ i∈s) (hn : 10∈L ↔ (0 : Fin 10)∈s)
    (cut : cutCondition C L B) (out : C.output∈L → C.output∈B)
    (x y z : Input) (same : signature C B x=signature C B y) :
    C.eval (inputs (blend s x z))=C.eval (inputs (blend s y z)) := by
  have left (u : Input) : ∀ i, i∈L → wire C (blend s u z) i=wire C u i := by
    apply agree
    · intro i hi mem
      apply inputs_eq _ _ s L hs hn true _ i hi (by simpa using mem)
      intro j hj
      simp [blend,of_decide_eq_true hj]
    · intro j hj i hi ni
      exact (ni ((cut j i hi).1 hj)).elim
  have bound (i : Nat) (hl : i∈L) (hb : i∈B) :
      wire C (blend s x z) i=wire C (blend s y z) i := by
    rw [left x i hl,left y i hl]
    exact congrFun same ⟨i,hb⟩
  change wire C (blend s x z) C.output=wire C (blend s y z) C.output
  by_cases lo : C.output∈L
  · exact bound _ lo (out lo)
  · apply agree C _ _ (fun i => i∉L) _ _ _ lo
    · intro i hi nmem
      apply inputs_eq _ _ s L hs hn false _ i hi (by simpa using nmem)
      intro j hj
      have n : j∉s := by simpa using hj
      simp [blend,n]
    · intro j hj i hi ni
      have il : i∈L := by classical exact not_not.mp ni
      exact bound i il ((cut j i hi).2 hj il)

-- The representatives distinguish the left rows using the empty and singleton right inputs.
open PEqualNP.CircuitLowerBounds

def adj : List Nat := [50,69,138,276,521,385,770,548,104,208]
def graph (x : Input) : Bool := decide (∃ i j : Fin 10, x i=true ∧ x j=true ∧ (adj.getD i.val 0).testBit j.val=true)
def row (m : Nat) : Input := fun i => m.testBit i.val
def leftSet (m : Nat) : Finset (Fin 10) := Finset.univ.filter (row m ·)
def mask (s : Finset (Fin 10)) : Nat := (BitVec.ofBoolListLE (List.ofFn fun i : Fin 10 => decide (i∈s))).toNat

theorem mask_lt (s : Finset (Fin 10)) : mask s < 1024 := by
  have h := (BitVec.ofBoolListLE (List.ofFn fun i : Fin 10 => decide (i∈s))).isLt
  simpa [mask] using h

theorem mask_set (s : Finset (Fin 10)) : leftSet (mask s)=s := by
  apply Finset.ext
  intro i
  have h : (mask s).testBit i.val = decide (i∈s) := by
    change (BitVec.ofBoolListLE _).getLsbD _ = _
    rw [BitVec.getLsbD_ofBoolListLE]
    simp only [List.getD_eq_getElem?_getD,List.getElem?_ofFn,i.isLt,↓reduceDIte,Option.getD_some]
  change i ∈ Finset.univ.filter (fun j : Fin 10 => (mask s).testBit j.val=true) ↔ i∈s
  simp only [Finset.mem_filter,Finset.mem_univ,true_and,h,decide_eq_true_eq]

