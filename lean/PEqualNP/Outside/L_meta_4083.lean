def W : List ℕ := W0 ++ W1 ++ W2 ++ W3 ++ W4 ++ W5 ++ W6 ++ W7

theorem W_len : W.length = 1024 := by decide +kernel

theorem allOK : checkFrom 0 W = true := by decide +kernel

theorem enc (s : Finset (Fin 10)) : ∃ t < 1024, ∀ i : Fin 10, i ∈ s ↔ t.testBit i.val = true := by
  induction s using Finset.induction_on with
  | empty => exact ⟨0, by norm_num, fun i => by simp⟩
  | @insert a s ha ih =>
    obtain ⟨t, ht, hts⟩ := ih
    refine ⟨t ||| 2 ^ a.val, ?_, fun i => ?_⟩
    · show t ||| 2 ^ a.val < 2 ^ 10
      exact Nat.or_lt_two_pow (by simpa using ht) (Nat.pow_lt_pow_right (by norm_num) a.isLt)
    · rw [Finset.mem_insert, Nat.testBit_or, Nat.testBit_two_pow, hts i]
      rw [Bool.or_eq_true, decide_eq_true_iff, Fin.ext_iff]
      constructor <;> rintro (h | h) <;>
        first | exact Or.inl h | exact Or.inr h | exact Or.inr h.symm | exact Or.inl h.symm

theorem count_le {α β γ : Type*} [DecidableEq β] [Fintype α] (B : α → β) (sig : ℕ → γ)
    (base : ℕ → α) (L : List ℕ) (hnd : (L.map sig).Nodup)
    (h : ∀ m m', B (base m) = B (base m') → sig m = sig m') :
    L.length ≤ (Finset.univ.image B).card := by
  have hLnd : L.Nodup := List.Nodup.of_map _ hnd
  rw [← List.toFinset_card_of_nodup hLnd]
  have hinj : Set.InjOn (fun m => B (base m)) (L.toFinset : Set ℕ) := by
    intro m hm m' hm' he
    exact List.inj_on_of_nodup_map hnd (List.mem_toFinset.1 hm) (List.mem_toFinset.1 hm')
      (h m m' he)
  rw [← Finset.card_image_of_injOn hinj]
  apply Finset.card_le_card
  intro b hb
  obtain ⟨m, _, rfl⟩ := Finset.mem_image.1 hb
  exact Finset.mem_image.2 ⟨base m, Finset.mem_univ _, rfl⟩

