theorem truth_all (m : Nat) (hm : m<1024) : graph (row m)=truth.testBit m := by
  let g : Fin 32 := ⟨m/32, by omega⟩
  let i : Fin 32 := ⟨m%32, by omega⟩
  have e : 32*g.val+i.val=m := by dsimp [g,i]; omega
  rw [←e]
  have chunk : ∀ j : Fin 32, ∀ i : Fin 32, graph (row (32*j.val+i.val))=truth.testBit (32*j.val+i.val) := by
    intro j
    fin_cases j
    · exact truth0
    · exact truth1
    · exact truth2
    · exact truth3
    · exact truth4
    · exact truth5
    · exact truth6
    · exact truth7
    · exact truth8
    · exact truth9
    · exact truth10
    · exact truth11
    · exact truth12
    · exact truth13
    · exact truth14
    · exact truth15
    · exact truth16
    · exact truth17
    · exact truth18
    · exact truth19
    · exact truth20
    · exact truth21
    · exact truth22
    · exact truth23
    · exact truth24
    · exact truth25
    · exact truth26
    · exact truth27
    · exact truth28
    · exact truth29
    · exact truth30
    · exact truth31
  exact chunk g i
