theorem PEqualNP.Outside.L_meta_4083 : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x2 : Fin (10 : ℕ) → Bool), x1.eval (List.ofFn x2 ++ [!x2 (0 : Fin (10 : ℕ))]) = (fun (x3 : Fin (10 : ℕ) → Bool) => Decidable.decide (∃ (x4 : Fin (10 : ℕ)) (x5 : Fin (10 : ℕ)), x3 x4 = Bool.true ∧ x3 x5 = Bool.true ∧ ([(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)].getD ↑x4 (0 : ℕ)).testBit ↑x5 = Bool.true)) x2) → ∀ (x3 : Finset (Fin (10 : ℕ))) (x4 x5 : Finset ℕ), (∀ (x6 : Fin (10 : ℕ)), ↑x6 ∈ x4 ↔ x6 ∈ x3) → ((10 : ℕ) ∈ x4 ↔ (0 : Fin (10 : ℕ)) ∈ x3) → (∀ (x8 : Fin x1.size), ∀ x9 ∈ (x1.gates.get x8).inputs, ((11 : ℕ) + ↑x8 ∈ x4 → x9 ∈ x4) ∧ ((11 : ℕ) + ↑x8 ∉ x4 → x9 ∈ x4 → x9 ∈ x5)) → (x1.output ∈ x4 → x1.output ∈ x5) → [(1 : ℕ), (2 : ℕ), (4 : ℕ), (6 : ℕ), (9 : ℕ), (12 : ℕ), (9 : ℕ), (9 : ℕ), (5 : ℕ), (3 : ℕ), (2 : ℕ)].getD x3.card (0 : ℕ) ≤ (Finset.image (fun (x10 : Fin (10 : ℕ) → Bool) (x11 : ↥x5) => (x1.wires (List.ofFn x10 ++ [!x10 (0 : Fin (10 : ℕ))])).getD (↑x11) Bool.false) Finset.univ).card := by
  intro C hf x3 x4 x5 h4 h10 hg hout
  obtain ⟨t, ht, hts⟩ := enc x3
  have hx3 : x3 = Finset.univ.filter fun i : Fin 10 => t.testBit i.val = true := by
    ext i; simp [hts]
  have hc := checkFrom_get W 0 allOK t (by rw [W_len]; exact ht)
  rw [Nat.zero_add] at hc
  simp only [check1, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨hlen, hdist⟩ := hc
  have hnd := distinct_nodup _ hdist
  have hcard : x3.card = pc t := by rw [hx3]; rfl
  have hg' : ∀ k (hk : k < C.gates.length), ∀ i ∈ (C.gates[k]).inputs,
      (11 + k ∈ x4 → i ∈ x4) ∧ (11 + k ∉ x4 → i ∈ x4 → i ∈ x5) := by
    intro k hk i hi
    exact hg ⟨k, hk⟩ i hi
  have hf' : ∀ x, C.eval (xs x) = f x := fun x => hf x
  let α : ℕ → Fin 10 → Bool := fun m i => (mix t m 0).testBit i.val
  have sig_eq : ∀ m m', (∀ j ∈ x5, (C.wires (xs (α m))).getD j false =
      (C.wires (xs (α m'))).getD j false) → sigL t m = sigL t m' := by
    intro m m' hB
    have gen : ∀ y : ℕ, fN (mix t m y) = fN (mix t m' y) := by
      intro y
      rw [← f_fN, ← f_fN, ← hf', ← hf']
      apply key C x3 x4 x5 h4 h10 hg' hout (α m) (α m') hB
      · intro i hi
        simp only [α, mix_bit _ _ _ _ i.isLt, (hts i).1 hi, ite_true]
      · intro i hi
        simp only [α, mix_bit _ _ _ _ i.isLt, (hts i).1 hi, ite_true]
      · intro i hi
        have hti : t.testBit i.val = false := by
          cases h : t.testBit i.val
          · rfl
          · exact absurd ((hts i).2 h) hi
        simp only [mix_bit _ _ _ _ i.isLt, hti, Bool.false_eq_true, ite_false]
    unfold sigL
    apply List.map_congr_left
    intro v _
    unfold sigb
    split_ifs
    · exact gen _
    · exact gen _
  have h1 : tab.getD x3.card 0 ≤ (dec (W.getD t 0)).length := by rw [hcard]; exact hlen
  exact le_trans h1 (count_le _ (sigL t) α _ hnd
    (fun m m' he => sig_eq m m' (fun j hj => congrFun he ⟨j, hj⟩)))
