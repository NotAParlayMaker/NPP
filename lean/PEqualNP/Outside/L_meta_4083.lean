-- Wire machinery for Circuit.wires (the fold over the gates).

def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem wires_eq (C : Circuit) (x : List Bool) : C.wires x = C.gates.foldl step x := rfl

theorem fold_prefix (gs : List Gate) : ∀ w : List Bool,
    ∃ t : List Bool, gs.foldl step w = w ++ t ∧ t.length = gs.length := by
  induction gs with
  | nil => intro w; exact ⟨[], by simp, rfl⟩
  | cons g gs ih =>
    intro w
    obtain ⟨t, ht, hl⟩ := ih (step w g)
    refine ⟨g.op.eval (g.inputs.map fun i => w.getD i false) :: t, ?_, by simp [hl]⟩
    rw [List.foldl_cons, ht]; simp [step]

theorem fold_length (gs : List Gate) (w : List Bool) :
    (gs.foldl step w).length = w.length + gs.length := by
  obtain ⟨t, ht, hl⟩ := fold_prefix gs w
  rw [ht]; simp [hl]

theorem fold_getD_lt (gs : List Gate) (w : List Bool) (i : ℕ) (h : i < w.length) :
    (gs.foldl step w).getD i false = w.getD i false := by
  obtain ⟨t, ht, _⟩ := fold_prefix gs w
  rw [ht, List.getD_append _ _ _ _ h]

def rd (C : Circuit) (x : List Bool) (g i : ℕ) : Bool :=
  if i < g then (C.wires x).getD i false else false

theorem wires_length (C : Circuit) (x : List Bool) :
    (C.wires x).length = x.length + C.gates.length := fold_length _ _

theorem wires_input (C : Circuit) (x : List Bool) (i : ℕ) (h : i < x.length) :
    (C.wires x).getD i false = x.getD i false := fold_getD_lt _ _ _ h

theorem wires_gate (C : Circuit) (x : List Bool) (j : ℕ) (hj : j < C.gates.length) :
    (C.wires x).getD (x.length + j) false
      = C.gates[j].op.eval (C.gates[j].inputs.map fun i => rd C x (x.length + j) i) := by
  have hsplit : C.gates = C.gates.take j ++ C.gates[j] :: C.gates.drop (j + 1) := by
    simp
  set A := (C.gates.take j).foldl step x with hA
  have hAl : A.length = x.length + j := by
    rw [hA, fold_length]; simp; omega
  have hw : C.wires x = (C.gates.drop (j + 1)).foldl step (step A C.gates[j]) := by
    rw [wires_eq]
    conv_lhs => rw [hsplit]
    rw [List.foldl_append, List.foldl_cons]
  have hreadA : ∀ i, A.getD i false = rd C x (x.length + j) i := by
    intro i
    unfold rd
    by_cases hi : i < x.length + j
    · rw [if_pos hi, hw, fold_getD_lt _ (step A C.gates[j]) i (by simp [step]; omega), step,
        List.getD_append _ _ _ _ (by omega)]
    · rw [if_neg hi, List.getD_eq_default]; omega
  rw [hw, fold_getD_lt _ _ _ (by simp [step]; omega), step,
    List.getD_append_right _ _ _ _ (by omega)]
  simp only [hAl, Nat.sub_self]
  simp only [List.getD_cons_zero]
  congr 1
  exact List.map_congr_left (fun i _ => hreadA i)

-- Two inputs whose wires agree on a set T of wires that is closed under reading
-- (every wire read by a gate in T is in T or already agrees).
theorem agree (C : Circuit) (x x' : List Bool) (hl : x.length = x'.length) (T : ℕ → Prop)
    (hin : ∀ i, i < x.length → T i → x.getD i false = x'.getD i false)
    (hg : ∀ j (hj : j < C.gates.length), T (x.length + j) → ∀ k ∈ C.gates[j].inputs,
      k < x.length + j → T k ∨ (C.wires x).getD k false = (C.wires x').getD k false) :
    ∀ w, T w → (C.wires x).getD w false = (C.wires x').getD w false := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w ih =>
  intro hT
  by_cases h1 : w < x.length
  · rw [wires_input C x w h1, wires_input C x' w (hl ▸ h1)]
    exact hin w h1 hT
  by_cases h2 : w < x.length + C.gates.length
  · obtain ⟨j, rfl⟩ : ∃ j, w = x.length + j := ⟨w - x.length, by omega⟩
    have hj : j < C.gates.length := by omega
    have e2 := wires_gate C x' j hj
    rw [← hl] at e2
    rw [wires_gate C x j hj, e2]
    congr 1
    apply List.map_congr_left
    intro k hk
    unfold rd
    by_cases hk2 : k < x.length + j
    · rw [if_pos hk2, if_pos hk2]
      rcases hg j hj hT k hk hk2 with h | h
      · exact ih k hk2 h
      · exact h
    · rw [if_neg hk2, if_neg hk2]
  · rw [List.getD_eq_default _ _ (by rw [wires_length]; omega),
      List.getD_eq_default _ _ (by rw [wires_length]; omega)]

def inp (u : Fin 10 → Bool) : List Bool := List.ofFn u ++ [!u 0]

theorem inp_length (u : Fin 10 → Bool) : (inp u).length = 11 := by simp [inp]

theorem inp_getD_lt (u : Fin 10 → Bool) (i : ℕ) (h : i < 10) :
    (inp u).getD i false = u ⟨i, h⟩ := by
  unfold inp
  rw [List.getD_append _ _ _ _ (by simpa using h)]
  rw [List.getD_eq_getElem?_getD, List.getElem?_ofFn]
  simp [h]

theorem inp_getD_10 (u : Fin 10 → Bool) : (inp u).getD 10 false = !u 0 := by
  unfold inp
  rw [List.getD_append_right _ _ _ _ (by simp)]
  simp

-- Wires inside the closed set A depend only on the inputs in S.
theorem lemA (C : Circuit) (S : Finset (Fin 10)) (A : Finset ℕ)
    (H1 : ∀ i : Fin 10, (i : ℕ) ∈ A ↔ i ∈ S) (H2 : (10 : ℕ) ∈ A ↔ (0 : Fin 10) ∈ S)
    (H3a : ∀ j (hj : j < C.gates.length), 11 + j ∈ A → ∀ k ∈ C.gates[j].inputs, k ∈ A)
    (u u' : Fin 10 → Bool) (hu : ∀ i ∈ S, u i = u' i) :
    ∀ w ∈ A, (C.wires (inp u)).getD w false = (C.wires (inp u')).getD w false := by
  intro w hw
  refine agree C (inp u) (inp u') (by simp [inp]) (· ∈ A) ?_ ?_ w hw
  · intro i hi hiA
    rw [inp_length] at hi
    by_cases h10 : i < 10
    · rw [inp_getD_lt u i h10, inp_getD_lt u' i h10]
      exact hu _ ((H1 ⟨i, h10⟩).1 hiA)
    · have : i = 10 := by omega
      subst this
      rw [inp_getD_10, inp_getD_10, hu 0 (H2.1 hiA)]
  · intro j hj hjA k hk _
    rw [inp_length] at hjA
    exact Or.inl (H3a j hj hjA k hk)

-- Outside A, the wires depend only on the inputs outside S and the boundary wires.
theorem lemB (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (H1 : ∀ i : Fin 10, (i : ℕ) ∈ A ↔ i ∈ S) (H2 : (10 : ℕ) ∈ A ↔ (0 : Fin 10) ∈ S)
    (H3b : ∀ j (hj : j < C.gates.length), 11 + j ∉ A → ∀ k ∈ C.gates[j].inputs, k ∈ A → k ∈ B)
    (H4 : C.output ∈ A → C.output ∈ B)
    (u u' : Fin 10 → Bool) (hu : ∀ i, i ∉ S → u i = u' i)
    (hB : ∀ k ∈ A, k ∈ B → (C.wires (inp u)).getD k false = (C.wires (inp u')).getD k false) :
    C.eval (inp u) = C.eval (inp u') := by
  have key : ∀ w, w ∉ A → (C.wires (inp u)).getD w false = (C.wires (inp u')).getD w false := by
    refine agree C (inp u) (inp u') (by simp [inp]) (· ∉ A) ?_ ?_
    · intro i hi hiA
      rw [inp_length] at hi
      by_cases h10 : i < 10
      · rw [inp_getD_lt u i h10, inp_getD_lt u' i h10]
        exact hu _ (fun h => hiA ((H1 ⟨i, h10⟩).2 h))
      · have : i = 10 := by omega
        subst this
        rw [inp_getD_10, inp_getD_10, hu 0 (fun h => hiA (H2.2 h))]
    · intro j hj hjA k hk _
      rw [inp_length] at hjA
      by_cases hkA : k ∈ A
      · exact Or.inr (hB k hkA (H3b j hj hjA k hk hkA))
      · exact Or.inl hkA
  unfold Circuit.eval
  by_cases ho : C.output ∈ A
  · exact hB _ ho (H4 ho)
  · exact key _ ho

-- The edge function and its truth table.

def adjL : List ℕ := [50, 69, 138, 276, 521, 385, 770, 548, 104, 208]

def tab : List ℕ := [1, 2, 4, 6, 9, 12, 9, 9, 5, 3, 2]

def fP (x : Fin 10 → Bool) : Bool :=
  decide (∃ (x4 : Fin 10) (x5 : Fin 10), x x4 = true ∧ x x5 = true ∧
    (adjL.getD ↑x4 0).testBit ↑x5 = true)

def mixF (S : Finset (Fin 10)) (u v : Fin 10 → Bool) : Fin 10 → Bool :=
  fun i => if i ∈ S then u i else v i

-- Equal boundary patterns give equal subfunctions.
theorem keyK (C : Circuit) (S : Finset (Fin 10)) (A B : Finset ℕ)
    (H0 : ∀ x, C.eval (inp x) = fP x)
    (H1 : ∀ i : Fin 10, (i : ℕ) ∈ A ↔ i ∈ S) (H2 : (10 : ℕ) ∈ A ↔ (0 : Fin 10) ∈ S)
    (H3a : ∀ j (hj : j < C.gates.length), 11 + j ∈ A → ∀ k ∈ C.gates[j].inputs, k ∈ A)
    (H3b : ∀ j (hj : j < C.gates.length), 11 + j ∉ A → ∀ k ∈ C.gates[j].inputs, k ∈ A → k ∈ B)
    (H4 : C.output ∈ A → C.output ∈ B)
    (u u' v : Fin 10 → Bool)
    (hP : ∀ k ∈ B, (C.wires (inp u)).getD k false = (C.wires (inp u')).getD k false) :
    fP (mixF S u v) = fP (mixF S u' v) := by
  rw [← H0, ← H0]
  apply lemB C S A B H1 H2 H3b H4
  · intro i hi; simp [mixF, hi]
  · intro k hkA hkB
    rw [lemA C S A H1 H2 H3a (mixF S u v) u (by intro i hi; simp [mixF, hi]) k hkA,
        hP k hkB,
        lemA C S A H1 H2 H3a u' (mixF S u' v) (by intro i hi; simp [mixF, hi]) k hkA]

def toFn (n : ℕ) : Fin 10 → Bool := fun i => n.testBit i

def TT : ℕ :=
  

theorem bridge : ∀ n < 1024, fP (toFn n) = TT.testBit n := by decide +kernel

def mixNat (s a y : ℕ) : ℕ := ((a &&& s) ||| (y &&& (1023 ^^^ s))) % 2 ^ 10

def ys : List ℕ := [0, 1, 2, 4, 8, 16, 32, 64, 128, 256, 512]

def row (s a : ℕ) : List Bool := ys.map (fun y => TT.testBit (mixNat s a y))

def popc (s : ℕ) : ℕ := ((Finset.range 10).filter (fun i => s.testBit i = true)).card

def dec (s N : ℕ) : List ℕ :=
  (List.range (tab.getD (popc s) 0)).map (fun k => (N >>> (10 * k)) % 1024)

def check (s N : ℕ) : Bool := decide (((dec s N).map (row s)).Nodup)

def checkAll : List ℕ → ℕ → Bool
  | [], _ => true
  | N :: Ns, s => check s N && checkAll Ns (s + 1)

