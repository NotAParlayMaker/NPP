theorem hlen : WT.length = 1024 := by decide +kernel

theorem hall : checkAll WT 0 = true := by decide +kernel

theorem checkAll_spec : ∀ (Ns : List ℕ) (k : ℕ), checkAll Ns k = true →
    ∀ i, i < Ns.length → check (k + i) (Ns.getD i 0) = true
  | [], _, _, i, hi => by simp at hi
  | N :: Ns, k, h, i, hi => by
    simp only [checkAll, Bool.and_eq_true] at h
    cases i with
    | zero => simpa using h.1
    | succ i =>
      have := checkAll_spec Ns (k + 1) h.2 i (by simpa using hi)
      rw [show k + (i + 1) = k + 1 + i by omega]
      simpa using this

theorem bit1023 : ∀ i : Fin 10, Nat.testBit 1023 i = true := by decide

theorem enc (S : Finset (Fin 10)) : ∃ s : ℕ, s < 1024 ∧
    (∀ i : Fin 10, s.testBit i = decide (i ∈ S)) ∧ S.card = popc s := by
  set T : Finset ℕ := S.map Fin.valEmbedding with hT
  have hb : ∀ i : ℕ, (∑ i ∈ T, 2 ^ i).testBit i = true ↔ i ∈ T := by
    intro i
    rw [← Nat.mem_bitIndices, ← List.mem_toFinset, Finset.toFinset_bitIndices_sum_two_pow]
  have hT10 : ∀ i ∈ T, i < 10 := by
    intro i hi
    rw [hT, Finset.mem_map] at hi
    obtain ⟨a, _, rfl⟩ := hi
    exact a.isLt
  have hTS : ∀ i : Fin 10, (i : ℕ) ∈ T ↔ i ∈ S := by
    intro i
    rw [hT, Finset.mem_map]
    constructor
    · rintro ⟨a, ha, he⟩
      have : a = i := Fin.ext he
      rw [← this]; exact ha
    · intro hi; exact ⟨i, hi, rfl⟩
  refine ⟨∑ i ∈ T, 2 ^ i, ?_, ?_, ?_⟩
  · have := Nat.lt_pow_two_of_testBit (n := 10) (∑ i ∈ T, 2 ^ i) (by
      intro i hi
      by_contra hc
      have h1 : (∑ i ∈ T, 2 ^ i).testBit i = true := by simpa using hc
      have := hT10 i ((hb i).1 h1)
      omega)
    simpa using this
  · intro i
    have := hb i
    rw [hTS] at this
    by_cases h : i ∈ S
    · simp [h] at this ⊢; exact this
    · simp [h] at this ⊢; exact this
  · unfold popc
    rw [← Finset.card_map Fin.valEmbedding]
    congr 1
    ext i
    rw [Finset.mem_filter, Finset.mem_range, hb]
    constructor
    · intro hi; exact ⟨hT10 i hi, hi⟩
    · intro hi; exact hi.2

theorem mix_eq (S : Finset (Fin 10)) (s a y : ℕ)
    (hsb : ∀ i : Fin 10, s.testBit i = decide (i ∈ S)) :
    toFn (mixNat s a y) = mixF S (toFn a) (toFn y) := by
  funext i
  have h1 := bit1023 i
  have h2 := hsb i
  unfold toFn mixNat mixF
  rw [Nat.testBit_mod_two_pow, Nat.testBit_lor, Nat.testBit_land, Nat.testBit_land,
    Nat.testBit_xor, h1, h2]
  by_cases h : i ∈ S
  · simp [h, i.isLt]
  · simp [h, i.isLt]

