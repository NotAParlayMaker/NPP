namespace CliqueCore
open GThreshold PEqualNP.CircuitLowerBounds

def clique (x : Fin 4 → Bool) : Bool :=
  (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) || (x 1 && x 2) || (x 1 && x 3) || (x 2 && x 3)

def sample (k : Fin 512) (i : Fin 4) : Bool := (k4inputs.getD i.val 0)[k.val]

set_option maxRecDepth 64000 in
theorem clique_eval : ∀ k, clique (sample k) = goal[k.val] := by decide +kernel

theorem sample_inputs (k : Fin 512) : List.ofFn (sample k) = k4inputs.map (fun w => w[k.val]) := by
  apply List.ext_getElem (by simp [k4inputs])
  intro i hi hj
  have hlt : i < k4inputs.length := by simpa using hj
  simp only [List.getElem_ofFn, sample, List.getElem_map, List.getD_eq_getElem?_getD,
    List.getElem?_eq_getElem hlt, Option.getD_some]

set_option maxRecDepth 8000 in
theorem terminal : ¬ SignedBuild 6 k4inputs.toFinset goal := by
  rintro (za|oa|ha|hb)
  · exact (by decide +kernel : goal ≠ (0 : W)) za
  · exact (by decide +kernel : goal ≠ ~~~(0 : W)) oa
  · have hit := search_complete (Or.inl rfl) 6 k4inputs (by decide +kernel) ha
    exact Bool.noConfusion (k4exact.symm.trans hit)
  · have hit := search_complete (Or.inr rfl) 6 k4inputs (by decide +kernel) hb
    exact Bool.noConfusion (k4exact.symm.trans hit)

theorem sevenBinary (D : Circuit) (hg : ∀ g ∈ D.gates, legal g)
    (he : ∀ x : Fin 4 → Bool, D.eval (List.ofFn x) = clique x) : 7 ≤ binaryCost D.gates := by
  by_contra! low
  have init : ∀ u ∈ k4inputs, holds k4inputs.toFinset u := fun u hu =>
    .inr (.inr ⟨u,List.mem_toFinset.mpr hu,.inl rfl⟩)
  obtain ⟨t,ht,run⟩ := compile D.gates D.output hg k4inputs k4inputs.toFinset init (by
    intro k
    change D.eval (k4inputs.map fun w => w[k.val]) = goal[k.val]
    rw [← sample_inputs, he, clique_eval])
  apply terminal
  apply sb_le (k := binaryCost D.gates) (by omega)
  rcases ht with rfl|rfl
  · exact Or.inr (Or.inr (Or.inl run))
  · exact Or.inr (Or.inr (Or.inr run))

end CliqueCore

namespace CliqueCore
open PEqualNP.CircuitLowerBounds

theorem binary_sum (gs : List Gate) :
    GThreshold.binaryCost gs + (gs.filter SevenTrack.ntag).length = gs.length := by
  induction gs with
  | nil => rfl
  | cons g gs ih =>
    obtain ⟨op, args⟩ := g
    cases op <;> simp [GThreshold.binaryCost, GThreshold.isBinary, SevenTrack.ntag, List.filter_cons] at * <;> omega

theorem core (D : Circuit) (hg : ∀ g ∈ D.gates, GThreshold.legal g)
    (he : ∀ y : Fin 4 → Bool, D.eval (List.ofFn y) = GraphPin.clique y) :
    7 ≤ BinaryPin.bc D.gates := by
  have h := sevenBinary D hg he
  have hb := binary_sum D.gates
  unfold BinaryPin.bc
  omega

end CliqueCore

