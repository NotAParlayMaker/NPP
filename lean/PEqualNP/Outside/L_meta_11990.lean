theorem countBinary (C : Circuit) (good : FanInTwo C)
    (he : ∀ x, C.eval (List.ofFn x) = target x) : 8 ≤ full_binaryCost C.gates := by
  have computed (k : Fin 128) :
      (C.gates.foldl full_step (inputs.map (full_bit128 k))).getD C.output false = full_bit128 k target7 := by
    let x (i : Fin 7) : Bool := full_bit128 k (inputs.getD i.val 0)
    have width : inputs.length = 7 := rfl
    have same : List.ofFn x = inputs.map (full_bit128 k) := by
      apply List.ext_getElem
      · simp [width]
      · intro i hi hj
        have hlt : i < inputs.length := by simpa using hj
        simp only [List.getElem_ofFn, List.getElem_map, x, List.getD_eq_getElem?_getD,
          List.getElem?_eq_getElem hlt, Option.getD_some]
    change C.eval (inputs.map (full_bit128 k)) = _
    rw [← same, he]
    exact samples k
  have available : ∀ u ∈ inputs, holds raw7.toFinset u := by
    have hyp : inputs.all (fun u => raw7.contains u) = true := by decide +kernel
    intro u hu
    exact .inr (.inr ⟨u,List.mem_toFinset.mpr (List.contains_iff_mem.mp (List.all_eq_true.mp hyp u hu)),.inl rfl⟩)
  have legal (g) (hg : g ∈ C.gates) : full_legal g := by
    obtain ⟨op,arity⟩ := good g hg
    exact ⟨by simpa only [Set.mem_insert_iff,Set.mem_singleton_iff] using op, arity⟩
  obtain ⟨t,ht,hb⟩ := full_compile target7 (by decide +kernel) (by decide +kernel)
    C.gates C.output legal inputs raw7.toFinset available computed
  apply lower7 _
  rcases ht with rfl | rfl
  · exact .inr (.inr (.inl hb))
  · exact .inr (.inr (.inr hb))

theorem withNot (C : Circuit) (good : FanInTwo C)
    (he : ∀ x, C.eval (List.ofFn x) = target x)
    (hasNot : ∃ g ∈ C.gates, g.op = GateOp.not) : 9 ≤ C.size := by
  obtain ⟨g,hg,hn⟩ := hasNot
  have h : full_binaryCost C.gates < C.gates.length :=
    (List.length_filter_lt_length_iff_exists (p := full_isBinary)).mpr
      ⟨g,hg,by simp [full_isBinary,hn]⟩
  have hb := countBinary C good he
