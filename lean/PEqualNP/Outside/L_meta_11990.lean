abbrev full_W128 := BitVec 128

def full_bit128 (k : Fin 128) (z : full_W128) : Bool := z[k.val]

def full_step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

theorem full_read_bit128 (w : List full_W128) (i : ℕ) (k : Fin 128) :
    (w.map (full_bit128 k)).getD i false = full_bit128 k (w.getD i 0) := by
  by_cases h : i < w.length
  · simp [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem h]
  · simp [List.getD_eq_getElem?_getD, List.getElem?_map,
      List.getElem?_eq_none (Nat.le_of_not_gt h), full_bit128]

def full_legal (g : Gate) : Prop :=
  (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2

def full_action (w : List full_W128) (g : Gate) : full_W128 := match g.op with
  | .not => ~~~(g.inputs.head?.map (fun i => w.getD i 0)).getD 0
  | .and => (g.inputs.map fun i => w.getD i 0).foldr (· &&& ·) (~~~0)
  | .or => (g.inputs.map fun i => w.getD i 0).foldr (· ||| ·) 0
  | _ => 0

set_option maxRecDepth 5000 in
theorem full_action_spec (w : List full_W128) (g : Gate) (hg : full_legal g) (k : Fin 128) :
    full_step (w.map (full_bit128 k)) g = (w ++ [full_action w g]).map (full_bit128 k) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩ <;> simp at cap
  all_goals have bit0 : (0 : full_W128)[k.val] = false := by change (0#128)[k.val] = false; simp
  all_goals rcases hop with rfl | rfl | rfl <;>
    simp only [full_step, List.map_cons, List.map_nil, full_read_bit128, List.map_append] <;>
    simp only [full_action, GateOp.eval, List.foldr_cons, List.foldr_nil, List.head?_cons, List.head?_nil,
      List.headD_cons, List.headD_nil, Option.map_some, Option.map_none, Option.getD_some, Option.getD_none,
      List.all_cons, List.all_nil, List.any_cons, List.any_nil, List.map_cons, List.map_nil, id_eq,
      Bool.and_true, Bool.or_false, full_bit128, BitVec.getElem_and, BitVec.getElem_or, BitVec.getElem_not,
      bit0, Bool.not_false]

def full_isBinary (g : Gate) : Bool := match g.op with
  | .not => false
  | _ => true

def full_binaryCost (gs : List Gate) : ℕ := (gs.filter full_isBinary).length

theorem full_available_read {av : Finset full_W128} {w : List full_W128} (hw : ∀ u ∈ w, holds av u) (i : ℕ) :
    holds av (w.getD i 0) := by
  by_cases h : i < w.length
  · exact hw _ (by simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h])
  · rw [List.getD_eq_default _ _ (Nat.le_of_not_gt h)]
    exact .inl rfl

set_option maxRecDepth 5000 in
theorem full_gate_reach (w : List full_W128) (av : Finset full_W128) (hw : ∀ u ∈ w, holds av u)
    (g : Gate) (hg : full_legal g) :
    if full_isBinary g then reachable av (full_action w g) else holds av (full_action w g) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩ <;> simp at cap
  all_goals rcases hop with rfl | rfl | rfl <;> simp only [full_isBinary, Bool.false_eq_true, ite_false, ite_true,
    full_action, List.head?_nil, List.head?_cons, List.map_nil, List.map_cons, List.foldr_nil, List.foldr_cons,
    Option.map_none, Option.map_some, Option.getD_none, Option.getD_some,
    show ∀ x : full_W128, x ||| (0 : full_W128) = x from fun x => BitVec.or_zero,
    show ∀ x : full_W128, x &&& ~~~0 = x from fun x => BitVec.and_allOnes]
  all_goals first
    | exact .inl (.inl rfl)
    | exact .inl (.inr (.inl rfl))
    | exact .inr (.inl rfl)
    | exact .inl (full_available_read hw _)
    | exact holds_not (full_available_read hw _)
    | exact and_reach (full_available_read hw _) (full_available_read hw _)
    | exact or_reach (full_available_read hw _) (full_available_read hw _)

