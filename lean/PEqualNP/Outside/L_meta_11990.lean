def can8 (goal : BitVec 8) : Nat → List (BitVec 8) → Bool
  | 0, ws => ws.contains goal
  | k+1, ws => can8 goal k ws || ws.any (fun a => ws.any (fun b => a != b &&
      (ops a b).any (fun z => can8 goal k (z :: ws))))

theorem can8_complete (goal : BitVec 8) (k) (ws : List (BitVec 8))
    (h : build basicOps goal k ws.toFinset) : can8 goal k ws = true := by
  induction k generalizing ws with
  | zero => exact List.contains_iff_mem.mpr (List.mem_toFinset.mp h)
  | succ k ih =>
    simp only [can8, Bool.or_eq_true, List.any_eq_true, Bool.and_eq_true, bne_iff_ne]
    rcases h with h | ⟨a,ha,b,hb,ne,z,hz,tail⟩
    · exact .inl (ih ws h)
    · exact .inr ⟨a,List.mem_toFinset.mp ha,b,List.mem_toFinset.mp hb,ne,z,
        List.mem_toFinset.mp hz,ih (z :: ws) (by simpa only [List.toFinset_cons] using tail)⟩

