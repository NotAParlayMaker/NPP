theorem edges (x : Fin 8 → Bool) :
    (((x 0 && x 1) || (x 0 && x 5) || (x 1 && x 2) || (x 2 && x 3) || (x 2 && x 7) || (x 3 && x 4) || (x 3 && x 6) || (x 4 && x 5)) = true ↔
