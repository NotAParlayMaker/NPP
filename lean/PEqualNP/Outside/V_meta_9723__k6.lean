noncomputable def lgL (ss : List Nat) : Nat → Nat → Nat :=
  List.rec (motive := fun _ => Nat → Nat → Nat) (fun _ acc => acc)
    (fun s _ ih U acc =>
      Bool.rec (ih (Nat.shiftRight U s) (Nat.add acc s)) (ih U acc) (Nat.beq (Nat.shiftRight U s) 0)) ss

def sh : List Nat := [16384, 8192, 4096, 2048, 1024, 512, 256, 128, 64, 32, 16, 8, 4, 2, 1]

abbrev GCont := Trie → Nat → Bool → Nat → Nat → List Nat

noncomputable def gUnit (k : GCont) (db : Trie) (id C F x u : Nat) : List Nat :=
  x :: u :: k db id true C (setBit F (neg u))

noncomputable def gU (k : GCont) (db : Trie) (id C F x U : Nat) : List Nat :=
  Bool.rec (gUnit k db id C F x (lgL sh U 0)) (x :: k (db.set 64 (Nat.sub id 1) (some C)) 0 false 0 0)
    (Nat.beq U 0)

noncomputable def gStep (k : GCont) (x : Nat) : GCont := fun db id mode C F =>
  Bool.rec
    (Bool.rec
      (Bool.rec (x :: k db id false (setBit C x) F) (x :: k db id true C C) (Nat.beq x 0))
      (x :: k db (Nat.succ x) false C F) (Nat.beq id 0))
    (Option.rec [] (fun D => gU k db id C F x (Nat.xor D (Nat.land D F))) (db.get x))
    mode

noncomputable def gen (toks : List Nat) : GCont :=
  List.rec (motive := fun _ => GCont) (fun _ _ _ _ _ => []) (fun x _ k => gStep k x) toks

