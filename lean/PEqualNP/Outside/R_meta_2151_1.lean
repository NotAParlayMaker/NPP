  intro C hFan hFirst hFun hOr
  cases hg : C.gates[1]? with
  | none =>
    rw [hg] at hOr
    simp at hOr
  | some g =>
    obtain ⟨hlt, heq⟩ := List.getElem?_eq_some_iff.1 hg
    have mem : g ∈ C.gates := heq ▸ List.getElem_mem hlt
    obtain ⟨hop, hlen⟩ := hFan g mem
    obtain ⟨gop, gins⟩ := g
    rw [hg] at hOr
    have hop' : gop = .or := Option.some.inj hOr
    subst hop'
    match gins, hlen with
