      · exact twoInputs C hFan hFirst hFun ⟨a, b, hab.1, hab.2, hg⟩
      · have : (9 : ℕ) ≤ a ∨ 9 ≤ b := by omega
        exact highWire C hFan hFirst hFun ⟨a, b, this, hg⟩
    | _::(_::_::_), h => exact absurd h (by simp)
