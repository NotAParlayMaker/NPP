theorem PEqualNP.Outside.R_meta_3568_1
    (h1 : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj], (∃ c : Fin n → Bool, ∀ u v : Fin n, G.Adj u v → c u ≠ c v) → PEqualNP.TopForm.NoFourCycle G → 2 ≤ G.edgeFinset.card → ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsLeastAO G C → ∀ z : Fin n, (∃ j < C.gates.length, (PEqualNP.MetaComplexity.NestedCover.gateAt C j).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (z : ℕ) ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt C j).inputs) → ∃ D : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsAO2 n D ∧ (∀ y : Fin n → Bool, PEqualNP.MetaComplexity.circuitFun n D y = true ↔ ∃ a b : Fin n, (G.deleteEdges (G.incidenceSet z)).Adj a b ∧ y a = true ∧ y b = true) ∧ D.size + G.degree z ≤ C.size)
    (h2 : ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj], (∃ c : Fin n → Bool, ∀ u v : Fin n, G.Adj u v → c u ≠ c v) → PEqualNP.TopForm.NoFourCycle G → 2 ≤ G.edgeFinset.card → ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsLeastAO G C → ∀ z : Fin n, (∃ j < C.gates.length, (PEqualNP.MetaComplexity.NestedCover.gateAt C j).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (z : ℕ) ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt C j).inputs) → (∃ p q : Fin n, (G.deleteEdges (G.incidenceSet z)).Adj p q) → (∃ S : Finset (Fin n), PEqualNP.MetaComplexity.CoverPromise.IsVertexCover (G.deleteEdges (G.incidenceSet z)) S ∧ ∀ T : Finset (Fin n), PEqualNP.MetaComplexity.CoverPromise.IsVertexCover G T → S.card < T.card) → ∃ D : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsAO2 n D ∧ (∀ y : Fin n → Bool, PEqualNP.MetaComplexity.circuitFun n D y = true ↔ ∃ a b : Fin n, (G.deleteEdges (G.incidenceSet z)).Adj a b ∧ y a = true ∧ y b = true) ∧ D.size + G.degree z + 1 ≤ C.size) :
    ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj], (∃ c : Fin n → Bool, ∀ u v : Fin n, G.Adj u v → c u ≠ c v) → PEqualNP.TopForm.NoFourCycle G → 2 ≤ G.edgeFinset.card → ∀ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsLeastAO G C → ∀ z : Fin n, (∃ j < C.gates.length, (PEqualNP.MetaComplexity.NestedCover.gateAt C j).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (z : ℕ) ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt C j).inputs) → ∃ D : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.TopForm.IsAO2 n D ∧ PEqualNP.MetaComplexity.circuitFun n D = (fun y : Fin n → Bool => @decide (∃ a b : Fin n, (G.deleteEdges (G.incidenceSet z)).Adj a b ∧ y a = true ∧ y b = true) (Classical.propDecidable _)) ∧ D.size + G.degree z ≤ C.size ∧ ((∃ p q : Fin n, (G.deleteEdges (G.incidenceSet z)).Adj p q) → (∃ S : Finset (Fin n), PEqualNP.MetaComplexity.CoverPromise.IsVertexCover (G.deleteEdges (G.incidenceSet z)) S ∧ ∀ T : Finset (Fin n), PEqualNP.MetaComplexity.CoverPromise.IsVertexCover G T → S.card < T.card) → D.size + G.degree z + 1 ≤ C.size) := by
  intro n G _ hb hc he C hC z hz
  by_cases hx : (∃ p q : Fin n, (G.deleteEdges (G.incidenceSet z)).Adj p q) ∧ (∃ S : Finset (Fin n), PEqualNP.MetaComplexity.CoverPromise.IsVertexCover (G.deleteEdges (G.incidenceSet z)) S ∧ ∀ T : Finset (Fin n), PEqualNP.MetaComplexity.CoverPromise.IsVertexCover G T → S.card < T.card)
  · obtain ⟨D, a, b, c⟩ := h2 n G hb hc he C hC z hz hx.1 hx.2
    exact ⟨D, a, funext fun y => Bool.eq_iff_iff.mpr ((b y).trans (@decide_eq_true_iff _ (Classical.propDecidable _)).symm), by omega, fun _ _ => c⟩
  · obtain ⟨D, a, b, c⟩ := h1 n G hb hc he C hC z hz
    exact ⟨D, a, funext fun y => Bool.eq_iff_iff.mpr ((b y).trans (@decide_eq_true_iff _ (Classical.propDecidable _)).symm), c, fun p s => absurd ⟨p, s⟩ hx⟩
