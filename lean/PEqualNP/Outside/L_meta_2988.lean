lemma gate_mono (g : Gate) (hg : g.op = GateOp.and ∨ g.op = GateOp.or) (W W' : List Bool)
    (h : ∀ i, W.getD i false = true → W'.getD i false = true) :
    g.op.eval (g.inputs.map fun i => W.getD i false) = true →
      g.op.eval (g.inputs.map fun i => W'.getD i false) = true := by
  rcases hg with ho | ho <;> rw [ho]
  · simp only [GateOp.eval, List.all_map, List.all_eq_true, Function.comp, id]
    intro hall i hi
    exact h i (hall i hi)
  · simp only [GateOp.eval, List.any_map, List.any_eq_true, Function.comp, id]
    rintro ⟨i, hi, hv⟩
    exact ⟨i, hi, h i hv⟩

lemma wires_mono (gs : List Gate) (hgs : ∀ g ∈ gs, g.op = GateOp.and ∨ g.op = GateOp.or) :
    ∀ W W' : List Bool, W.length = W'.length →
      (∀ i, W.getD i false = true → W'.getD i false = true) →
      ∀ i, (wiresFrom gs W).getD i false = true → (wiresFrom gs W').getD i false = true := by
  induction gs with
  | nil => intro W W' _ h; exact h
  | cons g gs ih =>
    intro W W' hl h
    have hstep : wiresFrom (g :: gs) W =
        wiresFrom gs (W ++ [g.op.eval (g.inputs.map fun i => W.getD i false)]) := rfl
    have hstep' : wiresFrom (g :: gs) W' =
        wiresFrom gs (W' ++ [g.op.eval (g.inputs.map fun i => W'.getD i false)]) := rfl
    rw [hstep, hstep']
    apply ih (fun g' hg' => hgs g' (List.mem_cons_of_mem _ hg'))
    · simp [hl]
    · intro i hi
      by_cases hlt : i < W.length
      · rw [List.getD_append _ _ _ _ hlt] at hi
        rw [List.getD_append _ _ _ _ (by omega)]
        exact h i hi
      · by_cases heq : i = W.length
        · subst heq
          rw [List.getD_append_right _ _ _ _ (le_refl _)] at hi
          rw [hl, List.getD_append_right _ _ _ _ (le_refl _)]
          simp only [Nat.sub_self, List.getD_cons_zero] at hi ⊢
          exact gate_mono g (hgs g (by simp)) W W' h hi
        · rw [List.getD_eq_default _ _ (by simp; omega)] at hi
          exact absurd hi (by simp)

lemma eval_mono (C : Circuit) (hC : Monotone2 C) {n : ℕ} (x y : Fin n → Bool)
    (hxy : ∀ i, x i = true → y i = true) :
    C.eval (List.ofFn x) = true → C.eval (List.ofFn y) = true := by
  have hgs : ∀ g ∈ C.gates, g.op = GateOp.and ∨ g.op = GateOp.or := by
    intro g hg
    have h := (hC g hg).1
    simpa using h
  exact wires_mono C.gates hgs (List.ofFn x) (List.ofFn y) (by simp) (by
    intro i hi
    by_cases hlt : i < n
    · rw [show (List.ofFn x).getD i false = x ⟨i, hlt⟩ from getD_ofFn n x false ⟨i, hlt⟩] at hi
      rw [show (List.ofFn y).getD i false = y ⟨i, hlt⟩ from getD_ofFn n y false ⟨i, hlt⟩]
      exact hxy _ hi
    · rw [List.getD_eq_default _ _ (by simp; omega)] at hi
      exact absurd hi (by simp)) C.output

section Cover

variable {V : Type*} [DecidableEq V] [Fintype V] (G : SimpleGraph V) [DecidableRel G.Adj]

lemma mem_nbrs {removed : Finset V} {u v : V} (huv : G.Adj u v) (hv : v ∉ removed) :
    v ∈ neighborsAfter G removed u := by
  simp only [neighborsAfter, Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨huv, hv⟩

lemma adj_of_mem_nbrs {removed : Finset V} {u v : V} (h : v ∈ neighborsAfter G removed u) :
    G.Adj u v := by
  simp only [neighborsAfter, Finset.mem_filter, Finset.mem_univ, true_and] at h
  exact h.1

lemma cover_of_steps
    (c4 : ∀ a a' c c' : V, a ≠ a' → c ≠ c' →
      ¬ (G.Adj a c ∧ G.Adj a' c ∧ G.Adj a c' ∧ G.Adj a' c')) :
    ∀ (groups : List (Finset V)) (removed : Finset V), TwinSteps G removed groups →
      ∃ K : Finset V, K.card ≤ groups.length ∧
        ∀ u v, G.Adj u v → u ∉ removed → v ∉ removed →
          (u ∈ removedThrough removed groups ∨ v ∈ removedThrough removed groups) →
          u ∈ K ∨ v ∈ K := by
  intro groups
  induction groups with
  | nil =>
    intro removed _
    refine ⟨∅, by simp, ?_⟩
    intro u v _ hu hv h
    change u ∈ removed ∨ v ∈ removed at h
    rcases h with h | h
    · exact absurd h hu
    · exact absurd h hv
  | cons group rest ih =>
    intro removed steps
    obtain ⟨twins, next⟩ := steps
    obtain ⟨K', hK', hcov⟩ := ih (removed ∪ group) next
    have hrest : ∀ u v, G.Adj u v → u ∉ removed → v ∉ removed → u ∉ group → v ∉ group →
        (u ∈ removedThrough removed (group :: rest) ∨ v ∈ removedThrough removed (group :: rest)) →
        u ∈ K' ∨ v ∈ K' := by
      intro u v huv hu hv hug hvg h
      exact hcov u v huv (by simp [hu, hug]) (by simp [hv, hvg]) h
    by_cases hact : ∃ a ∈ group, (neighborsAfter G removed a).Nonempty
    · obtain ⟨a, ha, haN⟩ := hact
      by_cases hmore : ∃ a' ∈ group, (neighborsAfter G removed a').Nonempty ∧ a' ≠ a
      swap
      · have hone : ∀ a' ∈ group, (neighborsAfter G removed a').Nonempty → a' = a := by
          intro a' ha' hN
          by_contra hne
          exact hmore ⟨a', ha', hN, hne⟩
        refine ⟨insert a K', ?_, ?_⟩
        · have := Finset.card_insert_le a K'
          simp only [List.length_cons]
          omega
        · intro u v huv hu hv h
          by_cases hug : u ∈ group
          · have e : u = a := hone u hug ⟨v, mem_nbrs G huv hv⟩
            left
            rw [e]
            exact Finset.mem_insert_self _ _
          · by_cases hvg : v ∈ group
            · have e : v = a := hone v hvg ⟨u, mem_nbrs G huv.symm hu⟩
              right
              rw [e]
              exact Finset.mem_insert_self _ _
            · rcases hrest u v huv hu hv hug hvg h with h1 | h1
              · exact Or.inl (Finset.mem_insert_of_mem h1)
              · exact Or.inr (Finset.mem_insert_of_mem h1)
      · obtain ⟨a', ha', ha'N, hne⟩ := hmore
        obtain ⟨c, hc⟩ := haN
        have hsame := twins a ha a' ha' ⟨c, hc⟩ ha'N
        have huniq : ∀ c' ∈ neighborsAfter G removed a, c' = c := by
          intro c' hc'
          by_contra hcc
          have h1 : G.Adj a c := adj_of_mem_nbrs G hc
          have h2 : G.Adj a c' := adj_of_mem_nbrs G hc'
          have h3 : G.Adj a' c := adj_of_mem_nbrs G (hsame ▸ hc)
          have h4 : G.Adj a' c' := adj_of_mem_nbrs G (hsame ▸ hc')
          exact c4 a a' c c' (Ne.symm hne) (Ne.symm hcc) ⟨h1, h3, h2, h4⟩
        refine ⟨insert c K', ?_, ?_⟩
        · have := Finset.card_insert_le c K'
          simp only [List.length_cons]
          omega
        · intro u v huv hu hv h
          by_cases hug : u ∈ group
          · have e := twins u hug a ha ⟨v, mem_nbrs G huv hv⟩ ⟨c, hc⟩
            have hvmem : v ∈ neighborsAfter G removed a := e ▸ mem_nbrs G huv hv
            right
            rw [huniq v hvmem]
            exact Finset.mem_insert_self _ _
          · by_cases hvg : v ∈ group
            · have e := twins v hvg a ha ⟨u, mem_nbrs G huv.symm hu⟩ ⟨c, hc⟩
              have humem : u ∈ neighborsAfter G removed a := e ▸ mem_nbrs G huv.symm hu
              left
              rw [huniq u humem]
              exact Finset.mem_insert_self _ _
            · rcases hrest u v huv hu hv hug hvg h with h1 | h1
              · exact Or.inl (Finset.mem_insert_of_mem h1)
              · exact Or.inr (Finset.mem_insert_of_mem h1)
    · refine ⟨K', by simp only [List.length_cons]; omega, ?_⟩
      intro u v huv hu hv h
      by_cases hug : u ∈ group
      · exact absurd ⟨u, hug, ⟨v, mem_nbrs G huv hv⟩⟩ hact
      · by_cases hvg : v ∈ group
        · exact absurd ⟨v, hvg, ⟨u, mem_nbrs G huv.symm hu⟩⟩ hact
        · exact hrest u v huv hu hv hug hvg h

lemma cover_of_exhaust
    (c4 : ∀ a a' c c' : V, a ≠ a' → c ≠ c' →
      ¬ (G.Adj a c ∧ G.Adj a' c ∧ G.Adj a c' ∧ G.Adj a' c'))
    (groups : List (Finset V)) (twins : TwinSteps G ∅ groups)
    (done : EdgelessAfter G (removedThrough ∅ groups)) :
    ∃ K : Finset V, K.card ≤ groups.length ∧ ∀ u v, G.Adj u v → u ∈ K ∨ v ∈ K := by
  obtain ⟨K, hK, hcov⟩ := cover_of_steps G c4 groups ∅ twins
  refine ⟨K, hK, fun u v huv => hcov u v huv (by simp) (by simp) ?_⟩
  by_contra hno
  exact done u v (not_or.mp hno).1 (not_or.mp hno).2 huv

end Cover

section Generic

variable {n : ℕ} (G : SimpleGraph (Fin n)) (F : (Fin n → Bool) → Bool)

lemma pair_and
    (hT : ∀ (x : Fin n → Bool) (u v : Fin n), G.Adj u v → x u = true → x v = true → F x = true)
    (hF : ∀ (x : Fin n → Bool) (u v : Fin n), ¬ G.Adj u v →
      (∀ w, x w = true → w = u ∨ w = v) → F x = false)
    {i j : Fin n} (h : G.Adj i j) (a b : Bool) :
    F (pairInput i j (fun _ => false) a b) = (a && b) := by
  cases a <;> cases b
  · apply hF _ i i G.irrefl
    intro k hk
    simp [pairInput] at hk
  · apply hF _ j j G.irrefl
    intro k hk
    by_cases hki : k = i <;> by_cases hkj : k = j <;>
      simp [pairInput, hki, hkj] at hk ⊢
  · apply hF _ i i G.irrefl
    intro k hk
    by_cases hki : k = i <;> by_cases hkj : k = j <;>
      simp [pairInput, hki, hkj] at hk ⊢
    assumption
  · exact hT _ i j h (by simp [pairInput]) (by simp [pairInput, h.ne.symm])

lemma pair_or
    (hT : ∀ (x : Fin n → Bool) (u v : Fin n), G.Adj u v → x u = true → x v = true → F x = true)
    (hF : ∀ (x : Fin n → Bool) (u v : Fin n), ¬ G.Adj u v →
      (∀ w, x w = true → w = u ∨ w = v) → F x = false)
    {i j u v : Fin n}
    (hij : i ≠ j) (hiu : G.Adj i u) (hjv : G.Adj j v)
    (huj : u ≠ j) (hvi : v ≠ i) (huv : ¬ G.Adj u v) (a b : Bool) :
    F (pairInput i j (fun k => decide (k = u ∨ k = v)) a b) = (a || b) := by
  have hu : pairInput i j (fun k => decide (k = u ∨ k = v)) a b u = true := by
    simp [pairInput, hiu.ne.symm, huj]
  have hv : pairInput i j (fun k => decide (k = u ∨ k = v)) a b v = true := by
    simp [pairInput, hvi, hjv.ne.symm]
  cases a <;> cases b
  · apply hF _ u v huv
    intro k hk
    by_cases hki : k = i <;> by_cases hkj : k = j <;>
      simp [pairInput, hki, hkj] at hk
    exact hk
  · exact hT _ j v hjv (by simp [pairInput, hij.symm]) hv
  · exact hT _ i u hiu (by simp [pairInput]) hu
  · exact hT _ i u hiu (by simp [pairInput]) hu

lemma marked_small
    (hT : ∀ (x : Fin n → Bool) (u v : Fin n), G.Adj u v → x u = true → x v = true → F x = true)
    (hF : ∀ (x : Fin n → Bool) (u v : Fin n), ¬ G.Adj u v →
      (∀ w, x w = true → w = u ∨ w = v) → F x = false)
    (hne : Nonempty (Fin n)) (S : Finset (Fin n)) (hS : S.card ≤ 2) :
    F (setInput S) = true ↔ containsEdge G S := by
  constructor
  · intro h
    by_contra hno
    have hfalse : F (setInput S) = false := by
      rcases Nat.lt_or_ge S.card 1 with h0 | h1
      · have hc0 : S.card = 0 := by omega
        have hS0 : S = ∅ := Finset.card_eq_zero.mp hc0
        obtain ⟨u⟩ := hne
        apply hF _ u u G.irrefl
        intro w hw
        simp [setInput, hS0] at hw
      · rcases Nat.lt_or_ge S.card 2 with h1' | h2
        · have hc1 : S.card = 1 := by omega
          obtain ⟨u, hu⟩ := Finset.card_eq_one.mp hc1
          apply hF _ u u G.irrefl
          intro w hw
          simp [setInput, hu] at hw
          exact Or.inl hw
        · have hc2 : S.card = 2 := by omega
          obtain ⟨u, v, huv, hSuv⟩ := Finset.card_eq_two.mp hc2
          apply hF _ u v
          · intro hadj
            exact hno ⟨u, by simp [hSuv], v, by simp [hSuv], hadj⟩
          · intro w hw
            simpa [setInput, hSuv] using hw
    rw [hfalse] at h
    exact Bool.noConfusion h
  · rintro ⟨a, ha, b, hb, hab⟩
    exact hT _ a b hab (by simp [setInput, ha]) (by simp [setInput, hb])

lemma least_size [DecidableRel G.Adj] (k : ℕ)
    (hT : ∀ (x : Fin n → Bool) (u v : Fin n), G.Adj u v → x u = true → x v = true → F x = true)
    (hF : ∀ (x : Fin n → Bool) (u v : Fin n), ¬ G.Adj u v →
      (∀ w, x w = true → w = u ∨ w = v) → F x = false)
    (hedge : ∃ a b : Fin n, G.Adj a b)
    (nbr : ∀ v : Fin n, ∃ w, G.Adj v w)
    (far : ∀ v : Fin n, ∃ a b, G.Adj a b ∧ a ≠ v ∧ b ≠ v)
    (wit : ∀ i j, G.Adj i j → ∃ u v, G.Adj i u ∧ G.Adj j v ∧ u ≠ j ∧ v ≠ i ∧ ¬ G.Adj u v)
    (required : ∀ groups : List (Finset (Fin n)), TwinSteps G ∅ groups →
      EdgelessAfter G (removedThrough ∅ groups) → k ≤ groups.length)
    (gs : List Gate) (out : ℕ) (least : Least n F gs out) :
    k + n ≤ nonNotCount gs + 1 := by
  classical
  obtain ⟨e1, e2, he⟩ := hedge
  have hne : Nonempty (Fin n) := ⟨e1⟩
  have zeroF : F (fun _ => false) = false :=
    hF _ e1 e1 G.irrefl (by intro w hw; simp at hw)
  have nonconst : ∃ x y : Fin n → Bool, F x ≠ F y := by
    refine ⟨fun i => decide (i = e1 ∨ i = e2), fun _ => false, ?_⟩
    rw [zeroF, hT _ e1 e2 he (by simp) (by simp)]
    simp
  have depends : ∀ v : Fin n, Dep F v := by
    intro v
    obtain ⟨w, hw⟩ := nbr v
    refine ⟨fun i => decide (i = w), ?_⟩
    have hvw : v ≠ w := hw.ne
    have h1 : F (Function.update (fun i => decide (i = w)) v (!(decide (v = w)))) = true := by
      apply hT _ v w hw
      · simp [hvw]
      · simp [Function.update, hvw.symm]
    have h2 : F (fun i => decide (i = w)) = false := by
      apply hF _ w w G.irrefl
      intro z hz
      simpa using hz
    rw [h1, h2]
    simp
  have restrict : ∀ (v : Fin n) (b : Bool), ∃ x y,
      F (Function.update x v b) ≠ F (Function.update y v b) := by
    intro v b
    cases b
    · obtain ⟨a, c, hac, hav, hcv⟩ := far v
      refine ⟨fun _ => false, fun i => decide (i = a ∨ i = c), ?_⟩
      have h1 : F (Function.update (fun _ => false) v false) = false := by
        apply hF _ v v G.irrefl
        intro z hz
        by_cases hzv : z = v <;> simp [Function.update, hzv] at hz
      have h2 : F (Function.update (fun i => decide (i = a ∨ i = c)) v false) = true := by
        apply hT _ a c hac
        · simp [Function.update, hav]
        · simp [Function.update, hcv]
      rw [h1, h2]
      simp
    · obtain ⟨w, hw⟩ := nbr v
      refine ⟨fun _ => false, fun i => decide (i = w), ?_⟩
      have h1 : F (Function.update (fun _ => false) v true) = false := by
        apply hF _ v v G.irrefl
        intro z hz
        by_cases hzv : z = v
        · exact Or.inl hzv
        · simp [Function.update, hzv] at hz
      have h2 : F (Function.update (fun i => decide (i = w)) v true) = true := by
        apply hT _ v w hw
        · simp [Function.update]
        · simp [Function.update, hw.ne.symm]
      rw [h1, h2]
      simp
  have outValid : out < n + gs.length := by
    by_contra! after
    obtain ⟨x, y, different⟩ := least.ncv nonconst
    exact different ((vl_beyond gs x out after).trans (vl_beyond gs y out after).symm)
  let outWire : Fin (n + gs.length) := ⟨out, outValid⟩
  have live := least_read_edge_live least nonconst depends restrict outValid
  let label : Fin n → Fin (n + gs.length) := firstInputBoundary least.hcl outWire live
  let branches : Finset (Fin (n + gs.length)) := circuitBranchWires gs
  have computes (x : Fin n → Bool) : vl gs x outWire.val = F x := least.hev x
  have marked (S : Finset (Fin n)) (hS : S.card ≤ 2) :
      vl gs (setInput S) outWire.val = true ↔ containsEdge G S := by
    change vl gs (setInput S) out = true ↔ _
    rw [least.hev]
    exact marked_small G F hT hF hne S hS
  have independent (r) : Independent G (BranchGroupsLean.bucket label r) :=
    firstInputGroup_independent least.hcl outWire live (predecessors_nodup least nonconst)
      G F computes (fun i j hij => by
        obtain ⟨u, v, hiu, hjv, huj, hvi, huv⟩ := wit i j hij
        exact ⟨u, v, pair_and G F hT hF hij, pair_or G F hT hF hij.ne hiu hjv huj hvi huv⟩) r
  have labels (v : Fin n) : label v = outWire ∨ label v ∈ branches := by
    have stopped := FirstBranchRoute.first_stops (readEdge gs) outWire (read_order least.hcl) live
      (inputWire gs v)
    rcases stopped with outLabel | fork
    · exact Or.inl outLabel
    · exact Or.inr (in_circuit_branches.mpr fork)
  have before (r) (member : r ∈ branches) : r < outWire := by
    obtain ⟨a, _, path, _, _⟩ := in_circuit_branches.mp member
    exact lt_of_lt_of_le (read_order least.hcl path) (wire_le_output least.hcl outWire live a)
  have twins (r) (member : r ∈ branches) : TwinGroup G
      (BranchGroupsLean.below label r) (BranchGroupsLean.bucket label r) :=
    circuit_branch_class_twins least.hcl outWire live G marked r
      (le_of_lt (before r member)) (Or.inr (in_circuit_branches.mp member)) (independent r)
  have branchLower : k ≤ branches.card :=
    BranchGroupsLean.roots_required G label outWire branches k labels before twins
      (independent outWire) required
  have branchBudget := branching_budget least.hcl outValid (fun w hw hne => by
      let wire : Fin (n + gs.length) := ⟨w, hw⟩
      obtain ⟨v, p, g, hg, _, hw'⟩ := live wire (fun h => hne (congrArg Fin.val h))
      exact ⟨p, g, hg, hw'⟩)
    (branches.image Fin.val) (fun w hw => by
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hw
      exact branch_slots_of_read_edges (in_circuit_branches.mp hv))
  rw [Finset.card_image_of_injective _ Fin.val_injective] at branchBudget
  have countTotal := nonNotCount_add_notCount gs
  change nonNotCount gs + notGateCount gs = gs.length at countTotal
  have npos : 0 < n := Fin.pos e1
  omega

end Generic

section PlaneFacts

variable {N : ℕ}

lemma cast_ne_nat (p l : Fin N) : Fin.castAdd N p ≠ Fin.natAdd N l := by
  intro h
  have h2 := congrArg Fin.val h
  simp at h2
  omega

lemma cast_inj {p p' : Fin N} (h : Fin.castAdd N p = Fin.castAdd N p') : p = p' := by
  have h2 := congrArg Fin.val h
  simp at h2
  exact Fin.ext h2

lemma nat_inj {l l' : Fin N} (h : Fin.natAdd N l = Fin.natAdd N l') : l = l' := by
  have h2 := congrArg Fin.val h
  simp at h2
  exact Fin.ext h2

def incGraph (N : ℕ) (I : Fin N → Fin N → Prop) : SimpleGraph (Fin (N + N)) where
  Adj a b := ∃ p l : Fin N, I p l ∧
    ((a = Fin.castAdd N p ∧ b = Fin.natAdd N l) ∨ (b = Fin.castAdd N p ∧ a = Fin.natAdd N l))
  symm := ⟨fun _ _ ⟨p, l, h, hh⟩ => ⟨p, l, h, hh.symm⟩⟩
  loopless := ⟨fun _ ⟨p, l, _, hh⟩ => by
    rcases hh with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact cast_ne_nat p l (h1.symm.trans h2)
    · exact cast_ne_nat p l (h1.symm.trans h2)⟩

variable (I : Fin N → Fin N → Prop)

lemma adj_cast_nat (p l : Fin N) :
    (incGraph N I).Adj (Fin.castAdd N p) (Fin.natAdd N l) ↔ I p l := by
  constructor
  · rintro ⟨p', l', h, (⟨h1, h2⟩ | ⟨h1, h2⟩)⟩
    · rw [cast_inj h1, nat_inj h2]
      exact h
    · exact absurd h2 (cast_ne_nat p l')
  · intro h
    exact ⟨p, l, h, Or.inl ⟨rfl, rfl⟩⟩

lemma adj_nat_cast (p l : Fin N) :
    (incGraph N I).Adj (Fin.natAdd N l) (Fin.castAdd N p) ↔ I p l :=
  ⟨fun h => (adj_cast_nat I p l).1 h.symm,
    fun h => ((adj_cast_nat I p l).2 h).symm⟩

lemma not_adj_cast_cast (p p' : Fin N) :
    ¬ (incGraph N I).Adj (Fin.castAdd N p) (Fin.castAdd N p') := by
  rintro ⟨p0, l0, _, (⟨_, h2⟩ | ⟨_, h2⟩)⟩
  · exact cast_ne_nat p' l0 h2
  · exact cast_ne_nat p l0 h2

lemma not_adj_nat_nat (l l' : Fin N) :
    ¬ (incGraph N I).Adj (Fin.natAdd N l) (Fin.natAdd N l') := by
  rintro ⟨p0, l0, _, (⟨h1, _⟩ | ⟨h1, _⟩)⟩
  · exact cast_ne_nat p0 l h1.symm
  · exact cast_ne_nat p0 l' h1.symm

lemma two_lines (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l)
    {p p' l l' : Fin N} (hne : p ≠ p') (h1 : I p l) (h2 : I p' l) (h3 : I p l') (h4 : I p' l') :
    l = l' := by
  obtain ⟨l0, _, hu⟩ := huniq p p' hne
  exact (hu l ⟨h1, h2⟩).trans (hu l' ⟨h3, h4⟩).symm

lemma c4_inc (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) :
    ∀ a a' c c' : Fin (N + N), a ≠ a' → c ≠ c' →
      ¬ ((incGraph N I).Adj a c ∧ (incGraph N I).Adj a' c ∧ (incGraph N I).Adj a c' ∧
        (incGraph N I).Adj a' c') := by
  intro a a' c c' haa hcc
  rintro ⟨h1, h2, h3, h4⟩
  induction a using Fin.addCases with
  | left p =>
    induction c using Fin.addCases with
    | left pc => exact not_adj_cast_cast I p pc h1
    | right lc =>
      induction a' using Fin.addCases with
      | left p' =>
        induction c' using Fin.addCases with
        | left pc' => exact not_adj_cast_cast I p pc' h3
        | right lc' =>
          have hpp : p ≠ p' := fun e => haa (by rw [e])
          have e := two_lines I huniq hpp ((adj_cast_nat I p lc).1 h1) ((adj_cast_nat I p' lc).1 h2)
            ((adj_cast_nat I p lc').1 h3) ((adj_cast_nat I p' lc').1 h4)
          exact hcc (by rw [e])
      | right l' => exact not_adj_nat_nat I l' lc h2
  | right l =>
    induction c using Fin.addCases with
    | left pc =>
      induction a' using Fin.addCases with
      | left p' => exact not_adj_cast_cast I p' pc h2
      | right l' =>
        induction c' using Fin.addCases with
        | left pc' =>
          have hpp : pc ≠ pc' := fun e => hcc (by rw [e])
          have e := two_lines I huniq hpp ((adj_nat_cast I pc l).1 h1) ((adj_nat_cast I pc' l).1 h3)
            ((adj_nat_cast I pc l').1 h2) ((adj_nat_cast I pc' l').1 h4)
          exact haa (by rw [e])
        | right lc' => exact not_adj_nat_nat I l lc' h3
    | right lc => exact not_adj_nat_nat I l lc h1

end PlaneFacts

section PlaneCount

variable {q N : ℕ} (I : Fin N → Fin N → Prop) [DecidableRel I]

lemma exists_point_off (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1) (l : Fin N) :
    ∃ p, ¬ I p l := by
  by_contra h
  have h' : ∀ p, I p l := not_exists_not.mp h
  have e : Fintype.card {p : Fin N // I p l} = N := by
    rw [Fintype.card_congr (Equiv.subtypeUnivEquiv h'), Fintype.card_fin]
  have h4 : 2 ^ 2 ≤ q ^ 2 := Nat.pow_le_pow_left hq 2
  rw [hline l] at e
  omega

lemma exists_other_point (hq : 2 ≤ q)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1) (l p : Fin N) :
    ∃ p', p' ≠ p ∧ I p' l := by
  have hc : 1 < Fintype.card {p : Fin N // I p l} := by
    rw [hline l]
    omega
  obtain ⟨a, b, hab⟩ := Fintype.exists_pair_of_one_lt_card hc
  by_cases ha : a.1 = p
  · refine ⟨b.1, ?_, b.2⟩
    intro hb
    exact hab (Subtype.ext (ha.trans hb.symm))
  · exact ⟨a.1, ha, a.2⟩

lemma exists_line_through (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) (p : Fin N) :
    ∃ l, I p l := by
  have hNpos : 0 < N := by
    rw [hN]
    omega
  obtain ⟨p', hp', _⟩ := exists_other_point I hq hline ⟨0, hNpos⟩ p
  obtain ⟨l, ⟨h1, _⟩, _⟩ := huniq p p' (Ne.symm hp')
  exact ⟨l, h1⟩

lemma exists_other_line (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) (p l : Fin N)
    (hpl : I p l) : ∃ l', l' ≠ l ∧ I p l' := by
  obtain ⟨p', hp'⟩ := exists_point_off I hq hN hline l
  have hne : p ≠ p' := fun e => hp' (e ▸ hpl)
  obtain ⟨l', ⟨h1, h2⟩, _⟩ := huniq p p' hne
  exact ⟨l', fun e => hp' (e ▸ h2), h1⟩

lemma inc_nbr (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) :
    ∀ v : Fin (N + N), ∃ w, (incGraph N I).Adj v w := by
  intro v
  induction v using Fin.addCases with
  | left p =>
    obtain ⟨l, hl⟩ := exists_line_through I hq hN hline huniq p
    exact ⟨Fin.natAdd N l, (adj_cast_nat I p l).2 hl⟩
  | right l =>
    obtain ⟨p, _, hp⟩ := exists_other_point I hq hline l l
    exact ⟨Fin.castAdd N p, (adj_nat_cast I p l).2 hp⟩

lemma inc_far (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) :
    ∀ v : Fin (N + N), ∃ a b, (incGraph N I).Adj a b ∧ a ≠ v ∧ b ≠ v := by
  intro v
  induction v using Fin.addCases with
  | left p =>
    obtain ⟨l, hl⟩ := exists_line_through I hq hN hline huniq p
    obtain ⟨p', hp', hp'l⟩ := exists_other_point I hq hline l p
    exact ⟨Fin.castAdd N p', Fin.natAdd N l, (adj_cast_nat I p' l).2 hp'l,
      fun e => hp' (cast_inj e), fun e => cast_ne_nat p l e.symm⟩
  | right l =>
    obtain ⟨p, _, hp⟩ := exists_other_point I hq hline l l
    obtain ⟨l', hl', hpl'⟩ := exists_other_line I hq hN hline huniq p l hp
    exact ⟨Fin.castAdd N p, Fin.natAdd N l', (adj_cast_nat I p l').2 hpl',
      fun e => cast_ne_nat p l e, fun e => hl' (nat_inj e)⟩

lemma inc_wit (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) :
    ∀ i j, (incGraph N I).Adj i j → ∃ u v, (incGraph N I).Adj i u ∧ (incGraph N I).Adj j v ∧
      u ≠ j ∧ v ≠ i ∧ ¬ (incGraph N I).Adj u v := by
  intro i j hij
  induction i using Fin.addCases with
  | left p =>
    induction j using Fin.addCases with
    | left p' => exact absurd hij (not_adj_cast_cast I p p')
    | right l =>
      have hpl := (adj_cast_nat I p l).1 hij
      obtain ⟨l', hl', hpl'⟩ := exists_other_line I hq hN hline huniq p l hpl
      obtain ⟨p', hp', hp'l⟩ := exists_other_point I hq hline l p
      refine ⟨Fin.natAdd N l', Fin.castAdd N p', (adj_cast_nat I p l').2 hpl',
        (adj_nat_cast I p' l).2 hp'l, fun e => hl' (nat_inj e), fun e => hp' (cast_inj e), ?_⟩
      intro h
      have hp'l' := (adj_nat_cast I p' l').1 h
      exact hl' (two_lines I huniq (Ne.symm hp') hpl' hp'l' hpl hp'l)
  | right l =>
    induction j using Fin.addCases with
    | left p =>
      have hpl := (adj_nat_cast I p l).1 hij
      obtain ⟨l', hl', hpl'⟩ := exists_other_line I hq hN hline huniq p l hpl
      obtain ⟨p', hp', hp'l⟩ := exists_other_point I hq hline l p
      refine ⟨Fin.castAdd N p', Fin.natAdd N l', (adj_nat_cast I p' l).2 hp'l,
        (adj_cast_nat I p l').2 hpl', fun e => hp' (cast_inj e), fun e => hl' (nat_inj e), ?_⟩
      intro h
      have hp'l' := (adj_cast_nat I p' l').1 h
      exact hl' (two_lines I huniq (Ne.symm hp') hpl' hp'l' hpl hp'l)
    | right l' => exact absurd hij (not_adj_nat_nat I l l')

lemma lines_through_le (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l) (p : Fin N) :
    (Finset.univ.filter (fun l => I p l)).card ≤ q + 1 := by
  classical
  let S : Finset (Fin N) := Finset.univ.filter (fun l => I p l)
  let A : Fin N → Finset (Fin N) := fun l => Finset.univ.filter (fun p' => I p' l ∧ p' ≠ p)
  have hA : ∀ l ∈ S, (A l).card = q := by
    intro l hl
    have hpl : I p l := (Finset.mem_filter.mp hl).2
    have h1 : (Finset.univ.filter (fun p' => I p' l)).card = q + 1 := by
      rw [← Fintype.card_subtype]
      exact hline l
    have h2 : A l = (Finset.univ.filter (fun p' => I p' l)).erase p := by
      ext x
      simp [A, and_comm]
    rw [h2, Finset.card_erase_of_mem (by simp [hpl]), h1]
    simp
  have hdisj : ∀ l ∈ S, ∀ l' ∈ S, l ≠ l' → Disjoint (A l) (A l') := by
    intro l hl l' hl' hne
    rw [Finset.disjoint_left]
    intro x hx hx'
    have hpl : I p l := (Finset.mem_filter.mp hl).2
    have hpl' : I p l' := (Finset.mem_filter.mp hl').2
    have h1 := (Finset.mem_filter.mp hx).2
    have h2 := (Finset.mem_filter.mp hx').2
    exact hne (two_lines I huniq (Ne.symm h1.2) hpl h1.1 hpl' h2.1)
  have hcard : (S.biUnion A).card = S.card * q := by
    rw [Finset.card_biUnion hdisj, Finset.sum_congr rfl hA, Finset.sum_const, smul_eq_mul]
  have hsub : S.biUnion A ⊆ Finset.univ.erase p := by
    intro x hx
    obtain ⟨l, _, hxl⟩ := Finset.mem_biUnion.mp hx
    have h3 := (Finset.mem_filter.mp hxl).2
    simp [h3.2]
  have hle := Finset.card_le_card hsub
  rw [hcard, Finset.card_erase_of_mem (Finset.mem_univ p), Finset.card_univ, Fintype.card_fin] at hle
  have hN1 : N - 1 = (q + 1) * q := by
    rw [hN]
    have : q ^ 2 + q + 1 - 1 = q ^ 2 + q := by omega
    rw [this]
    ring
  rw [hN1] at hle
  exact Nat.le_of_mul_le_mul_right hle (by omega)

end PlaneCount

section PlaneMain

variable {q N : ℕ} (I : Fin N → Fin N → Prop) [DecidableRel I]

lemma cover_bound (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l)
    (K : Finset (Fin (N + N)))
    (hK : ∀ u v, (incGraph N I).Adj u v → u ∈ K ∨ v ∈ K) : N ≤ K.card := by
  classical
  let KP : Finset (Fin N) := Finset.univ.filter (fun p => Fin.castAdd N p ∈ K)
  let KL : Finset (Fin N) := Finset.univ.filter (fun l => Fin.natAdd N l ∈ K)
  have hcard : KP.card + KL.card ≤ K.card := by
    have h1 : (KP.image (Fin.castAdd N) ∪ KL.image (Fin.natAdd N)) ⊆ K := by
      intro x hx
      rcases Finset.mem_union.mp hx with h | h
      · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp h
        exact (Finset.mem_filter.mp hp).2
      · obtain ⟨l, hl, rfl⟩ := Finset.mem_image.mp h
        exact (Finset.mem_filter.mp hl).2
    have hdisj : Disjoint (KP.image (Fin.castAdd N)) (KL.image (Fin.natAdd N)) := by
      rw [Finset.disjoint_left]
      intro x hx hx'
      obtain ⟨p, _, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨l, _, h⟩ := Finset.mem_image.mp hx'
      exact cast_ne_nat p l h.symm
    have h2 := Finset.card_le_card h1
    rw [Finset.card_union_of_disjoint hdisj,
      Finset.card_image_of_injective _ (fun a b h => cast_inj h),
      Finset.card_image_of_injective _ (fun a b h => nat_inj h)] at h2
    exact h2
  have hfil : ∀ l : Fin N, (Finset.univ.filter (fun p => I p l)).card = q + 1 := by
    intro l
    rw [← Fintype.card_subtype]
    exact hline l
  have hsum : ∑ l : Fin N, ∑ p : Fin N, (if I p l then 1 else 0) = N * (q + 1) := by
    have h : ∀ l : Fin N, ∑ p : Fin N, (if I p l then 1 else 0) = q + 1 := by
      intro l
      rw [← Finset.card_filter]
      exact hfil l
    simp [h]
  have hle : ∑ l : Fin N, ∑ p : Fin N, (if I p l then 1 else 0)
      ≤ ∑ l : Fin N, ∑ p : Fin N,
        ((if I p l ∧ p ∈ KP then 1 else 0) + (if I p l ∧ l ∈ KL then 1 else 0)) := by
    apply Finset.sum_le_sum
    intro l _
    apply Finset.sum_le_sum
    intro p _
    by_cases h : I p l
    · rcases hK _ _ ((adj_cast_nat I p l).2 h) with hp | hl
      · have hp' : p ∈ KP := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hp⟩
        simp [h, hp']
      · have hl' : l ∈ KL := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hl⟩
        simp [h, hl']
    · simp [h]
  have hP : ∑ l : Fin N, ∑ p : Fin N, (if I p l ∧ p ∈ KP then 1 else 0)
      ≤ KP.card * (q + 1) := by
    rw [Finset.sum_comm]
    calc ∑ p : Fin N, ∑ l : Fin N, (if I p l ∧ p ∈ KP then 1 else 0)
        = ∑ p : Fin N, (if p ∈ KP then (Finset.univ.filter (fun l => I p l)).card else 0) := by
          apply Finset.sum_congr rfl
          intro p _
          by_cases hp : p ∈ KP
          · simp only [hp, and_true, ite_true]
            rw [Finset.card_filter]
          · simp [hp]
      _ ≤ ∑ p : Fin N, (if p ∈ KP then (q + 1) else 0) := by
          apply Finset.sum_le_sum
          intro p _
          by_cases hp : p ∈ KP
          · simp only [hp, ite_true]
            exact lines_through_le I hq hN hline huniq p
          · simp [hp]
      _ = KP.card * (q + 1) := by
          rw [← Finset.sum_filter]
          simp
  have hL : ∑ l : Fin N, ∑ p : Fin N, (if I p l ∧ l ∈ KL then 1 else 0)
      ≤ KL.card * (q + 1) := by
    have e : ∑ l : Fin N, ∑ p : Fin N, (if I p l ∧ l ∈ KL then 1 else 0)
        = ∑ l : Fin N, (if l ∈ KL then (q + 1) else 0) := by
      apply Finset.sum_congr rfl
      intro l _
      by_cases hl : l ∈ KL
      · simp only [hl, and_true, ite_true]
        rw [← Finset.card_filter]
        exact hfil l
      · simp [hl]
    rw [e, ← Finset.sum_filter]
    simp
  have hfin : N * (q + 1) ≤ (KP.card + KL.card) * (q + 1) := by
    rw [← hsum]
    refine hle.trans ?_
    simp only [Finset.sum_add_distrib]
    rw [add_mul]
    exact Nat.add_le_add hP hL
  have h3 := Nat.le_of_mul_le_mul_right hfin (by omega)
  omega

lemma main (q N : ℕ) (I : Fin N → Fin N → Prop) [DecidableRel I] (C : Circuit)
    (hq : 2 ≤ q) (hN : N = q ^ 2 + q + 1)
    (hline : ∀ l : Fin N, Fintype.card {p : Fin N // I p l} = q + 1)
    (huniq : ∀ p p' : Fin N, p ≠ p' → ∃! l : Fin N, I p l ∧ I p' l)
    (hmono : Monotone2 C)
    (hpair : ∀ a b : Fin (N + N),
      circuitFun (N + N) C (fun k => decide (k = a ∨ k = b)) = true ↔
        ∃ p l : Fin N, I p l ∧ (Fin.castAdd N p = a ∨ Fin.castAdd N p = b) ∧
          (Fin.natAdd N l = a ∨ Fin.natAdd N l = b)) :
    3 * N ≤ C.size + 1 := by
  classical
  let F : (Fin (N + N) → Bool) → Bool := fun x => C.eval (List.ofFn x)
  have gpair : ∀ a b : Fin (N + N),
      F (fun k => decide (k = a ∨ k = b)) = true ↔ (incGraph N I).Adj a b := by
    intro a b
    refine (hpair a b).trans ?_
    constructor
    · rintro ⟨p, l, h, hp, hl⟩
      rcases hp with hp | hp <;> rcases hl with hl | hl
      · exact absurd (hp.trans hl.symm) (cast_ne_nat p l)
      · exact ⟨p, l, h, Or.inl ⟨hp.symm, hl.symm⟩⟩
      · exact ⟨p, l, h, Or.inr ⟨hp.symm, hl.symm⟩⟩
      · exact absurd (hp.trans hl.symm) (cast_ne_nat p l)
    · rintro ⟨p, l, h, (⟨h1, h2⟩ | ⟨h1, h2⟩)⟩
      · exact ⟨p, l, h, Or.inl h1.symm, Or.inr h2.symm⟩
      · exact ⟨p, l, h, Or.inr h1.symm, Or.inl h2.symm⟩
  have hT : ∀ (x : Fin (N + N) → Bool) (u v : Fin (N + N)), (incGraph N I).Adj u v →
      x u = true → x v = true → F x = true := by
    intro x u v huv hu hv
    refine eval_mono C hmono (fun k => decide (k = u ∨ k = v)) x ?_ ((gpair u v).2 huv)
    intro i hi
    have hi' : i = u ∨ i = v := by simpa using hi
    rcases hi' with rfl | rfl
    · exact hu
    · exact hv
  have hF : ∀ (x : Fin (N + N) → Bool) (u v : Fin (N + N)), ¬ (incGraph N I).Adj u v →
      (∀ w, x w = true → w = u ∨ w = v) → F x = false := by
    intro x u v huv act
    by_contra hx
    have hx' : F x = true := by simpa using hx
    have h2 := eval_mono C hmono x (fun k => decide (k = u ∨ k = v)) (by
      intro i hi
      simpa using act i hi) hx'
    exact huv ((gpair u v).1 h2)
  have hNpos : 0 < N := by
    rw [hN]
    omega
  obtain ⟨w0, hw0⟩ := inc_nbr I hq hN hline huniq (Fin.castAdd N ⟨0, hNpos⟩)
  have hedge : ∃ a b : Fin (N + N), (incGraph N I).Adj a b := ⟨_, w0, hw0⟩
  have nonconst : ∃ x y : Fin (N + N) → Bool, F x ≠ F y := by
    obtain ⟨a, b, hab⟩ := hedge
    refine ⟨fun i => decide (i = a ∨ i = b), fun _ => false, ?_⟩
    rw [hT _ a b hab (by simp) (by simp),
      hF (fun _ => false) a a (incGraph N I).irrefl (by intro w hw; simp at hw)]
    simp
  have hfan : FanInTwo C := by
    intro g hg
    obtain ⟨h1, h2⟩ := hmono g hg
    have h1' : g.op = GateOp.and ∨ g.op = GateOp.or := by simpa using h1
    refine ⟨?_, h2⟩
    rcases h1' with h | h
    · rw [h]
      simp
    · rw [h]
      simp
  obtain ⟨gs, o, least, budget⟩ := least_with_budget C hfan (f := F) (fun x => rfl) nonconst
  have required : ∀ groups : List (Finset (Fin (N + N))),
      TwinSteps (incGraph N I) ∅ groups →
      EdgelessAfter (incGraph N I) (removedThrough ∅ groups) → N ≤ groups.length := by
    intro groups twins done
    obtain ⟨K, hK, hcov⟩ := cover_of_exhaust (incGraph N I) (c4_inc I huniq) groups twins done
    exact (cover_bound I hq hN hline huniq K hcov).trans hK
  have size := least_size (incGraph N I) F N hT hF hedge (inc_nbr I hq hN hline huniq)
    (inc_far I hq hN hline huniq) (inc_wit I hq hN hline huniq) required gs o least
  have hcount : nonNotCount C.gates ≤ C.gates.length := List.countP_le_length
  unfold Circuit.size
  omega

end PlaneMain

end Plane

end PEqualNP.Outside.L_meta_2988

theorem PEqualNP.Outside.L_meta_2988 : ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit), (2 : ℕ) ≤ x1 → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x8 : Fin x2), Fintype.card { x9 : Fin x2 // x3 x9 x8 } = x1 + (1 : ℕ)) → (∀ (x9 x10 : Fin x2), x9 ≠ x10 → ∃! x12 : Fin x2, x3 x9 x12 ∧ x3 x10 x12) → PEqualNP.MetaComplexity.Monotone2 x5 → (∀ (x11 x12 : Fin (x2 + x2)), (PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 fun (x13 : Fin (x2 + x2)) => Decidable.decide (x13 = x11 ∨ x13 = x12)) = Bool.true ↔ ∃ (x13 : Fin x2) (x14 : Fin x2), x3 x13 x14 ∧ (Fin.castAdd x2 x13 = x11 ∨ Fin.castAdd x2 x13 = x12) ∧ (Fin.natAdd x2 x14 = x11 ∨ Fin.natAdd x2 x14 = x12)) → (3 : ℕ) * x2 ≤ x5.size + (1 : ℕ) := by
  intro x1 x2 x3 _ x5 hq hN hline huniq hmono hpair
  exact PEqualNP.Outside.L_meta_2988.Plane.main x1 x2 x3 x5 hq hN hline huniq hmono hpair
