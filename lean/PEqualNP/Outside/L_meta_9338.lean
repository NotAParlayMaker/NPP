    packedRowLoad row columns = (columns.map (fun j => row[j]!)).sum := by
  simp [packedRowLoad,fold_add_map]

theorem packedLoad_eq_sum (weights : Array (Array Nat)) (rows columns : List Nat) :
    packedLoad weights rows columns = (rows.map (fun i => packedRowLoad weights[i]! columns)).sum := by
  simp [packedLoad,fold_add_map]

theorem packedLoad_perm (weights : Array (Array Nat)) {rows rows' columns columns' : List Nat}
    (rowPerm : List.Perm rows rows') (colPerm : List.Perm columns columns') :
    packedLoad weights rows columns = packedLoad weights rows' columns' := by
  rw [packedLoad_eq_sum,packedLoad_eq_sum,(rowPerm.map _).sum_eq]
  congr 1
  apply List.map_congr_left
  intro i _
  rw [packedRowLoad_eq_sum,packedRowLoad_eq_sum]
  exact (colPerm.map _).sum_eq

