def walkPacked (s : List G4) (i : HI) := s.foldl (fun j g => packedAct g j) i

theorem walkPackedSound (s : List G4) (i : HI) : walkPacked s i = walkFour s i := by
  induction s generalizing i with
  | nil => rfl
  | cons g s ih =>
    change walkPacked s (packedAct g i) = walkFour s (extAct g i)
    rw [packedActSound,ih]

theorem walkPacked_eq (s : List G4) : walkPacked s = walkFour s :=
  funext (walkPackedSound s)

def checkRoute (k : Fin 28) (i : HI) : Bool :=
  if (tripleList k).contains i then true else
    let mapped := (i :: tripleList k).map (walkPacked (fourRoute k i))
    let expected := quadList (fourClass k i)
    expected.all (fun x => mapped.contains x) && mapped.all (fun x => expected.contains x)

def routeChecks (k : Fin 28) := (List.ofFn (checkRoute k)).all id

theorem routeChecksSound (k : Fin 28) (good : routeChecks k = true) : validAt k := by
  intro i outside
  have missing : ¬ (tripleList k).contains i := by
    rw [List.contains_iff_mem, ← List.mem_toFinset, tripleList_eq]
    exact outside
  have checked := (List.all_eq_true.mp good) (checkRoute k i) (List.mem_ofFn.mpr ⟨i,rfl⟩)
  simp only [id,checkRoute] at checked
  rw [ite_eq_right missing] at checked
  simp only [Bool.and_eq_true,List.all_eq_true,List.contains_iff_mem,walkPacked_eq] at checked
  rw [← tripleList_eq, ← quadList_eq, ← List.toFinset_cons]
  ext x
  simp only [Finset.mem_image, List.mem_toFinset, ← List.mem_map]
  exact ⟨checked.2 x,checked.1 x⟩

