theorem firstIndex : ∀ i : HI, walk (first i) i = 0 := by decide +kernel
set_option maxHeartbeats 0 in
theorem secondIndex : ∀ i : HI, i ≠ 0 →
    walk (second i).2 0 = 0 ∧ walk (second i).2 i = anchor (second i).1 := by decide +kernel
