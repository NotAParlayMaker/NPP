def addVertex (blocked : Array Nat) (common i : Nat) : Nat :=
  common &&& (allVertices ^^^ blocked[i]!)

private theorem addVertex_zero (blocked : Array Nat) (vertices : List Nat) :
    vertices.foldl (addVertex blocked) 0 = 0 := by
  induction vertices with
  | nil => rfl
  | cons i rest ih => simpa [List.foldl_cons, addVertex] using ih

/-- A passing search checks every selected sublist whose closure is nonempty. -/
theorem choose_sound (blocked : Array Nat) (check : List Nat → Nat → Bool)
    {selected available : List Nat} (sub : List.Sublist selected available) (picked : List Nat) (common : Nat)
    (ok : choose blocked check available selected.length picked common = true)
    (nonzero : selected.foldl (addVertex blocked) common ≠ 0) :
    check (selected.reverse ++ picked) (selected.foldl (addVertex blocked) common) = true := by
  induction sub generalizing picked common with
  | slnil => simpa [choose] using ok
  | @cons selected available i sub ih =>
    cases selected with
    | nil => simpa [choose] using ok
    | cons j rest =>
      have next := (Bool.and_eq_true_iff.mp ok).2
      exact ih picked common next nonzero
  | @cons_cons selected available i sub ih =>
    have both := (Bool.and_eq_true_iff.mp ok).1
    have step : addVertex blocked common i ≠ 0 := by
      intro zero
      apply nonzero
      rw [List.foldl_cons, zero, addVertex_zero]
    rcases Bool.or_eq_true_iff.mp both with zero | passed
    · exact (step (eq_of_beq zero)).elim
    · simpa only [List.reverse_cons, List.append_assoc, List.singleton_append, List.foldl_cons]
        using ih (i :: picked) (addVertex blocked common i) passed nonzero

/-- Removing the first selected entry leaves a sublist of the search partition. -/
theorem sublist_range_tail {i n : Nat} {rest : List Nat}
    (sub : List.Sublist (i :: rest) (List.range n)) : List.Sublist rest ((List.range n).drop (i+1)) := by
  obtain ⟨pre,post,split,hi,tail⟩ := List.cons_sublist_iff.mp sub
  obtain ⟨j,hj,hget⟩ := List.mem_iff_getElem.mp hi
  have jn : j < n := by
    have len : n = pre.length + post.length := by simpa using congrArg List.length split
    omega
  have atPos : (List.range n)[j]? = some i := by
    rw [split, List.getElem?_append_left hj, List.getElem?_eq_getElem hj, hget]
  rw [List.getElem?_range jn, Option.some.injEq] at atPos
  have le : i+1 ≤ pre.length := by omega
  rw [split,List.drop_append_of_le_length le]
  exact tail.trans (List.sublist_append_right _ _)

theorem checkSide_sound (sizes : List Nat) (skipFive : Bool) (blocked : Array Nat)
    (weights : Array (Array Nat)) (bias high : Nat)
    (pass : checkSide sizes skipFive blocked weights bias high = true)
    (selected : List Nat) (sub : List.Sublist selected (List.range sideSize)) (size : selected.length ∈ sizes)
    (nonzero : selected.foldl (addVertex blocked) allVertices ≠ 0) :
    checkedClosure weights bias high selected.length skipFive selected.reverse
      (selected.foldl (addVertex blocked) allVertices) = true := by
  have ok := List.all_eq_true.mp pass selected.length size
  simpa only [List.append_nil] using
    choose_sound blocked (checkedClosure weights bias high selected.length skipFive)
      sub [] allVertices ok nonzero

private theorem fold_mask (blocked : Array Nat) (selected : List Nat) (mask common : Nat) :
    selected.foldl (addVertex blocked) (mask &&& common) =
      mask &&& selected.foldl (addVertex blocked) common := by
  induction selected generalizing common with
  | nil => rfl
  | cons i rest ih =>
    simp only [List.foldl_cons,addVertex,Nat.and_assoc,ih]

private theorem members_mask (common : Nat) : members (allVertices &&& common) = members common := by
  unfold members
  apply List.filter_congr
  intro j hj
  simp [Nat.testBit_and,allVertices,Nat.shiftLeft_eq,List.mem_range.mp hj]

theorem checkSidePart_sound (sizes : List Nat) (skipFive : Bool) (blocked : Array Nat)
    (weights : Array (Array Nat)) (bias high : Nat)
    (pass : ∀ i : Fin sideSize, checkSidePart sizes skipFive blocked weights bias high i.val = true)
    (first : Nat) (rest : List Nat) (sub : List.Sublist (first :: rest) (List.range sideSize))
    (size : (first :: rest).length ∈ sizes) (nonzero : (first :: rest).foldl (addVertex blocked) allVertices ≠ 0) :
    checkedClosure weights bias high (first :: rest).length skipFive (first :: rest).reverse
      ((first :: rest).foldl (addVertex blocked) allVertices) = true := by
  have firstBound : first < sideSize := List.mem_range.mp (sub.subset (by simp))
  have ok := List.all_eq_true.mp (pass ⟨first,firstBound⟩) (first :: rest).length size
  have limited : (first :: rest).foldl (addVertex blocked) allVertices =
      allVertices &&& rest.foldl (addVertex blocked) (allVertices ^^^ blocked[first]!) := by
    exact fold_mask blocked rest allVertices (allVertices ^^^ blocked[first]!)
  have nz : rest.foldl (addVertex blocked) (allVertices ^^^ blocked[first]!) ≠ 0 := by
    intro zero
    exact nonzero (by rw [limited,zero,Nat.and_zero])
  have good : choose blocked (checkedClosure weights bias high (first :: rest).length skipFive)
      ((List.range sideSize).drop (first+1)) rest.length [first] (allVertices ^^^ blocked[first]!) = true := by
    simpa only [List.length_cons,Nat.add_sub_cancel] using ok
  have checked := choose_sound blocked (checkedClosure weights bias high (first :: rest).length skipFive)
    (sublist_range_tail sub) [first] (allVertices ^^^ blocked[first]!) good nz
  have equalColumns : members ((first :: rest).foldl (addVertex blocked) allVertices) =
        members (rest.foldl (addVertex blocked) (allVertices ^^^ blocked[first]!)) := by
    rw [limited,members_mask]
  unfold checkedClosure at checked ⊢
  rw [equalColumns,List.reverse_cons]
  exact checked

/-- The traversal uses the increasing list of exactly the selected vertices. -/
def rowList (A : Finset (Fin sideSize)) : List Nat :=
  (List.range sideSize).filter (fun i => decide (i ∈ A.image Fin.val))

theorem rowList_sublist (A : Finset (Fin sideSize)) : List.Sublist (rowList A) (List.range sideSize) :=
  List.filter_sublist

theorem rowList_toFinset (A : Finset (Fin sideSize)) : (rowList A).toFinset = A.image Fin.val := by
  ext i
  simp only [List.mem_toFinset,rowList,List.mem_filter,List.mem_range,decide_eq_true_eq]
  exact ⟨And.right,fun hi => ⟨by obtain ⟨j,_,rfl⟩ := Finset.mem_image.mp hi; exact j.isLt,hi⟩⟩

theorem rowList_length (A : Finset (Fin sideSize)) : (rowList A).length = A.card := by
  rw [← List.toFinset_card_of_nodup ((rowList_sublist A).nodup (List.nodup_range)),
    rowList_toFinset, Finset.card_image_of_injective _ Fin.val_injective]

def closureMask (blocked : Array Nat) (A : Finset (Fin sideSize)) : Nat :=
  (rowList A).foldl (addVertex blocked) allVertices

private theorem fold_bit (blocked : Array Nat) (selected : List Nat) (common j : Nat) :
    (selected.foldl (addVertex blocked) common).testBit j = true ↔
      common.testBit j = true ∧ ∀ i ∈ selected, (allVertices ^^^ blocked[i]!).testBit j = true := by
  induction selected generalizing common with
  | nil => simp
  | cons i rest ih =>
    rw [List.foldl_cons,ih]
    simp only [addVertex,Nat.testBit_and,Bool.and_eq_true,List.forall_mem_cons, and_assoc]

theorem mem_closureMask (blocked : Array Nat) (A : Finset (Fin sideSize)) (j : Nat) :
    j ∈ members (closureMask blocked A) ↔ j < sideSize ∧
      ∀ i ∈ A, blocked[i.val]!.testBit j = false := by
  by_cases bound : j < sideSize
  · have vertexBit : allVertices.testBit j = true := by
      simp [allVertices,Nat.shiftLeft_eq,bound]
    have bit (i : Nat) : (allVertices ^^^ blocked[i]!).testBit j = true ↔
        blocked[i]!.testBit j = false := by
      rw [Nat.testBit_xor,vertexBit]
      cases blocked[i]!.testBit j <;> decide
    simp only [members, List.mem_filter, List.mem_range, bound, true_and,closureMask,fold_bit,vertexBit,bit]
    constructor
    · intro h i hi
      apply h i.val
      rw [← List.mem_toFinset,rowList_toFinset]
      exact Finset.mem_image_of_mem _ hi
    · intro h i hi
      rw [← List.mem_toFinset,rowList_toFinset] at hi
      obtain ⟨v,hv,rfl⟩ := Finset.mem_image.mp hi
      exact h v hv
  · simp [members,bound]

