def limitOf (k : CI) : Nat := caps[k.val]!
def picked (k : CI) : List HI := tags[k.val]!
def pickedBoxes (k : CI) : Finset Box := ((picked k).toFinset).image hbox
def atCell (p : Nat) : Nat := (packetRows[p/21]!)[p%21]!

def laneWeight (p t : Nat) : Nat := ParallelWeight.digit 2048 t (atCell p)

def laneCap (t : Nat) : Nat := caps[t]!

theorem atCoordinate (i j : V) : atCell (ix i j) = (packetRows[i.val]!)[j.val]! := by
  have h := j.isLt
  simp only [atCell, ix]
  rw [show (i.val*21+j.val)/21 = i.val by omega,
    show (i.val*21+j.val)%21 = j.val by omega]

