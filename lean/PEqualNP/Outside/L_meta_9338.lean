theorem cellIdentity (i j : V) : (packetRows[i.val]!)[j.val]! =
    ParallelWeight.pack 2048 268 (laneWeight (ix i j)) := by
  unfold laneWeight
  rw [atCoordinate]
  exact (PacketGeometry.packOwnDigits 2048 268 ((packetRows[i.val]!)[j.val]!) (by decide) (packetBelow i j)).symm

