set_option maxHeartbeats 0 in
theorem thirdIndex : ∀ a : Fin 4, ∀ i : HI, i ≠ 0 → i ≠ anchor a →
    ({0,anchor a,i} : Finset HI).image (walk (third a i).2) = repLabels (third a i).1 := by decide +kernel

def boardZeroBits : ℕ := (readLimbs [1150079816126299998,971018257530083229,1040328738299307775,864513488565420021,1123538153155591545,857653874402451055,702539444257790974,458671])
def zeros : Finset Nat := (Finset.range 441).filter fun z => boardZeroBits.testBit z
theorem boardBits : ∀ i j : V, boardZeroBits.testBit (ix i j) = !(bit i j) := by decide +kernel
theorem zeroCoord {z : ℕ} (h : z ∈ zeros) :
    ∃ i j : V, bit i j = false ∧ ix i j = z := by
  have eq := Finset.mem_filter.mp h
  have small := Finset.mem_range.mp eq.1
  let i : V := ⟨z/21, by omega⟩
  let j : V := ⟨z%21, by omega⟩
  have index : ix i j = z := by
    change z/21*21+z%21 = z
    omega
  have white := boardBits i j
  rw [index] at white
  refine ⟨i,j,?_,index⟩
  cases e : bit i j
  · rfl
  · simp [e, eq.2] at white

theorem moveLegal (m : Move) (v : valid m) {b : Box} (h : legal b) : legal (moved m b) := by
  intro i hi j hj
  obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hi
  obtain ⟨c,hc,rfl⟩ := Finset.mem_image.mp hj
  exact (v.2.2 a c).trans (h a ha c hc)

theorem moveInjective (m : Move) (v : valid m) : Function.Injective (moved m) := by
  intro a b eq
  apply Prod.ext
  · exact Finset.image_injective (f := perm m.1) (fun _ _ => v.1 _ _) (congrArg Prod.fst eq)
  · exact Finset.image_injective (f := perm m.2) (fun _ _ => v.2.1 _ _) (congrArg Prod.snd eq)


theorem carryLabel (s : Word) (i : HI) : carry s (hbox i) = hbox (walk s i) := by
  induction s generalizing i with
  | nil => rfl
  | cons g tail ih =>
    change carry tail (moved (gen g) (hbox i)) = hbox (walk tail (act g i))
    rw [genActs, ih]

theorem carryInjective (s : Word) : Function.Injective (carry s) := by
  induction s with
  | nil => exact fun _ _ h => h
  | cons g tail ih => exact ih.comp (moveInjective _ (genValid g))

theorem firstChecks (i : HI) : carry (first i) (hbox i) = hbox 0 := by
  rw [carryLabel, firstIndex]

theorem secondChecks (i : HI) (nz : i ≠ 0) :
    carry (second i).2 (hbox 0) = hbox 0 ∧
    carry (second i).2 (hbox i) = hbox (anchor (second i).1) := by
  simp only [carryLabel, (secondIndex i nz).1, (secondIndex i nz).2, and_self]

theorem thirdChecks (a : Fin 4) (i : HI) (nz : i ≠ 0) (other : i ≠ anchor a) :
    ({hbox 0,hbox (anchor a),hbox i} : Finset Box).image (carry (third a i).2) =
      repSet (third a i).1 := by
  let s := (third a i).2
  let k := (third a i).1
  have labels : ({0,anchor a,i} : Finset HI).image (walk s) = repLabels k := thirdIndex a i nz other
  have eq := congrArg (Finset.image hbox) labels
  have endRep : (repLabels k).image hbox = repSet k := by
    unfold repLabels repSet
    generalize rep[k.val]! = triple
    rcases triple with ⟨x,y,z⟩
    simp
  rw [endRep] at eq
  simpa only [Finset.image_insert,Finset.image_singleton,carryLabel] using eq

abbrev admissibleTwelve (T : Finset Box) := T.card ≤ 12 ∧ (∀ b ∈ T, legal b) ∧ hits T

theorem moveTwelve (m : Move) (v : valid m) (T : Finset Box) (h : admissibleTwelve T) :
    admissibleTwelve (T.image (moved m)) := by
  refine ⟨Finset.card_image_le.trans h.1,?_,?_⟩
  · intro b hb
    obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hb
    exact moveLegal m v (h.2.1 a ha)
  · intro i j eq
    obtain ⟨a,rfl⟩ := Finite.surjective_of_injective (f := perm m.1) (fun _ _ => v.1 _ _) i
    obtain ⟨c,rfl⟩ := Finite.surjective_of_injective (f := perm m.2) (fun _ _ => v.2.1 _ _) j
    obtain ⟨b,hb,ha,hc⟩ := h.2.2 a c ((v.2.2 a c).symm.trans eq)
    exact ⟨moved m b, Finset.mem_image_of_mem _ hb, Finset.mem_image_of_mem _ ha, Finset.mem_image_of_mem _ hc⟩

theorem carryTwelve (s : Word) (T : Finset Box) (h : admissibleTwelve T) :
    admissibleTwelve (T.image (carry s)) := by
  induction s generalizing T with
  | nil => change admissibleTwelve (T.image id); simpa using h
  | cons g tail ih =>
    have H := ih _ (moveTwelve (gen g) (genValid g) T h)
    rw [Finset.image_image] at H
    exact H

theorem moveArea (m : Move) (v : valid m) (b : Box) : area (moved m b) = area b := by
  unfold area moved
  simp only [Finset.card_image_of_injective _ (show Function.Injective (perm m.1) from v.1),
    Finset.card_image_of_injective _ (show Function.Injective (perm m.2) from v.2.1)]

theorem carryArea (s : Word) (b : Box) : area (carry s b) = area b := by
  induction s generalizing b with
  | nil => rfl
  | cons g s ih =>
    change area (carry s (moved (gen g) b)) = area b
    rw [ih,moveArea _ (genValid g)]

theorem carryLarge (s : Word) (T : Finset Box) :
    (T.image (carry s)).filter (fun b => 28 < area b) =
      (T.filter (fun b => 28 < area b)).image (carry s) := by
  ext z
  simp only [Finset.mem_filter,Finset.mem_image]
  constructor
  · rintro ⟨⟨x,hx,rfl⟩,h⟩
    exact ⟨x,⟨hx,carryArea s x ▸ h⟩,rfl⟩
  · rintro ⟨x,⟨hx,h⟩,rfl⟩
    exact ⟨⟨x,hx,rfl⟩,(carryArea s x).symm ▸ h⟩

theorem carryImage (s : Word) (F : Finset HI) :
    (F.image hbox).image (carry s) = (F.image (walk s)).image hbox := by
  rw [Finset.image_image,Finset.image_image]
  apply Finset.image_congr
  intro i _
  exact carryLabel s i

