def ovalLeft (i : HI) : ℕ := (hs[i.val]!).1

theorem leftInRange : ∀ i : HI, ovalLeft i < 2^21 := by decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem leftNodup : (List.ofFn ovalLeft).Nodup := by decide +kernel

theorem leftInjective : Function.Injective ovalLeft := by
  intro i j eq
  have len : (List.ofFn ovalLeft).length = 168 := List.length_ofFn
  let a := i.cast len.symm
  let b := j.cast len.symm
  have same : (List.ofFn ovalLeft).get a = (List.ofFn ovalLeft).get b := by
    simpa only [List.get_eq_getElem, List.getElem_ofFn, a, b, Fin.val_cast, Fin.eta] using eq
  exact Fin.ext (congrArg Fin.val (leftNodup.injective_get same))

theorem hboxInjective : Function.Injective hbox := by
  intro i j eq
  apply leftInjective
  apply Nat.eq_of_testBit_eq
  intro n
  by_cases inside : n < 21
  · have h : (⟨n,inside⟩ : V) ∈ (hbox i).1 ↔ (⟨n,inside⟩ : V) ∈ (hbox j).1 := by rw [eq]
    apply Bool.eq_iff_iff.mpr
    simpa [hbox,setOfMask,ovalLeft] using h
  · have bound : 2^21 ≤ (2 : ℕ)^n := pow_le_pow_right₀ (by decide) (Nat.ge_of_not_lt inside)
    rw [Nat.testBit_eq_false_of_lt ((leftInRange i).trans_le bound),
      Nat.testBit_eq_false_of_lt ((leftInRange j).trans_le bound)]

theorem walkInjective (s : Word) : Function.Injective (walk s) := by
  intro i j e
  apply hboxInjective
  apply carryInjective s
  rw [carryLabel, carryLabel, e]

theorem walkAppend (s w : Word) (i : HI) : walk (s ++ w) i = walk w (walk s i) := by
  simp [walk]

theorem normalizeTriple (a b c : HI) (ab : a ≠ b) (ac : a ≠ c) (bc : b ≠ c) :
    ∃ k : Fin 28, ∃ s : Word, ({a,b,c} : Finset HI).image (walk s) = repLabels k := by
  let m := first a
  have ha : walk m a = 0 := firstIndex a
  let j := walk m b
  have hj : j ≠ 0 := fun e => ab (walkInjective m (ha.trans e.symm))
  let n := (second j).2
  let e := (second j).1
  have h0 : walk n 0 = 0 := (secondIndex j hj).1
  have he : walk n j = anchor e := (secondIndex j hj).2
  let y := walk n (walk m c)
  have y0 : y ≠ 0 := fun z => ac (walkInjective m (ha.trans (walkInjective n (h0.trans z.symm))))
  have ye : y ≠ anchor e := fun z => bc (walkInjective m (walkInjective n (he.trans z.symm)))
  let u := (third e y).2
  let k := (third e y).1
  have step : ({a,b,c} : Finset HI).image (walk (m++n)) = {0,anchor e,y} := by
    simp only [Finset.image_insert, Finset.image_singleton, walkAppend, ha, h0]
    change ({0,walk n j,y} : Finset HI) = {0,anchor e,y}
    rw [he]
  refine ⟨k,m++n++u,?_⟩
  calc
    _ = (({a,b,c} : Finset HI).image (walk (m++n))).image (walk u) := by
      simp [walkAppend]
    _ = repLabels k := by rw [step]; exact thirdIndex e y y0 ye

def reflect (i : V) : V := Fin.ofNat 21 (21 - i.val)

theorem reflectTwice : Function.Involutive reflect := by
  change ∀ i : V, reflect (reflect i) = i
  decide +kernel

theorem reflectBit : ∀ i j : V, bit (reflect j) (reflect i) = bit i j := by decide +kernel

def reflected (b : Box) : Box := (b.2.image reflect,b.1.image reflect)

theorem reflectCover (T : Finset Box) (h : admissibleTwelve T) :
    admissibleTwelve (T.image reflected) := by
  refine ⟨Finset.card_image_le.trans h.1,?_,?_⟩
  · intro b hb i hi j hj
    obtain ⟨d,hd,rfl⟩ := Finset.mem_image.mp hb
    obtain ⟨l,hl,rfl⟩ := Finset.mem_image.mp hi
    obtain ⟨r,hr,rfl⟩ := Finset.mem_image.mp hj
    exact (reflectBit r l).trans (h.2.1 d hd r hr l hl)
  · intro i j hz
    obtain ⟨d,hd,hi,hj⟩ := h.2.2 (reflect j) (reflect i) ((reflectBit i j).trans hz)
    refine ⟨reflected d,Finset.mem_image_of_mem _ hd,?_,?_⟩
    · exact reflectTwice i ▸ Finset.mem_image_of_mem reflect hj
    · exact reflectTwice j ▸ Finset.mem_image_of_mem reflect hi

set_option maxRecDepth 24000 in
set_option maxHeartbeats 0 in
theorem transposeActs : ∀ i : HI, reflected (hbox i) = hbox transposeAction[i.val]! := by decide +kernel

abbrev G4 := Fin 10

def extAct (g : G4) (i : HI) : HI :=
  if h : g.val < 9 then act ⟨g.val,h⟩ i else transposeAction[i.val]!

def extMove (g : G4) (b : Box) : Box :=
  if h : g.val < 9 then moved (gen ⟨g.val,h⟩) b else reflected b

theorem extActValid (g : G4) (i : HI) : extMove g (hbox i) = hbox (extAct g i) := by
  unfold extMove extAct
  split
  next h => exact genActs _ _
  next h => exact transposeActs i

theorem extMoveValid (g : G4) (T : Finset Box) (h : admissibleTwelve T) :
    admissibleTwelve (T.image (extMove g)) := by
  by_cases hg : g.val < 9
  · have ex : extMove g = moved (gen ⟨g.val,hg⟩) := by
      funext b
      simp [extMove,hg]
    rw [ex]
    exact moveTwelve _ (genValid ⟨g.val,hg⟩) T h
  · have ex : extMove g = reflected := by
      funext b
      simp [extMove,hg]
    rw [ex]
    exact reflectCover T h

def walkFour (s : List G4) (i : HI) := s.foldl (fun j g => extAct g j) i
def carryFour (s : List G4) (b : Box) := s.foldl (fun z g => extMove g z) b

theorem carryFourLabel (s : List G4) (i : HI) : carryFour s (hbox i) = hbox (walkFour s i) := by
  induction s generalizing i with
  | nil => rfl
  | cons g s ih =>
    change carryFour s (extMove g (hbox i)) = hbox (walkFour s (extAct g i))
    rw [extActValid,ih]

theorem carryFourCover (s : List G4) (T : Finset Box) (h : admissibleTwelve T) :
    admissibleTwelve (T.image (carryFour s)) := by
  induction s generalizing T with
  | nil => change admissibleTwelve (T.image id); simpa using h
  | cons g tail ih =>
    have H := ih _ (extMoveValid g T h)
    rw [Finset.image_image] at H
    exact H

def wordFour : ℕ → ℕ → List G4
  | 0, _ => []
  | fuel+1, n => if n = 0 then [] else Fin.ofNat 10 (n % 11 - 1) :: wordFour fuel (n / 11)

def fourCode (k : Fin 28) (i : HI) : ℕ := (certData[k.val]!)[i.val]!
def fourClass (k : Fin 28) (i : HI) : Fin 235 := Fin.ofNat 235 (fourCode k i)
def fourRoute (k : Fin 28) (i : HI) : List G4 := wordFour 7 (fourCode k i / 235)

def quadLabels (k : Fin 235) : Finset HI :=
  let (a,b,c,d) := quadData[k.val]!
  {a,b,c,d}

def quadRepSet (k : Fin 235) : Finset Box := (quadLabels k).image hbox

abbrev validAt (k : Fin 28) : Prop := ∀ i : HI, i ∉ repLabels k →
  (insert i (repLabels k)).image (walkFour (fourRoute k i)) = quadLabels (fourClass k i)


theorem carrySub (s : Word) (T : Finset Box) (F D : Finset HI)
    (marked : F.image hbox ⊆ T) (label : F.image (walk s) = D) :
    D.image hbox ⊆ T.image (carry s) := by
  rw [← label, ← carryImage]
  exact Finset.image_subset_image marked

theorem normalizeOneSub (T : Finset Box) (h : admissibleTwelve T) (i : HI)
    (marked : ({hbox i} : Finset Box) ⊆ T) :
    ∃ U, admissibleTwelve U ∧ ({hbox 0} : Finset Box) ⊆ U := by
  let s := first i
  refine ⟨T.image (carry s),carryTwelve s T h,?_⟩
  simpa only [Finset.image_singleton,carryLabel,s,firstIndex] using
    (Finset.image_subset_image (f := carry s) marked :
      ({hbox i} : Finset Box).image (carry s) ⊆ T.image (carry s))

theorem normalizeTwoSub (T : Finset Box) (h : admissibleTwelve T) (a b : HI) (ab : a ≠ b)
    (marked : ({hbox a,hbox b} : Finset Box) ⊆ T) :
    ∃ k : Fin 4, ∃ U, admissibleTwelve U ∧ ({hbox 0,hbox (anchor k)} : Finset Box) ⊆ U := by
  let m := first a
  let j := walk m b
  have j0 : j ≠ 0 := fun z => ab (walkInjective m ((firstIndex a).trans z.symm))
  let n := (second j).2
  let k := (second j).1
  have h0 : walk n 0 = 0 := (secondIndex j j0).1
  have hk : walk n j = anchor k := (secondIndex j j0).2
  have ha : walk m a = 0 := firstIndex a
  have labels : ({a,b} : Finset HI).image (walk (m++n)) = {0,anchor k} := by
    simp only [Finset.image_insert,Finset.image_singleton,walkAppend,ha,h0]
    change ({0,walk n j} : Finset HI) = _
    rw [hk]
  refine ⟨k,_,carryTwelve (m++n) T h,?_⟩
  have source : ({a,b} : Finset HI).image hbox ⊆ T := by
    simpa only [Finset.image_insert,Finset.image_singleton] using marked
  simpa only [Finset.image_insert,Finset.image_singleton] using carrySub (m++n) T _ _ source labels

theorem normalizeThreeSub (T : Finset Box) (h : admissibleTwelve T) (a b c : HI)
    (ab : a ≠ b) (ac : a ≠ c) (bc : b ≠ c)
    (marked : ({a,b,c} : Finset HI).image hbox ⊆ T) :
    ∃ k : Fin 28, ∃ U, admissibleTwelve U ∧ repSet k ⊆ U := by
  obtain ⟨k,s,hs⟩ := normalizeTriple a b c ab ac bc
  refine ⟨k,T.image (carry s),carryTwelve s T h,?_⟩
  have eq : repSet k = (repLabels k).image hbox := by
    unfold repLabels repSet
    rcases rep[k.val]! with ⟨a,b,c⟩
    simp only [Finset.image_insert, Finset.image_singleton]
  rw [eq]
  exact carrySub s T _ _ marked hs

