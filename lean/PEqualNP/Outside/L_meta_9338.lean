    (weights : Array (Array Nat)) (bias high : Nat)
    (pass : checkSide sizes skipFive blocked weights bias high = true)
    (A : Finset (Fin sideSize)) (size : A.card ∈ sizes) (nonzero : closureMask blocked A ≠ 0) :
    checkedClosure weights bias high A.card skipFive (rowList A).reverse (closureMask blocked A) = true := by
  simpa only [rowList_length,closureMask] using
    checkSide_sound sizes skipFive blocked weights bias high pass (rowList A) (rowList_sublist A)
      (by simpa only [rowList_length] using size) nonzero

theorem checkSidePart_finset_sound (sizes : List Nat) (skipFive : Bool) (blocked : Array Nat)
    (weights : Array (Array Nat)) (bias high : Nat)
    (pass : ∀ i : Fin sideSize, checkSidePart sizes skipFive blocked weights bias high i.val = true)
    (A : Finset (Fin sideSize)) (size : A.card ∈ sizes) (positive : A.Nonempty)
    (nonzero : closureMask blocked A ≠ 0) :
    checkedClosure weights bias high A.card skipFive (rowList A).reverse (closureMask blocked A) = true := by
  have sub := rowList_sublist A
  have len := rowList_length A
  unfold closureMask at nonzero ⊢
  cases eq : rowList A with
  | nil =>
    rw [eq,List.length_nil] at len
    exact (Finset.card_pos.mpr positive).ne' len.symm |>.elim
  | cons first rest =>
    rw [eq] at sub nonzero len
    rw [← len]
    exact checkSidePart_sound sizes skipFive blocked weights bias high pass first rest sub (len ▸ size) nonzero

private theorem fold_add_map {α : Type} (f : α → Nat) (xs : List α) (initial : Nat) :
    xs.foldl (fun sum i => sum + f i) initial = initial + (xs.map f).sum := by
  induction xs generalizing initial with
  | nil => simp
  | cons i tail ih => simp [ih,Nat.add_assoc]

