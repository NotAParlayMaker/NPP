  exact useLeft (Or.inr ⟨fiveA, fiveB.trans (Finset.card_le_card inclL.2)⟩)

theorem coverAll (P : Box → Prop) (down : ∀ ⦃a b : Box⦄, BoxLe a b → P b → P a)
    (hyper : ∀ h : HI, P (hbox h)) (small : ∀ b : Box, legal b → Nonextendable b → P b)
    (b : Box) (valid : legal b) : P b := by
  classical
  by_cases covered : ∃ h : HI, BoxLe b (hbox h)
  · obtain ⟨h, incl⟩ := covered
    exact down incl (hyper h)
  · exact small b valid (fun h incl => covered ⟨h, incl⟩)

theorem positionsSubset {a b : Box} (le : BoxLe a b) :
    positions a.1 a.2 ⊆ positions b.1 b.2 := by
  intro p hp
  obtain ⟨⟨i, j⟩, inside, rfl⟩ := Finset.mem_image.mp hp
  obtain ⟨hi, hj⟩ := Finset.mem_product.mp inside
  exact Finset.mem_image.mpr ⟨(i, j), Finset.mem_product.mpr ⟨le.1 hi, le.2 hj⟩, rfl⟩

theorem rectangleWeightMono (w : ℕ → ℕ) {a b : Box} (le : BoxLe a b) :
    (∑ p ∈ positions a.1 a.2, w p) ≤ ∑ p ∈ positions b.1 b.2, w p :=
  Finset.sum_le_sum_of_subset_of_nonneg (positionsSubset le) (fun _ _ _ => Nat.zero_le _)

theorem rectangleWeightEmpty (w : ℕ → ℕ) (b : Box) (empty : b.1 = ∅ ∨ b.2 = ∅) :
    (∑ p ∈ positions b.1 b.2, w p) = 0 := by
  rcases empty with h | h <;> simp [positions, h]


theorem rectanglePacketUpper (b : Box) (lanes : ℕ) (w : ℕ → ℕ → ℕ) (cap : ℕ → ℕ)
    (load : ∀ j < lanes, (∑ p ∈ positions b.1 b.2, w p j) < 1024)
    (maxCap : ∀ j < lanes, cap j ≤ 1023)
    (clear : ((∑ p ∈ positions b.1 b.2, PEqualNP.Outside.L_meta_9338_aux.ParallelWeight.pack 2048 lanes (w p)) +
      PEqualNP.Outside.L_meta_9338_aux.ParallelWeight.pack 2048 lanes (fun j => 1023 - cap j)) &&& PEqualNP.Outside.L_meta_9338_aux.ParallelWeight.pack 2048 lanes (fun _ => 1024) = 0) :
    ∀ j < lanes, (∑ p ∈ positions b.1 b.2, w p j) ≤ cap j :=
  ParallelWeight.batchGuardOfMask (positions b.1 b.2) lanes w cap load maxCap clear

end ParallelRectangles

namespace ClosureEnum9338

def sideSize : Nat := 21
def allVertices : Nat := (1 <<< sideSize) - 1

def members (mask : Nat) : List Nat :=
  (List.range sideSize).filter (fun i => mask.testBit i)

def packedRowLoad (row : Array Nat) (columns : List Nat) : Nat :=
  columns.foldl (fun total j => total + row[j]!) 0

def packedLoad (weights : Array (Array Nat)) (rows columns : List Nat) : Nat :=
  rows.foldl (fun total i => total + packedRowLoad weights[i]! columns) 0

def packetOK (weights : Array (Array Nat)) (bias high : Nat) (rows columns : List Nat) : Bool :=
  ((packedLoad weights rows columns + bias) &&& high) == 0

def checkedClosure (weights : Array (Array Nat)) (bias high : Nat)
    (size : Nat) (skipFive : Bool) (rows : List Nat) (common : Nat) : Bool :=
  let columns := members common
  if columns.isEmpty || (skipFive && size == 5 && Nat.blt columns.length 5)
      || Nat.blt 28 (size * columns.length) then
    true
  else
    packetOK weights bias high rows columns

def choose (blocked : Array Nat) (check : List Nat → Nat → Bool) :
    List Nat → Nat → List Nat → Nat → Bool
  | _, 0, rows, common => check rows common
  | [], _ + 1, _, _ => true
  | i :: rest, k + 1, rows, common =>
    let next := common &&& (allVertices ^^^ blocked[i]!)
    (next == 0 || choose blocked check rest k (i :: rows) next) &&
      choose blocked check rest (k + 1) rows common

def checkSide (sizes : List Nat) (skipFive : Bool) (blocked : Array Nat)
    (weights : Array (Array Nat)) (bias high : Nat) : Bool :=
  sizes.all fun k => choose blocked (checkedClosure weights bias high k skipFive)
    (List.range sideSize) k [] allVertices

/-- Partition the checks according to the least selected vertex. -/
def checkSidePart (sizes : List Nat) (skipFive : Bool) (blocked : Array Nat)
    (weights : Array (Array Nat)) (bias high first : Nat) : Bool :=
  let common := allVertices ^^^ blocked[first]!
  let rest := (List.range sideSize).drop (first + 1)
  sizes.all fun k => choose blocked (checkedClosure weights bias high k skipFive)
    rest (k - 1) [first] common

def checkHyper (hypers : Array (Nat × Nat)) (weights : Array (Array Nat))
    (bias unrestricted : Nat) : Bool :=
  hypers.all fun (a, b) => packetOK weights bias unrestricted (members a) (members b)

end ClosureEnum9338
