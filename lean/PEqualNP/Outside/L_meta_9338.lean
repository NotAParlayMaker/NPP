theorem normalizeFour (T : Finset Box) (h : admissibleTwelve T) (F : Finset HI)
    (four : F.card = 4) (inside : F.image hbox ⊆ T) :
    ∃ (klass : Fin 235) (U : Finset Box), admissibleTwelve U ∧ quadRepSet klass ⊆ U := by
  obtain ⟨a,b,c,d,ab,ac,ad,bc,bd,cd,rfl⟩ := Finset.card_eq_four.mp four
  obtain ⟨k,w,hw⟩ := normalizeTriple a b c ab ac bc
  let i := walk w d
  have outside : i ∉ repLabels k := by
    rw [← hw]
    intro inImage
    obtain ⟨e,he,ee⟩ := Finset.mem_image.mp inImage
    have eD : e = d := walkInjective w ee
    subst e
    simp [Ne.symm ad,Ne.symm bd,Ne.symm cd] at he
  let S := T.image (carry w)
  have hs : admissibleTwelve S := carryTwelve w T h
  have normalized : (insert i (repLabels k)).image hbox ⊆ S := by
    have eq : (insert i (repLabels k)).image hbox =
        (({a,b,c,d} : Finset HI).image hbox).image (carry w) := by
      rw [← hw, ← Finset.image_insert]
      simp only [Finset.image_image, Function.comp_def, carryLabel]
      have sets : insert d ({a,b,c} : Finset HI) = {a,b,c,d} := by ext; simp; aesop
      rw [sets]
    rw [eq]
    exact Finset.image_subset_image inside
  let route := fourRoute k i
  let klass := fourClass k i
  let U := S.image (carryFour route)
  have hu : admissibleTwelve U := carryFourCover route S hs
  refine ⟨klass,U,hu,?_⟩
  have certificate := allFourRoutes k i outside
  have eq : quadRepSet klass =
      ((insert i (repLabels k)).image hbox).image (carryFour route) := by
    unfold quadRepSet
    rw [← certificate]
    simp only [Finset.image_image,Function.comp_def,carryFourLabel,route]
  rw [eq]
  exact Finset.image_subset_image normalized
open Finset

private theorem disjoint_of_card_biUnion_eq {ι α : Type*} [DecidableEq α]
    (S : Finset ι) (A : ι → Finset α)
    (h : (S.biUnion A).card = ∑ i ∈ S, (A i).card) :
    (S : Set ι).PairwiseDisjoint A := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | @insert i S hi ih =>
    rw [Finset.biUnion_insert, Finset.sum_insert hi] at h
    have union_le := Finset.card_union_le (A i) (S.biUnion A)
    have parts_le : (S.biUnion A).card ≤ ∑ j ∈ S, (A j).card := Finset.card_biUnion_le
    have parts_eq : (S.biUnion A).card = ∑ j ∈ S, (A j).card := by omega
    have new_disj : Disjoint (A i) (S.biUnion A) := by
      apply Finset.card_union_eq_card_add_card.mp
      simpa only [parts_eq] using h
    rw [Finset.coe_insert]
    refine Set.pairwiseDisjoint_insert.mpr ⟨ih parts_eq, ?_⟩
    intro j hj _
    exact new_disj.mono_right (Finset.subset_biUnion_of_mem A hj)

def zeroBoardCells : Finset (V × V) := Finset.univ.filter (fun p => bit p.1 p.2 = false)

set_option maxRecDepth 12000 in
theorem zeroBoardCells_card : zeroBoardCells.card = 336 := by decide +kernel

theorem zeroBoardCells_union (T : Finset Box) (ok : ∀ b ∈ T, legal b) (cover : hits T) :
    T.biUnion (fun b => b.1 ×ˢ b.2) = zeroBoardCells := by
  ext ⟨i,j⟩
  simp only [Finset.mem_biUnion, Finset.mem_product, zeroBoardCells, Finset.mem_filter,
    Finset.mem_univ, true_and]
  exact ⟨fun ⟨b,hb,hi,hj⟩ => ok b hb i hi j hj, cover i j⟩

theorem smallExactPacking (T : Finset Box) (small : T.card ≤ 12) (ok : ∀ b ∈ T, legal b)
    (cover : hits T) (bound : ∀ b ∈ T, area b ≤ 28) :
    T.card = 12 ∧ (∀ b ∈ T, area b = 28) ∧
    (T : Set Box).PairwiseDisjoint (fun b => b.1 ×ˢ b.2) := by
  have lower : 336 ≤ ∑ b ∈ T, area b := by
    simpa only [zeroBoardCells_union T ok cover, zeroBoardCells_card, Finset.card_product, area]
      using (Finset.card_biUnion_le (s := T) (t := fun b => b.1 ×ˢ b.2))
  have upper : (∑ b ∈ T, area b) ≤ 28 * T.card := by
    simpa [Nat.mul_comm] using (Finset.sum_le_sum (g := fun _ => 28) bound)
  refine ⟨by omega, ?_, ?_⟩
  · intro b hb
    by_contra! h
    have less : (∑ a ∈ T, area a) < 28 * T.card := by
      simpa [Nat.mul_comm] using
        (Finset.sum_lt_sum (g := fun _ => 28) bound ⟨b,hb,by have := bound b hb; omega⟩)
    omega
  · apply disjoint_of_card_biUnion_eq
    simp only [zeroBoardCells_union T ok cover, zeroBoardCells_card, Finset.card_product]
    change 336 = ∑ b ∈ T, area b
    omega

def whiteRow (i : V) : Finset V := Finset.univ.filter (fun j => bit i j = false)
def whiteCol (j : V) : Finset V := Finset.univ.filter (fun i => bit i j = false)

theorem whiteRow_card : ∀ i : V, (whiteRow i).card = 16 := by decide +kernel
theorem whiteCol_card : ∀ j : V, (whiteCol j).card = 16 := by decide +kernel

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
private theorem whiteRows_inter : ∀ i k : V, i ≠ k → (whiteRow i ∩ whiteRow k).card = 12 := by
  decide +kernel

set_option maxRecDepth 12000 in
set_option maxHeartbeats 0 in
private theorem whiteCols_inter : ∀ j l : V, j ≠ l → (whiteCol j ∩ whiteCol l).card = 12 := by
  decide +kernel

private theorem factor28 (a b : ℕ) (ha : a ≤ 21) (hb : b ≤ 21) (hm : a*b = 28) :
    (a = 2 ∧ b = 14) ∨ (a = 4 ∧ b = 7) ∨ (a = 7 ∧ b = 4) ∨ (a = 14 ∧ b = 2) := by
  interval_cases a <;> omega

theorem legalShape28 (b : Box) (ok : legal b) (sz : area b = 28) :
    (b.1.card = 4 ∧ b.2.card = 7) ∨ (b.1.card = 7 ∧ b.2.card = 4) := by
  have hR : b.1.card ≤ 21 := by simpa using (Finset.card_le_univ b.1)
  have hC : b.2.card ≤ 21 := by simpa using (Finset.card_le_univ b.2)
  rcases factor28 b.1.card b.2.card hR hC sz with h | h | h | h
  · obtain ⟨i,hi,k,hk,ne⟩ := Finset.one_lt_card.mp (show 1 < b.1.card by omega)
    have sub : b.2 ⊆ whiteRow i ∩ whiteRow k := by
      intro j hj
      simp [whiteRow, ok i hi j hj, ok k hk j hj]
    have bound' := Finset.card_le_card sub
    rw [whiteRows_inter i k ne] at bound'
    omega
  · exact Or.inl h
  · exact Or.inr h
  · obtain ⟨j,hj,l,hl,ne⟩ := Finset.one_lt_card.mp (show 1 < b.2.card by omega)
    have sub : b.1 ⊆ whiteCol j ∩ whiteCol l := by
      intro i hi
      simp [whiteCol, ok i hi j hj, ok i hi l hl]
    have bound' := Finset.card_le_card sub
    rw [whiteCols_inter j l ne] at bound'
    omega

private theorem four_of_section {ι : Type*} (S : Finset ι) (A : ι → Finset V)
    (sizes : ∀ b ∈ S, (A b).card = 4 ∨ (A b).card = 7)
    (disj : (S : Set ι).PairwiseDisjoint A) (count : (S.biUnion A).card = 16) :
    ∀ b ∈ S, (A b).card = 4 := by
  let F := S.filter (fun b => (A b).card = 4)
  let G := S.filter (fun b => (A b).card ≠ 4)
  have partF : (∑ b ∈ F, (A b).card) = F.card * 4 :=
    Finset.sum_const_nat (fun b hb => (Finset.mem_filter.mp hb).2)
  have partG : (∑ b ∈ G, (A b).card) = G.card * 7 := by
    apply Finset.sum_const_nat
    intro b hb
    obtain ⟨hS,h4⟩ := Finset.mem_filter.mp hb
    exact (sizes b hS).resolve_left h4
  have total := Finset.sum_filter_add_sum_filter_not S (fun b => (A b).card = 4)
    (fun b => (A b).card)
  change (∑ b ∈ F, (A b).card) + (∑ b ∈ G, (A b).card) = _ at total
  rw [partF, partG, ← Finset.card_biUnion disj, count] at total
  intro b hb
  by_contra! hn
  have pos : 0 < G.card := Finset.card_pos.mpr ⟨b,Finset.mem_filter.mpr ⟨hb,hn⟩⟩
  omega

private theorem four_of_board_slice (T : Finset Box) (R C : Box → Finset V)
    (W : V → Finset V) (white : ∀ i, (W i).card = 16)
    (tiles : ∀ i j, j ∈ W i ↔ ∃ b ∈ T, i ∈ R b ∧ j ∈ C b)
    (sizes : ∀ b ∈ T, (C b).card = 4 ∨ (C b).card = 7)
    (disj : (T : Set Box).PairwiseDisjoint (fun b => R b ×ˢ C b))
    (b : Box) (hb : b ∈ T) (active : (R b).Nonempty) : (C b).card = 4 := by
  obtain ⟨i,hi⟩ := active
  let S := T.filter (fun d => i ∈ R d)
  have belong : b ∈ S := Finset.mem_filter.mpr ⟨hb,hi⟩
  have split : (S : Set Box).PairwiseDisjoint C := by
    intro x hx y hy hxy
    obtain ⟨hxt,hxi⟩ := Finset.mem_filter.mp (show x ∈ S from hx)
    obtain ⟨hyt,hyi⟩ := Finset.mem_filter.mp (show y ∈ S from hy)
    apply Finset.disjoint_left.mpr
    intro j hxj hyj
    have at_x : (i,j) ∈ R x ×ˢ C x := Finset.mem_product.mpr ⟨hxi,hxj⟩
    exact Finset.disjoint_left.mp (disj hxt hyt hxy) at_x (Finset.mem_product.mpr ⟨hyi,hyj⟩)
  have partition : S.biUnion C = W i := by
    ext j
    simpa only [S, Finset.mem_biUnion, Finset.mem_filter, and_assoc] using (tiles i j).symm
  exact four_of_section S C (fun d hd => sizes d (Finset.mem_filter.mp hd).1)
    split (partition ▸ white i) b belong

theorem noTwelveSmall (T : Finset Box) (small : T.card ≤ 12) (ok : ∀ b ∈ T, legal b)
    (cover : hits T) (bound : ∀ b ∈ T, area b ≤ 28) : False := by
  obtain ⟨ct,exact_area,pair⟩ := smallExactPacking T small ok cover bound
  obtain ⟨b,hb⟩ := Finset.card_pos.mp (show 0 < T.card by omega)
  have shape (d : Box) (hd : d ∈ T) := legalShape28 d (ok d hd) (exact_area d hd)
  have nonempty (s : Finset V) (h : s.card = 4 ∨ s.card = 7) : s.Nonempty :=
    Finset.card_pos.mp (by omega)
  have lshape (d : Box) (hd : d ∈ T) : d.1.card = 4 ∨ d.1.card = 7 := by
    rcases shape d hd with h | h
    · exact Or.inl h.1
    · exact Or.inr h.1
  have rshape (d : Box) (hd : d ∈ T) : d.2.card = 4 ∨ d.2.card = 7 := by
    rcases shape d hd with h | h
    · exact Or.inr h.2
    · exact Or.inl h.2
  have widths : b.2.card = 4 := by
    apply four_of_board_slice T Prod.fst Prod.snd whiteRow whiteRow_card _ rshape pair b hb
      (nonempty b.1 (lshape b hb))
    intro i j
    simpa only [whiteRow, Finset.mem_filter, Finset.mem_univ, true_and] using
      (show bit i j = false ↔ ∃ d ∈ T, i ∈ d.1 ∧ j ∈ d.2 from
        ⟨cover i j, fun ⟨d,hd,hi,hj⟩ => ok d hd i hi j hj⟩)
  have heights : b.1.card = 4 := by
    apply four_of_board_slice T Prod.snd Prod.fst whiteCol whiteCol_card _ lshape _ b hb
      (nonempty b.2 (rshape b hb))
    · intro j i
      simpa only [whiteCol, Finset.mem_filter, Finset.mem_univ, true_and] using
        (show bit i j = false ↔ ∃ d ∈ T, j ∈ d.2 ∧ i ∈ d.1 from
          ⟨fun h => by obtain ⟨d,hd,hi,hj⟩ := cover i j h; exact ⟨d,hd,hj,hi⟩,
           fun ⟨d,hd,hj,hi⟩ => ok d hd i hi j hj⟩)
    · intro x hx y hy hxy
      apply Finset.disjoint_left.mpr
      intro ⟨j,i⟩ hxij hyij
      obtain ⟨hxj,hxi⟩ := Finset.mem_product.mp hxij
      obtain ⟨hyj,hyi⟩ := Finset.mem_product.mp hyij
      have at_x : (i,j) ∈ x.1 ×ˢ x.2 := Finset.mem_product.mpr ⟨hxi,hxj⟩
      exact Finset.disjoint_left.mp (pair hx hy hxy) at_x (Finset.mem_product.mpr ⟨hyi,hyj⟩)
  have wrong := exact_area b hb
  simp [area, heights, widths] at wrong



open Finset

def hasLabelCover (c : ℕ) : Prop :=
  ∃ T : Finset Box, T.card ≤ 12 ∧ (∀ b ∈ T, legal b) ∧ hits T ∧
    ∃ Z : Finset Box, Z ⊆ T ∧ Z.card = c ∧ (∀ z ∈ Z, ∃ h : HI, z = hbox h)

theorem remainingContainedInLabels {c : ℕ} (exclude : ¬ hasLabelCover (c+1))
    {U Z : Finset Box} (small : U.card ≤ 12) (ok : ∀ b ∈ U, legal b) (hit : hits U)
    (sub : Z ⊆ U) (size : Z.card = c) (labels : ∀ z ∈ Z, ∃ h : HI, z = hbox h)
    {b : Box} (hb : b ∈ U) (notSelected : b ∉ Z) {h : HI}
    (rowsIn : b.1 ⊆ (hbox h).1) (colsIn : b.2 ⊆ (hbox h).2) : hbox h ∈ Z := by
  classical
  by_contra fresh
  apply exclude
  refine ⟨insert (hbox h) (U.erase b), ?_, ?_, ?_, insert (hbox h) Z, ?_, ?_, ?_⟩
  · exact (Finset.card_insert_le _ _).trans ((Finset.card_erase_add_one hb).le.trans small)
  · intro d hd
    rcases Finset.mem_insert.mp hd with rfl | hd
    · exact (labelShape h).2.2
    · exact ok d (Finset.mem_erase.mp hd).2
  · intro i j white
    obtain ⟨d, hd, hi, hj⟩ := hit i j white
    by_cases heq : d = b
    · subst d
      exact ⟨hbox h, Finset.mem_insert_self _ _, rowsIn hi, colsIn hj⟩
    · exact ⟨d, Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨heq,hd⟩), hi, hj⟩
  · intro z hz
    rcases Finset.mem_insert.mp hz with rfl | hz
    · exact Finset.mem_insert_self _ _
    · exact Finset.mem_insert_of_mem (Finset.mem_erase.mpr ⟨fun heq => notSelected (heq ▸ hz), sub hz⟩)
  · rw [Finset.card_insert_of_notMem fresh, size]
  · intro z hz
    rcases Finset.mem_insert.mp hz with rfl | hz
    · exact ⟨h,rfl⟩
    · exact labels z hz

theorem smallAreaWithoutLabels (exclude : ¬ hasLabelCover 1) {U : Finset Box}
    (small : U.card ≤ 12) (ok : ∀ b ∈ U, legal b) (hit : hits U) :
    ∀ b ∈ U, area b ≤ 28 := by
  intro b hb
  by_contra! large
  obtain ⟨h, rowsIn, colsIn⟩ := bigExt b.1 b.2 (ok b hb) large
  have impossible := remainingContainedInLabels (c := 0) (U := U) (Z := ∅)
    exclude small ok hit (Finset.empty_subset U) rfl (by simp) hb (by simp) rowsIn colsIn
  simp at impossible

theorem noCoverWithoutLabels (exclude : ¬ hasLabelCover 1) {U : Finset Box}
    (small : U.card ≤ 12) (ok : ∀ b ∈ U, legal b) (hit : hits U) : False :=
  noTwelveSmall U small ok hit (smallAreaWithoutLabels exclude small ok hit)

theorem labelIndices {Z : Finset Box} (labels : ∀ z ∈ Z, ∃ h : HI, z = hbox h) :
    ∃ F : Finset HI, F.card = Z.card ∧ F.image hbox = Z := by
  classical
  induction Z using Finset.induction_on with
  | empty => exact ⟨∅, by simp, by simp⟩
  | @insert b S fresh ih =>
    obtain ⟨F, hF, eqF⟩ := ih (fun z hz => labels z (Finset.mem_insert_of_mem hz))
    obtain ⟨h, heq⟩ := labels b (Finset.mem_insert_self _ _)
    have newIdx : h ∉ F := by
      intro mem
      apply fresh
      rw [← eqF, heq]
      exact Finset.mem_image_of_mem hbox mem
    refine ⟨insert h F, ?_, ?_⟩
    · rw [Finset.card_insert_of_notMem newIdx, Finset.card_insert_of_notMem fresh, hF]
    · rw [Finset.image_insert, eqF, heq]




-- Apply each cut to the packed weights and to the carrier of surviving cells.
namespace Weighted

open Finset

-- The weighted double-counting argument adapts L_meta_9334 under Apache-2.0.
theorem obstruct {ι α : Type*} [DecidableEq ι] [DecidableEq α]
    (T : Finset ι) (U : Finset α) (box : ι → Finset α) (w : α → ℕ)
    (Z : Finset ι) (sub : Z ⊆ T) (c limit cap : ℕ)
    (count : Z.card = c) (budget : T.card ≤ limit)
    (zero : ∀ i ∈ Z, ∀ p ∈ box i, w p = 0)
    (upper : ∀ i ∈ T \ Z, ∑ p ∈ box i, w p ≤ cap)
    (lower : (limit - c) * cap < ∑ p ∈ U, w p) :
    ¬ (∀ p ∈ U, ∃ i ∈ T, p ∈ box i) := by
  intro cover
  let R := T \ Z
  have remaining : R.card ≤ limit - c := by
    have card := Finset.card_sdiff_add_card_eq_card sub
    dsimp [R]
    omega
  have coverWeight (p : α) (hp : p ∈ U) :
      w p ≤ ∑ i ∈ R, (if p ∈ box i then w p else 0) := by
    obtain ⟨i, hi, member⟩ := cover p hp
    by_cases hz : i ∈ Z
    · simp [zero i hz p member]
    · have hr : i ∈ R := Finset.mem_sdiff.mpr ⟨hi, hz⟩
      have bound := Finset.single_le_sum (f := fun j => if p ∈ box j then w p else 0)
        (fun j _ => Nat.zero_le _) hr
      simpa [member] using bound
  have residualWeight (i : ι) (hi : i ∈ R) :
      (∑ p ∈ U, (if p ∈ box i then w p else 0)) ≤ cap := by
    rw [← Finset.sum_filter]
    exact (Finset.sum_le_sum_of_subset_of_nonneg
      (show U.filter (· ∈ box i) ⊆ box i from fun p hp => (Finset.mem_filter.mp hp).2)
      (fun _ _ _ => Nat.zero_le _)).trans (upper i hi)
  have covered := Finset.sum_le_sum coverWeight
  rw [Finset.sum_comm] at covered
  have bounded := Finset.sum_le_sum residualWeight
  simp only [Finset.sum_const, nsmul_eq_mul] at bounded
  exact (Nat.not_le_of_gt lower) (covered.trans (bounded.trans (Nat.mul_le_mul_right cap remaining)))

theorem obstructCover (T Z : Finset Box) (w : Nat → Nat) (c cap : Nat)
    (cover : T.card ≤ 12 ∧ (∀ b ∈ T, legal b) ∧ hits T)
    (sub : Z ⊆ T) (count : Z.card = c)
    (zero : ∀ b ∈ Z, ∀ p ∈ positions b.1 b.2, w p = 0)
    (upper : ∀ b ∈ T \ Z, ∑ p ∈ positions b.1 b.2, w p ≤ cap)
    (lower : (12 - c) * cap < ∑ p ∈ zeros, w p) : False := by
  apply obstruct T zeros (fun b => positions b.1 b.2) w Z sub c 12 cap count cover.1 zero upper lower
  intro p hp
  obtain ⟨i, j, isZero, index⟩ := zeroCoord hp
  obtain ⟨b, hb, hi, hj⟩ := cover.2.2 i j isZero
  exact ⟨b, hb, Finset.mem_image.mpr ⟨(i, j), Finset.mem_product.mpr ⟨hi, hj⟩, index⟩⟩


end Weighted

namespace ParallelWeight

def pack (base lanes : ℕ) (w : ℕ → ℕ) : ℕ :=
  ∑ j ∈ Finset.range lanes, w j * base ^ j

def digit (base lane word : ℕ) : ℕ :=
  word / base ^ lane % base

private theorem pack_succ (base lanes : ℕ) (w : ℕ → ℕ) :
    pack base (lanes + 1) w = w 0 + pack base lanes (fun j => w (j + 1)) * base := by
  simp only [pack, Finset.sum_range_succ', Finset.sum_mul, Nat.pow_zero, Nat.mul_one,
    Nat.pow_succ, Nat.mul_assoc]
  exact Nat.add_comm _ _

theorem digit_pack (base lanes : ℕ) (positive : 0 < base) (w : ℕ → ℕ)
    (bounded : ∀ j < lanes, w j < base) (t : ℕ) (inRange : t < lanes) :
    digit base t (pack base lanes w) = w t := by
  induction lanes generalizing w t with
  | zero => omega
  | succ lanes ih =>
    have least := bounded 0 (Nat.zero_lt_succ lanes)
    rw [pack_succ]
    cases t with
    | zero =>
      simp only [digit, Nat.pow_zero, Nat.div_one, Nat.add_mul_mod_self_right]
      exact Nat.mod_eq_of_lt least
    | succ t =>
      unfold digit
      rw [Nat.pow_succ', ← Nat.div_div_eq_div_mul, Nat.add_mul_div_right _ _ positive,
        Nat.div_eq_of_lt least, Nat.zero_add]
      exact ih (fun j => w (j + 1)) (fun j hj => bounded (j + 1) (Nat.succ_lt_succ hj))
        t (Nat.lt_of_succ_lt_succ inRange)

theorem sum_pack {ι : Type*} (rows : Finset ι) (base lanes : ℕ) (w : ι → ℕ → ℕ) :
    (∑ r ∈ rows, pack base lanes (w r)) = pack base lanes (fun j => ∑ r ∈ rows, w r j) := by
  simp only [pack, Finset.sum_mul]
  exact Finset.sum_comm

theorem batchDigit {ι : Type*} (rows : Finset ι) (base lanes : ℕ) (positive : 0 < base)
    (w : ι → ℕ → ℕ) (bounded : ∀ j < lanes, (∑ r ∈ rows, w r j) < base)
    (t : ℕ) (inRange : t < lanes) :
    digit base t (∑ r ∈ rows, pack base lanes (w r)) = ∑ r ∈ rows, w r t := by
  rw [sum_pack]
  exact digit_pack base lanes positive _ bounded t inRange

theorem pack_add (base lanes : ℕ) (u v : ℕ → ℕ) :
    pack base lanes (fun j => u j + v j) = pack base lanes u + pack base lanes v := by
  simp only [pack, Nat.add_mul, Finset.sum_add_distrib]

private theorem high_bit_digit (word t : ℕ) :
    word.testBit (11 * t + 10) = (digit 2048 t word).testBit 10 := by
  change word.testBit (11 * t + 10) = ((word / (2 ^ 11) ^ t) % 2 ^ 11).testBit 10
  rw [← Nat.pow_mul, Nat.testBit_mod_two_pow, Nat.testBit_div_two_pow]
  simp [Nat.add_comm]

private theorem high_bit_bias (a b : ℕ) (load : a < 1024) (cap : b ≤ 1023) :
    (a + (1023 - b)).testBit 10 = false ↔ a ≤ b := by
  rw [Nat.testBit_eq_decide_div_mod_eq]
  change decide ((a + (1023 - b)) / 1024 % 2 = 1) = false ↔ a ≤ b
  by_cases le : a ≤ b
  · have small : a + (1023 - b) < 1024 := by omega
    simp [Nat.div_eq_of_lt small, le]
  · have low : 1 ≤ (a + (1023 - b)) / 1024 :=
      (Nat.le_div_iff_mul_le (by decide)).mpr (by omega)
    have high : (a + (1023 - b)) / 1024 < 2 :=
      (Nat.div_lt_iff_lt_mul (by decide)).mpr (by omega)
    have quotient : (a + (1023 - b)) / 1024 = 1 := by omega
    simp [quotient, le]

-- The highest bit in each lane marks a violation of that lane's cap.
theorem batchGuard {ι : Type*} (rows : Finset ι) (lanes : ℕ) (w : ι → ℕ → ℕ) (cap : ℕ → ℕ)
    (load : ∀ j < lanes, (∑ r ∈ rows, w r j) < 1024)
    (maxCap : ∀ j < lanes, cap j ≤ 1023) (t : ℕ) (inRange : t < lanes) :
    ((∑ r ∈ rows, pack 2048 lanes (w r)) + pack 2048 lanes (fun j => 1023 - cap j)).testBit
      (11 * t + 10) = false ↔ ∑ r ∈ rows, w r t ≤ cap t := by
  have bounded (j : ℕ) (hj : j < lanes) :
      (∑ r ∈ rows, w r j) + (1023 - cap j) < 2048 := by
    have h := load j hj
    omega
  rw [sum_pack, ← pack_add, high_bit_digit,
    digit_pack 2048 lanes (by decide) _ bounded t inRange]
  exact high_bit_bias _ _ (load t inRange) (maxCap t inRange)

theorem batchGuardOfMask {ι : Type*} (rows : Finset ι) (lanes : ℕ) (w : ι → ℕ → ℕ) (cap : ℕ → ℕ)
    (load : ∀ j < lanes, (∑ r ∈ rows, w r j) < 1024)
    (maxCap : ∀ j < lanes, cap j ≤ 1023)
    (clear : ((∑ r ∈ rows, pack 2048 lanes (w r)) + pack 2048 lanes (fun j => 1023 - cap j))
      &&& pack 2048 lanes (fun _ => 1024) = 0) :
    ∀ t < lanes, (∑ r ∈ rows, w r t) ≤ cap t := by
  intro t inRange
  have high : (pack 2048 lanes (fun _ => 1024)).testBit (11 * t + 10) = true := by
    rw [high_bit_digit, digit_pack 2048 lanes (by decide) _ (fun _ _ => by decide) t inRange]
    decide
  have bit := congrArg (fun x : ℕ => x.testBit (11 * t + 10)) clear
  apply (batchGuard rows lanes w cap load maxCap t inRange).mp
  simpa only [Nat.testBit_and, high, Bool.and_true, Nat.zero_testBit] using bit

end ParallelWeight

namespace ParallelRectangles

open Finset

def closeCols (A : Finset V) : Finset V :=
  univ.filter (fun j => ∀ i ∈ A, bit i j = false)

def closeRows (B : Finset V) : Finset V :=
  univ.filter (fun i => ∀ j ∈ B, bit i j = false)

abbrev BoxLe (a b : Box) := a.1 ⊆ b.1 ∧ a.2 ⊆ b.2

abbrev Nonextendable (b : Box) := ∀ h : HI, ¬ BoxLe b (hbox h)

theorem mem_closeCols {A : Finset V} {j : V} :
    j ∈ closeCols A ↔ ∀ i ∈ A, bit i j = false := by
  simp [closeCols]

theorem mem_closeRows {B : Finset V} {i : V} :
    i ∈ closeRows B ↔ ∀ j ∈ B, bit i j = false := by
  simp [closeRows]

theorem closeColsLegal (A : Finset V) : legal (A, closeCols A) :=
  fun i hi _j hj => mem_closeCols.mp hj i hi

theorem closeRowsLegal (B : Finset V) : legal (closeRows B, B) :=
  fun _i hi j hj => mem_closeRows.mp hi j hj

theorem leCloseCols (b : Box) (valid : legal b) : BoxLe b (b.1, closeCols b.1) :=
  ⟨fun _ h => h, fun j hj => mem_closeCols.mpr fun i hi => valid i hi j hj⟩

theorem leCloseRows (b : Box) (valid : legal b) : BoxLe b (closeRows b.2, b.2) :=
  ⟨fun i hi => mem_closeRows.mpr fun j hj => valid i hi j hj, fun _ h => h⟩

private theorem outsideAbove {a b : Box} (le : BoxLe a b) (outside : Nonextendable a) :
    Nonextendable b :=
  fun h ext => outside h ⟨le.1.trans ext.1, le.2.trans ext.2⟩

private theorem smallArea {b : Box} (valid : legal b) (outside : Nonextendable b) :
    area b ≤ 28 := by
  by_contra! tooBig
  obtain ⟨h, contain⟩ := bigExt b.1 b.2 valid tooBig
  exact outside h contain

-- A legal box outside all hyperovals is contained in one of the checked closures.
theorem coverRestricted (P : Box → Prop) (down : ∀ ⦃a b : Box⦄, BoxLe a b → P b → P a)
    (empty : ∀ b : Box, b.1 = ∅ ∨ b.2 = ∅ → P b)
    (left : ∀ A : Finset V, A.Nonempty → (closeCols A).Nonempty →
      (A.card ≤ 4 ∨ (A.card = 5 ∧ 5 ≤ (closeCols A).card)) →
      area (A, closeCols A) ≤ 28 → Nonextendable (A, closeCols A) → P (A, closeCols A))
    (right : ∀ B : Finset V, (closeRows B).Nonempty → B.Nonempty →
      B.card ≤ 4 → area (closeRows B, B) ≤ 28 → Nonextendable (closeRows B, B) →
      P (closeRows B, B))
    (b : Box) (valid : legal b) (outside : Nonextendable b) : P b := by
  rcases b.1.eq_empty_or_nonempty with h | aNonempty
  · exact empty b (Or.inl h)
  rcases b.2.eq_empty_or_nonempty with h | bNonempty
  · exact empty b (Or.inr h)
  have inclL := leCloseCols b valid
  have useLeft (shape : b.1.card ≤ 4 ∨ (b.1.card = 5 ∧ 5 ≤ (closeCols b.1).card)) : P b := by
    have nonempty : (closeCols b.1).Nonempty := by
      obtain ⟨j, hj⟩ := bNonempty
      exact ⟨j, inclL.2 hj⟩
    have above := outsideAbove inclL outside
    exact down inclL (left b.1 aNonempty nonempty shape (smallArea (closeColsLegal b.1) above) above)
  by_cases aSmall : b.1.card ≤ 4
  · exact useLeft (Or.inl aSmall)
  by_cases bSmall : b.2.card ≤ 4
  · have inclR := leCloseRows b valid
    have nonempty : (closeRows b.2).Nonempty := by
      obtain ⟨i, hi⟩ := aNonempty
      exact ⟨i, inclR.1 hi⟩
    have above := outsideAbove inclR outside
    exact down inclR
      (right b.2 nonempty bNonempty bSmall (smallArea (closeRowsLegal b.2) above) above)
  have fiveB : 5 ≤ b.2.card := by omega
  have fiveA : b.1.card = 5 := by
    have h : b.1.card * b.2.card ≤ 28 := smallArea valid outside
    by_contra! notFive
    have sixA : 6 ≤ b.1.card := by omega
    have large := Nat.mul_le_mul sixA fiveB
