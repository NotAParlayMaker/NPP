private theorem foldl_add {α : Type*} (xs : List α) (f : α → Nat) (acc : Nat) :
    xs.foldl (fun total v => total + f v) acc = acc + (xs.map f).sum := by
  induction xs generalizing acc with
  | nil => simp
  | cons x xs ih => simp [ih, Nat.add_assoc]

private theorem foldVertices (xs : List Nat) (A : Finset V) (nd : xs.Nodup)
    (asSet : xs.toFinset = A.image Fin.val) (f : Nat → Nat) :
    xs.foldl (fun total x => total + f x) 0 = ∑ x ∈ A, f x.val := by
  rw [foldl_add, Nat.zero_add, ← List.sum_toFinset f nd, asSet]
  exact Finset.sum_image Fin.val_injective.injOn

private theorem packedLoad_sum (weights : Array (Array Nat)) (rows columns : List Nat)
    (A B : Finset V) (rowND : rows.Nodup) (colND : columns.Nodup)
    (rowSet : rows.toFinset = A.image Fin.val) (colSet : columns.toFinset = B.image Fin.val)
    (F : V → V → Nat) (lookup : ∀ i j : V, (weights[i.val]!)[j.val]! = F i j) :
    packedLoad weights rows columns = ∑ i ∈ A, ∑ j ∈ B, F i j := by
  unfold packedLoad
  rw [foldVertices rows A rowND rowSet]
  apply Finset.sum_congr rfl
  intro i _
  unfold packedRowLoad
  rw [foldVertices columns B colND colSet]
  exact Finset.sum_congr rfl (fun j _ => lookup i j)

private theorem positions_sum (A B : Finset V) (W : Nat → Nat) :
    ∑ p ∈ positions A B, W p = ∑ i ∈ A, ∑ j ∈ B, W (ix i j) := by
  unfold positions
  rw [Finset.sum_image ixInj.injOn, Finset.sum_product]

theorem packedLoad_eq (weights : Array (Array Nat)) (rows columns : List Nat)
    (A B : Finset V) (rowND : rows.Nodup) (colND : columns.Nodup)
    (rowSet : rows.toFinset = A.image Fin.val) (colSet : columns.toFinset = B.image Fin.val)
    (W : Nat → Nat) (lookup : ∀ i j : V, (weights[i.val]!)[j.val]! = W (ix i j)) :
    packedLoad weights rows columns = ∑ p ∈ positions A B, W p := by
  rw [positions_sum]
  exact packedLoad_sum weights rows columns A B rowND colND rowSet colSet
    (fun i j => W (ix i j)) lookup

theorem packedLoad_eq_transpose (weights : Array (Array Nat)) (rows columns : List Nat)
    (A B : Finset V) (rowND : rows.Nodup) (colND : columns.Nodup)
    (rowSet : rows.toFinset = B.image Fin.val) (colSet : columns.toFinset = A.image Fin.val)
    (W : Nat → Nat) (lookup : ∀ i j : V, (weights[j.val]!)[i.val]! = W (ix i j)) :
    packedLoad weights rows columns = ∑ p ∈ positions A B, W p := by
  rw [positions_sum, Finset.sum_comm]
  exact packedLoad_sum weights rows columns B A rowND colND rowSet colSet
    (fun j i => W (ix i j)) (fun j i => lookup i j)

end ParallelLoad
