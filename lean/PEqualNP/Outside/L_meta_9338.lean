def fourIdx (k : Fin 235) : CI := ⟨k.val, by have := k.isLt; omega⟩
def twoIdx (k : Fin 4) : CI := ⟨236 + k.val, by have := k.isLt; omega⟩
def threeIdx (k : Fin 28) : CI := ⟨240 + k.val, by have := k.isLt; omega⟩

set_option maxHeartbeats 0 in
set_option maxRecDepth 16000 in
theorem tagCardTest : ∀ k : CI, (picked k).toFinset.card = (picked k).length := by decide +kernel

theorem pickedCard (k : CI) : (pickedBoxes k).card = (picked k).length := by
  rw [pickedBoxes,Finset.card_image_of_injective _ hboxInjective]
  exact tagCardTest k

theorem labelsPicked (k : CI) : ∀ z ∈ pickedBoxes k, ∃ h : HI, z = hbox h := by
  intro z hz
  obtain ⟨h,_,rfl⟩ := Finset.mem_image.mp hz
  exact ⟨h,rfl⟩

theorem allHighBits : ∀ k : CI, packetHigh.testBit (11*k.val+10) = true := by decide +kernel

theorem checkedLane (checked : ∀ k : CI, cellFacts k) (k : CI) (b : Box) (mask : Nat)
    (high : mask.testBit (11*k.val+10) = true)
    (clear : ((∑ p ∈ positions b.1 b.2, ParallelWeight.pack 2048 268 (laneWeight p)) + packetBias) &&& mask = 0) :
    ∑ p ∈ positions b.1 b.2, laneWeight p k ≤ limitOf k := by
  have bit := PacketGeometry.maskedLane k.val clear high
  rw [metaConstants.1] at bit
  exact (ParallelWeight.batchGuard (positions b.1 b.2) 268 laneWeight laneCap (certLoad b checked)
    (fun t ht => metaConstants.2.2.1 ⟨t,ht⟩) k.val k.isLt).mp bit

set_option maxRecDepth 12000 in
set_option maxHeartbeats 1000000 in
theorem packetSmallBound (checked : ∀ k : CI, cellFacts k) (k : CI) (b : Box)
    (valid : legal b) (outside : ParallelRectangles.Nonextendable b) :
    ∑ p ∈ positions b.1 b.2, laneWeight p k ≤ limitOf k := by
  apply ParallelRectangles.coverRestricted (fun b => ∑ p ∈ positions b.1 b.2, laneWeight p k ≤ limitOf k) _ _ _ _ b valid outside
  · exact fun {_ _} le h => (ParallelRectangles.rectangleWeightMono _ le).trans h
  · intro emptyBox either
    rw [ParallelRectangles.rectangleWeightEmpty _ _ either]
    exact Nat.zero_le _
  · intro A an cn shape area _
    apply checkedLane checked k _ packetHigh (allHighBits k)
    exact rowClosurePacket (fun p => ParallelWeight.pack 2048 268 (laneWeight p)) cellIdentity rowParts A an cn shape area
  · intro B bn rn shape area _
    apply checkedLane checked k _ packetHigh (allHighBits k)
    exact colClosurePacket (fun p => ParallelWeight.pack 2048 268 (laneWeight p)) cellIdentity colParts B bn rn shape area

set_option maxRecDepth 12000 in
set_option maxHeartbeats 1000000 in
theorem packetFreeBound (checked : ∀ k : CI, cellFacts k) (k : CI) (free : k.val < 235)
    (b : Box) (valid : legal b) : ∑ p ∈ positions b.1 b.2, laneWeight p k ≤ limitOf k := by
  apply ParallelRectangles.coverAll (fun b => ∑ p ∈ positions b.1 b.2, laneWeight p k ≤ limitOf k)
    (fun {_ _} le h => (ParallelRectangles.rectangleWeightMono _ le).trans h) _ (packetSmallBound checked k) b valid
  intro h
  apply checkedLane checked k _ packetFreeHigh (metaConstants.2.2.2 ⟨k.val,free⟩)
  exact hyperClosurePacket (fun p => ParallelWeight.pack 2048 268 (laneWeight p)) cellIdentity hyperPackets h

theorem weightedImpossible (k : CI) (U : Finset Box) (ad : admissibleTwelve U)
    (sub : pickedBoxes k ⊆ U)
    (exclude : 235 ≤ k.val → ¬ hasLabelCover ((picked k).length + 1))
    (v : cellFacts k) : False := by
  have vanishes (h : HI) (selected : h ∈ picked k) (b : Box) (incl : ParallelRectangles.BoxLe b (hbox h)) :
      ∀ p ∈ positions b.1 b.2, laneWeight p k = 0 := by
    intro p hp
    obtain ⟨⟨i,j⟩, member, rfl⟩ := Finset.mem_image.mp hp
    obtain ⟨ia,jb⟩ := Finset.mem_product.mp member
    exact zeroAt k v h selected i j (incl.1 ia) (incl.2 jb)
  apply Weighted.obstructCover U (pickedBoxes k) (fun p => laneWeight p k) (picked k).length
    (limitOf k) ad sub (pickedCard k) _ _ v.2.1
  · intro b hb
    obtain ⟨h,hh,rfl⟩ := Finset.mem_image.mp hb
    exact vanishes h (List.mem_toFinset.mp hh) _ ⟨fun _ hi => hi,fun _ hj => hj⟩
  · intro b hb
    have hu := (Finset.mem_sdiff.mp hb).1
    by_cases free : k.val < 235
    · exact packetFreeBound checkedCert k free b (ad.2.1 b hu)
    by_cases within : ∃ h : HI, ParallelRectangles.BoxLe b (hbox h)
    · obtain ⟨h,sides⟩ := within
      have placed := remainingContainedInLabels (exclude (by omega)) ad.1 ad.2.1 ad.2.2
        sub (pickedCard k) (labelsPicked k) hu (Finset.mem_sdiff.mp hb).2 sides.1 sides.2
      obtain ⟨i,hi,eq⟩ := Finset.mem_image.mp placed
      have selected : h ∈ picked k := List.mem_toFinset.mp (hboxInjective eq ▸ hi)
      rw [Finset.sum_eq_zero (vanishes h selected b sides)]
      exact Nat.zero_le _
    · exact packetSmallBound checkedCert k b (ad.2.1 b hu) (fun h contained => within ⟨h,contained⟩)
theorem oneTable : (picked (235 : CI)) = [0] := by decide +kernel

set_option maxRecDepth 16000 in
theorem twoTable : ∀ k : Fin 4, picked (twoIdx k) = [0,anchor k] := by decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 16000 in
theorem threeTable : ∀ k : Fin 28, (picked (threeIdx k)).length = 3 ∧
    (picked (threeIdx k)).toFinset = repLabels k := by decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 16000 in
theorem fourTable : ∀ k : Fin 235, (picked (fourIdx k)).toFinset = quadLabels k := by decide +kernel

theorem oneImpossible (U : Finset Box) (ad : admissibleTwelve U)
    (sub : ({hbox 0} : Finset Box) ⊆ U) (exclude : ¬ hasLabelCover 2) : False := by
  apply weightedImpossible 235 U ad _ _ (checkedCert 235)
  · simpa [pickedBoxes,oneTable] using sub
  · simpa [oneTable] using fun (_ : 235 ≤ (235 : CI).val) => exclude

theorem twoImpossible (k : Fin 4) (U : Finset Box) (ad : admissibleTwelve U)
    (sub : ({hbox 0,hbox (anchor k)} : Finset Box) ⊆ U) (exclude : ¬ hasLabelCover 3) : False := by
  apply weightedImpossible (twoIdx k) U ad _ _ (checkedCert _)
  · simpa [pickedBoxes,twoTable] using sub
  · intro _
    simpa [twoTable] using exclude

theorem threeImpossible (k : Fin 28) (U : Finset Box) (ad : admissibleTwelve U)
    (sub : repSet k ⊆ U) (exclude : ¬ hasLabelCover 4) : False := by
  have identify : (repLabels k).image hbox = repSet k := by
    unfold repLabels repSet
    rcases rep[k.val]! with ⟨a,b,c⟩
    simp
  apply weightedImpossible (threeIdx k) U ad _ _ (checkedCert _)
  · simpa [pickedBoxes,(threeTable k).2,identify] using sub
  · intro _
    simpa [(threeTable k).1] using exclude

theorem fourImpossible (k : Fin 235) (U : Finset Box) (ad : admissibleTwelve U)
    (sub : quadRepSet k ⊆ U) : False := by
  apply weightedImpossible (fourIdx k) U ad _ _ (checkedCert _)
  · simpa [pickedBoxes,fourTable,quadRepSet] using sub
  · intro impossible
    have val := k.isLt
    change 235 ≤ k.val at impossible
    omega


-- Select a cover with the largest available label count below four, or any four labels.
theorem noTwelveFromCertificates
    (one : ∀ U, admissibleTwelve U → ({hbox 0} : Finset Box) ⊆ U → ¬ hasLabelCover 2 → False)
    (two : ∀ (k : Fin 4) U, admissibleTwelve U →
      ({hbox 0, hbox (anchor k)} : Finset Box) ⊆ U → ¬ hasLabelCover 3 → False)
    (three : ∀ (k : Fin 28) U, admissibleTwelve U → repSet k ⊆ U → ¬ hasLabelCover 4 → False)
    (four : ∀ (k : Fin 235) U, admissibleTwelve U → quadRepSet k ⊆ U → False)
    (T : Finset Box) (admissible : admissibleTwelve T) : False := by
  classical
  have tracked {c : ℕ} (existsCover : hasLabelCover c) :
      ∃ U, admissibleTwelve U ∧ ∃ F : Finset HI, F.card = c ∧ F.image hbox ⊆ U := by
    obtain ⟨U, small, ok, cover, Z, sub, card, labels⟩ := existsCover
    obtain ⟨F, indexedCard, indexedLabels⟩ := labelIndices labels
    exact ⟨U, ⟨small, ok, cover⟩, F, indexedCard.trans card, indexedLabels.symm ▸ sub⟩
  by_cases hasFour : hasLabelCover 4
  · obtain ⟨U, adm, F, card, marked⟩ := tracked hasFour
    obtain ⟨k, W, wAdm, wMarked⟩ := normalizeFour U adm F card marked
    exact four k W wAdm wMarked
  by_cases hasThree : hasLabelCover 3
  · obtain ⟨U, adm, F, card, marked⟩ := tracked hasThree
    obtain ⟨a, b, c, ab, ac, bc, rfl⟩ := Finset.card_eq_three.mp card
    obtain ⟨k, W, wAdm, wMarked⟩ := normalizeThreeSub U adm a b c ab ac bc marked
    exact three k W wAdm wMarked hasFour
  by_cases hasTwo : hasLabelCover 2
  · obtain ⟨U, adm, F, card, marked⟩ := tracked hasTwo
    obtain ⟨a, b, ab, rfl⟩ := Finset.card_eq_two.mp card
    have markedBoxes : ({hbox a, hbox b} : Finset Box) ⊆ U := by
      simpa only [Finset.image_insert, Finset.image_singleton] using marked
    obtain ⟨k, W, wAdm, wMarked⟩ := normalizeTwoSub U adm a b ab markedBoxes
    exact two k W wAdm wMarked hasThree
  by_cases hasOne : hasLabelCover 1
  · obtain ⟨U, adm, F, card, marked⟩ := tracked hasOne
    obtain ⟨a, rfl⟩ := Finset.card_eq_one.mp card
    have markedBoxes : ({hbox a} : Finset Box) ⊆ U := by
      simpa only [Finset.image_singleton] using marked
    obtain ⟨W, wAdm, wMarked⟩ := normalizeOneSub U adm a markedBoxes
    exact one W wAdm wMarked hasTwo
  exact noCoverWithoutLabels hasOne admissible.1 admissible.2.1 admissible.2.2


