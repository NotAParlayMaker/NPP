    (spec : ∀ i : V, i.val ∈ members mask ↔ i ∈ S) :
    (members mask).length = S.card := by
  rw [← List.toFinset_card_of_nodup (members_nodup mask),
    members_toFinset mask S spec, Finset.card_image_of_injective _ Fin.val_injective]

