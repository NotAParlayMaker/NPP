theorem genActs (g : G) (i : HI) : moved (gen g) (hbox i) = hbox (act g i) := by
  fin_cases g
  · exact genActs0 i
  · exact genActs1 i
  · exact genActs2 i
  · exact genActs3 i
  · exact genActs4 i
  · exact genActs5 i
  · exact genActs6 i
  · exact genActs7 i
  · exact genActs8 i

def repLabels (k : Fin 28) : Finset HI :=
  let (a,b,c) := rep[k.val]!
  {a,b,c}

