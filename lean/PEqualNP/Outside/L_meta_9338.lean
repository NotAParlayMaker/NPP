  induction n generalizing x with
  | zero =>
    have hx : x = 0 := by simpa using top
    simp [ParallelWeight.pack, hx]
  | succ n ih =>
    have next : x / base < base^n := (Nat.div_lt_iff_lt_mul pos).mpr (by simpa [Nat.pow_succ] using top)
    have shifted (j : Nat) : ParallelWeight.digit base (j+1) x =
        ParallelWeight.digit base j (x/base) := by
      simp only [ParallelWeight.digit, Nat.pow_succ', Nat.div_div_eq_div_mul]
    rw [packFirst]
    simp_rw [shifted]
    rw [ih (x/base) next]
    simpa [ParallelWeight.digit, Nat.mul_comm] using Nat.mod_add_div x base

theorem maskedLane {word high : Nat} (k : Nat) (clear : word &&& high = 0)
    (visible : high.testBit (11*k+10) = true) : word.testBit (11*k+10) = false := by
  have eq := congrArg (fun x : Nat => x.testBit (11*k+10)) clear
  simpa only [Nat.testBit_and, visible, Bool.and_true, Nat.zero_testBit] using eq

end PacketGeometry

