theorem metaConstants : packetBias = ParallelWeight.pack 2048 268 (fun j => 1023-laneCap j) ∧
    packetHigh = ParallelWeight.pack 2048 268 (fun _ => 1024) ∧
    (∀ k : CI, laneCap k ≤ 1023) ∧
    (∀ k : Fin 235, packetFreeHigh.testBit (11*k.val+10) = true) := by decide +kernel

def cellFacts (k : CI) : Prop :=
  (∑ p ∈ Finset.range 441, laneWeight p k) < 1024 ∧
  (12 - (picked k).length) * limitOf k < ∑ p ∈ zeros, laneWeight p k ∧
  (picked k).all (fun h => (List.range 441).all fun p =>
    !((hs[h.val]!).1.testBit (p/21) && (hs[h.val]!).2.testBit (p%21)) || laneWeight p k == 0) = true

instance (k : CI) : Decidable (cellFacts k) := by unfold cellFacts; infer_instance

theorem zeroAt (k : CI) (f : cellFacts k) (h : HI) (inside : h ∈ picked k)
    (i j : V) (left : i ∈ (hbox h).1) (right : j ∈ (hbox h).2) : laneWeight (ix i j) k = 0 := by
  have pv : ix i j < 441 := by unfold ix; have := i.isLt; have := j.isLt; omega
  have step := List.all_eq_true.mp (List.all_eq_true.mp f.2.2 h inside) (ix i j) (List.mem_range.mpr pv)
  have hi : (hs[h.val]!).1.testBit i.val = true := (Finset.mem_filter.mp left).2
  have hj : (hs[h.val]!).2.testBit j.val = true := (Finset.mem_filter.mp right).2
  have bound := j.isLt
  have quotient : ix i j / 21 = i.val := by unfold ix; omega
  have remainder : ix i j % 21 = j.val := by unfold ix; omega
  simpa [quotient, remainder, hi, hj] using step

theorem certPositionBound (b : Box) : positions b.1 b.2 ⊆ Finset.range 441 := by
  intro z hz
  obtain ⟨⟨i,j⟩, _, rfl⟩ := Finset.mem_image.mp hz
  apply Finset.mem_range.mpr
  unfold ix
  have := i.isLt
  have := j.isLt
  omega

theorem certLoad (b : Box) (checked : ∀ k : CI, cellFacts k) :
    ∀ t < 268, (∑ p ∈ positions b.1 b.2, laneWeight p t) < 1024 := by
  intro t ht
  exact lt_of_le_of_lt (Finset.sum_le_sum_of_subset_of_nonneg (certPositionBound b)
    (fun _ _ _ => Nat.zero_le _)) (checked ⟨t,ht⟩).1
