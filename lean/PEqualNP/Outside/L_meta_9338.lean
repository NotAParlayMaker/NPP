    {rows rows' columns columns' : List Nat}
    (rowPerm : List.Perm rows rows') (colPerm : List.Perm columns columns') :
    packetOK weights bias high rows columns = packetOK weights bias high rows' columns' := by
  unfold packetOK
  rw [packedLoad_perm weights rowPerm colPerm]

