theorem L2 : ∀ u v : Fin 26, adjF u v = true → ∃ x2 x3 : Fin 13, (x2 = x3 ∨ x2 = x3 + (1 : Fin (13 : ℕ)) ∨ x2 = x3 + (3 : Fin (13 : ℕ)) ∨ x2 = x3 + (9 : Fin (13 : ℕ))) ∧ Fin.castAdd 13 x2 = u ∧ Fin.natAdd 13 x3 = v := by
  decide +kernel

theorem link (f : Fin 26 → Bool) : Pr f ↔ ∃ u v : Fin 26, adjF u v = true ∧ f u = true ∧ f v = true := by
  constructor
  · rintro ⟨x2, x3, hd, h1, h2⟩
    exact ⟨_, _, L1 x2 x3 hd, h1, h2⟩
  · rintro ⟨u, v, ha, h1, h2⟩
    obtain ⟨x2, x3, hd, rfl, rfl⟩ := L2 u v ha
    exact ⟨x2, x3, hd, h1, h2⟩

theorem half1 (s t : Fin 26 → Fin 26) (hst : ∀ v, s (t v) = v)
    (ht : ∀ u v, adjF u v = true → (adjF (t u) (t v) || adjF (t v) (t u)) = true)
    (f : Fin 26 → Bool) : Pr f → Pr (fun v => f (s v)) := by
  rw [link, link]
  rintro ⟨u, v, ha, h1, h2⟩
  have h := ht u v ha
  rw [Bool.or_eq_true] at h
  rcases h with h | h
  · refine ⟨t u, t v, h, ?_, ?_⟩
    · show f (s (t u)) = true
      rw [hst]; exact h1
    · show f (s (t v)) = true
      rw [hst]; exact h2
  · refine ⟨t v, t u, h, ?_, ?_⟩
    · show f (s (t v)) = true
      rw [hst]; exact h2
    · show f (s (t u)) = true
      rw [hst]; exact h1

theorem half2 (s : Fin 26 → Fin 26)
    (hs : ∀ u v, adjF u v = true → (adjF (s u) (s v) || adjF (s v) (s u)) = true)
    (f : Fin 26 → Bool) : Pr (fun v => f (s v)) → Pr f := by
  rw [link, link]
  rintro ⟨u, v, ha, h1, h2⟩
  have h := hs u v ha
  rw [Bool.or_eq_true] at h
  rcases h with h | h
  · exact ⟨s u, s v, h, h1, h2⟩
  · exact ⟨s v, s u, h, h2, h1⟩

theorem inv (s t : Fin 26 → Fin 26) (h : good s t) (f : Fin 26 → Bool) :
    Pr f ↔ Pr (fun v => f (s v)) :=
  ⟨half1 s t h.1 h.2.2.2 f, half2 s h.2.2.1 f⟩

