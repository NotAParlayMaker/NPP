def adjN (u v : ℕ) : Bool :=
  decide (u < 13) && decide (13 ≤ v) &&
    ((u + 26 - v) % 13 == 0 || (u + 26 - v) % 13 == 1 || (u + 26 - v) % 13 == 3 || (u + 26 - v) % 13 == 9)

def adjF (u v : Fin 26) : Bool := adjN u.val v.val

def Pr (x1 : Fin (26 : ℕ) → Bool) : Prop :=
  ∃ (x2 : Fin (13 : ℕ)) (x3 : Fin (13 : ℕ)), (x2 = x3 ∨ x2 = x3 + (1 : Fin (13 : ℕ)) ∨ x2 = x3 + (3 : Fin (13 : ℕ)) ∨ x2 = x3 + (9 : Fin (13 : ℕ))) ∧ x1 (Fin.castAdd (13 : ℕ) x2) = Bool.true ∧ x1 (Fin.natAdd (13 : ℕ) x3) = Bool.true

def mk (t : List (List ℕ)) (a v : Fin 26) : Fin 26 :=
  ⟨((t.getD a.val []).getD v.val 0) % 26, Nat.mod_lt _ (by decide)⟩

abbrev good (s t : Fin 26 → Fin 26) : Prop :=
  (∀ v, s (t v) = v) ∧ (∀ v, t (s v) = v) ∧
  (∀ u v, adjF u v = true → (adjF (s u) (s v) || adjF (s v) (s u)) = true) ∧
  (∀ u v, adjF u v = true → (adjF (t u) (t v) || adjF (t v) (t u)) = true)

theorem L1 : ∀ x2 x3 : Fin 13, (x2 = x3 ∨ x2 = x3 + (1 : Fin (13 : ℕ)) ∨ x2 = x3 + (3 : Fin (13 : ℕ)) ∨ x2 = x3 + (9 : Fin (13 : ℕ))) → adjF (Fin.castAdd 13 x2) (Fin.natAdd 13 x3) = true := by
  decide +kernel

