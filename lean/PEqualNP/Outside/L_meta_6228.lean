    intro h
    apply hne
    have h2 : mk tG a a = mk tG a b := by rw [h]; exact (hG a).2
    have h3 := congrArg (mk tGi a) h2
    rwa [(hG a).1.2.1, (hG a).1.2.1] at h3
  refine ⟨(eG a).trans (eH (mk tG a b)), ?_, ?_, ?_⟩
  · show mk tH (mk tG a b) (mk tG a a) = 0
    rw [(hG a).2]; exact (hH _).2.1
  · exact (hH _).2.2 hc
  · intro f
    exact (inv _ _ (hH (mk tG a b)).1 f).trans
