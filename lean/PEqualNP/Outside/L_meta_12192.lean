theorem countBinary (C : Circuit) (good : FanInTwo C)
    (he : ∀ x, C.eval (List.ofFn x) = target x) : 10 ≤ full_binaryCost C.gates := by
  have computed (k : Fin 64) :
      (C.gates.foldl full_step (raw.map (full_bit64 k))).getD C.output false = full_bit64 k goal6 := by
    let x (i : Fin 6) : Bool := full_bit64 k (raw.getD i.val 0)
    have width : raw.length = 6 := rfl
    have same : List.ofFn x = raw.map (full_bit64 k) := by
      apply List.ext_getElem
      · simp [width]
      · intro i hi hj
        have hlt : i < raw.length := by simpa using hj
        simp only [List.getElem_ofFn, List.getElem_map, x, List.getD_eq_getElem?_getD,
          List.getElem?_eq_getElem hlt, Option.getD_some]
    change C.eval (raw.map (full_bit64 k)) = _
    rw [← same, he]
    exact samples k
  have available : ∀ u ∈ raw, holds raw.toFinset u := by
    have hyp : raw.all (fun u => raw.contains u) = true := by decide +kernel
    intro u hu
    exact .inr (.inr ⟨u,List.mem_toFinset.mpr (List.contains_iff_mem.mp (List.all_eq_true.mp hyp u hu)),.inl rfl⟩)
  have legal (g) (hg : g ∈ C.gates) : full_legal g := by
    obtain ⟨op,arity⟩ := good g hg
    exact ⟨by simpa only [Set.mem_insert_iff,Set.mem_singleton_iff] using op, arity⟩
  obtain ⟨t,ht,hb⟩ := full_compile goal6 (by decide +kernel) (by decide +kernel)
    C.gates C.output legal raw raw.toFinset available computed
  exact compared t ht hb

theorem withNot (C : Circuit) (good : FanInTwo C)
    (he : ∀ x, C.eval (List.ofFn x) = target x)
    (hasNot : ∃ g ∈ C.gates, g.op = GateOp.not) : 11 ≤ C.size := by
  obtain ⟨g,hg,hn⟩ := hasNot
  have h : full_binaryCost C.gates < C.gates.length :=
    (List.length_filter_lt_length_iff_exists (p := full_isBinary)).mpr
      ⟨g,hg,by simp [full_isBinary,hn]⟩
  have hb := countBinary C good he
  change 11 ≤ C.gates.length
  omega

theorem positive : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (3900735488 * 2 ^ 32 + 3892314112) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (3900735488 * 2 ^ 32 + 3892314112) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) := by
  intro s hs
  obtain ⟨C,hc,sz,he⟩ := hs
  by_cases neg : ∃ g ∈ C.gates, g.op = GateOp.not
  · have lb := withNot C hc he neg
    exact ⟨witness, upper.1, upper.2.1.le.trans (lb.trans sz), upper.2.2⟩
  · refine ⟨C, ?_, sz, he⟩
    intro g hg
    obtain ⟨op,arity⟩ := hc g hg
    refine ⟨?_, arity⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at op ⊢
    exact op.elim Or.inl (fun h => Or.inr (h.resolve_right (fun eq => neg ⟨g,hg,eq⟩)))
end PEqualNP.Outside.L_meta_12192_aux

theorem PEqualNP.Outside.L_meta_12192 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (3900735488 * 2 ^ 32 + 3892314112) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (3900735488 * 2 ^ 32 + 3892314112) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) :=
  PEqualNP.Outside.L_meta_12192_aux.positive
