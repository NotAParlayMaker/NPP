    (selectRows_lor rows) (selectRows_neg rows)) run hp (.inr fixed) nc
    (fun w hw => supply w (List.mem_toFinset.mp (sub hw)))
  obtain ⟨tt,ht,bt⟩ := unwrap_sb nc.1 nc.2 (sb_le (show k-1 ≤ 8 by omega) b)
