theorem full_compile (target : full_W64) (hnt0 : target ≠ 0) (hnt1 : target ≠ ~~~0)
    (gs : List Gate) (out : ℕ) (hg : ∀ g ∈ gs, full_legal g)
    (w : List full_W64) (av : Finset full_W64) (hw : ∀ u ∈ w, holds av u)
    (he : ∀ k, (gs.foldl full_step (w.map (full_bit64 k))).getD out false = full_bit64 k target) :
    ∃ t, (t = target ∨ t = ~~~target) ∧ build basicOps t (full_binaryCost gs) av := by
  induction gs generalizing w av with
  | nil =>
    have hv : w.getD out 0 = target := by
      apply BitVec.eq_of_getElem_eq
      intro i hi
      simpa only [List.foldl_nil, full_read_bit64, full_bit64] using he ⟨i, hi⟩
    have h := hv ▸ full_available_read hw out
    rcases h with zero | ones | ⟨t, ht, eq | eq⟩
    · exact False.elim (hnt0 zero)
    · exact False.elim (hnt1 ones)
    · exact ⟨t, .inl eq.symm, ht⟩
    · exact ⟨t, .inr (by simpa only [BitVec.not_not] using congrArg (fun u : full_W64 => ~~~u) eq.symm), ht⟩
  | cons g gs ih =>
    let z := full_action w g
    have stepOK := full_action_spec w g (hg g (by simp))
    have nextEval : ∀ k, (gs.foldl full_step ((w ++ [z]).map (full_bit64 k))).getD out false = full_bit64 k target := by
      intro k; simpa only [List.foldl_cons, stepOK] using he k
    have tail := ih (fun t ht => hg t (by simp [ht])) (w ++ [z])
    have cont (A : Finset full_W64) (hold : ∀ u ∈ w, holds A u) (new : holds A z) :=
      tail A (by
        intro u hu
        rcases List.mem_append.mp hu with hu | hu
        · exact hold u hu
        · exact (List.mem_singleton.mp hu) ▸ new) nextEval
    have stepClass := full_gate_reach w av hw g (hg g (by simp))
    cases neg : full_isBinary g
    · simp only [neg, Bool.false_eq_true, ite_false] at stepClass
      simpa [full_binaryCost, neg] using cont av hw stepClass
    · simp only [neg, ite_true] at stepClass
      have len : full_binaryCost (g :: gs) = full_binaryCost gs + 1 := by simp [full_binaryCost, neg]
      rw [len]
      rcases stepClass with existing | ⟨a, ha, b, hb, ne, new, op, rep⟩
      · obtain ⟨t, ht, run⟩ := cont av hw existing
        exact ⟨t, ht, Or.inl run⟩
      · obtain ⟨t, ht, run⟩ := cont (insert new av) (fun u hu => holds_insert (hw u hu)) rep
        exact ⟨t, ht, Or.inr ⟨a, ha, b, hb, ne, new, op, run⟩⟩

