theorem full_action_spec (w : List full_W64) (g : Gate) (hg : full_legal g) (k : Fin 64) :
    full_step (w.map (full_bit64 k)) g = (w ++ [full_action w g]).map (full_bit64 k) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩ <;> simp at cap
  all_goals have bit0 : (0 : full_W64)[k.val] = false := by change (0#64)[k.val] = false; simp
  all_goals rcases hop with rfl | rfl | rfl <;>
    simp only [full_step, List.map_cons, List.map_nil, full_read_bit64, List.map_append] <;>
    simp only [full_action, GateOp.eval, List.foldr_cons, List.foldr_nil, List.head?_cons, List.head?_nil,
      List.headD_cons, List.headD_nil, Option.map_some, Option.map_none, Option.getD_some, Option.getD_none,
      List.all_cons, List.all_nil, List.any_cons, List.any_nil, List.map_cons, List.map_nil, id_eq,
      Bool.and_true, Bool.or_false, full_bit64, BitVec.getElem_and, BitVec.getElem_or, BitVec.getElem_not,
      bit0, Bool.not_false]

def full_isBinary (g : Gate) : Bool := match g.op with
  | .not => false
  | _ => true

def full_binaryCost (gs : List Gate) : ℕ := (gs.filter full_isBinary).length

theorem full_available_read {av : Finset full_W64} {w : List full_W64} (hw : ∀ u ∈ w, holds av u) (i : ℕ) :
    holds av (w.getD i 0) := by
  by_cases h : i < w.length
  · exact hw _ (by simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h])
  · rw [List.getD_eq_default _ _ (Nat.le_of_not_gt h)]
    exact .inl rfl

