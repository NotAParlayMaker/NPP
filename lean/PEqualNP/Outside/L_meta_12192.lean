theorem full_gate_reach (w : List full_W64) (av : Finset full_W64) (hw : ∀ u ∈ w, holds av u)
    (g : Gate) (hg : full_legal g) :
    if full_isBinary g then reachable av (full_action w g) else holds av (full_action w g) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩ <;> simp at cap
  all_goals rcases hop with rfl | rfl | rfl <;> simp only [full_isBinary, Bool.false_eq_true, ite_false, ite_true,
    full_action, List.head?_nil, List.head?_cons, List.map_nil, List.map_cons, List.foldr_nil, List.foldr_cons,
    Option.map_none, Option.map_some, Option.getD_none, Option.getD_some,
    show ∀ x : full_W64, x ||| (0 : full_W64) = x from fun x => BitVec.or_zero,
    show ∀ x : full_W64, x &&& ~~~0 = x from fun x => BitVec.and_allOnes]
  all_goals first
    | exact .inl (.inl rfl)
    | exact .inl (.inr (.inl rfl))
    | exact .inr (.inl rfl)
    | exact .inl (full_available_read hw _)
    | exact holds_not (full_available_read hw _)
    | exact and_reach (full_available_read hw _) (full_available_read hw _)
    | exact or_reach (full_available_read hw _) (full_available_read hw _)

