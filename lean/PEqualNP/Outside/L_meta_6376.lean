theorem root_false : optimized 9 2 inputs = false := by
  change (inputs == [goal] || (pairs inputs).any checkPair) = false
  rw [Bool.or_eq_false_iff]
  refine ⟨by decide +kernel, List.any_eq_false.mpr ?_⟩
  intro p hp
  obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hp
  have size : (pairs inputs).length = 28 := by decide +kernel
  have hi' : i < 28 := size ▸ hi
  have h (j : Fin 28) : checkPair ((pairs inputs).getD j.val (0, 0, [])) = false := by
    fin_cases j
    · exact part_0
    · exact part_1
    · exact part_2
    · exact part_3
    · exact part_4
    · exact part_5
    · exact part_6
    · exact part_7
    · exact part_8
    · exact part_9
    · exact part_10
    · exact part_11
    · exact part_12
    · exact part_13
    · exact part_14
    · exact part_15
    · exact part_16
    · exact part_17
    · exact part_18
    · exact part_19
    · exact part_20
    · exact part_21
    · exact part_22
    · exact part_23
    · exact part_24
    · exact part_25
    · exact part_26
    · exact part_27
  have hj := h ⟨i, hi'⟩
  have lookup : (pairs inputs).getD i (0, 0, []) = (pairs inputs)[i] :=
    List.getD_eq_getElem _ _ hi
  have missing : checkPair (pairs inputs)[i] = false :=
    (congrArg checkPair lookup).symm.trans hj
  exact fun truth => Bool.noConfusion (truth.symm.trans missing)

