import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_18021_aux

def points (m : ℕ) (i : Fin 13) := m.testBit i.val

def lines (m : ℕ) (i : Fin 13) : Bool :=
  !(points m i || points m (i + 1) || points m (i + 3) || points m (i + 9))

def inc (i j : Fin 13) : Prop := i = j ∨ i = j+1 ∨ i = j+3 ∨ i = j+9

instance (i j : Fin 13) : Decidable (inc i j) := by unfold inc; infer_instance

def reps : List (ℕ × ℕ) := [(0, 8191), (1, 3054), (3, 972), (5, 2984), (7, 904), (11, 832), (13, 2848), (19, 708), (21, 2720), (25, 2656), (29, 2592), (37, 2440), (39, 392), (41, 2370), (71, 896), (83, 644), (85, 2688), (101, 2432), (133, 808), (135, 776), (141, 800), (161, 266), (207, 768), (349, 2560), (1917, 2048), (8191, 0)]

def moved (a : Fin 3) (b : Fin 13) (n : ℕ) (i : Fin 13) :=
  n.testBit (((if a = 0 then 1 else if a = 1 then 3 else 9 : Fin 13) * i + b).val)

def valid (m w : ℕ) : Prop :=
  if w < 13 then points m (Fin.ofNat 13 w) = false ∧
    ∀ j : Fin 13, inc (Fin.ofNat 13 w) j → lines m j = false
  else
    let code := w - 13
    let r := reps.getD (code / 39 % 26) (0,0)
    let a := Fin.ofNat 3 (code / 13)
    let b := Fin.ofNat 13 code
    ∀ i : Fin 13, points m i = moved a b r.1 i ∧ lines m i = moved a b r.2 i

instance (m w : ℕ) : Decidable (valid m w) := by unfold valid; split <;> infer_instance

def entry (word i : ℕ) := (word >>> (11*i)) % 2048

