private def code (s : ℕ) : ℕ :=
  match (witnessBins.getD (s / 128) []).find? (fun p => p.1 == s % 128) with
  | some p => p.2
  | none => 0

private def rep (s : ℕ) : Fin 26 := Fin.ofNat 26 (code s)
private def scale (s : ℕ) : Fin 3 := Fin.ofNat 3 (code s / 26)
private def shift (s : ℕ) : Fin 13 := Fin.ofNat 13 (code s / 78)

private def point (s : ℕ) (p : Fin 13) : Bool := s.testBit p.val

private def line (s : ℕ) (q : Fin 13) : Bool :=
  !(point s q || point s (q + 1) || point s (q + 3) || point s (q + 9))

private def affine (a : Fin 3) (b p : Fin 13) : Fin 13 :=
  (if a = 0 then 1 else if a = 1 then 3 else 9) * p + b

private def closed (s : ℕ) : Bool := (List.finRange 13).all fun p =>
  point s p || line s p || line s (p - 1) || line s (p - 3) || line s (p - 9)

private theorem mark_closed (s : ℕ)
    (h : ∀ p : Fin 13, point s p = false → ∃ q : Fin 13,
      (p = q ∨ p = q + 1 ∨ p = q + 3 ∨ p = q + 9) ∧ line s q = true) :
    closed s = true := by
  apply List.all_eq_true.mpr
  intro p _
  cases hp : point s p with
  | true => simp
  | false =>
    obtain ⟨q, hq, hl⟩ := h p hp
    rcases hq with rfl | h1 | h3 | h9
    · simp [hl]
    · have e : p - 1 = q := by rw [h1, add_sub_cancel_right]
      simp [e, hl]
    · have e : p - 3 = q := by rw [h3, add_sub_cancel_right]
      simp [e, hl]
    · have e : p - 9 = q := by rw [h9, add_sub_cancel_right]
      simp [e, hl]

private def verified (s : ℕ) : Bool :=
  let record := representatives.getD (rep s).val (0, 0)
  (List.finRange 13).all fun p =>
    let i := (affine (scale s) (shift s) p).val
    (point s p == record.1.testBit i) && (line s p == record.2.testBit i)

private def band (b : ℕ) : Prop :=
  ∀ k : Fin 256, closed (b * 256 + k.val) = true → verified (b * 256 + k.val) = true

set_option maxRecDepth 16000 in
set_option maxHeartbeats 42000000 in
private theorem all_bands (b : Fin 32) : band b.val := by
  fin_cases b <;> unfold band <;> decide +kernel

private theorem verified_on_closed (s : ℕ) (hBound : s < 8192) (hc : closed s = true) :
    verified s = true := by
  let b : Fin 32 := ⟨s / 256, by omega⟩
  let k : Fin 256 := ⟨s % 256, Nat.mod_lt _ (by decide)⟩
  have sum : b.val * 256 + k.val = s := by dsimp [b,k]; omega
  have band_proof := all_bands b k
  rw [sum] at band_proof
  exact band_proof hc

end PEqualNP.Outside.L_meta_18021

