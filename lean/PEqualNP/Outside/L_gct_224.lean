      have hj : ∀ p q : ℂ, Y * p - X * q = 0 → q = Y / X * p := by
        intro p q h
        rw [eq_comm, div_mul_eq_mul_div, div_eq_iff hx]
        linear_combination h
      fin_cases j
      exacts [hj _ _ a0, hj _ _ a1, hj _ _ a2, hj _ _ a3, hj _ _ a4, hj _ _ a5]
    · apply hx
      linear_combination b0 - b1 + b2 - b3 + b4 - b5 + (1 - m * Y) * hX + (m * X) * hY
