  ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (35534 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t → 6 ≤ t :=
