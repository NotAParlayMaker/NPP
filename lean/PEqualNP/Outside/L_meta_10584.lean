noncomputable def checkRecord (k : ℕ) (prev : ℕ → List ℕ) (size : ℕ) (state : List ℕ) (z : ℕ) : Bool :=
  force z fun z =>
  let h := readV 5 z
  force (8*h.1) fun len => force (h.2 % (1 <<< len)) fun flags =>
  let w := readV 5 (h.2 >>> len)
  let stream := readV 5 w.2
  force (8*stream.1) fun span => force (stream.2 % (1 <<< span)) fun choices =>
  let codes := readSeries (readV 5) (stream.2 >>> span)
  let marks := (readSeries readPair codes.2).1
  forceMap receiptValue codes.1 fun rules => screenNode k prev size rules marks flags choices w.1 state

noncomputable def emptyState (_ : ℕ) : List ℕ := []
