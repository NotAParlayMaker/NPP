abbrev DecorRect := ℕ × ℕ × ℕ × ℕ
noncomputable def sideP (wide : Bool) (w : ℕ) :=
  let core := window 1 4 w &&& starts
  if wide then core ||| extraP (w >>> 208) else core
noncomputable def sideN (wide : Bool) (w : ℕ) :=
  let core := window 16 4 (w &&& ((1 <<< 208)-1)) &&& 65535
  if wide then core ||| extraN (w >>> 208) else core
noncomputable def decorateRects {α : Type} (wide : Bool) (dup : ℕ) (v : List ℕ) (fn : List DecorRect → α) : α :=
  List.rec (fun cont => cont []) (fun a _ ih cont =>
    force (uniqueBank dup a) fun w => force (sideP wide w) fun p => force (sideN wide w) fun n =>
    ih fun t => cont ((a,w,p,n)::t)) v fn
theorem decorateRects_spec {α : Type} (wide : Bool) (dup : ℕ) (v : List ℕ) (fn : List DecorRect → α) :
    decorateRects wide dup v fn = fn (v.map fun a =>
      let w := uniqueBank dup a
      (a,w,sideP wide w,sideN wide w)) := by
  induction v generalizing fn with
  | nil => rfl
  | cons a v ih =>
    simp only [decorateRects,force_eq,List.map_cons]
    simp only [decorateRects,force_eq] at ih
    exact ih _
def verifiedPair (a x b y : ℕ) (i j u t : RPos) : Bool :=
  a != b && x.testBit i.val && x.testBit j.val && y.testBit u.val && y.testBit t.val &&
  renameP i == renameP u && renameN j == renameN t
noncomputable def cellProof (wide : Bool) (u v : DecorRect) : Bool :=
  let (a,x,ps,ns) := u
  let (b,y,qs,ms) := v
  force (ps &&& qs) fun pts => force (ns &&& ms) fun nts =>
  pts != 0 && nts != 0 &&
    let pm := if wide then posMask pts.log2 else 65535 <<< pts.log2
    let nm := if wide then negMask nts.log2 else starts <<< nts.log2
    verifiedPair a x b y (Fin.ofNat 248 ((x &&& pm).log2)) (Fin.ofNat 248 ((x &&& nm).log2))
      (Fin.ofNat 248 ((y &&& pm).log2)) (Fin.ofNat 248 ((y &&& nm).log2))
noncomputable def detect (wide : Bool) (dup : ℕ) (v : List ℕ) :=
  decorateRects wide dup v fun ds => ds.any (fun a => ds.any (cellProof wide a))
noncomputable def collide (k : ℕ) (v : List ℕ) : Bool :=
  v.length==k+1 && force (duplicates v) fun dup => detect false dup v || detect true dup v
theorem detectNo {k v} (wide : Bool) (aligned : ∀ w∈v,Aligned w) (h : feasible 248 k v)
    (len : v.length=k+1) : detect wide (duplicates v) v=false := by
  apply Bool.eq_false_iff.mpr
  intro yes
  simp only [detect,decorateRects_spec,List.any_eq_true,List.mem_map] at yes
  obtain ⟨q,⟨a,ha,rfl⟩,z,⟨b,hb,rfl⟩,valid⟩ := yes
  simp only [cellProof,force_eq,Bool.and_eq_true] at valid
  have cert := valid.2
  simp only [verifiedPair,Bool.and_eq_true,bne_iff_ne,beq_iff_eq] at cert
  obtain ⟨⟨⟨⟨⟨⟨ab,ax⟩,ay⟩,bx⟩,byy⟩,pc⟩,nc⟩ := cert
  obtain ⟨j,le,live,nd⟩ := h
  have card := List.toFinset_card_of_nodup nd
  have low := liveSize live
  obtain ⟨f,rect,mem,sep⟩ := protocol live (by omega) (by simpa using aligned)
  have memb (p n) : f p n∈v := List.mem_toFinset.mp (mem p n)
  have a1 := forcedAt ha aligned f memb sep ax
  have a2 := forcedAt ha aligned f memb sep ay
  have b1 := forcedAt hb aligned f memb sep bx
  have b2 := forcedAt hb aligned f memb sep byy
  have ca := (rect _ _ _ _ (a1.trans a2.symm)).trans a1
  have cb := (rect _ _ _ _ (b1.trans b2.symm)).trans b1
  rw [pc,nc] at ca
  exact ab (ca.symm.trans cb)
theorem collideOff {k v} (aligned : ∀ w∈v,Aligned w) (h : feasible 248 k v) : collide k v=false := by
  by_cases l : v.length=k+1 <;> simp [collide,l,force_eq,detectNo _ aligned h]
def AllAligned (v : List ℕ) := ∀ x∈v,Aligned x

theorem alignedOut {a b z n cv m k ka kb rest w} (ha : Aligned a) (hb : Aligned b) (hz : Aligned z)
    (hr : AllAligned rest) (hw : w∈oneOutput m k rest n cv a b z ka kb) : AllAligned w := by
  unfold oneOutput at hw
  split at hw
  · simp only [List.mem_singleton] at hw
    subst w
    cases ka <;> cases kb <;> simpa [AllAligned,save,ha,hb,hz] using hr
  · simp at hw

theorem alignedGate {a b z n cv m k rest v w} (ha : Aligned a) (hb : Aligned b) (hz : Aligned z)
    (hr : AllAligned rest) (hw : w∈oneGate m k v rest n cv a b z) : AllAligned w := by
  unfold oneGate at hw
  split at hw
  · simp only [List.mem_append] at hw
    rcases hw with ((h|h)|h)|h <;> exact alignedOut ha hb hz hr h
  · simp at hw

theorem alignedSteps {m k v w} (h : AllAligned v) (hw : w∈successors m k v) : AllAligned w := by
  obtain ⟨a,ha,b,hh,hp⟩ := (by simpa only [successors,List.mem_flatMap] using hw :
    ∃ a∈v,∃ b∈v,w∈onePair m k v a b)
  unfold onePair at hp
  split at hp
  · have hr : AllAligned (without v a b) := fun x hx => h x (List.mem_filter.mp hx).1
    simp only [List.mem_append] at hp
    rcases hp with ((e|e)|e)|e
    · exact alignedGate (h _ ha) (h _ hh) (alignedCombine 0 (h _ ha) (h _ hh)) hr e
    · exact alignedGate (h _ ha) (h _ hh) (alignedCombine 1 (h _ ha) (h _ hh)) hr e
    · exact alignedGate (h _ ha) (h _ hh) (alignedCombine 2 (h _ ha) (h _ hh)) hr e
    · exact alignedGate (h _ ha) (h _ hh) (alignedCombine 3 (h _ ha) (h _ hh)) hr e
  · simp at hp

noncomputable def scan (f : ℕ → Bool → ℕ → List ℕ → Bool) (width : ℕ) :
    List (List ℕ) → ℕ → ℕ → ℕ → Bool
  | [],_,_,_ => false
  | w::ws,i,b,c => force b fun b => force c fun c =>
    if b.testBit 0 then f i true (c%(1<<<width)) w || scan f width ws (i+1) (b>>>1) (c>>>width)
    else f i false 0 w || scan f width ws (i+1) (b>>>1) c

theorem scanHit {f : ℕ → Bool → ℕ → List ℕ → Bool} {width w ws}
    (hw : w∈ws) (hit : ∀ i b c, f i b c w=true) (i b c : ℕ) :
    scan f width ws i b c=true := by
  induction ws generalizing i b c with
  | nil => simp at hw
  | cons x xs ih =>
    simp only [scan,force_eq]
    rcases List.mem_cons.mp hw with rfl|mem
    · split <;> simp [hit]
    · split <;> simp [ih mem]
noncomputable def screened : ℕ → ℕ → List ℕ → Bool
  | 0,k,w => if collide k w then false else fastSearch 248 k w
  | _+1,0,w => terminal 248 w
  | d+1,k+1,w => forceMap id w fun v => if collide (k+1) v then false else
      terminal 248 v || (successors 248 k v).any (screened d k)
theorem screenedOk (d k : ℕ) (v : List ℕ) (av : AllAligned v) (h : feasible 248 k v) : screened d k v=true := by
  induction d generalizing k v with
  | zero =>
    simp only [screened,collideOff av h,Bool.false_eq_true,↓reduceIte,fastSearch_eq]
    obtain ⟨j,le,live,nd⟩ := h
    exact complete 248 k live le v rfl nd
  | succ d ih =>
    cases k with
    | zero =>
      obtain ⟨j,le,live,nd⟩ := h
      exact complete 248 0 live le v rfl nd
    | succ k =>
      simp only [screened,forceMap_eq,List.map_id_fun,id_eq,collideOff av h,Bool.false_eq_true,↓reduceIte,Bool.or_eq_true]
      rcases move h with endNow|⟨w,hw,ok⟩
      · exact Or.inl endNow
      · exact Or.inr (List.any_eq_true.mpr ⟨w,hw,ih k w (alignedSteps av hw) ok⟩)
noncomputable def screenRows (k : ℕ) (prev : ℕ → List ℕ) (count : ℕ) (rs : List ℕ)
    (ms : List (ℕ × ℕ)) (flags choices width : ℕ) (v : List ℕ) : Bool :=
  scan (fun i take pick w => force (lookupMark i ms) fun tag =>
    if 1024≤tag then
      let j := tag-1024
      if j<count then !(sameSet w (prev j) && decide (prev j).Nodup) else true
    else if 2≤tag then cutSearch 248 (zeroPairs 248 w (tag-2) (full 248)) k w
    else if take then !(testRule k w (rs[pick]?.getD 0))
    else screened 2 k w) width (successors 248 k v) 0 flags choices

noncomputable def screenNode (k : ℕ) (prev : ℕ → List ℕ) (count : ℕ)
    (rs : List ℕ) (ms : List (ℕ × ℕ)) (flags choices width : ℕ) (xs : List ℕ) : Bool :=
  forceMap id xs fun v => !terminal 248 v && !screenRows k prev count rs ms flags choices width v

theorem screenNode_sound {k prev count rs ms flags choices width v} (av : AllAligned v)
    (prior : ∀ j<count, Excluded 248 k (prev j))
    (check : screenNode k prev count rs ms flags choices width v=true) : Excluded 248 (k+1) v := by
  simp only [screenNode,forceMap_eq,List.map_id_fun,id_eq,Bool.and_eq_true,Bool.not_eq_true'] at check
  intro ok
  rcases move ok with term|⟨w,hw,h⟩
  · simp [term] at check
  · have bad : screenRows k prev count rs ms flags choices width v=true := by
      apply scanHit hw
      intro i take pick
      rw [force_eq]
      split
      · dsimp only
        split
        · rename_i inside
          rw [Bool.not_eq_true']
          apply Bool.eq_false_iff.mpr
          intro both
          simp only [Bool.and_eq_true] at both
          obtain ⟨same,nd⟩ := both
          obtain ⟨j,lim,live,_⟩ := h
          exact prior _ inside ⟨j,lim,sameSet_sound same ▸ live,of_decide_eq_true nd⟩
        · rfl
      · split
        · obtain ⟨j,hj,live,nd⟩ := h
          exact cut_complete (by decide) live w rfl nd _ k hj
        · split
          · rw [Bool.not_eq_true']
            exact rejectRule h _
          · exact screenedOk 2 k w (alignedSteps av hw) h
    simp [bad] at check

