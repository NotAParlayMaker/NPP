noncomputable def force {β : Type} (n : Nat) (f : Nat → β) : β := Nat.rec (f 0) (fun k _ => f (Nat.succ k)) n
theorem force_eq {β : Type} (n : Nat) (f : Nat → β) : force n f = f n := by cases n <;> rfl
noncomputable def forceMap {α β : Type} (f : α → Nat) (l : List α) : (List Nat → β) → β :=
  List.rec (fun k => k []) (fun a _ ih k => force (f a) fun x => ih fun xs => k (x::xs)) l
theorem forceMap_eq {α β : Type} (f : α → Nat) (l : List α) (k : List Nat → β) : forceMap f l k = k (l.map f) := by
  induction l generalizing k with
  | nil => rfl
  | cons a l ih =>
    change force (f a) (fun x => forceMap f l fun xs => k (x::xs)) = _
    rw [force_eq,ih]
    rfl
noncomputable def fastPair (m fuel : ℕ) (go : List ℕ → Bool) (v : List ℕ) (a b : ℕ) : Bool :=
  if a<b then
    forceMap id (without v a b) fun rest =>
    force rest.length fun n =>
    force (cover m rest) fun cv =>
    let check := fun z => force z (gateStep m fuel go v rest n cv a b)
    check (a &&& b) || check (a ||| b) || check (a ^^^ (a &&& b)) || check (b ^^^ (a &&& b))
  else false
theorem fastPair_eq (m fuel : ℕ) (go : List ℕ → Bool) (v : List ℕ) (a b : ℕ) :
    fastPair m fuel go v a b = pairStep m fuel go v a b := by
  simp [fastPair,pairStep,forceMap_eq,force_eq]

noncomputable def fastSearch (m : ℕ) : ℕ → List ℕ → Bool
  | 0,v => terminal m v
  | f+1,w => forceMap id w fun v => terminal m v || v.any (fun a => v.any (fun b => fastPair m f (fastSearch m f) v a b))

theorem fastSearch_eq (m k : ℕ) : fastSearch m k = search m k := by
  induction k with
  | zero => rfl
  | succ k ih => funext v; simp [fastSearch,search,anyGate,forceMap_eq,fastPair_eq,ih]

noncomputable def fastContr (m fuel : ℕ) (v : List ℕ) (s : FloorData) (code : ℕ) : Bool :=
  force s.pairMask fun mask => force (min mask.log2 (m-1)) fun r =>
  force code fun code =>
  forceMap (slice m mask r) v fun pv =>
  forceMap id (replay 5 code (0::s.basis)) fun av =>
  fuel+paidCount 5 code<s.lower+pv.count 0 && pv.all (fun x => av.contains x)

theorem fastContr_eq (m fuel : ℕ) (v : List ℕ) (s : FloorData) (code : ℕ) :
    fastContr m fuel v s code = contradictsFloor m fuel v s code := by
  simp [fastContr,contradictsFloor,force_eq,forceMap_eq]

def readV : ℕ → ℕ → ℕ × ℕ
  | 0,s => (0,s)
  | d+1,s =>
    let b := s % 256
    if b < 128 then (b,s >>> 8) else
      let t := readV d (s >>> 8)
      (b % 128 + 128*t.1,t.2)

def readN {α : Type} (get : ℕ → α × ℕ) : ℕ → ℕ → List α × ℕ
  | 0,s => ([],s)
  | k+1,s =>
    let v := get s
    let r := readN get k v.2
    (v.1::r.1,r.2)

def readSeries {α : Type} (get : ℕ → α × ℕ) (s : ℕ) :=
  let n := readV 10 s
  readN get n.1 n.2

def readPair (s : ℕ) :=
  let a := readV 10 s
  let b := readV 10 a.2
  ((a.1,b.1),b.2)

def lookupMark (i : ℕ) : List (ℕ × ℕ) → ℕ
  | [] => 0
  | h::t => if i=h.1 then h.2 else lookupMark i t

def anyIdx {α : Type} (f : ℕ → α → Bool) : List α → ℕ → Bool
  | [],_ => false
  | x::xs,i => f i x || anyIdx f xs (i+1)

theorem anyIdxHit {α : Type} {f : ℕ → α → Bool} {w : α} {ws : List α}
    (mem : w ∈ ws) (ok : ∀ i,f i w=true) (i : ℕ) : anyIdx f ws i=true := by
  induction ws generalizing i with
  | nil => simp at mem
  | cons a t ih =>
    rcases List.mem_cons.mp mem with rfl|h
    · simp [anyIdx,ok]
    · simp [anyIdx,ih h (i+1)]

noncomputable def testRule (fuel : ℕ) (v : List ℕ) (rule : ℕ) : Bool :=
  fastContr 248 fuel v (chosenFloor (rule % 128)).val (rule/128)

theorem rejectRule {k v} (ok : feasible 248 k v) (r : ℕ) : testRule k v r=false := by
  rw [testRule,fastContr_eq]
  exact floor_consistent (by decide) ok _ (chosenFloor (r%128)).property _

def sameSet (a b : List ℕ) : Bool := a.all (fun x => b.contains x) && b.all (fun x => a.contains x)

theorem sameSet_sound {a b : List ℕ} (h : sameSet a b=true) : a.toFinset=b.toFinset := by
  simp only [sameSet,Bool.and_eq_true] at h
  obtain ⟨ab,ba⟩ := h
  ext x
  simp only [List.mem_toFinset]
  exact ⟨fun hx => List.contains_iff_mem.mp (List.all_eq_true.mp ab x hx),
    fun hx => List.contains_iff_mem.mp (List.all_eq_true.mp ba x hx)⟩

def getSlot (n pos width : ℕ) := (n >>> (pos*width)) % (1 <<< width)

def unpackState (word : ℕ → ℕ) (width raw : ℕ) : List ℕ :=
  ((List.range 7).filter (fun i => raw.testBit i)).map word ++
  (((List.range 6).map (fun j => getSlot (raw >>> 7) j width)).filter (· != 0)).map (fun i => word (i+6))

def pRep (i : ℕ) := ( >>> (8*i)) % 256
def nRep (i : ℕ) := ( >>> (8*i)) % 256

abbrev RPos := Fin 248
abbrev RNeg := Fin 16
def pbit (w : ℕ) (p : RPos) := w.testBit p.val
def nbit (w : ℕ) (n : RNeg) := w.testBit (248+n.val)
def renameP (i : RPos) : RPos := Fin.ofNat 248 (pRep i.val)
def renameN (i : RPos) : RNeg := Fin.ofNat 16 (nRep i.val)
def Aligned (w : ℕ) := ∀ i : RPos,
    w.testBit i.val=pbit w (renameP i) ∧ w.testBit (248+i.val)=nbit w (renameN i)
theorem alignedCombine {a b} (d : ℕ) (ha : Aligned a) (hb : Aligned b) : Aligned (combine d a b) := by
  intro i
  exact ⟨combine_congr_bits d a b _ _ (ha i).1 (hb i).1,
    combine_congr_bits d a b _ _ (ha i).2 (hb i).2⟩
theorem firstRows : ∀ n : RNeg,
    renameP ⟨n.val,by omega⟩=0 ∧ renameN ⟨n.val,by omega⟩=n := by decide +kernel
theorem baseSeparated {a} (good : Good 248 a) (al : Aligned a) (p : RPos) (n : RNeg) : pbit a p≠nbit a n := by
  have diff (j : RNeg) : pbit a 0≠nbit a j := by
    let i : RPos := ⟨j.val,by omega⟩
    have h := good i.val i.isLt
    rw [(al i).1,(al i).2] at h
    simpa only [(firstRows j).1,(firstRows j).2,i] using h
  have h := good p.val p.isLt
  rw [(al p).2] at h
  have eq : nbit a (renameN p) = nbit a n := by
    have h1 := diff (renameN p);have h2 := diff n
    exact (by decide : ∀ u v w : Bool, u≠v → u≠w → v=w) _ _ _ h1 h2
  exact eq ▸ h
def specialA (d : ℕ) := decide (d=0 ∨ d=2)
def specialB (d : ℕ) := decide (d=0 ∨ d=3)
def specialZ (d : ℕ) := decide (d≠1)
theorem special {d : ℕ} (hd : d<4) (a b i : ℕ) :
    (combine d a b).testBit i=specialZ d ↔ a.testBit i=specialA d ∧ b.testBit i=specialB d := by
  interval_cases d <;> cases h : a.testBit i <;> cases f : b.testBit i <;>
    simp [combine,specialZ,specialA,specialB,Nat.testBit_and,Nat.testBit_or,Nat.testBit_xor,h,f]

def Rect (f : RPos → RNeg → ℕ) := ∀ p n q m, f p n=f q m → f p m=f p n

theorem rectSplit {f : RPos → RNeg → ℕ} {z a b : ℕ} (r : Rect f)
    (fresh : ∀ p n, f p n≠a ∧ f p n≠b) (ne : a≠b)
    (g : RPos → RNeg → ℕ) (vals : ∀ p n, g p n=a ∨ g p n=b)
    (rectg : Rect g) : Rect (fun p n => if f p n=z then g p n else f p n) := by
  intro p n q m eq
  by_cases e : f p n=z <;> by_cases t : f q m=z
  · have cross := r p n q m (e.trans t.symm)
    simp only [e,t,if_true] at eq
    simp [e,cross,rectg p n q m eq]
  · simp only [e,t,if_true,if_false] at eq
    rcases vals p n with x|x
    · exact ((fresh q m).1 (eq.symm.trans x)).elim
    · exact ((fresh q m).2 (eq.symm.trans x)).elim
  · simp only [e,t,if_true,if_false] at eq
    rcases vals q m with x|x
    · exact ((fresh p n).1 (eq.trans x)).elim
    · exact ((fresh p n).2 (eq.trans x)).elim
  · simp only [e,t,if_false] at eq
    simp [r p n q m eq,e]

theorem boolThird {a b c : Bool} (x : a≠b) (y : b≠c) : a=c := by cases a <;> cases b <;> cases c <;> simp_all

theorem splitChoice {f : RPos → RNeg → ℕ} {d a b : ℕ} (hd : d<4)
    (r : Rect f) (sep : ∀ p n, pbit (f p n) p≠nbit (f p n) n) :
    ∃ g : RPos → RNeg → ℕ, Rect g ∧ (∀ p n,g p n=a ∨ g p n=b) ∧
      ∀ p n, f p n=combine d a b → pbit (g p n) p≠nbit (g p n) n := by
  let z := combine d a b
  have neq (p n) (h : f p n=z) : pbit z p≠nbit z n := h ▸ sep p n
  have sp (p) : pbit z p=specialZ d ↔ pbit a p=specialA d ∧ pbit b p=specialB d := special hd _ _ _
  have sn (n) : nbit z n=specialZ d ↔ nbit a n=specialA d ∧ nbit b n=specialB d := special hd _ _ _
  by_cases yes : ∃ p n, f p n=z ∧ pbit z p=specialZ d
  · obtain ⟨p0,n0,h0,s0⟩ := yes
    let g (_ : RPos) (n : RNeg) := if nbit a n=specialA d then b else a
    refine ⟨g,fun _ _ _ _ h => h.symm,?_,?_⟩
    · intro p n; dsimp [g]; split <;> simp
    · intro p n h
      have cross : f p0 n=z := (r p0 n0 p n (h0.trans h.symm)).trans h0
      have ns : nbit z n≠specialZ d := fun e => neq _ _ cross (s0.trans e.symm)
      have ps : pbit z p=specialZ d := by
        exact boolThird (neq _ _ h) ns
      dsimp [g]; split
      · rename_i spec
        intro e; exact ns ((sn n).2 ⟨spec,e ▸ ((sp p).1 ps).2⟩)
      · rename_i spec
        exact fun e => spec (e ▸ ((sp p).1 ps).1)
  · let g (p : RPos) (_ : RNeg) := if pbit a p=specialA d then b else a
    refine ⟨g,fun _ _ _ _ _ => rfl,?_,?_⟩
    · intro p n; dsimp [g]; split <;> simp
    · intro p n h
      have ps : pbit z p≠specialZ d := fun e => yes ⟨p,n,h,e⟩
      have ns : nbit z n=specialZ d := by
        exact boolThird (Ne.symm (neq _ _ h)) ps
      dsimp [g]; split
      · rename_i spec
        intro e; exact ps ((sp p).2 ⟨spec,e.symm ▸ ((sn n).1 ns).2⟩)
      · rename_i spec
        exact fun e => spec (e.symm ▸ ((sn n).1 ns).1)

theorem protocol {k S} (live : Live 248 k S) (size : k+1=S.card)
    (align : ∀ w∈S,Aligned w) : ∃ f : RPos → RNeg → ℕ, Rect f ∧
    (∀ p n, f p n∈S) ∧ ∀ p n, pbit (f p n) p≠nbit (f p n) n := by
  induction live with
  | @done a good nz =>
    refine ⟨fun _ _ => a, fun _ _ _ _ _ => rfl, fun _ _ => Finset.mem_singleton_self _,?_⟩
    intro p n
    exact baseSeparated good (align a (Finset.mem_singleton_self _)) p n
  | @step k U a b d hd _ _ ne fr tail ih =>
    let z := combine d a b
    have zn : z∉U := fun h => fr (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem h))
    have lt := liveSize tail
    rw [Finset.card_insert_of_notMem zn] at lt
    have ca := Finset.card_insert_le a (insert b U)
    have cb := Finset.card_insert_le b U
    have an : a∉insert b U := by intro ha; rw [Finset.insert_eq_of_mem ha] at size; omega
    have bn : b∉U := by intro hb; rw [Finset.insert_eq_of_mem hb] at size; have := Finset.card_insert_le a U; omega
    have st : k+1=(insert z U).card := by rw [Finset.card_insert_of_notMem zn]; omega
    have alU (w) (hw : w∈U) := align w (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem hw))
    have al : ∀ w∈insert z U,Aligned w := by
      intro w hw
      rcases Finset.mem_insert.mp hw with rfl|mem
      · exact alignedCombine _ (align _ (Finset.mem_insert_self _ _)) (align _ (Finset.mem_insert_of_mem (Finset.mem_insert_self _ _)))
      · exact alU _ mem
    obtain ⟨f,rr,mem,sep⟩ := ih st al
    obtain ⟨g,rg,vals,sg⟩ := splitChoice (d:=d) (a:=a) (b:=b) hd rr sep
    have fresh (p n) : f p n≠a ∧ f p n≠b := by
      have h := Finset.mem_insert.mp (mem p n)
      constructor
      · intro eq; rw [eq] at h; rcases h with e|e
        · exact fr (e ▸ Finset.mem_insert_self _ _)
        · exact an (Finset.mem_insert_of_mem e)
      · intro eq; rw [eq] at h; rcases h with e|e
        · exact fr (e ▸ Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
        · exact bn e
    refine ⟨fun p n => if f p n=z then g p n else f p n,rectSplit rr fresh ne g vals rg,?_,?_⟩
    · intro p n; dsimp only; split
      · rcases vals p n with e|e <;> simp [e]
      · rename_i h; exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem ((Finset.mem_insert.mp (mem p n)).resolve_left h))
    · intro p n; dsimp only; split
      · exact sg p n (by assumption)
      · exact sep p n

def duplicates : List ℕ → ℕ
  | [] => 0
  | a::t => (separation 248 a &&& cover 248 t) ||| duplicates t

theorem duplicateBit {v : List ℕ} {a b i : ℕ} (ha : a∈v) (hb : b∈v) (ne : a≠b)
    (sa : (separation 248 a).testBit i=true) (sb : (separation 248 b).testBit i=true) :
    (duplicates v).testBit i=true := by
  induction v with
  | nil => simp at ha
  | cons c t ih =>
    simp only [duplicates,Nat.testBit_or,Nat.testBit_and,Bool.or_eq_true,Bool.and_eq_true]
    rcases List.mem_cons.mp ha with rfl|ma
    · have mb := (List.mem_cons.mp hb).resolve_left (Ne.symm ne)
      exact Or.inl ⟨sa,(coverBit 248 i t).2 ⟨b,mb,(surface 248 b i).1 sb⟩⟩
    · rcases List.mem_cons.mp hb with rfl|mb
      · exact Or.inl ⟨sb,(coverBit 248 i t).2 ⟨a,ma,(surface 248 a i).1 sa⟩⟩
      · exact Or.inr (ih ma mb)

def gridMask : ℕ := (1 <<< 248)-1
def uniqueBank (dup w : ℕ) := separation 248 w &&& (gridMask ^^^ dup) &&& gridMask
theorem forcedAt {v : List ℕ} {a} (ha : a∈v) (align : ∀ w∈v, Aligned w)
    (f : RPos → RNeg → ℕ) (inside : ∀ p n, f p n∈v)
    (separates : ∀ p n,pbit (f p n) p≠nbit (f p n) n)
    {i : RPos} (one : (uniqueBank (duplicates v) a).testBit i.val=true) :
    f (renameP i) (renameN i)=a := by
  let w := f (renameP i) (renameN i)
  have wm : w∈v := inside _ _
  have good : pbit w (renameP i)≠nbit w (renameN i) := separates _ _
  rw [←(align w wm i).1,←(align w wm i).2] at good
  have mark := (surface 248 w i.val).2 good
  change ((separation 248 a &&& (gridMask ^^^ duplicates v)) &&& gridMask).testBit i.val=true at one
  simp only [Nat.testBit_and,Nat.testBit_xor,Bool.and_eq_true] at one
  by_contra ne
  have dup := duplicateBit wm ha ne mark one.1.1
  have wrong := one.1.2
  simp [one.2,dup] at wrong

noncomputable def window (stride : ℕ) : ℕ → ℕ → ℕ
  | 0,w => w
  | d+1,w => force (window stride d w) fun u => u ||| (u >>> (stride*2^d))

