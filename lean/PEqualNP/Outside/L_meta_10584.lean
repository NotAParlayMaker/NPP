def RangeOk (f : ℕ → Bool) (a n : ℕ) := ∀ j : Fin n, f (a+j.val)=true
theorem joinRange {f a n m} (h : RangeOk f a n) (g : RangeOk f (a+n) m) : RangeOk f a (n+m) := by
  intro j
  by_cases small : j.val<n
  · exact h ⟨_,small⟩
  · have hv := g ⟨j.val-n,by omega⟩
    simpa only [show a+n+(j.val-n)=a+j.val by omega] using hv

theorem recordSound {k prev size state z} (aligned : AllAligned state) (h : ∀ j<size, Excluded 248 k (prev j))
    (c : checkRecord k prev size state z=true) : Excluded 248 (k+1) state := by
  simp only [checkRecord,force_eq,forceMap_eq] at c
  exact screenNode_sound aligned h c
