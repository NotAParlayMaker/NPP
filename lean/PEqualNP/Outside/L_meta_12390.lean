theorem PEqualNP.Outside.L_meta_12390 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (3907577984 * 2 ^ 32 + 3900762240) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (3907577984 * 2 ^ 32 + 3900762240) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) := by
  refine Classical.byContradiction ?_
  intro contra
  apply contra
  intro s hs
  refine ⟨PEqualNP.Outside.L_meta_12390_aux.upper, PEqualNP.Outside.L_meta_12390_aux.upper_monotone, ?_, PEqualNP.Outside.L_meta_12390_aux.upper_eval⟩
  exact PEqualNP.Outside.L_meta_12390_aux.circuitLower s hs
