private theorem edgeTest (es : List (ℕ × ℕ)) (x : Fin 8 → Bool)
    (h : ∀ p ∈ es, p.1 < 8 ∧ p.2 < 8) :
    (es.any fun p => x (Fin.ofNat 8 p.1) && x (Fin.ofNat 8 p.2)) = true ↔
      ∃ u v : Fin 8, (u.val, v.val) ∈ es ∧ x u = true ∧ x v = true := by
  rw [List.any_eq_true]
  constructor
  · rintro ⟨⟨a,b⟩, hab, he⟩
    obtain ⟨ha, hb⟩ := h (a,b) hab
    have eqA : Fin.ofNat 8 a = ⟨a,ha⟩ := Fin.ext (Nat.mod_eq_of_lt ha)
    have eqB : Fin.ofNat 8 b = ⟨b,hb⟩ := Fin.ext (Nat.mod_eq_of_lt hb)
    rw [eqA, eqB, Bool.and_eq_true] at he
    exact ⟨⟨a,ha⟩, ⟨b,hb⟩, hab, he.1, he.2⟩
  · rintro ⟨a, b, hab, ha, hb⟩
    have eqA : Fin.ofNat 8 a.val = a := Fin.ext (Nat.mod_eq_of_lt a.isLt)
    have eqB : Fin.ofNat 8 b.val = b := Fin.ext (Nat.mod_eq_of_lt b.isLt)
    exact ⟨(a.val,b.val), hab, by rw [eqA, eqB, Bool.and_eq_true]; exact ⟨ha,hb⟩⟩

end PEqualNP.Outside.L_meta_939

