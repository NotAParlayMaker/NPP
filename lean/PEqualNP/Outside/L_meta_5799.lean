def dist (i j : E) : Nat := classes[21 * i.val + j.val]!
def groupOf (i j : E) : G := Fin.ofNat _ codes[21 * i.val + j.val]!
def row (g : G) (r : R) : R := Fin.ofNat _ ((rtable[g.val]! >>> (6*r.val)) % 64)
def vert (g : G) (v : V) : V := Fin.ofNat _ ((vtable[g.val]! >>> (4*v.val)) % 16)
def inv (g : G) (v : V) : V := Fin.ofNat _ ((itable[g.val]! >>> (4*v.val)) % 16)
def reps : List (Nat × Nat × Nat) := [(1,1,2),(4,527,557112),(7,335487,511970)]
def rep (i j : E) : Nat × Nat × Nat := reps.getD (dist i j - 1) (1,1,2)
def left (i j : E) : W := BitVec.ofNat 58 (rep i j).2.1
def right (i j : E) : W := BitVec.ofNat 58 (rep i j).2.2
def small (r : R) : E := Fin.ofNat 21 r.val
def atE (e : E) : R := ⟨e.val, by omega⟩
set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem tgt : ∀ r : R, target.getLsbD r.val = decide (r.val < 21) := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem validV : ∀ (g : G) (v : V), vert g (inv g v) = v := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem validR : ∀ (g : G) (r : R), target.getLsbD (row g r).val = target.getLsbD r.val := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem validC : ∀ (g : G) (v : V) (r : R), (col (vert g v)).getLsbD r.val = (col v).getLsbD (row g r).val := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem validPair : ∀ (i j : E), i ≠ j → rep i j ∈ reps ∧ (rep i j).1 < 58 ∧ row (groupOf i j) 0 = atE i ∧ row (groupOf i j) (Fin.ofNat 58 (rep i j).1) = atE j ∧ (left i j).toNat = (rep i j).2.1 ∧ (right i j).toNat = (rep i j).2.2 := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem nearL : ∀ (i j : E) (r : R), i ≠ j → (left i j).getLsbD r.val = true → let a := row (groupOf i j) r; a.val < 21 ∧ dist i (small a) < dist i j := by decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem nearR : ∀ (i j : E) (r : R), i ≠ j → (right i j).getLsbD r.val = true → let a := row (groupOf i j) r; a.val < 21 ∧ dist (small a) j < dist i j := by decide +kernel

def moved (g : G) (x : W) : W :=
  (BitVec.ofBoolListLE (List.ofFn fun r : R => x.getLsbD (row g r).val)).cast (by simp)

theorem movedBit (g : G) (x : W) (r : R) : (moved g x).getLsbD r.val = x.getLsbD (row g r).val := by
  simp only [moved, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE]
  rw [List.getD_eq_getElem _ _ (by simp)]
  simp only [List.getElem_ofFn]

theorem misses {x y : W} (ht : x ||| y = target) (hx : x ≠ target) : ∃ i : E, x.getLsbD i.val = false := by
  by_contra! h
  apply hx
  apply BitVec.eq_of_getLsbD_eq
  intro k hk
  have v := tgt ⟨k,hk⟩
  have comb := congrArg (fun w : W => w.getLsbD k) ht
  simp only [BitVec.getLsbD_or] at comb
  change target.getLsbD k = decide (k < 21) at v
  by_cases he : k < 21
  · rw [v, decide_eq_true he]
    cases e : x.getLsbD k with
    | false => exact (h ⟨k,he⟩ e).elim
    | true => rfl
  · rw [v, decide_eq_false he] at comb ⊢
    simpa using (Bool.or_eq_false_iff.mp comb).1

theorem pushOr {x y : W} (ht : x ||| y = target) (g : G) : moved g x ||| moved g y = target := by
  apply BitVec.eq_of_getLsbD_eq
  intro k hk
  let r : R := ⟨k,hk⟩
  change (moved g x ||| moved g y).getLsbD r.val = _
  rw [BitVec.getLsbD_or, movedBit, movedBit, ← BitVec.getLsbD_or, ht, validR]

theorem maskEq (x m : W) (h : ∀ r : R, m.getLsbD r.val = true → x.getLsbD r.val = true) : x.toNat &&& m.toNat = m.toNat := by
  have eq : x &&& m = m := by
    apply BitVec.eq_of_getLsbD_eq
    intro k hk
    rw [BitVec.getLsbD_and]
    cases hm : m.getLsbD k with
    | false => simp
    | true => simp [h ⟨k,hk⟩ hm]
  exact congrArg BitVec.toNat eq

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
theorem solve (x y : W) (ht : x ||| y = target) (hx : x ≠ target) (hy : y ≠ target) :
  ∃ (rr : R → R) (vv : V → V) (a b : W), Function.Surjective vv ∧
  (∀ v r, (col (vv v)).getLsbD r.val = (col v).getLsbD (rr r).val) ∧
  (∀ r, a.getLsbD r.val = x.getLsbD (rr r).val ∧ b.getLsbD r.val = y.getLsbD (rr r).val) ∧
  a ||| b = target ∧ ∃ t ∈ reps, b.getLsbD 0 = false ∧ a.getLsbD t.1 = false ∧ a.toNat &&& t.2.1 = t.2.1 ∧ b.toNat &&& t.2.2 = t.2.2 := by
  classical
  obtain ⟨i₀,hi₀⟩ := misses (x := y) (y := x) (by rw [BitVec.or_comm]; exact ht) hy
  obtain ⟨j₀,hj₀⟩ := misses ht hx
  let P := fun d : Nat => ∃ i j : E, y.getLsbD i.val = false ∧ x.getLsbD j.val = false ∧ dist i j = d
  have hex : ∃ d, P d := ⟨_, i₀,j₀,hi₀,hj₀,rfl⟩
  obtain ⟨i,j,hi,hj,hd⟩ := Nat.find_spec hex
  have minimal (a b : E) (ha : y.getLsbD a.val = false) (hb : x.getLsbD b.val = false) : dist i j ≤ dist a b :=
    calc
      dist i j = Nat.find hex := hd
      _ ≤ dist a b := Nat.find_min' hex (show P (dist a b) from ⟨a,b,ha,hb,rfl⟩)
  have ne : i ≠ j := by
    rintro rfl
    have a := congrArg (fun z : W => z.getLsbD i.val) ht
    change (x ||| y).getLsbD i.val = target.getLsbD (atE i).val at a
    rw [BitVec.getLsbD_or, hi, hj, tgt] at a
    simp [atE, i.isLt] at a
  let g := groupOf i j
  obtain ⟨hm,hs,h0,h1,hL,hR⟩ := validPair i j ne
  have htfin : (Fin.ofNat 58 (rep i j).1).val = (rep i j).1 := Nat.mod_eq_of_lt hs
  refine ⟨row g, vert g, moved g x, moved g y, fun v => ⟨inv g v, validV g v⟩, validC g,
    fun r => ⟨movedBit g x r, movedBit g y r⟩, pushOr ht g, rep i j, hm, ?_, ?_, ?_, ?_⟩
  · change (moved g y).getLsbD (0 : R).val = false
    rw [movedBit, h0]; exact hi
  · rw [← htfin, movedBit, h1]; exact hj
  · rw [← hL]
    apply maskEq
    intro r h
    obtain ⟨hs',hl⟩ := nearL i j r ne h
    let a := row g r
