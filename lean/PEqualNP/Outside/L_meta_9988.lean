def fooled (a b : ℕ) : Bool := (ent (a / 21) (b % 21) != cB) || (ent (b / 21) (a % 21) != cB)

def pw : List ℕ → Bool
  | [] => true
  | a :: S => S.all (fun b => a != b && fooled a b) && pw S

-- chkT t U d os: the sibling chain t answers the rectangles os in order; the answer to K shows that
-- the entries of U outside K need more than d rectangles.
def chkT : Cert → ℕ → ℕ → List (ℕ × ℕ × ℕ) → Bool
  | .nil, _, _, os => os.isEmpty
  | .node lab fc ns, U, d, os =>
    match os with
    | [] => false
    | K :: os' =>
      (match lab with
        | 0 :: S => decide (d < S.length) && S.all (fun s => (U ^^^ (U &&& K.2.2)).testBit s) && pw S
        | 1 :: x :: _ => decide (0 < d) && (U ^^^ (U &&& K.2.2)).testBit x &&
            chkT fc (U ^^^ (U &&& K.2.2)) (d - 1) (T.filter (fun K' => K'.2.2.testBit x))
        | _ => false) && chkT ns U d os'

-- Checks on the data, by evaluation.
def okRows : Bool := T.all (fun K => (List.range 21).all (fun i =>
  K.2.1.testBit i == (List.range 21).all (fun j => !K.1.testBit j || ent i j == cB)))
def okEnt : Bool := T.all (fun K => (List.range 21).all (fun i => (List.range 21).all (fun j =>
  K.2.2.testBit (i * 21 + j) == (K.2.1.testBit i && K.1.testBit j))))
def okClos : Bool := (T.map Prod.fst).contains (2 ^ 21 - 1) &&
  T.all (fun K => (List.range 21).all (fun i => (T.map Prod.fst).contains (K.1 &&& Z i)))
def okAll : Bool := decide (ALL < 2 ^ (21 * 21)) &&
  (List.range 21).all (fun i => (List.range 21).all (fun j => !ALL.testBit (i * 21 + j) || ent i j == cB))

theorem okRows_t : okRows = true := by decide +kernel
theorem okEnt_t : okEnt = true := by decide +kernel
theorem okClos_t : okClos = true := by decide +kernel
theorem okAll_t : okAll = true := by decide +kernel
theorem chk_t : chkT cert ALL 12 [(0, 0, 0)] = true := by decide +kernel

abbrev Rect := Finset (Fin 21) × Finset (Fin 21)

def AllC (L : List Rect) : Prop := ∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, ent i.val j.val = cB

def CovBy (U : ℕ) (L : List Rect) : Prop :=
  ∀ i j : Fin 21, U.testBit (i.val * 21 + j.val) = true → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2

def Small (U : ℕ) : Prop := ∀ s, U.testBit s = true → s < 21 * 21

theorem split (s : ℕ) (hs : s < 21 * 21) :
    s / 21 < 21 ∧ s % 21 < 21 ∧ s / 21 * 21 + s % 21 = s := by
  refine ⟨by omega, by omega, by omega⟩

theorem fin_split (i j : Fin 21) :
    (i.val * 21 + j.val) / 21 = i.val ∧ (i.val * 21 + j.val) % 21 = j.val := by
  have := i.isLt; have := j.isLt; constructor <;> omega

-- Every rectangle of colour c lies in a maximal one of T.
theorem intent_exists (R : Finset (Fin 21)) :
    ∃ K ∈ T, ∀ j : Fin 21, K.1.testBit j.val = true ↔ ∀ i ∈ R, ent i.val j.val = cB := by
  have hc := okClos_t
  simp only [okClos, Bool.and_eq_true, List.contains_iff_mem, List.all_eq_true, List.mem_range,
    List.mem_map] at hc
  obtain ⟨⟨K0, hK0, hK0f⟩, hcl⟩ := hc
  induction R using Finset.induction_on with
  | empty =>
    refine ⟨K0, hK0, fun j => ?_⟩
    rw [hK0f, Nat.testBit_two_pow_sub_one]
    simp [j.isLt]
  | insert a R ha ih =>
    obtain ⟨K, hK, hKb⟩ := ih
    obtain ⟨K', hK', hK'f⟩ := hcl K hK a.val a.isLt
    refine ⟨K', hK', fun j => ?_⟩
    rw [hK'f, Nat.testBit_land, Z_bit _ _ j.isLt, Bool.and_eq_true, hKb, Finset.forall_mem_insert,
      beq_iff_eq]
    exact and_comm

theorem rect_in (r : Rect) (hr : ∀ i ∈ r.1, ∀ j ∈ r.2, ent i.val j.val = cB) :
    ∃ K ∈ T, ∀ i ∈ r.1, ∀ j ∈ r.2, K.2.2.testBit (i.val * 21 + j.val) = true := by
  obtain ⟨K, hK, hKb⟩ := intent_exists r.1
  refine ⟨K, hK, fun i hi j hj => ?_⟩
  have he := okEnt_t
  have hr2 := okRows_t
  simp only [okEnt, okRows, List.all_eq_true, List.mem_range, beq_iff_eq] at he hr2
  rw [he K hK i.val i.isLt j.val j.isLt, Bool.and_eq_true]
  refine ⟨?_, (hKb j).mpr (fun i' hi' => hr i' hi' j hj)⟩
  rw [hr2 K hK i.val i.isLt, List.all_eq_true]
  intro j' hj'
  rw [List.mem_range] at hj'
  by_cases hb : K.1.testBit j' = true
  · have := (hKb ⟨j', hj'⟩).mp hb i hi
    simp [hb, this]
  · simp [hb]

theorem pw_pairwise : ∀ S : List ℕ, pw S = true → S.Pairwise (fun a b => a ≠ b ∧ fooled a b = true)
  | [], _ => List.Pairwise.nil
  | a :: S, h => by
    simp only [pw, Bool.and_eq_true, List.all_eq_true, bne_iff_ne, ne_eq] at h
    exact List.pairwise_cons.mpr ⟨fun b hb => h.1 b hb, pw_pairwise S h.2⟩

theorem fool_sound (S : List ℕ) (U : ℕ) (hU : Small U) (hS : ∀ s ∈ S, U.testBit s = true)
    (hp : pw S = true) (L : List Rect) (hL : AllC L) (hC : CovBy U L) : S.length ≤ L.length := by
  classical
  have hpw := pw_pairwise S hp
  have key : ∀ s ∈ S, ∃ r ∈ L, s / 21 ∈ r.1.image Fin.val ∧ s % 21 ∈ r.2.image Fin.val := by
    intro s hs
    obtain ⟨h1, h2, h3⟩ := split s (hU s (hS s hs))
    obtain ⟨r, hr, hi, hj⟩ := hC ⟨s / 21, h1⟩ ⟨s % 21, h2⟩ (by simpa [h3] using hS s hs)
    exact ⟨r, hr, Finset.mem_image.mpr ⟨_, hi, rfl⟩, Finset.mem_image.mpr ⟨_, hj, rfl⟩⟩
  choose! f hfL hf1 hf2 using key
  have hinj : Set.InjOn f (S.toFinset : Set ℕ) := by
    intro a ha b hb hab
    have ha' : a ∈ S := List.mem_toFinset.mp ha
    have hb' : b ∈ S := List.mem_toFinset.mp hb
    by_contra hne
    have hfo : fooled a b = true ∨ fooled b a = true := by
      let R' : ℕ → ℕ → Prop := fun x y => fooled x y = true ∨ fooled y x = true
      haveI : Std.Symm R' := ⟨fun x y h => Or.symm h⟩
      exact List.Pairwise.forall (R := R') (hpw.imp (fun h => Or.inl h.2)) ha' hb' hne
    obtain ⟨i1, hi1, ei1⟩ := Finset.mem_image.mp (hf1 a ha')
    obtain ⟨j1, hj1, ej1⟩ := Finset.mem_image.mp (hf2 a ha')
    obtain ⟨i2, hi2, ei2⟩ := Finset.mem_image.mp (hf1 b hb')
    obtain ⟨j2, hj2, ej2⟩ := Finset.mem_image.mp (hf2 b hb')
    rw [hab] at hi1 hj1
    have e1 := hL (f b) (hfL b hb') i1 hi1 j2 hj2
    have e2 := hL (f b) (hfL b hb') i2 hi2 j1 hj1
    rw [ei1, ej2] at e1
    rw [ei2, ej1] at e2
    rcases hfo with h | h <;> simp [fooled, e1, e2] at h
  calc S.length = S.toFinset.card := (List.toFinset_card_of_nodup (hpw.imp (fun h => h.1))).symm
    _ ≤ L.toFinset.card :=
        Finset.card_le_card_of_injOn f
          (fun s hs => List.mem_toFinset.mpr (hfL s (List.mem_toFinset.mp hs))) hinj
    _ ≤ L.length := List.toFinset_card_le L

theorem zip_find {α β : Type} {f : α × β → Bool} : ∀ {as : List α} {bs : List β},
    as.length = bs.length → (as.zip bs).all f = true → ∀ {a : α}, a ∈ as → ∃ b, f (a, b) = true
  | [], _, _, _, _, ha => by simp at ha
  | _ :: _, [], hl, _, _, _ => by simp at hl
  | a' :: as, b' :: bs, hl, h, a, ha => by
    simp only [List.zip_cons_cons, List.all_cons, Bool.and_eq_true] at h
    rcases List.mem_cons.mp ha with rfl | ha'
    · exact ⟨b', h.1⟩
    · exact zip_find (by simpa using hl) h.2 ha'

theorem sub_bit (U m s : ℕ) : (U ^^^ (U &&& m)).testBit s = (U.testBit s && !m.testBit s) := by
  rw [Nat.testBit_xor, Nat.testBit_land]
  cases U.testBit s <;> cases m.testBit s <;> rfl

theorem small_sub (U m : ℕ) (hU : Small U) : Small (U ^^^ (U &&& m)) :=
  fun s hs => hU s (by rw [sub_bit, Bool.and_eq_true] at hs; exact hs.1)

theorem sound : ∀ (t : Cert) (U d : ℕ) (os : List (ℕ × ℕ × ℕ)), chkT t U d os = true → Small U →
    ∀ K ∈ os, ∀ L : List Rect, AllC L → CovBy (U ^^^ (U &&& K.2.2)) L → d < L.length
  | .nil, U, d, os, h, _, K, hK, _, _, _ => by
    simp only [chkT, List.isEmpty_iff] at h
    subst h; simp at hK
  | .node _ _ _, _, _, [], h, _, _, _, _, _, _ => by simp [chkT] at h
  | .node lab fc ns, U, d, K0 :: os', h, hU, K, hK, L, hL, hC => by
    simp only [chkT, Bool.and_eq_true] at h
    obtain ⟨hl, hns⟩ := h
    rcases List.mem_cons.mp hK with rfl | hK'
    · have hU' := small_sub U K.2.2 hU
      split at hl
      · simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true] at hl
        have := fool_sound _ _ hU' hl.1.2 hl.2 L hL hC
        omega
      · rename_i x _
        simp only [Bool.and_eq_true, decide_eq_true_eq] at hl
        obtain ⟨⟨hd, hx⟩, hfc⟩ := hl
        obtain ⟨h1, h2, h3⟩ := split x (hU' x hx)
        obtain ⟨r, hr, hi, hj⟩ := hC ⟨x / 21, h1⟩ ⟨x % 21, h2⟩ (by simpa [h3] using hx)
        obtain ⟨K2, hK2, hK2r⟩ := rect_in r (hL r hr)
        have hK2x : K2.2.2.testBit x = true := by
          have := hK2r _ hi _ hj
          simpa [h3] using this
        have ih := sound fc _ (d - 1) _ hfc hU' K2 (List.mem_filter.mpr ⟨hK2, hK2x⟩)
          (L.erase r) (fun r' hr' => hL r' (List.mem_of_mem_erase hr')) (by
            intro i j hij
            rw [sub_bit, Bool.and_eq_true, Bool.not_eq_true'] at hij
            obtain ⟨r', hr', hi', hj'⟩ := hC i j hij.1
            refine ⟨r', ?_, hi', hj'⟩
            apply (List.mem_erase_of_ne _).mpr hr'
            rintro rfl
            have := hK2r i hi' j hj'
            rw [hij.2] at this
            exact absurd this (by decide))
        rw [List.length_erase_of_mem hr] at ih
        have : 0 < L.length := List.length_pos_of_mem hr
        omega
