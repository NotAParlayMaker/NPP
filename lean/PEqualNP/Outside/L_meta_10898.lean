def edgeFn (x : Fin 7 → Bool) : Bool := (x 0 && x 3) || (x 0 && x 4) || (x 3 && x 4) || (x 0 && x 5) || (x 1 && x 5) || (x 3 && x 5) || (x 4 && x 5) || (x 0 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 4 && x 6)

def listed (x : Fin 7 → Bool) : Bool := decide (∃ i < ([0, 3, 0, 4, 3, 4, 0, 5, 1, 5, 3, 5, 4, 5, 0, 6, 2, 6, 3, 6, 4, 6] : List ℕ).length / 2, (List.ofFn x).getD (([0, 3, 0, 4, 3, 4, 0, 5, 1, 5, 3, 5, 4, 5, 0, 6, 2, 6, 3, 6, 4, 6] : List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0, 3, 0, 4, 3, 4, 0, 5, 1, 5, 3, 5, 4, 5, 0, 6, 2, 6, 3, 6, 4, 6] : List ℕ).getD (2 * i + 1) 0) false = true)

theorem edge_eq : ∀ x : Fin 7→Bool, edgeFn x = listed x := by decide +kernel

def gates11 : List Gate :=
  [⟨.or,[4,3]⟩,⟨.or,[7,0]⟩,⟨.or,[8,1]⟩,⟨.or,[8,2]⟩,
   ⟨.and,[3,4]⟩,⟨.and,[9,5]⟩,⟨.and,[0,7]⟩,⟨.and,[10,6]⟩,
   ⟨.or,[11,12]⟩,⟨.or,[13,14]⟩,⟨.or,[15,16]⟩]

theorem gates11_types : ∀ g ∈ gates11, (g.op=.and ∨ g.op=.or) ∧ g.inputs.length≤2 := by
  intro g hg
  simp only [gates11,List.mem_cons,List.not_mem_nil,or_false] at hg
  rcases hg with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> simp

theorem gates11_correct : ∀ x : Fin 7→Bool,
    Circuit.eval ⟨gates11,17⟩ (List.ofFn x)=listed x := by decide +kernel

