def graph10898 (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 3) || (x 0 && x 4) || (x 3 && x 4) || (x 0 && x 5) ||
    (x 1 && x 5) || (x 3 && x 5) || (x 4 && x 5) ||
    (x 0 && x 6) || (x 2 && x 6) || (x 3 && x 6) || (x 4 && x 6)

def testInput (vertices : List ℕ) (i : Fin 7) : Bool := vertices.contains i.val

private theorem raw_reader {n : ℕ} {C : Circuit} (back : ReadsBack n C)
    {p : ℕ} (out : C.output≠p) {x z : List Bool} (hx : x.length=n) (hz : z.length=n)
    (same : ∀ i<n, i≠p → x.getD i false=z.getD i false)
    (different : C.eval x≠C.eval z) :
    ∃ j<C.gates.length, p∈(gateAt C j).inputs := by
  by_contra none
  have values (u : ℕ) : u≠p → val C x u=val C z u := by
    induction u using Nat.strong_induction_on with
    | _ u ih =>
      intro ne
      by_cases raw : u<n
      · rw [val_input hx raw,val_input hz raw,same u raw ne]
      by_cases past : n+C.gates.length≤u
      · rw [val_ge hx past,val_ge hz past]
      obtain ⟨j,rfl⟩ : ∃ j,u=n+j := ⟨u-n,by omega⟩
      have jl : j<C.gates.length := by omega
      rw [val_gate hx jl,val_gate hz jl]
      congr 1
      apply List.map_congr_left
      intro i hi
      have lt := back j jl i hi
      rw [ite_eq_left lt,ite_eq_left lt]
      exact ih i lt (fun eq => none ⟨j,jl,eq ▸ hi⟩)
  exact different (values C.output out)

private theorem pin_update (x : Fin 7 → Bool) :
    pinRow 7 1 false (List.ofFn x) = List.ofFn (Function.update x (1 : Fin 7) false) := by
  unfold pinRow
  apply congrArg List.ofFn
  funext i
  have get : (List.ofFn x).getD i.val false=x i := by
    rw [List.getD_eq_getElem _ _ (by simpa using i.isLt),List.getElem_ofFn]
  by_cases h : i=1
  · subst i
    simp
  · have hv : i.val≠1 := fun e => h (Fin.ext e)
    rw [ite_eq_right hv, get, Function.update_of_ne h]

def quotient : Fin 7 → Fin 5 := ![0,0,4,1,2,4,3]

theorem quotient_computes :
    (fun x : Fin 5 → Bool => graph10898 (Function.update (x ∘ quotient) (1 : Fin 7) false)) =
      PEqualNP.Outside.L_meta_10898_aux.K5.T25 := by
  funext x
  revert x
  decide +kernel

theorem lower11 (t : ℕ) (has : HasCircuitSize 7 graph10898 t) : 11≤t := by
  obtain ⟨C,fanC,smallC,compC⟩ := has
  have varying : ∃ x z : List Bool, x.length=7 ∧ z.length=7 ∧ C.eval x ≠ C.eval z := by
    refine ⟨List.ofFn (testInput []),List.ofFn (testInput [0,3]),by simp,by simp,?_⟩
    rw [compC,compC]
    decide
  obtain ⟨D,fanD,backD,properD,smallD,_,compD⟩ := Normalization.normalize_any fanC varying
  have value (x : Fin 7 → Bool) : D.eval (List.ofFn x)=graph10898 x :=
    (compD _ (by simp)).trans (compC x)
  have out : D.output≠1 := by
    intro h
    have e := value (testInput [1])
    change val D (List.ofFn (testInput [1])) D.output = graph10898 (testInput [1]) at e
    rw [h,val_input (n := 7) (by simp) (by decide)] at e
    exact (by decide : (List.ofFn (testInput [1])).getD 1 false ≠ graph10898 (testInput [1])) e
  have changeAt1 : ∃ j<D.gates.length, 1∈(gateAt D j).inputs := by
    apply raw_reader backD out
      (x := List.ofFn (testInput [5])) (z := List.ofFn (testInput [1,5])) (by simp) (by simp)
    · decide +kernel
    · rw [value,value]
      decide
  have readers : 0<(D.gates.filter fun g => g.inputs.contains 1).length := by
    obtain ⟨j,hj,mem⟩ := changeAt1
    have h : gateAt D j ∈ (D.gates.filter fun g => g.inputs.contains 1) :=
      List.mem_filter.mpr ⟨gateAt_mem hj,List.contains_iff_mem.mpr mem⟩
    exact List.length_pos_of_mem h
  have pinVaries : ∃ x z : List Bool, x.length=7 ∧ z.length=7 ∧
      D.eval (pinRow 7 1 false x) ≠ D.eval (pinRow 7 1 false z) := by
    refine ⟨List.ofFn (testInput []),List.ofFn (testInput [0,3]),by simp,by simp,?_⟩
    rw [pin_update,pin_update,value,value]
    decide
  obtain ⟨E,fanE,saves,pinned⟩ :=
    pin_saves_readers (by decide : 1<7) fanD properD false pinVaries
  have trimmed : HasCircuitSize 7 (fun x => graph10898 (Function.update x (1 : Fin 7) false)) (t-1) := by
    refine ⟨E,fanE,by omega,?_⟩
    intro x
    rw [pinned _ (by simp),pin_update,value]
  have base := PEqualNP.Outside.L_meta_10898_aux.Identification.Relabel.relabel_size quotient _ (t-1) trimmed
  change HasCircuitSize 5
    (fun x : Fin 5 → Bool => graph10898 (Function.update (x ∘ quotient) (1 : Fin 7) false)) (t-1) at base
  rw [quotient_computes] at base
  have bound := PEqualNP.Outside.L_meta_10898_aux.K5.main (t-1) base
  omega


end PEqualNP.Outside.L_meta_10898_aux

