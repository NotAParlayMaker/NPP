import Mathlib
import PEqualNP.Defs

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Defs.LratEncoding

theorem PEqualNP.Outside.R_meta_582_582
    (sat :
      let yes : List ℕ := [129, 257, 1025, 130, 514, 8194, 260, 4100, 8196, 136, 2056, 4104, 1040, 2064, 8208, 544, 1056, 4128, 320, 576, 2112]
      FormulaSat (enc2 14 26 (fun r => yes.any fun e => e &&& r == e)
        [129, 257, 1025, 130, 514, 8194, 260, 4100, 8196, 136, 2056, 4104, 1040, 2064, 8208, 544, 1056, 4128, 320, 576, 2112, 127, 244, 314, 432, 541, 660, 792, 1102, 1220, 1290, 1548, 2087, 2212, 2338, 2565, 3078, 3716, 4179, 4304, 4370, 4625, 5008, 5186, 6147, 7426, 8297, 8416, 8488, 8713, 9288, 9992, 10273, 10656, 12353, 13504, 14849, 16256]))
    (decode : ∀ (n s : ℕ) (g : ℕ → Bool) (rows : List ℕ),
      FormulaSat (enc2 n s g rows) →
      ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧
        ∀ r ∈ rows, C.eval (List.ofFn (fun i : Fin n => r.testBit i.val)) = g r)
    (boundary :
      let yes : List ℕ := [129, 257, 1025, 130, 514, 8194, 260, 4100, 8196, 136, 2056, 4104, 1040, 2064, 8208, 544, 1056, 4128, 320, 576, 2112]
      let rows : List ℕ := [129, 257, 1025, 130, 514, 8194, 260, 4100, 8196, 136, 2056, 4104, 1040, 2064, 8208, 544, 1056, 4128, 320, 576, 2112, 127, 244, 314, 432, 541, 660, 792, 1102, 1220, 1290, 1548, 2087, 2212, 2338, 2565, 3078, 3716, 4179, 4304, 4370, 4625, 5008, 5186, 6147, 7426, 8297, 8416, 8488, 8713, 9288, 9992, 10273, 10656, 12353, 13504, 14849, 16256]
      ∀ C : Circuit, Monotone2 C →
        (∀ r ∈ rows, C.eval (List.ofFn (fun i : Fin 14 => r.testBit i.val)) =
          (yes.any fun e => e &&& r == e)) →
        ∀ x : Fin 14 → Bool, C.eval (List.ofFn x) = true ↔
          ∃ u v : Fin 14,
            (([1408,8832,12544,6272,11264,5632,2816] : List ℕ).getD u.val 0).testBit v.val = true ∧
            x u = true ∧ x v = true) :
  ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ 26 ∧ (∀ x : Fin 14 → Bool, (C.eval (List.ofFn x) = true ↔ ∃ u v : Fin 14, (u.val, v.val) ∈ ([(0, 7), (0, 8), (0, 10), (1, 7), (1, 9), (1, 13), (2, 8), (2, 12), (2, 13), (3, 7), (3, 11), (3, 12), (4, 10), (4, 11), (4, 13), (5, 9), (5, 10), (5, 12), (6, 8), (6, 9), (6, 11)] : List (ℕ × ℕ)) ∧ x u = true ∧ x v = true)) := by
  obtain ⟨C, model, size, rows⟩ := decode 14 26
    (fun r => ([129, 257, 1025, 130, 514, 8194, 260, 4100, 8196, 136, 2056, 4104, 1040, 2064, 8208, 544, 1056, 4128, 320, 576, 2112] : List ℕ).any fun e => e &&& r == e)
    [129, 257, 1025, 130, 514, 8194, 260, 4100, 8196, 136, 2056, 4104, 1040, 2064, 8208, 544, 1056, 4128, 320, 576, 2112, 127, 244, 314, 432, 541, 660, 792, 1102, 1220, 1290, 1548, 2087, 2212, 2338, 2565, 3078, 3716, 4179, 4304, 4370, 4625, 5008, 5186, 6147, 7426, 8297, 8416, 8488, 8713, 9288, 9992, 10273, 10656, 12353, 13504, 14849, 16256] sat
  have incidence : ∀ u v : Fin 14,
      (([1408,8832,12544,6272,11264,5632,2816] : List ℕ).getD u.val 0).testBit v.val = true ↔
      (u.val,v.val) ∈ ([(0, 7), (0, 8), (0, 10), (1, 7), (1, 9), (1, 13), (2, 8),
        (2, 12), (2, 13), (3, 7), (3, 11), (3, 12), (4, 10), (4, 11), (4, 13), (5, 9),
        (5, 10), (5, 12), (6, 8), (6, 9), (6, 11)] : List (ℕ × ℕ)) := by decide +kernel
  refine ⟨C,model,size,?_⟩
  intro x
  simpa only [incidence] using boundary C model rows x
