def validOp (g : Gate) : Bool :=
  match g.op with
  | .and | .or => decide (g.inputs.length ≤ 2)
  | _ => false

theorem validLine (g : Gate) (h : g ∈ witness.gates) : validOp g = true :=
  List.all_eq_true.mp (by decide +kernel : witness.gates.all validOp = true) g h

theorem basis : FanInTwo witness := by
  intro g hg
  have h := validLine g hg
  rcases g with ⟨op, ins⟩
  cases op <;> simp_all [validOp]

def words (xs : List ℕ) : BitVec 1024 :=
