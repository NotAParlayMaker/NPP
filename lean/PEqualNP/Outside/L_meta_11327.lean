def rowsP : List Sig := [(0xa199f,0x88a),(0x146667,0x2224),(0x678079,0x268050),(0x7e0781,0x7e0500),(0x79f801,0x595000)]
theorem rowsP_sublists : rowsP.sublists.filter (fun ws => cuts ws == topP) = [rowsP] := by decide +kernel
theorem root_match : sameSet (rowsP.map (actS (G_pow[0]?.getD []))) (L7[0]?.getD ([], [])).1 = true := by decide +kernel

theorem no_build_7 : ¬ build basicOpsP goalP 7 rowsP.toFinset := by
  intro hb
  obtain ⟨s, hs, hl⟩ := compress hb
  let ws := rowsP.filter (· ∈ s)
  have hsub : ws.Sublist rowsP := List.filter_sublist
  have heq : ws.toFinset = s := by
    ext w
    simp only [ws, List.mem_toFinset, List.mem_filter, decide_eq_true_eq, and_iff_right_iff_imp]
    exact fun hw => List.mem_toFinset.mp (hs hw)
  have hcuts : cuts ws = topP := cuts_full (heq.symm ▸ hl)
  have hmem : ws ∈ rowsP.sublists.filter (fun zs => cuts zs == topP) :=
    List.mem_filter.mpr ⟨List.mem_sublists.mpr hsub, by simp [hcuts]⟩
  rw [rowsP_sublists, List.mem_singleton] at hmem
  have hs_eq : s = rowsP.toFinset := by rw [← heq, hmem]
  have hl_rows : live basicOpsP goalP 7 rowsP.toFinset := hs_eq ▸ hl
  have hrot := live_map (actS (G_pow[0]?.getD [])) (actS_inj 0 (by decide))
    (actS_goal 0 (by decide)) (actS_ops 0 (by decide)) hl_rows
  have himg : rowsP.toFinset.image (actS (G_pow[0]?.getD [])) =
      (rowsP.map (actS (G_pow[0]?.getD []))).toFinset := by
    ext u; simp [List.mem_map]
  rw [himg, sameSet_sound root_match] at hrot
  exact L7_sound 0 (by decide) hrot

-- 7-variable circuit compilation & x_1 = x_2 = false gate elimination (live_restrict)
abbrev W7 := BitVec 128
def ops7 (x y : W7) : List W7 := [x &&& y, x ||| y, x &&& ~~~y, y &&& ~~~x]
abbrev basicOps7 (a b : W7) : Finset W7 := (ops7 a b).toFinset

def pairsO : List ℕ := [121, 9, 9, 17, 17, 24, 24, 33, 33, 40, 40, 65, 65, 72, 72, 80, 80, 49, 56, 97, 104, 112, 112]
def pairsZ : List ℕ := [0, 1, 8, 1, 16, 8, 16, 1, 32, 8, 32, 1, 64, 8, 64, 16, 64, 48, 48, 96, 96, 48, 96]

def projN : List ℕ → W7 → ℕ
  | [], _ => 0
  | idx :: idxs, w => Nat.bit (w.getLsbD idx) (projN idxs w)

theorem projN_testBit : ∀ (idxs : List ℕ) (w : W7) (k : ℕ),
    (projN idxs w).testBit k = (idxs[k]?.map w.getLsbD).getD false
  | [], _, _ => by simp [projN]
  | idx :: idxs, w, 0 => by simp [projN]
  | idx :: idxs, w, k + 1 => by simp [projN, Nat.testBit_bit_succ, projN_testBit idxs w k]

def projB (idxs : List ℕ) (w : W7) : B := BitVec.ofNat 23 (projN idxs w)

theorem projB_getLsbD (idxs : List ℕ) (w : W7) (k : ℕ) (hk : k < 23) :
    (projB idxs w).getLsbD k = (idxs[k]?.map w.getLsbD).getD false := by
  unfold projB
  rw [BitVec.getLsbD_ofNat, decide_eq_true hk, Bool.true_and, projN_testBit]

theorem projB_and (idxs : List ℕ) (a b : W7) : projB idxs (a &&& b) = projB idxs a &&& projB idxs b := by
  apply BitVec.eq_of_getLsbD_eq; intro k hk
  rw [BitVec.getLsbD_and, projB_getLsbD _ _ k hk, projB_getLsbD _ _ k hk, projB_getLsbD _ _ k hk]
  cases idxs[k]? <;> simp [BitVec.getLsbD_and]

theorem projB_or (idxs : List ℕ) (a b : W7) : projB idxs (a ||| b) = projB idxs a ||| projB idxs b := by
  apply BitVec.eq_of_getLsbD_eq; intro k hk
  rw [BitVec.getLsbD_or, projB_getLsbD _ _ k hk, projB_getLsbD _ _ k hk, projB_getLsbD _ _ k hk]
  cases idxs[k]? <;> simp [BitVec.getLsbD_or]

theorem projB_not (idxs : List ℕ) (hlen : idxs.length = 23) (hlt : ∀ idx ∈ idxs, idx < 128) (a : W7) :
    projB idxs (~~~a) = ~~~projB idxs a := by
  apply BitVec.eq_of_getLsbD_eq; intro k hk
  rw [BitVec.getLsbD_not, projB_getLsbD _ _ k hk, projB_getLsbD _ _ k hk]
  have hk' : k < idxs.length := by omega
  rw [List.getElem?_eq_getElem hk']
  have hmem := hlt idxs[k] (List.getElem_mem hk')
  simp [hk, hmem]

theorem pairsO_spec : pairsO.length = 23 ∧ ∀ idx ∈ pairsO, idx < 128 := by decide
theorem pairsZ_spec : pairsZ.length = 23 ∧ ∀ idx ∈ pairsZ, idx < 128 := by decide

def restP (w : W7) : Sig := (projB pairsO w, projB pairsZ w)
def nrmP (u : Sig) : Sig := if u.2.getLsbD 0 then negP u else u
def projS (w : W7) : Sig := nrmP (restP w)

theorem nrmP_bit0 (u : Sig) : (nrmP u).2.getLsbD 0 = false := by
  unfold nrmP
  cases h : u.2.getLsbD 0
  · simp only [Bool.false_eq_true, ite_false, h]
  · simp only [ite_true, negP, BitVec.getLsbD_not, show (0 : ℕ) < 23 by decide, decide_true, Bool.true_and, h, Bool.not_true]

theorem projS_bit0 (w : W7) : (projS w).2.getLsbD 0 = false := nrmP_bit0 _

theorem projS_ne_one (w : W7) : projS w ≠ oneP := by
  intro h
  have := projS_bit0 w
  rw [h] at this
  exact Bool.noConfusion this

theorem nrmP_neg (u : Sig) : nrmP (negP u) = nrmP u := by
  unfold nrmP
  cases h : u.2.getLsbD 0
  · have h1 : (negP u).2.getLsbD 0 = true := by
      simp only [negP, BitVec.getLsbD_not, show (0 : ℕ) < 23 by decide, decide_true, Bool.true_and, h, Bool.not_false]
    rw [h1]
    simp only [ite_true, ite_false, Bool.false_eq_true, negP, BitVec.not_not]
  · have h1 : (negP u).2.getLsbD 0 = false := by
      simp only [negP, BitVec.getLsbD_not, show (0 : ℕ) < 23 by decide, decide_true, Bool.true_and, h, Bool.not_true]
    rw [h1]
    simp only [ite_true, ite_false, Bool.false_eq_true]

theorem restP_not (w : W7) : restP (~~~w) = negP (restP w) :=
  Prod.ext (projB_not pairsO pairsO_spec.1 pairsO_spec.2 w) (projB_not pairsZ pairsZ_spec.1 pairsZ_spec.2 w)

theorem projS_not (w : W7) : projS (~~~w) = projS w := by
  unfold projS; rw [restP_not, nrmP_neg]

theorem nrmP_ops (x y z : Sig) (hx : x.2.getLsbD 0 = false) (hy : y.2.getLsbD 0 = false)
    (hz : z ∈ opsP x y ∨ z ∈ opsP (negP x) y ∨ z ∈ opsP x (negP y) ∨ z ∈ opsP (negP x) (negP y)) :
    nrmP z ∈ opsP x y := by
  have h0 : (0 : ℕ) < 23 := by decide
  have nrm_of_false (u : Sig) (hu : u.2.getLsbD 0 = false) : nrmP u = u := by
    unfold nrmP; simp only [hu, Bool.false_eq_true, ite_false]
  have nrm_of_true (u : Sig) (hu : u.2.getLsbD 0 = true) : nrmP u = negP u := by
    unfold nrmP; simp only [hu, ite_true]
  have b_eq (u v : B) (h : ∀ i < 23, u.getLsbD i = v.getLsbD i) : u = v := BitVec.eq_of_getLsbD_eq h
  simp only [opsP, negP, List.mem_cons, List.not_mem_nil, or_false] at hz ⊢
  rcases hz with (rfl | rfl | rfl | rfl) | (rfl | rfl | rfl | rfl) | (rfl | rfl | rfl | rfl) | (rfl | rfl | rfl | rfl)
  · left; exact nrm_of_false _ (by simp only [BitVec.getLsbD_and, hx, hy, Bool.and_false])
  · right; left; exact nrm_of_false _ (by simp only [BitVec.getLsbD_or, hx, hy, Bool.or_false])
  · right; right; left; exact nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.false_and])
  · right; right; right; exact nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.false_and])
  · right; right; right
    rw [nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.and_false])]
    exact Prod.ext (BitVec.and_comm ..) (BitVec.and_comm ..)
  · right; right; left
    rw [nrm_of_true _ (by simp only [BitVec.getLsbD_or, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.not_false, Bool.true_or])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · right; left
    rw [nrm_of_true _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, hx, hy, Bool.not_false, Bool.and_true])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · left
    rw [nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.false_and])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · right; right; left
    exact nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.false_and])
  · right; right; right
    rw [nrm_of_true _ (by simp only [BitVec.getLsbD_or, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.not_false, Bool.or_true])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · left
    rw [nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.false_and])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · right; left
    rw [nrm_of_true _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, hx, hy, Bool.not_false, Bool.and_true])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · right; left
    rw [nrm_of_true _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, hx, hy, Bool.not_false, Bool.and_true])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · left
    rw [nrm_of_true _ (by simp only [BitVec.getLsbD_or, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.not_false, Bool.true_or])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [negP, BitVec.getLsbD_not, BitVec.getLsbD_or, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · right; right; right
    rw [nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.not_false, Bool.not_true, Bool.and_false])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)
  · right; right; left
    rw [nrm_of_false _ (by simp only [BitVec.getLsbD_and, BitVec.getLsbD_not, h0, decide_true, Bool.true_and, hx, hy, Bool.not_false, Bool.not_true, Bool.and_false])]
    exact Prod.ext (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.1.getLsbD i <;> cases y.1.getLsbD i <;> rfl)
                   (b_eq _ _ fun i hi => by simp only [BitVec.getLsbD_not, BitVec.getLsbD_and, hi, decide_true, Bool.true_and]; cases x.2.getLsbD i <;> cases y.2.getLsbD i <;> rfl)

theorem projS_ops (a b z : W7) (hz : z ∈ basicOps7 a b) : projS z ∈ opsP (projS a) (projS b) := by
  have hrest : restP z ∈ opsP (restP a) (restP b) := by
    simp only [basicOps7, ops7, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
    simp only [opsP, restP, List.mem_cons, List.not_mem_nil, or_false]
    rcases hz with rfl | rfl | rfl | rfl
    · left; exact Prod.ext (projB_and ..) (projB_and ..)
    · right; left; exact Prod.ext (projB_or ..) (projB_or ..)
    · right; right; left
      exact Prod.ext (by simp only [projB_and, projB_not pairsO pairsO_spec.1 pairsO_spec.2])
                     (by simp only [projB_and, projB_not pairsZ pairsZ_spec.1 pairsZ_spec.2])
    · right; right; right
      exact Prod.ext (by simp only [projB_and, projB_not pairsO pairsO_spec.1 pairsO_spec.2])
                     (by simp only [projB_and, projB_not pairsZ pairsZ_spec.1 pairsZ_spec.2])
  have hneg_neg (u : Sig) : negP (negP u) = u := Prod.ext (by simp [negP]) (by simp [negP])
  apply nrmP_ops (projS a) (projS b) (restP z) (projS_bit0 a) (projS_bit0 b)
  unfold projS nrmP
  cases ha : (restP a).2.getLsbD 0 <;> cases hb : (restP b).2.getLsbD 0 <;>
    simp only [ite_true, ite_false, Bool.false_eq_true, hneg_neg]
  · exact Or.inl hrest
  · exact Or.inr (Or.inr (Or.inl hrest))
  · exact Or.inr (Or.inl hrest)
  · exact Or.inr (Or.inr (Or.inr hrest))

theorem opsP_zero_left (y : Sig) : ∀ w ∈ opsP zeroP y, w = zeroP ∨ w = y := by
  intro w hw
  simp only [opsP, zeroP, List.mem_cons, List.not_mem_nil, or_false] at hw
  rcases hw with rfl | rfl | rfl | rfl
  · left; exact Prod.ext BitVec.zero_and BitVec.zero_and
  · right; exact Prod.ext BitVec.zero_or BitVec.zero_or
  · left; exact Prod.ext BitVec.zero_and BitVec.zero_and
  · right
    exact Prod.ext
      (by change y.1 &&& ~~~(0 : B) = y.1; rw [show ~~~(0 : B) = BitVec.allOnes 23 from rfl, BitVec.and_allOnes])
      (by change y.2 &&& ~~~(0 : B) = y.2; rw [show ~~~(0 : B) = BitVec.allOnes 23 from rfl, BitVec.and_allOnes])

theorem opsP_zero_right (x : Sig) : ∀ w ∈ opsP x zeroP, w = zeroP ∨ w = x := by
  intro w hw
  simp only [opsP, zeroP, List.mem_cons, List.not_mem_nil, or_false] at hw
  rcases hw with rfl | rfl | rfl | rfl
  · left; exact Prod.ext BitVec.and_zero BitVec.and_zero
  · right; exact Prod.ext BitVec.or_zero BitVec.or_zero
  · right
    exact Prod.ext
      (by change x.1 &&& ~~~(0 : B) = x.1; rw [show ~~~(0 : B) = BitVec.allOnes 23 from rfl, BitVec.and_allOnes])
      (by change x.2 &&& ~~~(0 : B) = x.2; rw [show ~~~(0 : B) = BitVec.allOnes 23 from rfl, BitVec.and_allOnes])
  · left; exact Prod.ext BitVec.zero_and BitVec.zero_and

theorem opsP_self (x : Sig) : ∀ w ∈ opsP x x, w = zeroP ∨ w = x := by
  intro w hw
  simp only [opsP, List.mem_cons, List.not_mem_nil, or_false] at hw
  rcases hw with rfl | rfl | rfl | rfl
  · right; exact Prod.ext BitVec.and_self BitVec.and_self
  · right; exact Prod.ext BitVec.or_self BitVec.or_self
  · left; exact Prod.ext (BitVec.and_not_self x.1) (BitVec.and_not_self x.2)
  · left; exact Prod.ext (BitVec.and_not_self x.1) (BitVec.and_not_self x.2)

def zCount (s : Finset W7) : ℕ := (s.filter (fun w => projS w = zeroP)).card
def nonZeroImg (s : Finset W7) : Finset Sig := (s.image projS).erase zeroP

set_option maxRecDepth 100000 in
theorem live_restrict {g : W7} (hg : projS g = goalP) {k : ℕ} {s : Finset W7}
    (h : live basicOps7 g k s) :
    build basicOpsP goalP (k - zCount s) (nonZeroImg s) := by
  have hg_nz : goalP ≠ zeroP := by decide
  induction k generalizing s with
  | zero =>
    change s = {g} at h; subst h
    have hzc : zCount {g} = 0 := by
      unfold zCount; simp [hg, hg_nz]
    rw [hzc]
    change goalP ∈ nonZeroImg {g}
    simp [nonZeroImg, hg, hg_nz]
  | succ k ih =>
    have hsc := live_card h
    rcases h with skip | ⟨a, ha, b, hb, hab, z, hz, hout, rest, hs_eq, tail⟩
    · exact build_mono_k (by omega) (ih skip)
    · have htail := ih tail
      have hz_ops := projS_ops a b z hz
      have hsub_rest : nonZeroImg rest ⊆ nonZeroImg s := by
        intro u hu
        simp only [nonZeroImg, Finset.mem_erase, Finset.mem_image] at hu ⊢
        obtain ⟨hne, v, hv, rfl⟩ := hu
        exact ⟨hne, v, by rw [hs_eq]; simp [hv], rfl⟩
      have hcard_rest : zCount rest ≤ zCount (insert z rest) := by
        unfold zCount
        exact Finset.card_le_card (Finset.filter_subset_filter _ (Finset.subset_insert z rest))
      by_cases hza : projS a = zeroP
      · have hzb_or := opsP_zero_left (projS b) (projS z) (hza ▸ hz_ops)
        have hsub : nonZeroImg (insert z rest) ⊆ nonZeroImg s := by
          intro u hu
          simp only [nonZeroImg, Finset.mem_erase, Finset.mem_image, Finset.mem_insert] at hu ⊢
          obtain ⟨hne, v, rfl | hv, rfl⟩ := hu
          · rcases hzb_or with h0 | h1
            · exact (hne h0).elim
            · exact ⟨hne, b, hb, h1.symm⟩
          · exact ⟨hne, v, by rw [hs_eq]; simp [hv], rfl⟩
        have hm : zCount s ≤ zCount (insert z rest) + 1 := by
          by_cases hzb : projS b = zeroP
          · have hzz : projS z = zeroP := by rcases hzb_or with h0 | h1; exact h0; exact h1.trans hzb
            have hz_nr : z ∉ rest := fun hm => hout (by rw [hs_eq]; simp [hm])
            have h1 : zCount (insert z rest) = zCount rest + 1 := by
              unfold zCount
              rw [Finset.filter_insert, if_pos hzz, Finset.card_insert_of_notMem (by simp [hz_nr])]
            have h2 : zCount s ≤ zCount rest + 2 := by
              unfold zCount; rw [hs_eq, Finset.filter_insert, Finset.filter_insert, if_pos hzb, if_pos hza]
              have hc1 := Finset.card_insert_le a (insert b (rest.filter (fun w => projS w = zeroP)))
              have hc2 := Finset.card_insert_le b (rest.filter (fun w => projS w = zeroP))
              omega
            omega
          · have h2 : zCount s ≤ zCount rest + 1 := by
              unfold zCount; rw [hs_eq, Finset.filter_insert, Finset.filter_insert, if_neg hzb, if_pos hza]
              exact Finset.card_insert_le a (rest.filter (fun w => projS w = zeroP))
            omega
        exact build_mono_k (by omega) (build_mono_av hsub htail)
      · by_cases hzb : projS b = zeroP
        · have hza_or := opsP_zero_right (projS a) (projS z) (hzb ▸ hz_ops)
          have hsub : nonZeroImg (insert z rest) ⊆ nonZeroImg s := by
            intro u hu
            simp only [nonZeroImg, Finset.mem_erase, Finset.mem_image, Finset.mem_insert] at hu ⊢
            obtain ⟨hne, v, rfl | hv, rfl⟩ := hu
            · rcases hza_or with h0 | h1
              · exact (hne h0).elim
              · exact ⟨hne, a, ha, h1.symm⟩
            · exact ⟨hne, v, by rw [hs_eq]; simp [hv], rfl⟩
          have hm : zCount s ≤ zCount (insert z rest) + 1 := by
            have h2 : zCount s ≤ zCount rest + 1 := by
              unfold zCount; rw [hs_eq, Finset.filter_insert, Finset.filter_insert, if_pos hzb, if_neg hza]
              exact Finset.card_insert_le b (rest.filter (fun w => projS w = zeroP))
            omega
          exact build_mono_k (by omega) (build_mono_av hsub htail)
        · have hzc_eq : zCount s = zCount rest := by
            unfold zCount; rw [hs_eq, Finset.filter_insert, Finset.filter_insert, if_neg hzb, if_neg hza]
          have hzc_le : zCount s ≤ k := by
            have hsubf : insert a (insert b (s.filter (fun w => projS w = zeroP))) ⊆ s := by
              intro u hu
              rcases Finset.mem_insert.mp hu with rfl | hu
              · exact ha
              · rcases Finset.mem_insert.mp hu with rfl | hu
                · exact hb
                · exact (Finset.mem_filter.mp hu).1
            have han : a ∉ insert b (s.filter (fun w => projS w = zeroP)) := by
              simp [hab, hza]
            have hbn : b ∉ s.filter (fun w => projS w = zeroP) := by
              simp [hzb]
            have hle := Finset.card_le_card hsubf
            rw [Finset.card_insert_of_notMem han, Finset.card_insert_of_notMem hbn] at hle
            unfold zCount; omega
          by_cases hzz : projS z = zeroP
          · have hsub : nonZeroImg (insert z rest) ⊆ nonZeroImg s := by
              intro u hu
              simp only [nonZeroImg, Finset.mem_erase, Finset.mem_image, Finset.mem_insert] at hu ⊢
              obtain ⟨hne, v, rfl | hv, rfl⟩ := hu
              · exact (hne hzz).elim
              · exact ⟨hne, v, by rw [hs_eq]; simp [hv], rfl⟩
            exact build_mono_k (by omega) (build_mono_av hsub htail)
          · by_cases heqab : projS a = projS b
            · have hsame := opsP_self (projS a) (projS z) (heqab ▸ hz_ops)
              have hsub : nonZeroImg (insert z rest) ⊆ nonZeroImg s := by
                intro u hu
                simp only [nonZeroImg, Finset.mem_erase, Finset.mem_image, Finset.mem_insert] at hu ⊢
                obtain ⟨hne, v, rfl | hv, rfl⟩ := hu
                · rcases hsame with h0 | h1
                  · exact (hne h0).elim
                  · exact ⟨hne, a, ha, h1.symm⟩
                · exact ⟨hne, v, by rw [hs_eq]; simp [hv], rfl⟩
              exact build_mono_k (by omega) (build_mono_av hsub htail)
            · have hstep : build basicOpsP goalP ((k - zCount (insert z rest)) + 1) (nonZeroImg s) := by
                refine Or.inr ⟨projS a, ?_, projS b, ?_, heqab, projS z, ?_, ?_⟩
                · exact Finset.mem_erase.mpr ⟨hza, Finset.mem_image_of_mem projS ha⟩
                · exact Finset.mem_erase.mpr ⟨hzb, Finset.mem_image_of_mem projS hb⟩
                · simp only [basicOpsP, List.mem_toFinset, List.mem_filter, Bool.and_eq_true, bne_iff_ne]
                  exact ⟨hz_ops, hzz, projS_ne_one z⟩
                · apply build_mono_av _ htail
                  intro u hu
                  simp only [nonZeroImg, Finset.mem_erase, Finset.mem_image, Finset.mem_insert] at hu
                  obtain ⟨hne, v, rfl | hv, rfl⟩ := hu
                  · exact Finset.mem_insert_self _ _
                  · exact Finset.mem_insert_of_mem (hsub_rest (Finset.mem_erase.mpr ⟨hne, Finset.mem_image_of_mem projS hv⟩))
              exact build_mono_k (by omega) hstep

-- Circuit compilation on 128 inputs (adapted from L_meta_9136.lean)
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

def holds (av : Finset W7) (z : W7) : Prop :=
  z = 0 ∨ z = ~~~0 ∨ ∃ a ∈ av, z = a ∨ z = ~~~a

theorem holds_insert {av : Finset W7} {z a : W7} (h : holds av z) : holds (insert a av) z := by
  rcases h with h | h | ⟨u, hu, he⟩
  · exact .inl h
  · exact .inr (.inl h)
  · exact .inr (.inr ⟨u, Finset.mem_insert_of_mem hu, he⟩)

theorem holds_not {av : Finset W7} {z : W7} (h : holds av z) : holds av (~~~z) := by
  rcases h with rfl | rfl | ⟨a, ha, he⟩
  · exact .inr (.inl rfl)
  · exact .inl BitVec.not_not
  · rcases he with he | he <;> rw [he]
    · exact .inr (.inr ⟨a, ha, .inr rfl⟩)
    · exact .inr (.inr ⟨a, ha, .inl BitVec.not_not⟩)

def reachable (av : Finset W7) (z : W7) : Prop :=
  holds av z ∨ ∃ a ∈ av, ∃ b ∈ av, a ≠ b ∧ ∃ w ∈ basicOps7 a b, holds (insert w av) z

theorem reachable_not {av : Finset W7} {z : W7} (h : reachable av z) : reachable av (~~~z) := by
  rcases h with h | ⟨a, ha, b, hb, ne, w, hop, hw⟩
  · exact .inl (holds_not h)
  · exact .inr ⟨a, ha, b, hb, ne, w, hop, holds_not hw⟩

theorem and_reach {av : Finset W7} {x y : W7} (hx : holds av x) (hy : holds av y) :
    reachable av (x &&& y) := by
  have const : holds av (0 : W7) := .inl rfl
  have oldx := hx
  rcases hx with rfl | rfl | ⟨a, ha, ea⟩
  · rw [show (0 : W7) &&& y = 0 from BitVec.zero_and]; exact .inl const
  · change reachable av (BitVec.allOnes 128 &&& y)
    rw [BitVec.allOnes_and]; exact .inl hy
  rcases hy with rfl | rfl | ⟨b, hb, eb⟩
  · rw [show x &&& (0 : W7) = 0 from BitVec.and_zero]; exact .inl const
  · change reachable av (x &&& BitVec.allOnes 128)
    rw [BitVec.and_allOnes]; exact .inl oldx
  by_cases h : a = b
  · subst b
    rcases ea with ea | ea <;> rcases eb with eb | eb <;> rw [ea, eb] <;>
      simp only [BitVec.and_self, BitVec.and_not_self, BitVec.not_and_self] <;>
      first | exact .inl const | exact .inl (.inr (.inr ⟨a, ha, .inl rfl⟩)) |
        exact .inl (.inr (.inr ⟨a, ha, .inr rfl⟩))
  have add (w : W7) (hw : w ∈ basicOps7 a b) (z : W7) (hz : z = w ∨ z = ~~~w) :
      reachable av z :=
    .inr ⟨a, ha, b, hb, h, w, hw, .inr (.inr ⟨w, Finset.mem_insert_self .., hz⟩)⟩
  rcases ea with ea | ea <;> rcases eb with eb | eb <;> rw [ea, eb]
  · exact add _ (by simp [basicOps7, ops7] : a &&& b ∈ basicOps7 a b) _ (.inl rfl)
  · exact add _ (by simp [basicOps7, ops7] : a &&& ~~~b ∈ basicOps7 a b) _ (.inl rfl)
  · exact add _ (by simp [basicOps7, ops7] : b &&& ~~~a ∈ basicOps7 a b) _ (.inl (BitVec.and_comm ..))
  · exact add _ (by simp [basicOps7, ops7] : a ||| b ∈ basicOps7 a b) _ (.inr BitVec.not_or.symm)

theorem or_reach {av : Finset W7} {x y : W7} (hx : holds av x) (hy : holds av y) :
    reachable av (x ||| y) := by
  simpa only [BitVec.not_and, BitVec.not_not] using reachable_not (and_reach (holds_not hx) (holds_not hy))

private def bit7 (k : Fin 128) (z : W7) : Bool := z[k.val]
private def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

private theorem read_bit7 (w : List W7) (i : ℕ) (k : Fin 128) :
    (w.map (bit7 k)).getD i false = bit7 k (w.getD i 0) := by
  by_cases h : i < w.length
  · simp [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem h]
  · simp [List.getD_eq_getElem?_getD, List.getElem?_map,
      List.getElem?_eq_none (Nat.le_of_not_gt h), bit7]

def legal (g : Gate) : Prop := (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2

def action (w : List W7) (g : Gate) : W7 := match g.op with
  | .not => ~~~(g.inputs.head?.map (fun i => w.getD i 0)).getD 0
  | .and => (g.inputs.map fun i => w.getD i 0).foldr (· &&& ·) (~~~0)
  | .or => (g.inputs.map fun i => w.getD i 0).foldr (· ||| ·) 0
  | _ => 0

theorem action_spec (w : List W7) (g : Gate) (hg : legal g) (k : Fin 128) :
    step (w.map (bit7 k)) g = (w ++ [action w g]).map (bit7 k) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩ <;> simp at cap
  all_goals have bit0 : (0 : W7)[k.val] = false := by simp
  all_goals rcases hop with rfl | rfl | rfl <;>
    simp only [step, List.map_cons, List.map_nil, read_bit7, List.map_append] <;>
    simp only [action, GateOp.eval, List.foldr_cons, List.foldr_nil, List.head?_cons, List.head?_nil,
      List.headD_cons, List.headD_nil, Option.map_some, Option.map_none, Option.getD_some, Option.getD_none,
      List.all_cons, List.all_nil, List.any_cons, List.any_nil, List.map_cons, List.map_nil, id_eq,
      Bool.and_true, Bool.or_false, bit7, BitVec.getElem_and, BitVec.getElem_or, BitVec.getElem_not,
      bit0, Bool.not_false]

def isBinary (g : Gate) : Bool := match g.op with
  | .not => false
  | _ => true
def binaryCost (gs : List Gate) := (gs.filter isBinary).length

theorem available_read {av : Finset W7} {w : List W7} (hw : ∀ u ∈ w, holds av u) (i : ℕ) :
    holds av (w.getD i 0) := by
  by_cases h : i < w.length
  · exact hw _ (by simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h])
  · rw [List.getD_eq_default _ _ (Nat.le_of_not_gt h)]
    exact .inl rfl

theorem gate_reach (w : List W7) (av : Finset W7) (hw : ∀ u ∈ w, holds av u)
    (g : Gate) (hg : legal g) :
    if isBinary g then reachable av (action w g) else holds av (action w g) := by
  obtain ⟨op, args⟩ := g
  obtain ⟨hop, cap⟩ := hg
  change op = .and ∨ op = .or ∨ op = .not at hop
  change args.length ≤ 2 at cap
  rcases args with _ | ⟨i, _ | ⟨j, _ | ⟨u, tail⟩⟩⟩ <;> simp at cap
  all_goals rcases hop with rfl | rfl | rfl <;> simp only [isBinary, Bool.false_eq_true, ite_false, ite_true,
    action, List.head?_nil, List.head?_cons, List.map_nil, List.map_cons, List.foldr_nil, List.foldr_cons,
    Option.map_none, Option.map_some, Option.getD_none, Option.getD_some,
    show ∀ x : W7, x ||| (0 : W7) = x from fun x => BitVec.or_zero,
    show ∀ x : W7, x &&& ~~~0 = x from fun x => BitVec.and_allOnes]
  all_goals first
    | exact .inl (.inl rfl)
    | exact .inl (.inr (.inl rfl))
    | exact .inr (.inl rfl)
    | exact .inl (available_read hw _)
    | exact holds_not (available_read hw _)
    | exact and_reach (available_read hw _) (available_read hw _)
    | exact or_reach (available_read hw _) (available_read hw _)

def goal7 : W7 := 0xfffffffeffffffeefffefffeffaaaa00
def rows7 : List W7 := [0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa, 0xcccccccccccccccccccccccccccccccc, 0xf0f0f0f0f0f0f0f0f0f0f0f0f0f0f0f0, 0xff00ff00ff00ff00ff00ff00ff00ff00, 0xffff0000ffff0000ffff0000ffff0000, 0xffffffff00000000ffffffff00000000, 0xffffffffffffffff0000000000000000]

theorem compile (gs : List Gate) (out : ℕ) (hg : ∀ g ∈ gs, legal g)
    (w : List W7) (av : Finset W7) (hw : ∀ u ∈ w, holds av u)
    (he : ∀ k, (gs.foldl step (w.map (bit7 k))).getD out false = bit7 k goal7) :
    ∃ t, (t = goal7 ∨ t = ~~~goal7) ∧ build basicOps7 t (binaryCost gs) av := by
  induction gs generalizing w av with
  | nil =>
    have hv : w.getD out 0 = goal7 := by
      apply BitVec.eq_of_getElem_eq
      intro i hi
      simpa only [List.foldl_nil, read_bit7, bit7] using he ⟨i, hi⟩
    have h := hv ▸ available_read hw out
    rcases h with zero | ones | ⟨t, ht, eq | eq⟩
    · exact False.elim ((by decide : goal7 ≠ 0) zero)
    · exact False.elim ((by decide : goal7 ≠ ~~~0) ones)
    · exact ⟨t, .inl eq.symm, ht⟩
    · exact ⟨t, .inr (by simpa only [BitVec.not_not] using congrArg (fun w : W7 => ~~~w) eq.symm), ht⟩
  | cons g gs ih =>
    let z := action w g
    have stepOK := action_spec w g (hg g (by simp))
    have nextEval : ∀ k, (gs.foldl step ((w ++ [z]).map (bit7 k))).getD out false = bit7 k goal7 := by
      intro k; simpa only [List.foldl_cons, stepOK] using he k
    have tail := ih (fun t ht => hg t (by simp [ht])) (w ++ [z])
    have cont (A : Finset W7) (hold : ∀ u ∈ w, holds A u) (new : holds A z) :=
      tail A (by
        intro u hu
        rcases List.mem_append.mp hu with hu | hu
        · exact hold u hu
        · exact (List.mem_singleton.mp hu) ▸ new) nextEval
    have stepClass := gate_reach w av hw g (hg g (by simp))
    cases neg : isBinary g
    · simp only [neg, Bool.false_eq_true, ite_false] at stepClass
      simpa [binaryCost, neg] using cont av hw stepClass
    · simp only [neg, ite_true] at stepClass
      have len : binaryCost (g :: gs) = binaryCost gs + 1 := by simp [binaryCost, neg]
      rw [len]
      rcases stepClass with existing | ⟨a, ha, b, hb, ne, new, op, rep⟩
      · obtain ⟨t, ht, run⟩ := cont av hw existing
        exact ⟨t, ht, Or.inl run⟩
      · obtain ⟨t, ht, run⟩ := cont (insert new av) (fun u hu => holds_insert (hw u hu)) rep
        exact ⟨t, ht, Or.inr ⟨a, ha, b, hb, ne, new, op, run⟩⟩

def F (x : Fin 7 → Bool) : Bool := (x 0 && x 3) || (x 0 && x 4) || (x 3 && x 4) || (x 0 && x 5) || (x 1 && x 5) || (x 2 && x 5) || (x 3 && x 5) || (x 0 && x 6) || (x 1 && x 6) || (x 3 && x 6) || (x 4 && x 6)

theorem sample7_ok : ∀ k : Fin 128, F (fun i => (rows7.getD i.val 0)[k.val]) = goal7[k.val] := by decide +kernel
theorem projS_goal7 : projS goal7 = goalP := by decide +kernel
theorem projS_x1 : projS (rows7.getD 1 0) = zeroP := by decide +kernel
theorem projS_x2 : projS (rows7.getD 2 0) = zeroP := by decide +kernel
theorem x1_ne_x2 : rows7.getD 1 0 ≠ rows7.getD 2 0 := by decide
theorem projS_rows7_sub : rows7.all (fun w => projS w == zeroP || rowsP.contains (projS w)) = true := by decide +kernel
theorem x1_ess_only : rows7.all (fun w => w == rows7.getD 1 0 || w.getLsbD 32 == w.getLsbD 34) = true := by decide +kernel
theorem x2_ess_only : rows7.all (fun w => w == rows7.getD 2 0 || w.getLsbD 32 == w.getLsbD 36) = true := by decide +kernel
theorem goal7_diff_32_34 : goal7.getLsbD 32 ≠ goal7.getLsbD 34 := by decide
theorem goal7_diff_32_36 : goal7.getLsbD 32 ≠ goal7.getLsbD 36 := by decide

theorem ops7_diff (p q : ℕ) (hp : p < 128) (hq : q < 128) (a b z : W7) (hz : z ∈ basicOps7 a b)
    (hd : z.getLsbD p ≠ z.getLsbD q) : a.getLsbD p ≠ a.getLsbD q ∨ b.getLsbD p ≠ b.getLsbD q := by
  simp only [basicOps7, ops7, List.mem_toFinset, List.mem_cons, List.not_mem_nil, or_false] at hz
  by_contra! fail
  obtain ⟨ha, hb⟩ := fail
  apply hd
  rcases hz with rfl | rfl | rfl | rfl <;>
    simp only [BitVec.getLsbD_and, BitVec.getLsbD_or, BitVec.getLsbD_not,
      decide_eq_true hp, decide_eq_true hq, Bool.true_and, ha, hb]

theorem bound (gs : List Gate) (o : ℕ) (hg : ∀ g ∈ gs, legal g)
    (he : ∀ x : Fin 7 → Bool, Circuit.eval ⟨gs, o⟩ (List.ofFn x) = F x) :
    9 < binaryCost gs := by
  by_contra! low
  have init : ∀ u ∈ rows7, holds rows7.toFinset u := fun u hu =>
    .inr (.inr ⟨u, List.mem_toFinset.mpr hu, .inl rfl⟩)
  have evaluate (k : Fin 128) :
      (gs.foldl step (rows7.map (bit7 k))).getD o false = bit7 k goal7 := by
    let x (i : Fin 7) : Bool := bit7 k (rows7.getD i.val 0)
    have same : List.ofFn x = rows7.map (bit7 k) := by
      apply List.ext_getElem
      · simp [rows7]
      · intro i hi hj
