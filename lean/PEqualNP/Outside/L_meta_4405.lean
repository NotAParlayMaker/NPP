def signedOr (m : Nat) : List (Fin 9) → Sig
  | [] => zero
  | j::js => if m.testBit j.val then bin true (inputs.getD j.val zero) (signedOr m js)
    else signedOr m js
def maskWord (m : Nat) := signedOr m (List.finRange 9)
def bank (m : Nat) := inputs ++ [seed,maskWord m]
theorem bitSigned (m : Nat) (r : Row) (js : List (Fin 9)) :
    bit r (signedOr m js) = js.any (fun j => m.testBit j.val && sample r j) := by
  induction js with
  | nil => exact bit_zero _
  | cons j js ih =>
    cases h : m.testBit j.val <;> simp [signedOr,h,bit_bin,sample,ih]
theorem bankBits (m : Nat) (r : Row) :
    (bank m).map (bit r) = List.ofFn (sample r) ++
    [sample r 4 || sample r 6,(List.finRange 9).any (fun i => m.testBit i.val && sample r i)] := by
  rw [sampled]
  simp [bank,seed_table,maskWord,bitSigned]
theorem beginAt (C : Circuit) (m : Nat) (legal : PEqualNP.MetaComplexity.FanInTwo C)
    (computes : ∀ x : Fin 9 → Bool, C.eval (List.ofFn x ++ [x 4 || x 6,
      (List.finRange 9).any (fun i => m.testBit i.val && x i)]) = edge x) :
    ∃ k t S, k ≤ C.size ∧ Live graph k t S ∧ ∀ a ∈ S, a ∈ bank m := by
  have out : (execute C.gates (bank m)).getD C.output zero = graph := by
    apply BitVec.eq_of_getLsbD_eq
    intro j hj
    let r : Row := ⟨j,hj⟩
    change bit r _ = bit r graph
    rw [←b_read,execute_bits _ _ _ (fun g hg => (legal g hg).1),bankBits,edge_table]
    exact computes (sample r)
  have mem := get_rep (execute C.gates (bank m)) C.output
  rw [out] at mem
  exact extract C.gates (bank m) legal graph_proper (mem.resolve_right (fun n => n graph_proper))
