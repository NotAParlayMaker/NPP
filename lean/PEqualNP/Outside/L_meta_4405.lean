theorem witnessesChecked : masks.all (fun m =>
    checkEssential graph (bank m) (witnesses m) && (need m == required m)) = true := by decide +kernel
theorem need_present {m k t S} (hm : m ∈ masks) (h : Live graph k t S)
    (sub : ∀ a ∈ S, a ∈ bank m) : ∀ a ∈ required m, a ∈ S := by
  have hh := List.all_eq_true.mp witnessesChecked m hm
  change checkEssential graph (bank m) (witnesses m) && (need m == required m) = true at hh
  simp only [Bool.and_eq_true] at hh
  obtain ⟨hw,he⟩ := hh
  intro a ha
  have eq : need m = required m := beq_iff_eq.mp he
  rw [←eq] at ha
  obtain ⟨r,s,hd,hi⟩ := essential_ok hw a (List.mem_toFinset.mpr ha)
  exact raw_required h (bank m) a sub r s hd hi
theorem raw_present {k t S} (h : Live graph k t S) (sub : ∀ a ∈ S, a ∈ inputs) :
    S = inputs.toFinset := by
  have hw : checkEssential graph inputs (witnesses 0) = true := by decide +kernel
  have he : need 0 = inputs := by decide +kernel
  ext a
  rw [List.mem_toFinset]
  refine ⟨sub a,fun ha => ?_⟩
  rw [←he] at ha
  obtain ⟨r,s,hd,hi⟩ := essential_ok hw a (List.mem_toFinset.mpr ha)
  exact raw_required h inputs a sub r s hd hi
abbrev binaryMask (m : Nat) := m ∈ ([3,5,9,33,65,129,257,36,132] : List Nat)
def byOne (a : Sig) := (List.finRange 9).any (fun i => (List.finRange 9).any (fun j =>
  a == bin true (inputs.getD i.val zero) (inputs.getD j.val zero)))
theorem supplyOne {z k t S} (oneGate : byOne z = true) (run : Live graph k t S)
    (sub : ∀ a ∈ S, a ∈ inputs ++ [z]) (cap : k ≤ 13)
    (bare : Impossible graph 14 inputs.toFinset) : False := by
  obtain ⟨i,_,hi⟩ := List.any_eq_true.mp oneGate
  obtain ⟨j,_,hz⟩ := List.any_eq_true.mp hi
  have hz' := beq_iff_eq.mp hz
  have val := bin_rep true (get_rep inputs i.val) (get_rep inputs j.val)
  rw [←hz'] at val
  obtain ⟨kk,t',U,hk,run',hs⟩ := pull_gate run val sub
  exact bare kk t' (by omega) (raw_present run' hs ▸ run')
