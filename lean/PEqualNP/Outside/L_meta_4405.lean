def directTest (g : Forest) (m : Nat) (p : Bool × Bool) :=
  let ws := cutRoot m p.1 p.2
  match assignedRoot m p with
  | .inr i => indexedRoot g 13 i ws
  | .inl c => g.cols.contains c && decide ws.Nodup &&
      poolCut (subcube c.1 c.2.1) c.2.2.2.2 13 0 (varsX (rawMask g.mask c)) ws
theorem directTest_sound {g : Forest} {prior : Nat → Nat} (m : Nat) (p : Bool × Bool)
    (low : ∀ q, Lower (varsX q) (graphGoal q) (prior q))
    (geom : graphValid g prior = true) (tables : checkedTables g 13) (ok : directTest g m p = true) :
    Impossible (targetOf g) 13 (cutRoot m p.1 p.2).toFinset := by
  unfold directTest at ok
  cases hd : assignedRoot m p with
  | inr i =>
    simp only [hd] at ok
    exact root_index low geom tables (Nat.le_refl _) ok
  | inl c =>
    simp only [hd,Bool.and_eq_true,List.contains_eq_mem,decide_eq_true_eq] at ok
    simp only [graphValid,Bool.and_eq_true,List.all_eq_true,beq_iff_eq] at geom
    have slice := col_sound c prior low (geom.1.2 c ok.1.1)
    exact poolCut_sound slice [] rfl ok.1.2 ok.2
