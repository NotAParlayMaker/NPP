    · by_cases absent : m=65 ∧ rawSix ∉ S
      · have eq : S = (cutRoot m true false).toFinset := by
          ext a
          simp only [cutRoot,↓reduceIte,Bool.false_eq_true,List.append_assoc,List.nil_append,
            List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
          have er : rawSix ∉ inputs.erase rawSix := by decide +kernel
          have e : ∀ a, a ∈ inputs.erase rawSix ↔ a ∈ inputs ∧ a ≠ rawSix := by
            intro a
            by_cases ha : a=rawSix
            · subst a
              simp [er]
            · simp [List.mem_erase_of_ne ha,ha]
          rw [e]
          have hn' := hn a
          simp [required,absent.1,e] at hn'
          have hx := sub a
          simp [bank] at hx
          constructor
          · intro ha
            rcases hx ha with h | h | h
            · exact Or.inl ⟨h,fun eq => absent.2 (eq ▸ ha)⟩
            · exact Or.inr (Or.inl h)
            · exact Or.inr (Or.inr h)
          · rintro (h | h | h)
            · exact hn' h.1 h.2
            · exact h ▸ m1
            · exact h ▸ m2
        exact checks (true,false) (by simp [cuts,absent.1]) k t le (eq ▸ run)
      · have allRaw : ∀ a ∈ inputs, a ∈ S := by
          intro a ha
          by_cases he : m=65
          · by_cases e : a=rawSix
            · exact e ▸ Classical.byContradiction (fun h => absent ⟨he,h⟩)
            · apply hn
              simp only [required,he,↓reduceIte]
              exact (List.mem_erase_of_ne e).mpr ha
          · exact hn a (by simpa [required,he] using ha)
        have eq : S=(cutRoot m false false).toFinset := by
          ext a
          have hx := sub a
          simp [bank] at hx
          simp only [cutRoot,↓reduceIte,Bool.false_eq_true,List.append_assoc,List.nil_append,List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
          exact ⟨hx,fun h => h.elim (allRaw a) (fun hh => hh.elim (fun e=>e ▸ m1) (fun e=>e ▸ m2))⟩
        exact checks (false,false) (by simp [cuts]) k t le (eq ▸ run)
    · by_cases hb : binaryMask m
      · have test := List.all_eq_true.mp allOne m hm
