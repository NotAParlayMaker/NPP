    (if binaryMask m then [] else [(false,true)])
theorem reduceToSixteen {m k t S} (hm : m ∈ masks) (run : Live graph k t S)
    (sub : ∀ a ∈ S, a ∈ bank m) (le : k ≤ 13) (bare : Impossible graph 14 inputs.toFinset)
    (checks : ∀ p ∈ cuts m, Impossible graph 13 (cutRoot m p.1 p.2).toFinset) : False := by
