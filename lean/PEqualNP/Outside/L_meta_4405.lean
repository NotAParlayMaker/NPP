def assignedRoot (m : Nat) (p : Bool × Bool) : Sum ColumnInfo Nat :=
  if m=3 && p==(false,false) then .inr 4 else
  if m=5 && p==(false,false) then .inr 8 else
  if m=9 && p==(false,false) then .inr 5 else
  if m=33 && p==(false,false) then .inr 9 else
  if m=65 && p==(true,false) then .inr 2 else
  if m=129 && p==(false,false) then .inr 6 else
  if m=257 && p==(false,false) then .inr 7 else
  if m=36 && p==(false,false) then .inr 10 else
  if m=81 && p==(false,true) then .inr 0 else
  if m=84 && p==(false,true) then .inr 1 else
  if m=208 && p==(false,true) then .inr 3 else
