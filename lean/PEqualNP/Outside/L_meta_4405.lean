      · have h65 : m≠65 := by intro e;exact hb (e ▸ (by decide : binaryMask 65))
        have eq : S=(cutRoot m false true).toFinset := by
          ext a
          have hx := sub a
          simp [bank] at hx
          simp only [cutRoot,↓reduceIte,Bool.false_eq_true,List.append_assoc,List.nil_append,List.mem_toFinset,List.mem_append,List.mem_cons,List.not_mem_nil,or_false]
