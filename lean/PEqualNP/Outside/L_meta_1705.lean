theorem xy_cases (x y : Fin 21 → Bool)
    (h : (Finset.univ.filter (fun p : Fin 21 => x p = true)).card +
      (Finset.univ.filter (fun l : Fin 21 => y l = true)).card ≤ 2) :
    ∃ a j, a < 43 ∧ j < 43 ∧
      (∀ p : Fin 21, x p = (decide (p.val = a) || decide (p.val = j))) ∧
      (∀ l : Fin 21, y l = (decide (21 + l.val = a) || decide (21 + l.val = j))) := by
  let U : Finset ℕ := (Finset.univ.filter (fun p : Fin 21 => x p = true)).image (fun p => p.val) ∪
    (Finset.univ.filter (fun l : Fin 21 => y l = true)).image (fun l => 21 + l.val)
  have hU : U.card ≤ 2 := by
    refine le_trans (Finset.card_union_le _ _) ?_
    exact le_trans (Nat.add_le_add Finset.card_image_le Finset.card_image_le) h
  have hmem : ∀ i, i ∈ U ↔ (∃ p : Fin 21, x p = true ∧ p.val = i) ∨
      (∃ l : Fin 21, y l = true ∧ 21 + l.val = i) := by
    intro i
    simp [U]
  have hb : ∀ i ∈ U, i < 42 := by
    intro i hi
    rcases (hmem i).1 hi with ⟨p, _, hp⟩ | ⟨l, _, hl⟩
    · have := p.isLt
      omega
    · have := l.isLt
      omega
  obtain ⟨a, j, ha, hj, haj⟩ := two_cases U hU hb
  refine ⟨a, j, ha, hj, ?_, ?_⟩
  · intro p
    have hp := p.isLt
    have h1 := haj p.val (by omega)
    rw [hmem] at h1
    rw [Bool.eq_iff_iff]
    simp only [Bool.or_eq_true, decide_eq_true_eq]
    rw [← h1]
    constructor
    · intro hx
      exact Or.inl ⟨p, hx, rfl⟩
    · rintro (⟨p', hx, hp'⟩ | ⟨l, _, hl⟩)
      · have : p' = p := Fin.ext hp'
        rw [← this]
        exact hx
      · omega
  · intro l
    have hl := l.isLt
    have h1 := haj (21 + l.val) (by omega)
    rw [hmem] at h1
    rw [Bool.eq_iff_iff]
    simp only [Bool.or_eq_true, decide_eq_true_eq]
    rw [← h1]
    constructor
    · intro hy
      exact Or.inr ⟨l, hy, rfl⟩
    · rintro (⟨p, _, hp'⟩ | ⟨l', hy, hl'⟩)
      · have := p.isLt
        omega
      · have : l' = l := Fin.ext (by omega)
        rw [← this]
        exact hy

theorem row_eq (x y : Fin 21 → Bool) (a j : ℕ) (ha : a < 43) (hj : j < 43)
    (hx : ∀ p : Fin 21, x p = (decide (p.val = a) || decide (p.val = j)))
    (hy : ∀ l : Fin 21, y l = (decide (21 + l.val = a) || decide (21 + l.val = j))) :
    List.ofFn x ++ List.ofFn y = litL.map (fun n => n.testBit (43 * a + j)) := by
  apply List.ext_getElem
  · simp [litL_len]
  · intro i h1 h2
    have hi : i < 42 := by simpa using h1
    have hl : i < litL.length := by rw [litL_len]; exact hi
    have e : litL.getD i 0 = litL[i] := by
      simp [List.getD_eq_getElem?_getD, hl]
    have hR : (litL.map (fun n => n.testBit (43 * a + j)))[i]'h2
        = (decide (i = a) || decide (i = j)) := by
      rw [List.getElem_map, ← e]
      exact lits i hi a ha j hj
    refine Eq.trans ?_ hR.symm
    by_cases h : i < 21
    · rw [List.getElem_append_left (by simpa using h), List.getElem_ofFn, hx]
    · have h' : i - 21 < 21 := by omega
      rw [List.getElem_append_right (by simpa using h), List.getElem_ofFn, hy]
      simp only [List.length_ofFn]
      have e2 : 21 + (i - 21) = i := by omega
      rw [e2]

theorem rhs_eq (x y : Fin 21 → Bool) (a j : ℕ)
    (hx : ∀ p : Fin 21, x p = (decide (p.val = a) || decide (p.val = j)))
    (hy : ∀ l : Fin 21, y l = (decide (21 + l.val = a) || decide (21 + l.val = j))) :
    decide (∃ p : Fin 21, ∃ l : Fin 21, ((p : ℕ), (l : ℕ)) ∈ incL ∧ x p = true ∧ y l = true)
      = expB a j := by
  rw [Bool.eq_iff_iff]
  simp only [decide_eq_true_eq, expB, List.any_eq_true]
  constructor
  · rintro ⟨p, l, hm, hxp, hyl⟩
    refine ⟨(p.val, l.val), hm, ?_⟩
    rw [hx] at hxp
    rw [hy] at hyl
    rw [Bool.and_eq_true]
    exact ⟨hxp, hyl⟩
  · rintro ⟨⟨p, l⟩, hm, hpl⟩
    obtain ⟨hp, hl⟩ := inc_range (p, l) hm
    rw [Bool.and_eq_true] at hpl
    refine ⟨⟨p, hp⟩, ⟨l, hl⟩, hm, ?_, ?_⟩
    · rw [hx]
      exact hpl.1
    · rw [hy]
      exact hpl.2

theorem main (x y : Fin 21 → Bool)
    (h : (Finset.univ.filter (fun p : Fin 21 => x p = true)).card +
      (Finset.univ.filter (fun l : Fin 21 => y l = true)).card ≤ 2) :
    Circuit.eval ⟨gatesL, 269⟩ (List.ofFn x ++ List.ofFn y)
      = decide (∃ p : Fin 21, ∃ l : Fin 21, ((p : ℕ), (l : ℕ)) ∈ incL ∧ x p = true ∧ y l = true) := by
  obtain ⟨a, j, ha, hj, hx, hy⟩ := xy_cases x y h
  have hr : 43 * a + j < 1849 := by omega
  rw [rhs_eq x y a j hx hy, row_eq x y a j ha hj hx hy,
    eval_link MK (43 * a + j) (MK_bit _ hr) gatesL gates_ao 269 litL]
  have hb := out_eq
  unfold outN at hb
  rw [hb]
  exact bits a ha j hj

