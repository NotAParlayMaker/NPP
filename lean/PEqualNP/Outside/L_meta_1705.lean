def isAO : GateOp → Bool
  | GateOp.and => true
  | GateOp.or => true
  | _ => false

def opN (M : ℕ) : GateOp → List ℕ → ℕ
  | GateOp.and, l => l.foldr (fun a b => a &&& b) M
  | GateOp.or, l => l.foldr (fun a b => a ||| b) 0
  | _, _ => 0

def wfN (M : ℕ) (gs : List Gate) (w : List ℕ) : List ℕ :=
  gs.foldl (fun w g => w ++ [opN M g.op (g.inputs.map fun i => w.getD i 0)]) w

theorem opN_bit (M j : ℕ) (hM : M.testBit j = true) (op : GateOp) (hop : isAO op = true)
    (l : List ℕ) : (opN M op l).testBit j = op.eval (l.map fun n => n.testBit j) := by
  cases op with
  | and =>
    induction l with
    | nil => simpa [opN, GateOp.eval] using hM
    | cons a l ih =>
      simp only [opN, GateOp.eval, List.foldr_cons, List.map_cons, List.all_cons, Nat.testBit_and,
        id] at ih ⊢
      rw [ih]
  | or =>
    induction l with
    | nil => simp [opN, GateOp.eval]
    | cons a l ih =>
      simp only [opN, GateOp.eval, List.foldr_cons, List.map_cons, List.any_cons, Nat.testBit_or,
        id] at ih ⊢
      rw [ih]
  | not => simp [isAO] at hop
  | mod m => simp [isAO] at hop
  | maj => simp [isAO] at hop

theorem getD_bit (w : List ℕ) (j i : ℕ) :
    (w.map fun n => n.testBit j).getD i false = (w.getD i 0).testBit j := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
  cases w[i]? <;> simp

theorem wfN_map (M j : ℕ) (hM : M.testBit j = true) (gs : List Gate)
    (hgs : ∀ g ∈ gs, isAO g.op = true) : ∀ w : List ℕ,
    (wfN M gs w).map (fun n => n.testBit j)
      = gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)])
          (w.map fun n => n.testBit j) := by
  induction gs with
  | nil => intro w; rfl
  | cons g gs ih =>
    intro w
    have h1 := ih (fun g' hg' => hgs g' (List.mem_cons_of_mem _ hg'))
      (w ++ [opN M g.op (g.inputs.map fun i => w.getD i 0)])
    have key : (g.inputs.map fun i => w.getD i 0).map (fun n => n.testBit j)
        = g.inputs.map fun i => (w.map fun n => n.testBit j).getD i false := by
      rw [List.map_map]
      apply List.map_congr_left
      intro i _
      exact (getD_bit w j i).symm
    simp only [wfN, List.foldl_cons] at h1 ⊢
    rw [h1, List.map_append, List.map_cons, List.map_nil,
      opN_bit M j hM g.op (hgs g List.mem_cons_self), key]

theorem eval_link (M j : ℕ) (hM : M.testBit j = true) (gs : List Gate)
    (hgs : ∀ g ∈ gs, isAO g.op = true) (o : ℕ) (W : List ℕ) :
    Circuit.eval ⟨gs, o⟩ (W.map fun n => n.testBit j) = ((wfN M gs W).getD o 0).testBit j := by
  rw [← getD_bit, wfN_map M j hM gs hgs W]
  rfl

