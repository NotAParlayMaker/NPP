  rw [Nat.testBit_two_pow_sub_one]
  simpa using hj

theorem two_cases (U : Finset ℕ) (hU : U.card ≤ 2) (hb : ∀ i ∈ U, i < 42) :
    ∃ a j, a < 43 ∧ j < 43 ∧ ∀ i, i < 42 → (i ∈ U ↔ i = a ∨ i = j) := by
