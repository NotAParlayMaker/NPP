private theorem tight_elim (n : ℕ) (gs : List Gate) : ∀ (acc : List Stat × List Gate),(∀ g ∈ gs,Ok g) → acc.1.length=n + acc.2.length → (∀ w < acc.1.length,acc.1.getD w (Stat.const false)=Stat.wire w) → (elim n gs acc).2.length=acc.2.length + gs.length → (elim n gs acc).2=acc.2 ++ gs.map normGate ∧ (∀ w < (elim n gs acc).1.length,(elim n gs acc).1.getD w (Stat.const false)=Stat.wire w):=by
 induction gs with
 | nil =>
  intro acc _ _ hid _
  exact ⟨by simp [elim],hid⟩
 | cons g gs ih =>
  intro acc hok hlen hid hfull
  have hstep_le : (elimStep n acc g).2.length ≤ acc.2.length + 1:=by
   simp only [elimStep,List.length_append];have:=toList_length_le (simplify g.op (n + acc.2.length) (g.inputs.map fun i=>acc.1.getD i (Stat.const false))).1;omega
  have hrest_le : (elim n gs (elimStep n acc g)).2.length ≤ (elimStep n acc g).2.length + gs.length :=
   elim_len n gs (elimStep n acc g)
  have heq_step : (elimStep n acc g).2.length=acc.2.length + 1:=by
   change (elim n gs (elimStep n acc g)).2.length=acc.2.length + (gs.length + 1) at hfull;omega
  have heq_rest : (elim n gs (elimStep n acc g)).2.length=(elimStep n acc g).2.length + gs.length:=by
   change (elim n gs (elimStep n acc g)).2.length=acc.2.length + (gs.length + 1) at hfull;omega
  have hsimp_some : ∃ g', (simplify g.op (n + acc.2.length) (g.inputs.map fun i=>acc.1.getD i (Stat.const false))).1=some g':=by
   cases ho : (simplify g.op (n + acc.2.length) (g.inputs.map fun i=>acc.1.getD i (Stat.const false))).1 with
   | none =>
    simp only [elimStep,ho,Option.toList_none,List.append_nil] at heq_step;omega
   | some g'=>exact ⟨g',rfl⟩
  obtain ⟨g',hg'⟩:=hsimp_some;have hokg : Ok g:=hok g List.mem_cons_self;have hgate_res : g'=normGate g ∧
   (simplify g.op (n + acc.2.length) (g.inputs.map fun i=>acc.1.getD i (Stat.const false))).2 =
    Stat.wire (n + acc.2.length):=by
   have hget : ∀ a,acc.1.getD a (Stat.const false) = if a < acc.1.length then Stat.wire a else Stat.const false:=by
    intro a
    by_cases ha : a < acc.1.length
    · rw [ite_eq_left_iff.2 (fun h=>(h ha).elim),hid a ha]
    · rw [ite_eq_right_iff.2 (fun h=>(ha h).elim),List.getD_eq_default _ _ (by omega)]
   have hop_cases : g.op=GateOp.and ∨ g.op=GateOp.or ∨ g.op=GateOp.not:=by simpa using hokg.1
   rcases hop_cases with hop | hop | hop
   · rcases hin : g.inputs with _ | ⟨a,_ | ⟨b,_ | ⟨c,l⟩⟩⟩
     · simp [simplify,simpAnd,hop,hin] at hg'
     · rw [hop,hin] at hg';simp only [List.map_cons,List.map_nil,simplify,simpAnd,hget] at hg'
       by_cases ha : a < acc.1.length <;> simp [ha] at hg'
     · rw [hop] at hg' ⊢;simp only [hin,List.map_cons,List.map_nil,simplify,simpAnd,hget] at hg' ⊢
       by_cases ha : a < acc.1.length <;> by_cases hb : b < acc.1.length
       · simp only [ha,hb,↓reduceIte,Option.some.injEq] at hg' ⊢;refine ⟨?_,trivial⟩
         subst hg';cases g;simp_all [normGate]
       · simp [ha,hb] at hg'
       · simp [ha,hb] at hg'
       · simp [ha,hb] at hg'
     · have:=hokg.2;rw [hin] at this;simp at this
   · rcases hin : g.inputs with _ | ⟨a,_ | ⟨b,_ | ⟨c,l⟩⟩⟩
     · simp [simplify,simpOr,hop,hin] at hg'
     · rw [hop,hin] at hg';simp only [List.map_cons,List.map_nil,simplify,simpOr,hget] at hg'
       by_cases ha : a < acc.1.length <;> simp [ha] at hg'
     · rw [hop] at hg' ⊢;simp only [hin,List.map_cons,List.map_nil,simplify,simpOr,hget] at hg' ⊢
       by_cases ha : a < acc.1.length <;> by_cases hb : b < acc.1.length
       · simp only [ha,hb,↓reduceIte,Option.some.injEq] at hg' ⊢;refine ⟨?_,trivial⟩
         subst hg';cases g;simp_all [normGate]
       · simp [ha,hb] at hg'
       · simp [ha,hb] at hg'
       · simp [ha,hb] at hg'
     · have:=hokg.2;rw [hin] at this;simp at this
   · rcases hin : g.inputs with _ | ⟨a,rest⟩
     · simp [simplify,simpNot,hop,hin] at hg'
     · rw [hop] at hg' ⊢;simp only [hin,List.map_cons,simplify,simpNot,hget] at hg' ⊢
       by_cases ha : a < acc.1.length
       · simp only [ha,↓reduceIte,Option.some.injEq] at hg' ⊢;refine ⟨?_,trivial⟩
         subst hg';cases g;simp_all [normGate]
       · simp [ha] at hg'
  have hstep_fst : (elimStep n acc g).1=acc.1 ++ [Stat.wire (n + acc.2.length)]:=by simp only [elimStep,hgate_res.2]
  have hstep_snd : (elimStep n acc g).2=acc.2 ++ [normGate g]:=by simp only [elimStep,hg',hgate_res.1,Option.toList_some]
  have hlen' : (elimStep n acc g).1.length=n + (elimStep n acc g).2.length:=by rw [hstep_fst,hstep_snd];simp;omega
  have hid' : ∀ w < (elimStep n acc g).1.length, (elimStep n acc g).1.getD w (Stat.const false)=Stat.wire w:=by
   intro w hw;rw [hstep_fst] at hw ⊢
   by_cases hwl : w < acc.1.length
   · rw [getD_snoc_ne _ _ _ _ (by omega)];exact hid w hwl
   · have hwe : w=acc.1.length:=by simp at hw;omega
     subst hwe;rw [getD_snoc_eq,hlen]
  obtain ⟨ih1,ih2⟩:=ih (elimStep n acc g) (fun g1 hg1=>hok g1 (List.mem_cons_of_mem _ hg1))
   hlen' hid' heq_rest
  refine ⟨?_,ih2⟩
  change (elim n gs (elimStep n acc g)).2=_;rw [ih1,hstep_snd,List.append_assoc,List.map_cons];rfl

theorem least_of_minimal (n : ℕ) (f : (Fin n → Bool) → Bool) (C : Circuit)
    (hnc : ∃ x y, f x ≠ f y) (fan : FanInTwo C) (eval : circuitFun n C = f)
    (lower : ∀ t, HasCircuitSize n f t → C.size ≤ t) :
    Least n f (C.gates.map normGate) C.output := by
  let acc := elim n C.gates (idStats n, [])
  have inv (y : Fin n → Bool) : Inv n (List.ofFn y) (wiresFrom C.gates (List.ofFn y)) acc :=
    inv_elim n _ (by simp) C.gates _ _ fan (inv_id n y)
  have value (y : Fin n → Bool) : (acc.1.getD C.output (.const false)).val (wiresFrom acc.2 (List.ofFn y)) = f y :=
    (((inv y).2 C.output).2).trans (congrFun eval y)
  have clean : CleanL n acc.2 := clean_elim n (List.ofFn fun _ : Fin n => false) (by simp)
    C.gates _ _ fan (inv_id n _) (by intro p g hp; simp at hp)
  cases sel : acc.1.getD C.output (.const false) with
  | const c =>
    obtain ⟨x,y,d⟩ := hnc
    exfalso; apply d; rw [← value x,← value y,sel]
    rfl
  | wire j =>
    have eqv : (fun y : Fin n → Bool => vl acc.2 y j) = f := by
      funext y; have h := value y; rw [sel] at h; exact h
    have ub := has_of_clean n acc.2 j clean
    rw [eqv] at ub
    have lo := lower _ ub
    change C.gates.length ≤ acc.2.length at lo
    have hi : acc.2.length ≤ C.gates.length := by simpa [acc] using elim_len n C.gates (idStats n,[])
    have identity (w : ℕ) (hw : w < (idStats n).length) :
        (idStats n).getD w (.const false) = .wire w := by
      simp only [idStats,List.length_ofFn] at hw; simp [idStats,hw]
    have mapEq := (tight_elim n C.gates (idStats n,[]) fan (by simp [idStats]) identity
      (by simpa [acc] using le_antisymm hi lo)).1
    have cgs : CleanL n (C.gates.map normGate) := by
      change acc.2 = [] ++ C.gates.map normGate at mapEq
      rw [List.nil_append] at mapEq
      rw [← mapEq]
      exact clean
    refine ⟨cgs, ?_, ?_⟩
    · intro x; unfold vl; rw [wiresFrom_norm]; exact congrFun eval x
    · intro gs o cl he
      have ub := has_of_clean n gs o cl
      rw [show (fun y => vl gs y o) = f from funext he] at ub
      simpa only [List.length_map,Circuit.size] using lower _ ub

end Norm4093

namespace NoOr4093
open PEqualNP.CircuitLowerBounds PublicReaders4093
open PublicReaders4093.Readers

theorem twoReads (gs : List Gate) (w : ℕ)
    (two : 2 ≤ (gs.filter fun g => g.inputs.contains w).length) :
    ∃ p q, p < q ∧ Reads gs p w ∧ Reads gs q w := by
  induction gs with
  | nil => simp at two
  | cons g gs ih =>
    by_cases hit : g.inputs.contains w = true
    · have pos : 0 < (gs.filter fun h => h.inputs.contains w).length := by
        simp only [List.filter_cons, hit, if_true, List.length_cons] at two
        omega
      obtain ⟨h, hh⟩ := List.length_pos_iff_exists_mem.mp pos
      obtain ⟨hm, hw⟩ := List.mem_filter.mp hh
      obtain ⟨j, hj⟩ := List.mem_iff_getElem?.mp hm
      exact ⟨0, j+1, by omega, ⟨g, rfl, by simpa using hit⟩,
        ⟨h, by simpa using hj, by simpa using hw⟩⟩
    · obtain ⟨p, q, lt, ⟨a, ha, hwa⟩, ⟨b, hb, hwb⟩⟩ := ih (by
        simpa only [List.filter_cons, if_neg hit] using two)
      exact ⟨p+1, q+1, by omega, ⟨a, by simpa using ha, hwa⟩, ⟨b, by simpa using hb, hwb⟩⟩

theorem noOr {n : ℕ} {f : (Fin (n+1) → Bool) → Bool} {gs : List Gate} {o : ℕ}
    (L : Least (n+1) f gs o) (i : Fin (n+1))
    (nc : ∃ x y, f (Function.update x i false) ≠ f (Function.update y i false))
    (two : 2 ≤ (gs.filter fun g => g.inputs.contains i.val).length)
    (noOR : ∀ g ∈ gs.filter (fun g => g.inputs.contains i.val), g.op ≠ .or) :
    Drop f i false 4 gs.length := by
  obtain ⟨p, q, lt, hp, hq⟩ := twoReads gs i two
  have fixed (r : ℕ) (hr : Reads gs r i) : IsC n gs i false (n+1+r) := by
    obtain ⟨g, hg, hi⟩ := hr
    have ng := noOR g (List.mem_filter.mpr ⟨List.mem_iff_getElem?.mpr ⟨r,hg⟩,by simpa using hi⟩)
    apply isC_reader L.hcl i r g hg hi false (Or.inr ?_)
    cases h : g.op <;> simp_all [fixBit]
  exact L.fourth i false nc p q lt.ne hp hq (fixed p hp) (fixed q hq)

end NoOr4093

namespace Multi4093
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PublicReaders4093
open PublicReaders4093.Readers

theorem two_indices {α : Type*} (raw : List α) (P : α → Bool) (k : ℕ)
    (h : 2 ≤ ((raw.drop k).filter P).length) :
    ∃ a b g t, k ≤ a ∧ a < b ∧ raw[a]? = some g ∧ P g = true ∧
      raw[b]? = some t ∧ P t = true := by
  have aux (l : List α) (h : 2 ≤ (l.filter P).length) :
      ∃ (a b : ℕ) (g t : α), a < b ∧ l[a]? = some g ∧ P g = true ∧ l[b]? = some t ∧ P t = true := by
    induction l with
    | nil => simp at h
    | cons g l ih =>
      by_cases hg : P g = true
      · have hpos : 0 < (l.filter P).length := by
          simp [List.filter_cons, hg] at h
          omega
        obtain ⟨t, ht⟩ := List.length_pos_iff_exists_mem.mp hpos
        obtain ⟨ht, hp⟩ := List.mem_filter.mp ht
        obtain ⟨b, hb⟩ := List.mem_iff_getElem?.mp ht
        exact ⟨0,b+1,g,t,by omega,rfl,hg,hb,hp⟩
      · have hl : 2 ≤ (l.filter P).length := by simpa [List.filter_cons, hg] using h
        obtain ⟨a,b,s,t,hab,ha,hs,hb,ht⟩ := ih hl
        exact ⟨a+1,b+1,s,t,by omega,ha,hs,hb,ht⟩
  obtain ⟨a,b,s,t,hab,ha,hs,hb,ht⟩ := aux _ h
  rw [List.getElem?_drop] at ha hb
  exact ⟨k+a,k+b,s,t,by omega,by omega,ha,hs,hb,ht⟩

theorem multi {n o : ℕ} {f : (Fin (n+1) → Bool) → Bool} {gs : List Gate}
    (L : Least (n+1) f gs o) (i : Fin (n+1))
    (hnc : ∃ x y, f (Function.update x i false) ≠ f (Function.update y i false))
    (p q : ℕ) (hpq : p ≠ q) (hp : Reads gs p i) (hq : Reads gs q i)
    (hc : IsC n gs i false (n+1+p))
    (u v : ℕ) (huv : u ≠ v) (hu : Reads gs u (n+1+p)) (hv : Reads gs v (n+1+p)) :
    Drop f i false 4 gs.length := by
  obtain ⟨x,y,hxy⟩ := hnc
  have fnc : ∃ x y, f x ≠ f y := ⟨_,_,hxy⟩
  have disjoint (j : ℕ) (hj : Reads gs j (n+1+p)) (r : ℕ) (hr : Reads gs r i) : r ≠ j := by
    rintro rfl
    exact L.no_tri fnc p r i hp hr hj
  exact L.save4 i false ⟨x,y,hxy⟩ p q u v hpq (disjoint u hu _ hp) (disjoint v hv _ hp)
    (disjoint u hu _ hq) (disjoint v hv _ hq) huv (rc_input false hp) (rc_input false hq)
    (rc_of_reads hu hc) (rc_of_reads hv hc)

def effective (g : Gate) : List ℕ := g.inputs.take (bif g.op.eval [false] then 1 else 2)

theorem rawMulti {n o : ℕ} {f : (Fin (n+1) → Bool) → Bool} {gs : List Gate}
    (L : Least (n+1) f gs o) (i : Fin (n+1))
    (hnc : ∃ x y, f (Function.update x i false) ≠ f (Function.update y i false))
    (raw : List Gate) (bridge : ∀ j g, raw[j]? = some g → ∀ w ∈ effective g, Reads gs j w)
    (p : ℕ) (hp : Reads gs p i) (hc : IsC n gs i false (n+1+p))
    (direct : 2 ≤ (raw.filter fun g => (effective g).contains i.val).length)
    (down : 2 ≤ ((raw.drop (p+1)).filter fun g => (effective g).contains (n+1+p)).length) :
    Drop f i false 4 gs.length := by
  obtain ⟨a,b,s,t,_,hab,ha,hs,hb,ht⟩ := two_indices raw (fun g => (effective g).contains i.val) 0
    (by simpa using direct)
  obtain ⟨u,v,g,h,_,huv,hu,hg,hv,hh⟩ := two_indices raw _ (p+1) down
  have other : ∃ q, p ≠ q ∧ Reads gs q i := by
    by_cases e : p = a
    · exact ⟨b,by omega,bridge b t hb i (List.contains_iff_mem.mp ht)⟩
    · exact ⟨a,e,bridge a s ha i (List.contains_iff_mem.mp hs)⟩
  obtain ⟨q,hpq,hq⟩ := other
  exact multi L i hnc p q hpq hp hq hc u v (by omega)
    (bridge u g hu _ (List.contains_iff_mem.mp hg))
    (bridge v h hv _ (List.contains_iff_mem.mp hh))

end Multi4093

namespace Chain4093
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PublicReaders4093 PublicReaders4093.Readers
variable {n o : ℕ} {gs : List Gate} {f : (Fin (n+1) → Bool) → Bool}
private theorem cleanOr (L : Least (n+1) f gs o) (i : Fin (n+1))
    (nc : ∃ x y, f (Function.update x i false) ≠ f (Function.update y i false))
    (q : ℕ) (g : Gate) (atq : gs[q]?=some g) (hop : g.op=.or) (hi : i.val ∈ g.inputs) : ¬ IsC n gs i false (n+1+q) := by
  rintro ⟨c,hc⟩
  have hnc : ∃ x y,f x≠f y := by obtain ⟨x,y,h⟩ := nc; exact ⟨_,_,h⟩
  have hq := (List.getElem?_eq_some_iff.mp atq).1
  have low (x : Fin (n+1) → Bool) (h : x i=false) : vl gs x (n+1+q)=c := by
    have e := restr_const L.hcl (f:=fun u => vl gs u (n+1+q)) (fun _ => rfl) i false c hc x
    rwa [Function.update_eq_self_iff.mpr h.symm] at e
  have high (x : Fin (n+1) → Bool) (h : x i=true) : vl gs x (n+1+q)=true := by
    rw [vl_gate gs L.hcl x q g atq,hop]; simp only [GateOp.eval,List.any_eq_true,List.mem_map]; exact ⟨true,⟨i,hi,(vl_input gs x i i.isLt).trans h⟩,rfl⟩
  cases c with
  | false => apply L.no_alias hnc q hq i (by omega); intro x; rw [vl_input gs x i i.isLt]; cases e : x i; exact low x e; exact high x e
  | true => apply L.no_const hnc q hq true; intro x; cases e : x i; exact low x e; exact high x e

theorem cascade (L : Least (n+1) f gs o) (i : Fin (n+1))
    (nc : ∃ x y, f (Function.update x i false) ≠ f (Function.update y i false))
    (p q r : ℕ) (g h k : Gate) (pg : gs[p]?=some g) (qh : gs[q]?=some h) (rk : gs[r]?=some k)
    (gp : g.op=.and) (hq : h.op=.or) (kr : k.op≠.or)
    (pi : i.val∈g.inputs) (qi : i.val∈h.inputs) (rp : n+1+p ∈ k.inputs) : Drop f i false 4 gs.length := by
  have hp : Reads gs p i := ⟨g,pg,pi⟩
  have hq' : Reads gs q i := ⟨h,qh,qi⟩
  have hr : Reads gs r (n+1+p) := ⟨k,rk,rp⟩
  have order : p<r := by have := reads_lt L.hcl hr; omega
  have neq : p≠q := by rintro rfl; rw [pg] at qh; cases qh; simp [gp] at hq
  have other : q≠r := by rintro rfl; rw [qh] at rk; cases rk; exact kr hq
  have pc := isC_reader L.hcl i p g pg pi false (Or.inr (by simp [fixBit,gp]))
  obtain ⟨b,bs⟩ := pc
  have z : b=false := by
    let x : Fin (n+1) → Bool := fun _ => false
    let y := Function.update x i false
    have val := restr_const L.hcl (f:=fun u => vl gs u (n+1+p)) (fun _ => rfl) i false b bs x
    have yy : vl gs y (n+1+p)=false := by
      rw [vl_gate gs L.hcl y p g pg,gp]; simp only [GateOp.eval,List.all_eq_false,List.mem_map]
      exact ⟨false,⟨i,pi,(vl_input gs y i i.isLt).trans (by simp [y])⟩,by decide⟩
    exact val.symm.trans yy
  subst b
  have rc := const_read n gs L.hcl i false r k rk (n+1+p) rp (by simpa [fixBit,kr] using bs)
  obtain ⟨s,rs,sr,sc⟩ := L.next i false nc r (reads_len hr) rc
  have sf : q≠s := by
    rintro rfl
    obtain ⟨u,uq,mem⟩ := sr
    rw [qh] at uq; cases uq
    apply cleanOr L i nc q h qh hq qi
    apply st_allconst n gs L.hcl i false q h qh
    have diff : i.val≠n+1+r := by omega
    rcases L.hcl q h qh with ⟨not,_,_,_⟩ | ⟨_,a,b,_,_,hin⟩
    · simp [hq] at not
    · rw [hin] at qi mem; simp at qi mem
      intro w hw; rw [hin] at hw; simp at hw
      have sides : w=i.val ∨ w=n+1+r := by rcases qi with q1|q1 <;> rcases mem with q2|q2 <;> rcases hw with u|u <;> omega
      rcases sides with e|e
      · exact e ▸ ⟨false,stF_self n gs i false⟩
      · exact e ▸ rc
  exact L.save4 i false nc p q r s neq (by omega) (by omega) other sf (by omega)
    (rc_input false hp) (rc_input false hq') (rc_of_reads hr ⟨false,bs⟩) sc
end Chain4093

namespace Graph4093
open PEqualNP.MetaComplexity.NestedCover

theorem nc {n} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (A : Finset (Fin n))
    (deg : ∀ v ∉ A, (G.neighborSet v).ncard=3) (marks : ∀ u v,G.Adj u v → u∉A)
    (edge : ∃ u v,G.Adj u v) (i : Fin n) : ∃ x y, graphFun G A (Function.update x i false) ≠ graphFun G A (Function.update y i false) := by
  have next (u : Fin n) (h : G.Adj u i) : ∃ v,G.Adj u v ∧ v≠i := by
    by_contra! no
    have sub : G.neighborSet u ⊆ ({i} : Set (Fin n)) := fun v hv => no v hv
    have le := Set.ncard_le_ncard sub
    rw [deg u (marks u i h),Set.ncard_singleton] at le; omega
  have survive : ∃ u v,G.Adj u v ∧ u≠i ∧ v≠i := by
    obtain ⟨u,v,h⟩ := edge
    by_cases hu : u=i
    · subst u; obtain ⟨w,hw,ne⟩ := next v h.symm; exact ⟨v,w,hw,h.ne.symm,ne⟩
    by_cases hv : v=i
    · subst v; obtain ⟨w,hw,ne⟩ := next u h; exact ⟨u,w,hw,hu,ne⟩
    exact ⟨u,v,h,hu,hv⟩
  obtain ⟨u,v,adj,hu,hv⟩ := survive
  let on : Fin n → Bool := fun _ => true
  let off : Fin n → Bool := fun _ => false
  have one : graphFun G A (Function.update on i false)=true := by
    rw [graphFun,Bool.or_eq_true]; right; apply decide_eq_true; exact ⟨u,v,adj,by simp [on,Function.update_of_ne hu],by simp [on,Function.update_of_ne hv]⟩
  have zero : graphFun G A (Function.update off i false)=false := by rw [Function.update_eq_self_iff.mpr (show false=off i from rfl)]; simp [graphFun,off]
  exact ⟨on,off,by rw [one,zero];decide⟩
end Graph4093

namespace Assemble4093
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.MetaComplexity.NestedCover PublicReaders4093 PublicReaders4093.Readers
private theorem normop (g : Gate) : (normGate g).op=g.op := by cases g with | mk op ins => cases op <;> rfl
private theorem normalized {g : Gate} (ok : Ok g) : (normGate g).inputs = Multi4093.effective g := by
  have ops : g.op=.and ∨ g.op=.or ∨ g.op=.not := by simpa using ok.1
  rcases ops with h|h|h <;> simp [normGate,Multi4093.effective,h,GateOp.eval,List.take_of_length_le ok.2]

theorem main (m : ℕ) (G : SimpleGraph (Fin m)) [DecidableRel G.Adj] (A : Finset (Fin m)) (C : Circuit)
    (deg : ∀ u ∉ A,(G.neighborSet u).ncard=3) (marks : ∀ u v,G.Adj u v → u∉A) (edge : ∃ u v,G.Adj u v)
    (fan : FanInTwo C) (eval : circuitFun m C=graphFun G A) (lower : ∀ t,HasCircuitSize m (graphFun G A) t → C.size≤t)
    (two : ∀ i ∉ A,2≤(C.gates.filter fun g => (Multi4093.effective g).contains i.val).length)
    (ex : ∃ i ∉ A, ∃ p g, C.gates[p]?=some g ∧ g.op=.and ∧ (Multi4093.effective g).contains i.val=true ∧
       ((∀ h ∈ C.gates.filter (fun t => (Multi4093.effective t).contains i.val), h.op≠.or) ∨
         2≤((C.gates.drop (p+1)).filter fun t => (Multi4093.effective t).contains (m+p)).length ∨
         ∃ k ∈ (C.gates.drop (p+1)).filter (fun t => (Multi4093.effective t).contains (m+p)),k.op≠.or)) :
    ∃ i ∉ A, Drop (graphFun G A) i false 4 C.size := by
  obtain ⟨i,un,p,g,pg,hand,read,pattern⟩ := ex
  obtain ⟨n,rfl⟩ : ∃ n,m=n+1 := ⟨m-1,by have := i.isLt; omega⟩
  let N := n+1
  let gs := C.gates.map normGate
  refine ⟨i,un,?_⟩
  have nc := Graph4093.nc G A deg marks edge i
  have fnc : ∃ x y,graphFun G A x≠graphFun G A y := by obtain ⟨x,y,ne⟩ := nc; exact ⟨_,_,ne⟩
  have L : Least N (graphFun G A) gs C.output := Norm4093.least_of_minimal N _ C fnc fan eval lower
  have atn (j : ℕ) (t : Gate) (ht : C.gates[j]?=some t) : gs[j]?=some (normGate t) := by simp [gs,List.getElem?_map,ht]
  have ok (t : Gate) (ht : t∈C.gates) : Ok t := fan t ht
  have nmem j t (ht : C.gates[j]?=some t) : (normGate t).inputs=Multi4093.effective t := normalized (ok t (List.mem_iff_getElem?.mpr ⟨j,ht⟩))
  have bridge j t (ht : C.gates[j]?=some t) (w : ℕ) (hw : w∈Multi4093.effective t) : Reads gs j w := ⟨_,atn j t ht,(nmem j t ht) ▸ hw⟩
  have pi := (List.contains_iff_mem.mp read)
  have pnorm : i.val∈(normGate g).inputs := (nmem p g pg) ▸ pi
  have ac := isC_reader L.hcl i p (normGate g) (atn p g pg) pnorm false (Or.inr (by simp [fixBit,normop,hand]))
  have done (h : Drop (graphFun G A) i false 4 gs.length) : Drop (graphFun G A) i false 4 C.size := by simpa [gs,Circuit.size] using h
  apply done
  by_cases no : ∀ h∈C.gates.filter (fun t => (Multi4093.effective t).contains i.val), h.op≠.or
  · have same : (gs.filter (fun t => t.inputs.contains i.val)) = (C.gates.filter (fun t => (Multi4093.effective t).contains i.val)).map normGate := by
      rw [show gs=C.gates.map normGate from rfl,List.filter_map]; apply congrArg (List.map normGate); apply List.filter_congr; intro t ht; simp [Function.comp,normalized (ok t ht)]
    apply NoOr4093.noOr L i nc (by rw [same,List.length_map];exact two i un)
    intro h hh; rw [same] at hh; obtain ⟨t,ht,rfl⟩ := List.mem_map.mp hh; rw [normop]; exact no t ht
  obtain ⟨h,hm,hor⟩ : ∃ h∈C.gates.filter (fun t => (Multi4093.effective t).contains i.val),h.op=.or := by push Not at no; exact no
  obtain ⟨hmem,hi⟩ := List.mem_filter.mp hm
  obtain ⟨q,qh⟩ := List.mem_iff_getElem?.mp hmem
  rcases pattern with all|multi|⟨k,hk,kn⟩
  · exact (all h hm hor).elim
  · exact Multi4093.rawMulti L i nc C.gates bridge p (bridge p g pg i pi) ac (two i un) multi
  · obtain ⟨km,kr⟩ := List.mem_filter.mp hk
    obtain ⟨r,rk⟩ := List.mem_iff_getElem?.mp km
    rw [List.getElem?_drop] at rk
    exact Chain4093.cascade L i nc p q (p+1+r) _ _ _ (atn p g pg) (atn q h qh) (atn _ k rk)
      ((normop g).trans hand) ((normop h).trans hor) (fun e => kn ((normop k).symm.trans e))
      pnorm ((nmem q h qh) ▸ List.contains_iff_mem.mp hi) ((nmem _ k rk) ▸ List.contains_iff_mem.mp kr)
end Assemble4093

