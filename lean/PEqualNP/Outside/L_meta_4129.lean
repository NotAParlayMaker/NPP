  change ∀ D : Finset (Sym2 Vertex),
    BitVec.ofNat 16 (PEqualNP.MetaComplexity.tableIndex
      (fun i : EdgeIndex => decide (edgeAt i ∈ D))) ∉ exceptionMasks →
    ∃ C Z : Finset Vertex,
      PEqualNP.MetaComplexity.NestedCover.IsMinCover (graph.deleteEdges (D : Set (Sym2 Vertex))) C ∧
      graph.IsVertexCover (Z : Set Vertex) ∧ C ⊆ Z ∧ Z.card = 7
  intro D hMask
  have hGood : removed D ∉ exceptions := by
    intro hBad
    have hmem : BitVec.ofNat 16 (mask (removed D)) ∈
