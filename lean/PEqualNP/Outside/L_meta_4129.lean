lemma boundaryCertificate :
    ∀ row ∈ boundaryData,
      (∀ C ∈ difficultCovers, missed C ⊆ edgeIndices row.1 → row.2.1 ≤ C.card) ∧
      ∀ i : EdgeIndex, addEdge row.1 i ∉ boundaryData.map Prod.fst →
        boundaryCodeWorks (addEdge row.1 i) row.2.1 (row.2.2.getD i.val (0, 0)) := by
  unfold boundaryCodeWorks codePairBase
  decide +kernel

lemma findBoundary (Q R : Finset EdgeIndex) (hQ : Q ∈ exceptions)
    (hR : R ∉ exceptions) (hs : Q ⊆ R) :
    ∃ B e, B ∈ exceptions ∧ Q ⊆ B ∧ insert e B ⊆ R ∧ insert e B ∉ exceptions := by
  have walk (A : Finset EdgeIndex) :
      Q ∪ A ∉ exceptions →
        ∃ B e, B ∈ exceptions ∧ Q ⊆ B ∧ insert e B ⊆ Q ∪ A ∧
          insert e B ∉ exceptions := by
    induction A using Finset.induction_on with
    | empty => simp [hQ]
    | @insert e A _ ih =>
        rw [Finset.union_insert]
        intro hok
        by_cases hb : Q ∪ A ∈ exceptions
        · exact ⟨Q ∪ A, e, hb, Finset.subset_union_left, fun _ h => h, hok⟩
        · obtain ⟨B, j, hB, hQB, hSub, hGood⟩ := ih hb
          exact ⟨B, j, hB, hQB, hSub.trans (Finset.subset_insert e _), hGood⟩
  have h := walk R
  rw [Finset.union_eq_right.mpr hs] at h
  exact h hR

lemma replaceCover (R : Finset EdgeIndex) (hR : R ∉ exceptions)
    (C : Finset Vertex) (hC : missed C ⊆ R) : ∃ p : ℕ × ℕ, pairWorks R C.card p := by
  rcases initialCertificate C with difficult | easy
  · obtain ⟨B, i, hB, hQB, hSub, hI⟩ := findBoundary (missed C) R (difficultMask C difficult) hR hC
    obtain ⟨row, hr, rfl⟩ := List.mem_map.mp hB
    have tested := boundaryCertificate row hr
    have hle := tested.1 C difficult hQB
    have hCode : addEdge row.1 i ∉ boundaryData.map Prod.fst := by
      intro hm
      obtain ⟨entry, he, hEq⟩ := List.mem_map.mp hm
      apply hI
      rw [← addEdgeIndices, ← hEq]
      exact List.mem_map.mpr ⟨entry, he, rfl⟩
    have pair := boundaryCodeSound _ _ _ (tested.2 i hCode)
    rw [addEdgeIndices] at pair
    exact ⟨_, pair.1.trans hle, pair.2.1, pair.2.2.1, pair.2.2.2.1.trans hSub, pair.2.2.2.2⟩
  · obtain ⟨p, hp⟩ := easy
    exact ⟨p, hp.1, hp.2.1, hp.2.2.1, hp.2.2.2.1.trans hC, hp.2.2.2.2⟩

