def exceptions : List (Finset EdgeIndex) := boundaryData.map fun row => edgeIndices row.1

lemma exceptionCodes :
    exceptions.map (fun s => BitVec.ofNat 16 (mask s)) = exceptionMasks := by
  decide +kernel

lemma edgesAdjacent : ∀ i : EdgeIndex, graph.Adj (endpoints i).1 (endpoints i).2 := by
  unfold graph
  decide +kernel

lemma adjacentListed :
    ∀ a b : Vertex, graph.Adj a b →
      ∃ i : EdgeIndex, endpoints i = (a, b) ∨ endpoints i = (b, a) := by
  unfold graph
  decide +kernel

lemma coverIff (D : Finset (Sym2 Vertex)) (C : Finset Vertex) :
    (graph.deleteEdges (D : Set (Sym2 Vertex))).IsVertexCover (C : Set Vertex) ↔
      missed C ⊆ removed D := by
  change (∀ a b : Vertex, (graph.deleteEdges (D : Set (Sym2 Vertex))).Adj a b →
    a ∈ C ∨ b ∈ C) ↔ missed C ⊆ removed D
  constructor
  · intro h i hi
    have hmiss := (Finset.mem_filter.mp hi).2
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ i, ?_⟩
    by_contra hnot
    have hadj : (graph.deleteEdges (D : Set (Sym2 Vertex))).Adj
        (endpoints i).1 (endpoints i).2 :=
      SimpleGraph.deleteEdges_adj.mpr ⟨edgesAdjacent i, hnot⟩
    exact (h _ _ hadj).elim hmiss.1 hmiss.2
  · intro h a b hab
    have kept : graph.Adj a b ∧ s(a, b) ∉ D := SimpleGraph.deleteEdges_adj.mp hab
    have hits (i : EdgeIndex) (hkeep : edgeAt i ∉ D) :
        (endpoints i).1 ∈ C ∨ (endpoints i).2 ∈ C := by
      by_contra hnot
      have hi : i ∈ missed C :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ i,
          fun hl => hnot (Or.inl hl), fun hr => hnot (Or.inr hr)⟩
      exact hkeep (Finset.mem_filter.mp (h hi)).2
    rcases adjacentListed a b kept.1 with ⟨i, hi | hi⟩
    · have hkeep : edgeAt i ∉ D := by simpa [edgeAt, hi] using kept.2
      simpa [hi] using hits i hkeep
    · have hkeep : edgeAt i ∉ D := by
        simpa only [edgeAt, hi, Prod.fst, Prod.snd, ← Sym2.eq_swap (a := a) (b := b)]
          using kept.2
      simpa [hi] using (hits i hkeep).symm

def pairWorks (R : Finset EdgeIndex) (k : ℕ) (p : ℕ × ℕ) : Prop :=
  (vertices p.1).card ≤ k ∧ vertices p.1 ⊆ vertices p.2 ∧
    (vertices p.2).card = 7 ∧ missed (vertices p.1) ⊆ R ∧ missed (vertices p.2) = ∅

def hits (v : ℕ) (i : EdgeIndex) : Bool :=
  v.testBit (endpoints i).1.val || v.testBit (endpoints i).2.val

lemma missedIff (v : ℕ) (i : EdgeIndex) :
    i ∈ missed (vertices v) ↔ hits v i = false := by
  simp [missed, vertices, hits]

def codePairBase (k : ℕ) (p : ℕ × ℕ) : Prop :=
  (vertices p.1).card ≤ k ∧ p.1 &&& p.2 = p.1 ∧
    (vertices p.2).card = 7 ∧ (List.finRange 16).all (hits p.2) = true

lemma codePairSound (R : Finset EdgeIndex) (k : ℕ) (p : ℕ × ℕ)
    (base : codePairBase k p) (sub : missed (vertices p.1) ⊆ R) : pairWorks R k p := by
  refine ⟨base.1, ?_, base.2.2.1, sub, ?_⟩
  · intro i hi
    have hp : p.1.testBit i.val = true := (Finset.mem_filter.mp hi).2
    have hb := congrArg (fun n : ℕ => n.testBit i.val) base.2.1
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, by
      simpa only [Nat.testBit_and, hp, Bool.true_and] using hb⟩
  · ext i
    have hc := (List.all_eq_true.mp base.2.2.2) i (by simp)
    simp [missedIff, hc]

def initialCodeWorks (v : ℕ) (p : ℕ × ℕ) : Prop :=
  codePairBase (vertices v).card p ∧
    (List.finRange 16).all (fun i => !hits v i || hits p.1 i) = true

lemma initialCodeSound (v : ℕ) (p : ℕ × ℕ) (h : initialCodeWorks v p) :
    pairWorks (missed (vertices v)) (vertices v).card p := by
  apply codePairSound _ _ _ h.1
  intro i hi
  apply (missedIff v i).mpr
  have hp := (missedIff _ _).mp hi
  have htest := (List.all_eq_true.mp h.2) i (by simp)
  simpa [hp] using htest

lemma difficultMask (C : Finset Vertex) (h : C ∈ difficultCovers) : missed C ∈ exceptions := by
  have checked : ∀ C ∈ difficultCovers, missed C ∈ exceptions := by
    decide +kernel
  exact checked C h

def initialBlockWorks (row : ℕ) : Prop :=
  ∀ col : Fin 64,
    let v := row * 64 + col.val
    v ∈ difficultCodes ∨ initialCodeWorks v (initialPair row col.val)

