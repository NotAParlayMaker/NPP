lemma verticesSurjective (C : Finset Vertex) : ∃ v : Fin 2048, vertices v.val = C := by
  induction C using Finset.induction_on with
  | empty => exact ⟨0, by decide⟩
  | @insert v C _ ih =>
      obtain ⟨code, hC⟩ := ih
      have hb : 2 ^ v.val < 2 ^ 11 := Nat.pow_lt_pow_right (by decide) v.isLt
      refine ⟨⟨code.val ||| (2 ^ v.val), Nat.or_lt_two_pow code.isLt hb⟩, ?_⟩
      ext i
      have oldBit : code.val.testBit i.val = true ↔ i ∈ C := by
        rw [← hC]
        simp [vertices]
      simp only [vertices, Finset.mem_filter, Finset.mem_univ, true_and,
        Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq,
        Finset.mem_insert]
      rw [oldBit, Fin.ext_iff]
      exact ⟨fun h => h.elim Or.inr (fun he => Or.inl he.symm),
        fun h => h.elim (fun he => Or.inr he.symm) Or.inl⟩

lemma initialCertificate (C : Finset Vertex) :
    C ∈ difficultCovers ∨ ∃ p, pairWorks (missed C) C.card p := by
  obtain ⟨v, hv⟩ := verticesSurjective C
  let row : Fin 32 := ⟨v.val / 64, by omega⟩
  let col : Fin 64 := ⟨v.val % 64, Nat.mod_lt _ (by decide)⟩
  have idx : row.val * 64 + col.val = v.val := by
    dsimp [row, col]
    omega
  have checked := initialBlocks row col
  dsimp only at checked
  rw [idx] at checked
  rcases checked with difficult | easy
  · exact Or.inl (List.mem_map.mpr ⟨v.val, difficult, hv⟩)
  · exact Or.inr ⟨_, by simpa only [hv] using initialCodeSound _ _ easy⟩

def addEdge (r : ℕ) (i : EdgeIndex) : ℕ := r ||| (2 ^ i.val)

lemma addEdgeIndices (r : ℕ) (i : EdgeIndex) :
    edgeIndices (addEdge r i) = insert i (edgeIndices r) := by
  ext j
  simp only [edgeIndices, addEdge, Finset.mem_filter, Finset.mem_univ, true_and,
    Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq,
    Finset.mem_insert, Fin.ext_iff]
  exact ⟨fun h => h.elim Or.inr (fun he => Or.inl he.symm),
    fun h => h.elim (fun he => Or.inr he.symm) Or.inl⟩

def boundaryCodeWorks (r k : ℕ) (p : ℕ × ℕ) : Prop :=
  codePairBase k p ∧
    (List.finRange 16).all (fun j => r.testBit j.val || hits p.1 j) = true

lemma boundaryCodeSound (r k : ℕ) (p : ℕ × ℕ) (h : boundaryCodeWorks r k p) :
    pairWorks (edgeIndices r) k p := by
  apply codePairSound _ _ _ h.1
  intro j hj
  have hp := (missedIff _ _).mp hj
  have htest := (List.all_eq_true.mp h.2) j (by simp)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ j, by simpa [hp] using htest⟩

