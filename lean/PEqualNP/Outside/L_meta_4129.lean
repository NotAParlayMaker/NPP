import Mathlib.Tactic.FinCases
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_4129

abbrev Vertex := Fin 11
abbrev EdgeIndex := Fin 16

def edges : List (ℕ × ℕ) := [(0, 9), (0, 10), (1, 4), (1, 8), (2, 5), (2, 10), (3, 6), (3, 7), (4, 8), (4, 10), (5, 8), (5, 9), (6, 7), (6, 10), (7, 9), (8, 9)]

def graph : SimpleGraph Vertex := PEqualNP.EdgeOwnership.edgeGraph 11 edges

def endpoints (i : EdgeIndex) : Vertex × Vertex :=
  let p := edges.getD i.val (0, 0)
  (Fin.ofNat 11 p.1, Fin.ofNat 11 p.2)

def edgeAt (i : EdgeIndex) : Sym2 Vertex := s((endpoints i).1, (endpoints i).2)

def removed (D : Finset (Sym2 Vertex)) : Finset EdgeIndex :=
  Finset.univ.filter fun i => edgeAt i ∈ D

def missed (C : Finset Vertex) : Finset EdgeIndex :=
  Finset.univ.filter fun i => (endpoints i).1 ∉ C ∧ (endpoints i).2 ∉ C

def vertices (v : ℕ) : Finset Vertex := Finset.univ.filter fun i => v.testBit i.val

def edgeIndices (v : ℕ) : Finset EdgeIndex := Finset.univ.filter fun i => v.testBit i.val

def mask {n : ℕ} (s : Finset (Fin n)) : ℕ :=
  PEqualNP.MetaComplexity.tableIndex fun i => decide (i ∈ s)

