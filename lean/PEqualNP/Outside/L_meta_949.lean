theorem finiteNo949 (r : Fin 156) (hr : 0 < cost949 r) (fam : BitVec 256)
    (cols : Fin 6 → BitVec 8) (hf : fam ∈ allowedFams949 (cost949 r-1))
    (hc : ∀ v, fam.getLsbD (cols v).toNat = true)
    (hm : ∀ u : BitVec 6, (neg949 r).getLsbD u.toNat = true →
        ∃ c : Fin 8, c.val < 2^(cost949 r-1) ∧ ∀ v : Fin 6, (cols v).getLsbD c.val = u.getLsbD v.val) : False := by
  have byRows (rows : List (BitVec 6)) (hrows : rows.all (fun u => (neg949 r).getLsbD u.toNat) = true)
      (hall : (allowedFams949 (cost949 r-1)).all (fun f => !search949 (codes949 (cost949 r-1)) rows (fun _ => f)) = true) : False := by
    have ok := search_complete949 (codes949 (cost949 r-1)) rows cols (fun _ => fam) hc
    have yes := ok (by
      intro u hu
      obtain ⟨c, hlt, hp⟩ := hm u (List.all_eq_true.mp hrows u hu)
      exact ⟨c, by simp [codes949, hlt], hp⟩)
