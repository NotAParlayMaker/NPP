private def move949 (f : BitVec 256) (u : BitVec 6) (v : Fin 6) (c : Fin 8) :=
  let m := codeFilter949 c
  f &&& (if u.getLsbD v.val then m else ~~~m)
private theorem move_spec949 (f : BitVec 256) (u : BitVec 6) (v : Fin 6) (c : Fin 8)
    (a : BitVec 8) (h : f.getLsbD a.toNat = true) (ha : a.getLsbD c.val = u.getLsbD v.val) :
    (move949 f u v c).getLsbD a.toNat = true := by
  have hlt : a.toNat < 256 := a.isLt
  cases eq : u.getLsbD v.val <;>
    simp only [move949, eq, Bool.false_eq_true, if_false, if_true,
      BitVec.getLsbD_and, BitVec.getLsbD_not, decide_eq_true hlt, h,
      filter_spec949, ha, eq] <;> rfl

def search949 (codes : List (Fin 8)) : List (BitVec 6) → (Fin 6 → BitVec 256) → Bool
  | [], _ => true
  | u :: us, fs => codes.any fun c =>
      let next v := move949 (fs v) u v c
      (List.finRange 6).all (fun v => next v != 0) && search949 codes us next

theorem search_complete949 (codes : List (Fin 8)) (rows : List (BitVec 6))
    (cols : Fin 6 → BitVec 8) (fs : Fin 6 → BitVec 256)
    (hf : ∀ v, (fs v).getLsbD (cols v).toNat = true)
    (hr : ∀ u ∈ rows, ∃ c ∈ codes, ∀ v : Fin 6, (cols v).getLsbD c.val = u.getLsbD v.val) :
    search949 codes rows fs = true := by
  induction rows generalizing fs with
  | nil => rfl
  | cons u us ih =>
    obtain ⟨c,hc,he⟩ := hr u (by simp)
    have hn (v : Fin 6) := move_spec949 (fs v) u v c (cols v) (hf v) (he v)
    refine List.any_eq_true.mpr ⟨c,hc,Bool.and_eq_true_iff.mpr ⟨?_,?_⟩⟩
    · apply List.all_eq_true.mpr
      intro v _
      apply bne_iff_ne.mpr
      intro h
      have h' := hn v
      change move949 (fs v) u v c = 0 at h
      rw [h] at h'
      simpa using h'
    · exact ih _ hn (fun x hx => hr x (by simp [hx]))

