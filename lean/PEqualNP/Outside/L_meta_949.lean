def readMask949 (s u : BitVec 6) := (s &&& u) != 0
def raw949 (s : BitVec 9) : BitVec 6 := s.truncate 6
def pick949 {α : Type} (c : Fin 8) (i : ℕ) (a b : α) := if c.val.testBit i then b else a
def sideMask949 (s : BitVec 9) (x y z : BitVec 6) :=
  raw949 s ||| (if s.getLsbD 6 then x else 0) ||| (if s.getLsbD 7 then y else 0) ||| (if s.getLsbD 8 then z else 0)

def chosen949 (k : ℕ) (c : Fin 8) (s0 t0 s1 t1 s2 t2 o : BitVec 9) : BitVec 6 :=
  let a := if 0 < k then pick949 c 0 (raw949 s0) (raw949 t0) else 0
  let b := if 1 < k then pick949 c 1 (sideMask949 s1 a 0 0) (sideMask949 t1 a 0 0) else 0
  let g := if 2 < k then pick949 c 2 (sideMask949 s2 a b 0) (sideMask949 t2 a b 0) else 0
  sideMask949 o a b g

private def propSide949 (s : BitVec 9) (u : BitVec 6) (x y z : Bool) :=
  readMask949 (raw949 s) u || (s.getLsbD 6 && x) || (s.getLsbD 7 && y) || (s.getLsbD 8 && z)

private def wireBool949 (k : ℕ) (u : BitVec 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :=
  let a := decide (0 < k) && (readMask949 (raw949 s0) u && readMask949 (raw949 t0) u)
  let b := decide (1 < k) && (propSide949 s1 u a false false && propSide949 t1 u a false false)
  let g := decide (2 < k) && (propSide949 s2 u a b false && propSide949 t2 u a b false)
  propSide949 o u a b g

private def chosenBool949 (k : ℕ) (c : Fin 8) (u : BitVec 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :=
  let a := decide (0 < k) && pick949 c 0 (readMask949 (raw949 s0) u) (readMask949 (raw949 t0) u)
  let b := decide (1 < k) && pick949 c 1 (propSide949 s1 u a false false) (propSide949 t1 u a false false)
  let g := decide (2 < k) && pick949 c 2 (propSide949 s2 u a b false) (propSide949 t2 u a b false)
  propSide949 o u a b g

private lemma read_raw949 : ∀ (s : BitVec 9) (u : BitVec 6),
    (bare949 s).getLsbD u.toNat = readMask949 (raw949 s) u := by decide +kernel

private lemma wireBool_correct949 (k : ℕ) (u : BitVec 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :
    (fun949 k s0 t0 s1 t1 s2 t2 o).getLsbD u.toNat = wireBool949 k u s0 t0 s1 t1 s2 t2 o := by
  have side (s : BitVec 9) (a b c : BitVec 64) :
      (side949 s a b c).getLsbD u.toNat = propSide949 s u (a.getLsbD u.toNat) (b.getLsbD u.toNat) (c.getLsbD u.toNat) := by
    simp only [side949,propSide949,BitVec.getLsbD_or,read_raw949]
    cases e : s.getLsbD 6 <;> cases f : s.getLsbD 7 <;> cases g : s.getLsbD 8 <;> simp only [sel949,e,f,g] <;> simp
  by_cases h0 : 0<k <;> by_cases h1 : 1<k <;> by_cases h2 : 2<k <;>
    simp [fun949,wireBool949,h0,h1,h2,side,read_raw949,BitVec.getLsbD_and]

private lemma mask_or949 : ∀ (a b u : BitVec 6),
    readMask949 (a ||| b) u = (readMask949 a u || readMask949 b u) := by
  intro a b u; apply Bool.eq_iff_iff.mpr; simp [readMask949,BitVec.and_or_distrib_right,BitVec.or_eq_zero_iff]; tauto

private lemma chosenBool_correct949 (k : ℕ) (c : Fin 8) (u : BitVec 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :
    readMask949 (chosen949 k c s0 t0 s1 t1 s2 t2 o) u = chosenBool949 k c u s0 t0 s1 t1 s2 t2 o := by
  have z : readMask949 0 u = false := by simp [readMask949]
  have side (s : BitVec 9) (a b c : BitVec 6) :
      readMask949 (sideMask949 s a b c) u = propSide949 s u (readMask949 a u) (readMask949 b u) (readMask949 c u) := by
    by_cases h : s.getLsbD 6 <;> by_cases h' : s.getLsbD 7 <;> by_cases h'' : s.getLsbD 8 <;>
      simp only [sideMask949,propSide949,mask_or949,h,h',h''] <;> simp_all
  have pk (i) (a b : BitVec 6) : readMask949 (pick949 c i a b) u =
      pick949 c i (readMask949 a u) (readMask949 b u) := by unfold pick949; split <;> rfl
  by_cases h0 : 0<k <;> by_cases h1 : 1<k <;> by_cases h2 : 2<k <;>
    simp [chosen949,chosenBool949,h0,h1,h2,side,pk,z] <;> simp [readMask949]

private theorem branch_mono949 (k : ℕ) (c : Fin 8) (u : BitVec 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :
    wireBool949 k u s0 t0 s1 t1 s2 t2 o ≤ chosenBool949 k c u s0 t0 s1 t1 s2 t2 o := by
  have mo (s : BitVec 9) {a b g A B G : Bool} (ha : a ≤ A) (hb : b ≤ B) (hg : g ≤ G) :
      propSide949 s u a b g ≤ propSide949 s u A B G := by
    unfold propSide949
    exact (by decide : ∀ (p q r t a b g A B G : Bool), a ≤ A → b ≤ B → g ≤ G →
      (p || q&&a || r&&b || t&&g) ≤ (p || q&&A || r&&B || t&&G)) _ _ _ _ _ _ _ _ _ _ ha hb hg
  have sel (i : ℕ) {a b A B : Bool} (ha : a ≤ A) (hb : b ≤ B) :
      (decide (i<k) && (a && b)) ≤ (decide (i<k) && pick949 c i A B) := by
    unfold pick949
    exact (by decide : ∀ (p q a b A B : Bool), a ≤ A → b ≤ B →
      (p && (a && b)) ≤ (p && (if q then B else A))) _ _ _ _ _ _ ha hb
  apply mo
  · exact sel 0 le_rfl le_rfl
  · apply sel 1 <;> exact mo _ (sel 0 le_rfl le_rfl) le_rfl le_rfl
  · apply sel 2 <;> apply mo _ (sel 0 le_rfl le_rfl) _ le_rfl <;>
      apply sel 1 <;> exact mo _ (sel 0 le_rfl le_rfl) le_rfl le_rfl

private theorem eq_branch949 (k : ℕ) (hk : k ≤ 3) (u : BitVec 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :
    ∃ c : Fin 8, c.val < 2^k ∧
      wireBool949 k u s0 t0 s1 t1 s2 t2 o = chosenBool949 k c u s0 t0 s1 t1 s2 t2 o := by
  let a := decide (0<k) && (readMask949 (raw949 s0) u && readMask949 (raw949 t0) u)
  let b := decide (1<k) && (propSide949 s1 u a false false && propSide949 t1 u a false false)
  have code : ∀ (kk : Fin 4) (a b g : Bool), ∃ c : Fin 8, c.val < 2^kk.val ∧
      (0<kk.val → c.val.testBit 0 = a) ∧ (1<kk.val → c.val.testBit 1 = b) ∧
      (2<kk.val → c.val.testBit 2 = g) := by decide
  obtain ⟨c,hc,h0,h1,h2⟩ := code ⟨k,by omega⟩ (readMask949 (raw949 s0) u)
    (propSide949 s1 u a false false) (propSide949 s2 u a b false)
  have pin (i : ℕ) (p q : Bool) (h : i<k → c.val.testBit i = p) :
      (decide (i<k) && pick949 c i p q) = (decide (i<k) && (p&&q)) := by
    by_cases hi : i<k
    · simp [pick949,hi,h hi]; cases p <;> simp
    · simp [hi]
  have ea := pin 0 _ (readMask949 (raw949 t0) u) h0
  have eb := pin 1 _ (propSide949 t1 u a false false) h1
  have ec := pin 2 _ (propSide949 t2 u a b false) h2
  refine ⟨c,hc,?_⟩
  simp only [chosenBool949, wireBool949, ea, show (decide (0 < k) && (readMask949 (raw949 s0) u && readMask949 (raw949 t0) u)) = a from rfl, eb, show (decide (1 < k) && (propSide949 s1 u a false false && propSide949 t1 u a false false)) = b from rfl, ec]

private lemma neg_row949 (k : ℕ) (neg pos : BitVec 64) (s0 t0 s1 t1 s2 t2 o : BitVec 9)
    (hs : spec949 k neg pos s0 t0 s1 t1 s2 t2 o) (u : BitVec 6) (h : neg.getLsbD u.toNat = true) :
    wireBool949 k u s0 t0 s1 t1 s2 t2 o = false := by
  have eq := congrArg (fun v : BitVec 64 => v.getLsbD u.toNat) hs.1
  simpa [BitVec.getLsbD_and,h,wireBool_correct949] using eq

private lemma pos_row949 (k : ℕ) (neg pos : BitVec 64) (s0 t0 s1 t1 s2 t2 o : BitVec 9)
    (hs : spec949 k neg pos s0 t0 s1 t1 s2 t2 o) (u : BitVec 6) (h : pos.getLsbD u.toNat = true) :
    wireBool949 k u s0 t0 s1 t1 s2 t2 o = true := by
  have eq := congrArg (fun v : BitVec 64 => v.getLsbD u.toNat) hs.2
  simpa [BitVec.getLsbD_and,h,wireBool_correct949] using eq

