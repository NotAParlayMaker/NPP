    (neg949 r).getLsbD u.toNat = true → ∀ i : Fin 6, u.getLsbD i.val = false →
    (pos949 r).getLsbD (u ||| ((1 : BitVec 6) <<< i.val)).toNat = true := by decide +kernel

theorem mis_code949 (r : Fin 156) (k : ℕ) (hk : k ≤ 3) (s0 t0 s1 t1 s2 t2 o : BitVec 9)
    (hs : spec949 k (neg949 r) (pos949 r) s0 t0 s1 t1 s2 t2 o) (u : BitVec 6)
    (hn : (neg949 r).getLsbD u.toNat = true) :
    ∃ c : Fin 8, c.val < 2^k ∧ chosen949 k c s0 t0 s1 t1 s2 t2 o = ~~~u := by
  obtain ⟨c,hc,he⟩ := eq_branch949 k hk u s0 t0 s1 t1 s2 t2 o
  let mask := chosen949 k c s0 t0 s1 t1 s2 t2 o
  have off : readMask949 mask u = false :=
    (chosenBool_correct949 ..).trans (he.symm.trans (neg_row949 _ _ _ _ _ _ _ _ _ _ hs u hn))
  have on (i : Fin 6) (hi : u.getLsbD i.val = false) :
      readMask949 mask (u ||| ((1 : BitVec 6) <<< i.val)) = true := by
    change readMask949 (chosen949 k c s0 t0 s1 t1 s2 t2 o) _ = true
    rw [chosenBool_correct949]
    have h := branch_mono949 k c (u ||| ((1 : BitVec 6) <<< i.val)) s0 t0 s1 t1 s2 t2 o
    have hh := pos_row949 _ _ _ _ _ _ _ _ _ _ hs _ (extensions949 r u hn i hi)
    rw [hh] at h
    exact (by decide : ∀ b : Bool, true ≤ b → b = true) _ h
  exact ⟨c,hc,(by decide : ∀ a b : BitVec 6, readMask949 a b = false →
    (∀ i : Fin 6, b.getLsbD i.val = false → readMask949 a (b ||| ((1 : BitVec 6) <<< i.val)) = true) →
    a = ~~~b) mask u off on⟩

