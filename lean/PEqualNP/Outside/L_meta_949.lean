abbrev rename949 (C : AndCountCircuit 6) (e : Equiv.Perm (Fin 6)) : AndCountCircuit 6 :=
  {C with leftVars := fun i => (C.leftVars i).map e.toEmbedding,
          rightVars := fun i => (C.rightVars i).map e.toEmbedding,
          outVars := C.outVars.map e.toEmbedding}

theorem rename_wf949 (C : AndCountCircuit 6) (e : Equiv.Perm (Fin 6)) :
    (rename949 C e).WellFormed ↔ C.WellFormed := Iff.rfl

private lemma vars949 (B U : Finset (Fin 6)) (e : Equiv.Perm (Fin 6)) :
    (∃ v ∈ B.map e.toEmbedding, v ∈ U) ↔ ∃ v ∈ B, v ∈ U.map e.symm.toEmbedding := by
  simp
  constructor
  · rintro ⟨v,hB,hU⟩
    exact ⟨e.symm v,hB,by simpa using hU⟩
  · rintro ⟨v,hB,hU⟩
    exact ⟨e v,by simpa using hB,hU⟩

theorem eval_rename949 (C : AndCountCircuit 6) (e : Equiv.Perm (Fin 6)) (U : Finset (Fin 6)) :
    (rename949 C e).eval U = C.eval (U.map e.symm.toEmbedding) := by
  have fuel : ∀ d i, (rename949 C e).gateValFuel U d i = C.gateValFuel (U.map e.symm.toEmbedding) d i := by
    intro d
    induction d with
    | zero => intro i; rfl
    | succ d ih =>
      intro i
      have sides (B : Finset (Fin 6)) (T : Finset (Fin C.size)) :
          sideTrue U (B.map e.toEmbedding) T i ((rename949 C e).gateValFuel U d) =
          sideTrue (U.map e.symm.toEmbedding) B T i (C.gateValFuel (U.map e.symm.toEmbedding) d) := by
        apply Bool.eq_iff_iff.mpr; simp only [sideTrue, eval, decide_eq_true_eq]
        apply or_congr (vars949 B U e)
        simp only [ih]
      exact congrArg₂ Bool.and (sides (C.leftVars i) (C.leftGates i)) (sides (C.rightVars i) (C.rightGates i))
  apply Bool.eq_iff_iff.mpr; simp only [sideTrue, eval, decide_eq_true_eq]
  apply or_congr (vars949 C.outVars U e)
  change (∃ j ∈ C.outGates, (rename949 C e).gateValFuel U C.size j = true) ↔ _
  simp only [fuel,gateVal]


theorem transport949 {G H : SimpleGraph (Fin 6)} (e : G ≃g H) (C : AndCountCircuit 6)
    (hC : ∀ I : Finset (Fin 6), (∀ v ∈ I, ∀ w ∈ I, ¬ G.Adj v w) →
      (∀ u, u ∉ I → ∃ v ∈ I, G.Adj u v) →
      C.eval I = false ∧ ∀ u, u ∉ I → C.eval (insert u I) = true) :
    ∀ I : Finset (Fin 6), (∀ v ∈ I, ∀ w ∈ I, ¬ H.Adj v w) →
      (∀ u, u ∉ I → ∃ v ∈ I, H.Adj u v) →
      (rename949 C e.toEquiv).eval I = false ∧ ∀ u, u ∉ I →
        (rename949 C e.toEquiv).eval (insert u I) = true := by
  intro I hi hm
  let U := I.map e.toEquiv.symm.toEmbedding
  have mem (v : Fin 6) : v ∈ U ↔ e v ∈ I := by simp [U]
  have hind : ∀ v ∈ U, ∀ w ∈ U, ¬ G.Adj v w := by
    intro v hv w hw h
    exact hi _ ((mem _).mp hv) _ ((mem _).mp hw) (e.map_rel_iff.mpr h)
  have hmax : ∀ u, u ∉ U → ∃ v ∈ U, G.Adj u v := by
    intro u hu
    obtain ⟨v,hv,ha⟩ := hm (e u) (fun hh => hu ((mem _).mpr hh))
    refine ⟨e.symm v,(mem _).mpr (by simpa using hv),e.map_rel_iff.mp (by simpa using ha)⟩
  obtain ⟨h0,h1⟩ := hC U hind hmax
  constructor
  · exact (eval_rename949 _ _ _).trans h0
  · intro u hu
    rw [eval_rename949,Finset.map_insert]
    apply h1
    intro hh
    have e' := (mem _).mp hh
    change e.toEquiv (e.toEquiv.symm u) ∈ I at e'
    exact hu (by simpa using e')

end PEqualNP.Outside.L_meta_949_aux

