private def fits (G : SimpleGraph (Fin 6)) (s mask : ℕ) : Prop :=
  ∃ f : Fin 6 → Fin 6, Function.Injective f ∧
    ∀ a b, a.val < s → b.val < s → (G.Adj (f a) (f b) ↔ (graphOfMask mask).Adj a b)

private def extension (s g mask : ℕ) (a b : Fin 6) : Prop :=
  a ≠ b ∧ (if a.val = s then mask.testBit b.val else if b.val = s then mask.testBit a.val
            else g.testBit (edgeIx a b)) = true

private def rowBits {s : ℕ} (h : Fin 6 → Bool) :=
  BitVec.ofBoolListLE (List.ofFn fun i : Fin s => if hi : i.val < 6 then h ⟨i.val,hi⟩ else false)

private def entryOK (s old row next pc : ℕ) : Prop :=
  let f := fun i : Fin 6 => (⟨(pc / 8^i.val % 8) % 6,by omega⟩ : Fin 6)
  (∀ i j, f i = f j → i=j) ∧
   (∀ i : Fin 6, i.val < s+1 → (f i).val < s+1) ∧
   ∀ a b : Fin 6, a.val < s+1 → b.val < s+1 →
     (extension s old row (f a) (f b) ↔ (graphOfMask next).Adj a b)
private instance (s old row next pc) : Decidable (entryOK s old row next pc) := by
  unfold entryOK extension; dsimp only; infer_instance

private theorem nextFits {s R R' : ℕ} (old : Fin R → ℕ) (new : Fin R' → ℕ)
    (cert : ∀ r : Fin R, ∀ row : Fin (2^s), ∃ r' pc, entryOK s (old r) row.val (new r') pc)
    (hs : s<6) (G : SimpleGraph (Fin 6)) :
    (∃ r, fits G s (old r)) → ∃ r', fits G (s+1) (new r') := by
  classical
  rintro ⟨r,f,inj,he⟩
  let v : Fin 6 := ⟨s,hs⟩
  let h (i : Fin 6) := decide (G.Adj (f i) (f v))
  let bits := rowBits (s:=s) h
  obtain ⟨r',pc,hc⟩ := cert r ⟨bits.toNat,by simpa using bits.isLt⟩
  let t (i : Fin 6) : Fin 6 := ⟨(pc / 8^i.val % 8) % 6,by omega⟩
  obtain ⟨hinj,lt,ha⟩ := hc
  have bit (a : Fin 6) (hₐ : a.val<s) : bits.toNat.testBit a.val = h a := by
    change (rowBits (s:=s) h).getLsbD a.val = _
    unfold rowBits; rw [BitVec.getLsbD_ofBoolListLE]; simp [List.getD_eq_getElem?_getD,hₐ,a.isLt]
  have step (a b : Fin 6) (a₀ : a.val < s+1) (b₀ : b.val < s+1) :
      extension s (old r) bits.toNat a b ↔ G.Adj (f a) (f b) := by
    by_cases eq : a=b
    · subst b; simp [extension]
    by_cases av : a=v
    · subst a
      have bl : b.val < s := by by_contra! bad; exact eq (Fin.ext (show s=b.val by omega))
      simp [extension,v,bit b bl,h,G.adj_comm,eq]
    by_cases bv : b=v
    · subst b
      have al : a.val < s := by by_contra! bad; exact av (Fin.ext (by change a.val=s; omega))
      simp [extension,v,show a.val ≠ s by omega,bit a al,h,eq]
    have al : a.val<s := by by_contra! bad; exact av (Fin.ext (by change a.val=s; omega))
    have bl : b.val<s := by by_contra! bad; exact bv (Fin.ext (by change b.val=s; omega))
    simpa [extension,graphOfMask,show a.val≠s by omega,show b.val≠s by omega] using (he a b al bl).symm
  refine ⟨r',f ∘ t,inj.comp hinj,?_⟩
  intro a b a₀ b₀
  exact (step (t a) (t b) (lt a a₀) (lt b b₀)).symm.trans (ha a b a₀ b₀)
end PEqualNP.Outside.L_meta_949_aux
