theorem modelCorrect949 (k : Nat) (hk : k ≤ 3) (t : BitVec 9) (v : BitVec 7) : (modelFam949 k t).getLsbD (col949 k t v).toNat = true := by
  let hi : Fin 128 := ⟨t.toNat / 4, by have := t.isLt; omega⟩
  let lo : Fin 4 := ⟨t.toNat % 4, Nat.mod_lt _ (by decide)⟩
  have ht : BitVec.ofNat 9 (hi.val * 4 + lo.val) = t := by
    dsimp [hi, lo]; rw [Nat.div_add_mod' t.toNat 4]; simp
  have h := topAll949 hi lo v ⟨k,by omega⟩
  simpa only [ht] using h

