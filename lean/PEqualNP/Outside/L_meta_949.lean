def edgeIx (a b : Fin 6) : ℕ :=
  let i := min a.val b.val
  let j := max a.val b.val
  5*i-i*(i-1)/2+(j-i-1)

def graphOfMask (g : ℕ) : SimpleGraph (Fin 6) where
  Adj a b := a ≠ b ∧ g.testBit (edgeIx a b) = true
  symm := ⟨by intro a b h; simpa [edgeIx,min_comm,max_comm,ne_comm] using h⟩
  loopless := ⟨by simp⟩

instance (g : ℕ) : DecidableRel (graphOfMask g).Adj :=
  fun a b => inferInstanceAs (Decidable (a ≠ b ∧ g.testBit (edgeIx a b) = true))

