theorem row_card949 (neg : BitVec 64) (k : ℕ) (cols : Fin 6 → BitVec 8)
    (hr : ∀ u : BitVec 6, neg.getLsbD u.toNat = true →
      ∃ c : Fin 8, c.val < 2^k ∧ ∀ v : Fin 6, (cols v).getLsbD c.val = u.getLsbD v.val) :
    (rows949 neg).card ≤ 2^k := by
  classical
  let A := ↥(rows949 neg)
  have h (a : A) := hr a.val (Finset.mem_filter.mp a.property).2
  let code (a : A) : Fin (2^k) := ⟨(h a).choose.val, (h a).choose_spec.1⟩
  have inj : Function.Injective code := by
    intro a b hab
    have hc : (h a).choose.val = (h b).choose.val := congrArg (fun x : Fin (2^k) => x.val) hab
    apply Subtype.ext
    apply BitVec.eq_of_getLsbD_eq_iff.mpr
    intro i hi
    have ha := (h a).choose_spec.2 (⟨i,hi⟩ : Fin 6)
    have hb := (h b).choose_spec.2 (⟨i,hi⟩ : Fin 6)
    rw [hc] at ha
    exact ha.symm.trans hb
  simpa [A] using Fintype.card_le_of_injective code inj

