theorem contradict949 {G : SimpleGraph (Fin 6)} (C : AndCount.AndCountCircuit 6)
    (hw : C.WellFormed) (hc : ∀ I : Finset (Fin 6),
       (∀ v ∈ I, ∀ w ∈ I, ¬ G.Adj v w) → (∀ u, u ∉ I → ∃ v ∈ I, G.Adj u v) →
       C.eval I = false ∧ ∀ u, u ∉ I → C.eval (insert u I) = true) :
    ∃ (k : ℕ) (X Y : Fin k → Finset (Fin 6)), k ≤ C.size ∧
      (∀ i : Fin k, ∀ a ∈ X i, ∀ b ∈ Y i, G.Adj a b) ∧
      (∀ a b : Fin 6, G.Adj a b → ∃ i : Fin k,
        (a ∈ X i ∧ b ∈ Y i) ∨ (b ∈ X i ∧ a ∈ Y i)) := by
  classical
  obtain ⟨r,⟨e⟩⟩ := relabel949 G
  let D := rename949 C e.toEquiv
  have hle : cost949 r ≤ C.size := by
    by_contra! small
    have cap : ∀ r : Fin 156, cost949 r ≤ 4 := by decide +kernel
    have size : D.size ≤ cost949 r - 1 := by change C.size ≤ _; omega
    obtain ⟨s0,t0,s1,t1,s2,t2,o,enc⟩ := encode949 D (cost949 r - 1)
      ((rename_wf949 C e.toEquiv).mpr hw) size (by specialize cap r; omega)
    apply impossible949 r (by omega) s0 t0 s1 t1 s2 t2 o
    exact actual_spec949 r D (fun U h => transport949 e C hc U h.1 h.2) _ _ _ _ _ _ _ _ enc
  obtain ⟨X,Y,edges,cover⟩ := covers949 r
  let lift (S : Finset (Fin 6)) := S.map e.toEquiv.symm.toEmbedding
  have mem (a : Fin 6) (S : Finset (Fin 6)) : a ∈ lift S ↔ e a ∈ S := by simp [lift]
  refine ⟨_, fun i => lift (X i), fun i => lift (Y i), hle, ?_, ?_⟩
  · intro i a ha b hb
    exact e.map_rel_iff.mp (edges i (e a) ((mem _ _).mp ha) (e b) ((mem _ _).mp hb))
  · intro a b hab
    obtain ⟨i,hi⟩ := cover (e a) (e b) (e.map_rel_iff.mpr hab)
    exact ⟨i,by simpa only [mem] using hi⟩
end PEqualNP.Outside.L_meta_949_aux
theorem PEqualNP.Outside.L_meta_949 : ¬ (∃ (G : SimpleGraph (Fin 6)) (C : PEqualNP.AndCount.AndCountCircuit 6), C.WellFormed ∧ (∀ I : Finset (Fin 6), (∀ v ∈ I, ∀ w ∈ I, ¬ G.Adj v w) → (∀ u, u ∉ I → ∃ v ∈ I, G.Adj u v) → C.eval I = false ∧ ∀ u, u ∉ I → C.eval (insert u I) = true) ∧ ¬ (∃ (k : ℕ) (X Y : Fin k → Finset (Fin 6)), k ≤ C.size ∧ (∀ i : Fin k, ∀ a ∈ X i, ∀ b ∈ Y i, G.Adj a b) ∧ (∀ a b : Fin 6, G.Adj a b → ∃ i : Fin k, (a ∈ X i ∧ b ∈ Y i) ∨ (b ∈ X i ∧ a ∈ Y i)))) := by
  rintro ⟨G,C,hw,hc,hn⟩
  exact hn (PEqualNP.Outside.L_meta_949_aux.contradict949 C hw hc)
