private theorem bit_use949 (b : Bool) (x : BitVec 8) (c : Fin 8) :
    (if b then x else 0).getLsbD c.val = (b && x.getLsbD c.val) := by cases b <;> simp
private theorem bit_src949 (b : Bool) (c : Fin 8) : ((if b then 255 else 0) : BitVec 8).getLsbD c.val = b := by
  cases b <;> fin_cases c <;> decide
private theorem bit_pick949 (m x y : BitVec 8) (c : Fin 8) :
    ((~~~m &&& x) ||| (m &&& y)).getLsbD c.val =
      (if m.getLsbD c.val then y.getLsbD c.val else x.getLsbD c.val) := by
  simp only [BitVec.getLsbD_or, BitVec.getLsbD_and,BitVec.getLsbD_not]
  cases hm : m.getLsbD c.val <;> simp [c.isLt,hm]
private theorem bit_mask949 (s : BitVec 9) (x y z : BitVec 6) (v : Fin 6) :
    (sideMask949 s x y z).getLsbD v.val =
      (s.getLsbD v.val || (s.getLsbD 6 && x.getLsbD v.val) ||
       (s.getLsbD 7 && y.getLsbD v.val) || (s.getLsbD 8 && z.getLsbD v.val)) := by
  simp only [sideMask949,raw949,BitVec.getLsbD_or]
  have use (b : Bool) (z : BitVec 6) : (if b then z else 0).getLsbD v.val = (b && z.getLsbD v.val) := by cases b <;> simp
  simp only [use]
  simp [v.isLt]
private theorem coord_sel949 (c : Fin 8) (i : Nat) (a b : BitVec 6) (v : Fin 6) :
    (pick949 c i a b).getLsbD v.val = if c.val.testBit i then b.getLsbD v.val else a.getLsbD v.val := by
  unfold pick949; split <;> rfl
theorem colBit949 (k : Nat) (hk : k ≤ 3) (c : Fin 8) (v : Fin 6) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :
    (col949 k (top949 s1 t1 s2 t2 o) (rawCol949 v s0 t0 s1 t1 s2 t2 o)).getLsbD c.val =
       ((c.val < 2^k) && !(chosen949 k c s0 t0 s1 t1 s2 t2 o).getLsbD v.val) := by
  have m0 : (170 : BitVec 8).getLsbD c.val = c.val.testBit 0 := by fin_cases c <;> decide
  have m1 : (204 : BitVec 8).getLsbD c.val = c.val.testBit 1 := by fin_cases c <;> decide
  have m2 : (240 : BitVec 8).getLsbD c.val = c.val.testBit 2 := by fin_cases c <;> decide
  have cap : (cap949 k).getLsbD c.val = decide (c.val < 2^k) := by interval_cases k <;> fin_cases c <;> decide
  have top0 : (top949 s1 t1 s2 t2 o).getLsbD 0 = s1.getLsbD 6 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top1 : (top949 s1 t1 s2 t2 o).getLsbD 1 = t1.getLsbD 6 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top2 : (top949 s1 t1 s2 t2 o).getLsbD 2 = s2.getLsbD 6 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top3 : (top949 s1 t1 s2 t2 o).getLsbD 3 = s2.getLsbD 7 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top4 : (top949 s1 t1 s2 t2 o).getLsbD 4 = t2.getLsbD 6 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top5 : (top949 s1 t1 s2 t2 o).getLsbD 5 = t2.getLsbD 7 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top6 : (top949 s1 t1 s2 t2 o).getLsbD 6 = o.getLsbD 6 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top7 : (top949 s1 t1 s2 t2 o).getLsbD 7 = o.getLsbD 7 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have top8 : (top949 s1 t1 s2 t2 o).getLsbD 8 = o.getLsbD 8 := by unfold top949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r0 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 0 = s0.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r1 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 1 = t0.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r2 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 2 = s1.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r3 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 3 = t1.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r4 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 4 = s2.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r5 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 5 = t2.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have r6 : (rawCol949 v s0 t0 s1 t1 s2 t2 o).getLsbD 6 = o.getLsbD v.val := by unfold rawCol949; exact BitVec.getLsbD_ofBoolListLE.trans (by rfl)
  have raw (s : BitVec 9) : (raw949 s).getLsbD v.val = s.getLsbD v.val := by simp [raw949,v.isLt]
  have full : (255 : BitVec 8).getLsbD c.val = true := by fin_cases c <;> decide
  interval_cases k <;> simp only [col949,chosen949,Nat.reduceLT,↓reduceIte,
    bit_pick949, coord_sel949,bit_mask949,cap,m0,m1,m2,raw,
    BitVec.getLsbD_and,BitVec.getLsbD_not,BitVec.getLsbD_or,bit_use949,
    top0,top1,top2,top3,top4,top5,top6,top7,top8,r0,r1,r2,r3,r4,r5,r6,full,
    BitVec.getLsbD_zero,Bool.and_true,Bool.and_false,Bool.false_and,Bool.or_false,
    c.isLt,decide_true,Bool.true_and,Bool.and_comm]
  all_goals cases h0 : c.val.testBit 0 <;> cases h1 : c.val.testBit 1 <;> cases h2 : c.val.testBit 2 <;> simp [Bool.or_comm,Bool.and_comm,Bool.and_left_comm,Bool.or_left_comm,Bool.or_assoc,Bool.and_assoc]

theorem impossible949 (r : Fin 156) (hr : 0 < cost949 r) (s0 t0 s1 t1 s2 t2 o : BitVec 9) :
    ¬ spec949 (cost949 r - 1) (neg949 r) (pos949 r) s0 t0 s1 t1 s2 t2 o := by
  intro hs
  let k := cost949 r - 1
  have cap : ∀ r : Fin 156, cost949 r ≤ 4 := by decide +kernel
  have hk : k ≤ 3 := by dsimp [k]; specialize cap r; omega
  let t := top949 s1 t1 s2 t2 o
  let cols := fun v => col949 k t (rawCol949 v s0 t0 s1 t1 s2 t2 o)
  apply finiteNo949 r hr (modelFam949 k t) cols (modelMem949 k hk t) (fun v => modelCorrect949 k hk t _)
  intro u hn
  obtain ⟨c,hc,eq⟩ := mis_code949 r k hk s0 t0 s1 t1 s2 t2 o hs u hn
  refine ⟨c,hc,fun v => ?_⟩
  change (col949 _ _ _).getLsbD _ = _
  rw [colBit949 k hk,eq,BitVec.getLsbD_not]
  simp [hc,v.isLt]
end PEqualNP.Outside.L_meta_949_aux

