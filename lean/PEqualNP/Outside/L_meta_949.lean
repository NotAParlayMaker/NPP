def rawBit0 : BitVec 64 := 12297829382473034410
def rawBit1 : BitVec 64 := 14757395258967641292
def rawBit2 : BitVec 64 := 17361641481138401520
def rawBit3 : BitVec 64 := 18374966859414961920
def rawBit4 : BitVec 64 := 18446462603027742720
def rawBit5 : BitVec 64 := 18446744069414584320

def sel949 (s : BitVec 9) (i : Nat) (v : BitVec 64) := if s.getLsbD i then v else 0
def bare949 (s : BitVec 9) := sel949 s 0 rawBit0 ||| sel949 s 1 rawBit1 ||| sel949 s 2 rawBit2 ||| sel949 s 3 rawBit3 ||| sel949 s 4 rawBit4 ||| sel949 s 5 rawBit5
def side949 (s : BitVec 9) (g0 g1 g2 : BitVec 64) :=
  bare949 s ||| sel949 s 6 g0 ||| sel949 s 7 g1 ||| sel949 s 8 g2
def fun949 (k : ℕ) (s0 t0 s1 t1 s2 t2 o : BitVec 9) : BitVec 64 :=
  let a := if 0 < k then bare949 s0 &&& bare949 t0 else 0
  let b := if 1 < k then side949 s1 a 0 0 &&& side949 t1 a 0 0 else 0
  let c := if 2 < k then side949 s2 a b 0 &&& side949 t2 a b 0 else 0
  side949 o a b c
open PEqualNP.AndCount

def inputs949 (u : BitVec 6) := Finset.univ.filter fun i : Fin 6 => u.getLsbD i.val

private def choose949 {n : ℕ} (G : Finset (Fin n)) (j : ℕ) : Bool :=
  if h : j<n then decide (⟨j,h⟩ ∈ G) else false

private def mask949 {n : ℕ} (V : Finset (Fin 6)) (G : Finset (Fin n)) : BitVec 9 :=
  BitVec.ofBoolListLE [decide (0∈V),decide (1∈V),decide (2∈V),decide (3∈V),
    decide (4∈V),decide (5∈V),choose949 G 0,choose949 G 1,choose949 G 2]

private theorem bareSingleton949 : ∀ u : BitVec 6,
    rawBit0.getLsbD u.toNat = u.getLsbD 0 ∧ rawBit1.getLsbD u.toNat = u.getLsbD 1 ∧
    rawBit2.getLsbD u.toNat = u.getLsbD 2 ∧ rawBit3.getLsbD u.toNat = u.getLsbD 3 ∧
    rawBit4.getLsbD u.toNat = u.getLsbD 4 ∧ rawBit5.getLsbD u.toNat = u.getLsbD 5 := by decide

private theorem select_bit (s : BitVec 9) (i : ℕ) (v : BitVec 64) (u : BitVec 6) :
    (sel949 s i v).getLsbD u.toNat = (s.getLsbD i && v.getLsbD u.toNat) := by
  unfold sel949
  split <;> simp_all

private theorem bare_bit {n : ℕ} (V : Finset (Fin 6)) (G : Finset (Fin n)) (u : BitVec 6) :
    (bare949 (mask949 V G)).getLsbD u.toNat = decide (∃ v ∈ V, v ∈ inputs949 u) := by
  obtain ⟨r0,r1,r2,r3,r4,r5⟩ := bareSingleton949 u
  apply Bool.eq_iff_iff.mpr
  simp only [bare949,BitVec.getLsbD_or,select_bit,r0,r1,r2,r3,r4,r5,mask949,
    BitVec.getLsbD_ofBoolListLE,List.getD_cons_zero,List.getD_cons_succ,Bool.or_eq_true,
    Bool.and_eq_true,decide_eq_true_eq]
  simp [inputs949,Fin.exists_fin_succ]
  tauto

private theorem side_bit {n : ℕ} (V : Finset (Fin 6)) (G : Finset (Fin n)) (a b c : BitVec 64) (u : BitVec 6) :
    (side949 (mask949 V G) a b c).getLsbD u.toNat =
      (decide (∃ v ∈ V, v ∈ inputs949 u) || (choose949 G 0 && a.getLsbD u.toNat) ||
      (choose949 G 1 && b.getLsbD u.toNat) || (choose949 G 2 && c.getLsbD u.toNat)) := by
  simp only [side949,BitVec.getLsbD_or,select_bit,bare_bit]
  simp only [mask949,BitVec.getLsbD_ofBoolListLE]; rfl

private theorem bare_zero : bare949 0 = 0 := by decide
private theorem side_zero (a b c : BitVec 64) : side949 0 a b c = 0 := by simp [side949,sel949]; exact bare_zero

private theorem ex0 (p : Fin 0 → Prop) : (∃ i, p i) ↔ False := by simp [Fin.exists_fin_succ]
private theorem ex1 (p : Fin 1 → Prop) : (∃ i, p i) ↔ p 0 := by simp [Fin.exists_fin_succ]
private theorem ex2 (p : Fin 2 → Prop) : (∃ i, p i) ↔ p 0 ∨ p 1 := by simp [Fin.exists_fin_succ]
private theorem ex3 (p : Fin 3 → Prop) : (∃ i, p i) ↔ p 0 ∨ p 1 ∨ p 2 := by simp [Fin.exists_fin_succ]

set_option maxHeartbeats 4000000 in
theorem encode949 (C : AndCountCircuit 6) (k : ℕ) (_hw : C.WellFormed) (hk : C.size ≤ k) (h3 : k ≤ 3) :
    ∃ s0 t0 s1 t1 s2 t2 o : BitVec 9, ∀ u : BitVec 6,
    (fun949 k s0 t0 s1 t1 s2 t2 o).getLsbD u.toNat = C.eval (inputs949 u) := by
  rcases C with ⟨n,lv,lg,rv,rg,ov,og⟩
  change n ≤ k at hk
  have hn : n ≤ 3 := by omega
  interval_cases n
  · refine ⟨0, 0, 0, 0, 0, 0, mask949 ov og, ?_⟩
    intro u
    interval_cases k <;> first | omega | skip
    all_goals
      simp only [fun949, side_bit, bare_bit, BitVec.getLsbD_and, AndCountCircuit.eval, AndCountCircuit.gateVal, AndCountCircuit.gateValFuel, AndCountCircuit.sideTrue, ex0]
      simp [choose949,side_zero,bare_zero,side_bit,bare_bit,Fin.reduceFinMk,Bool.or_assoc]
  · refine ⟨mask949 (lv 0) (lg 0), mask949 (rv 0) (rg 0), 0, 0, 0, 0, mask949 ov og, ?_⟩
    intro u
    interval_cases k <;> first | omega | skip
    all_goals
      simp only [fun949, side_bit, bare_bit, BitVec.getLsbD_and, AndCountCircuit.eval, AndCountCircuit.gateVal, AndCountCircuit.gateValFuel, AndCountCircuit.sideTrue, ex1]
      simp [choose949,side_zero,bare_zero,side_bit,bare_bit,Fin.reduceFinMk,Bool.or_assoc]
  · refine ⟨mask949 (lv 0) (lg 0), mask949 (rv 0) (rg 0), mask949 (lv 1) (lg 1), mask949 (rv 1) (rg 1), 0, 0, mask949 ov og, ?_⟩
    intro u
    interval_cases k <;> first | omega | skip
    all_goals
      simp only [fun949, side_bit, bare_bit, BitVec.getLsbD_and, AndCountCircuit.eval, AndCountCircuit.gateVal, AndCountCircuit.gateValFuel, AndCountCircuit.sideTrue, ex2]
      simp [choose949,side_zero,bare_zero,side_bit,bare_bit,Fin.reduceFinMk,Bool.or_assoc]
  · refine ⟨mask949 (lv 0) (lg 0), mask949 (rv 0) (rg 0), mask949 (lv 1) (lg 1), mask949 (rv 1) (rg 1), mask949 (lv 2) (lg 2), mask949 (rv 2) (rg 2), mask949 ov og, ?_⟩
    intro u
    interval_cases k <;> first | omega | skip
    all_goals
      simp only [fun949, side_bit, bare_bit, BitVec.getLsbD_and, AndCountCircuit.eval, AndCountCircuit.gateVal, AndCountCircuit.gateValFuel, AndCountCircuit.sideTrue, ex3]
      simp [choose949,side_zero,bare_zero,side_bit,bare_bit,Fin.reduceFinMk,Bool.or_assoc]

