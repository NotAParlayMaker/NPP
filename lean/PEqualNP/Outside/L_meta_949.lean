def rowSet949 (u : BitVec 6) : Finset (Fin 6) := Finset.univ.filter fun i => u.getLsbD i.val

def MaxInd949 (G : SimpleGraph (Fin 6)) (U : Finset (Fin 6)) : Prop :=
  (∀ a ∈ U, ∀ b ∈ U, ¬ G.Adj a b) ∧ (∀ v, v ∉ U → ∃ w ∈ U, G.Adj v w)

instance (G : SimpleGraph (Fin 6)) [DecidableRel G.Adj] (U : Finset (Fin 6)) :
    Decidable (MaxInd949 G U) := by unfold MaxInd949; infer_instance

