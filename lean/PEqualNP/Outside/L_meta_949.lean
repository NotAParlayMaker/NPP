theorem semanticRows949 : ∀ r : Fin 156, ∀ u : BitVec 6,
    let U := rowSet949 u
    let G := graphOfMask (representative r)
    ((neg949 r).getLsbD u.toNat = true → MaxInd949 G U) ∧
    ((pos949 r).getLsbD u.toNat = true → ∃ v ∈ U, MaxInd949 G (U.erase v)) := by decide +kernel

theorem actual_spec949 (r : Fin 156) (C : PEqualNP.AndCount.AndCountCircuit 6)
    (correct : ∀ U, MaxInd949 (graphOfMask (representative r)) U →
        C.eval U = false ∧ ∀ v, v ∉ U → C.eval (insert v U) = true)
    (k : ℕ) (s0 t0 s1 t1 s2 t2 o : BitVec 9)
    (enc : ∀ u : BitVec 6, (fun949 k s0 t0 s1 t1 s2 t2 o).getLsbD u.toNat = C.eval (rowSet949 u)) :
    spec949 k (neg949 r) (pos949 r) s0 t0 s1 t1 s2 t2 o := by
  constructor
  · apply BitVec.eq_of_getLsbD_eq
    intro i hi
    let u : BitVec 6 := BitVec.ofNat 6 i
    have hm : u.toNat = i := Nat.mod_eq_of_lt (by simpa using hi)
    have hh := (semanticRows949 r u).1
    rw [← hm]
    simp only [BitVec.getLsbD_and,BitVec.getLsbD_zero,enc]
    cases e : (neg949 r).getLsbD u.toNat
    · simp
    · simp [(correct _ (hh e)).1]
  · apply BitVec.eq_of_getLsbD_eq
    intro i hi
    let u : BitVec 6 := BitVec.ofNat 6 i
    have hm : u.toNat = i := Nat.mod_eq_of_lt (by simpa using hi)
    rw [← hm]
    simp only [BitVec.getLsbD_and,enc]
    cases e : (pos949 r).getLsbD u.toNat
    · simp
    · obtain ⟨v,hv,hm⟩ := (semanticRows949 r u).2 e
      have h := (correct _ hm).2 v (Finset.notMem_erase _ _)
      rw [Finset.insert_erase hv] at h
      simp [h]

