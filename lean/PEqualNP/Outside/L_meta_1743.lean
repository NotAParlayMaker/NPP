theorem PEqualNP.Outside.L_meta_1743 : ∀ (x1 : ℕ) (x2 : (Fin x1 → Bool) → Bool) (x3 : PEqualNP.CircuitLowerBounds.Circuit) (x4 : Fin x1),   PEqualNP.MetaComplexity.FanInTwo x3 →     PEqualNP.MetaComplexity.circuitFun x1 x3 = x2 →       (∀ (x7 : ℕ), PEqualNP.MetaComplexity.HasCircuitSize x1 x2 x7 → x3.size ≤ x7) →         (∃ (x8 : Fin x1 → Bool) (x9 : Fin x1 → Bool), x2 (Function.update x8 x4 Bool.false) ≠ x2 (Function.update x9 x4 Bool.false)) →           (have x9 : List PEqualNP.CircuitLowerBounds.Gate := List.filter (fun (x9 : PEqualNP.CircuitLowerBounds.Gate) => (List.take (bif x9.op.eval [Bool.false] then (1 : ℕ) else (2 : ℕ)) x9.inputs).contains ↑x4) x3.gates;             (4 : ℕ) ≤ x9.length ∨ x9.length = (3 : ℕ) ∧ ∃ x10 ∈ x9, x10.op ≠ PEqualNP.CircuitLowerBounds.GateOp.or) →             ∃ (x10 : ℕ), x10 + (4 : ℕ) ≤ x3.size ∧ PEqualNP.MetaComplexity.HasCircuitSize x1 (fun (x11 : Fin x1 → Bool) => x2 (Function.update x11 x4 Bool.false)) x10 := by
  classical
  intro m f C i hf he hmin hnc hr
  cases m with
  | zero => exact Fin.elim0 i
  | succ n =>
    have hcmin : IsMinimalCircuit (n+1) C := by
      refine ⟨hf, ?_⟩
      intro D hd hdC
      apply hmin D.size
      exact ⟨D, hd, le_rfl, fun x => congrFun (hdC.trans he) x⟩
    have hnmin := norm_min C (n+1) hcmin
    have hnfun : circuitFun (n+1) (norm C) = f := (norm_fun C (n+1)).trans he
    have hvar : ∃ x y, circuitFun (n+1) (norm C) x ≠ circuitFun (n+1) (norm C) y := by
      obtain ⟨x,y,h⟩ := hnc
      rw [hnfun]
      exact ⟨_,_,h⟩
    have hcl := minimum_clean (norm C) (n+1) (norm_legal C hf) hnmin hvar
    have L : Least (n+1) f (norm C).gates (norm C).output := by
      refine ⟨hcl, fun x => congrFun hnfun x, ?_⟩
      intro gs o hgs hgsf
      apply hnmin.2 ⟨gs,o⟩ (fun g hg => (clean_nok _ _ hgs g hg).1)
      funext x
      exact (hgsf x).trans (congrFun hnfun x).symm
    have hfil := norm_filter C hf i.val
    have hcount : ((norm C).gates.filter (fun g => g.inputs.contains i.val)).length =
        (C.gates.filter (eff i.val)).length := by rw [hfil, List.length_map]
    have hread : 4 ≤ ((norm C).gates.filter (fun g => g.inputs.contains i.val)).length ∨
        ((norm C).gates.filter (fun g => g.inputs.contains i.val)).length = 3 ∧
        ∃ g ∈ (norm C).gates, i.val ∈ g.inputs ∧ g.op ≠ GateOp.or := by
      change 4 ≤ (C.gates.filter (eff i.val)).length ∨
        (C.gates.filter (eff i.val)).length = 3 ∧
        ∃ g ∈ C.gates.filter (eff i.val), g.op ≠ GateOp.or at hr
      rcases hr with h4 | ⟨h3, g, hg, hop⟩
      · exact Or.inl (by omega)
      · obtain ⟨hg, hread⟩ := List.mem_filter.mp hg
        refine Or.inr ⟨by omega, Chain.normGate g, List.mem_map.mpr ⟨g,hg,rfl⟩, ?_, ?_⟩
        · have hh := norm_read g (hf g hg) i.val
          exact List.contains_iff_mem.mp (hh.trans hread)
        · simpa only [norm_op] using hop
    have hdrop := clean_drop n f (norm C) i L hnc hread
    simpa [Drop, PEqualNP.Outside.L_meta_1743.Bridge.norm, Circuit.size] using hdrop
