theorem PEqualNP.Outside.L_meta_1743 : ∀ (x1 : ℕ) (x2 : (Fin x1 → Bool) → Bool) (x3 : PEqualNP.CircuitLowerBounds.Circuit) (x4 : Fin x1),   PEqualNP.MetaComplexity.FanInTwo x3 →     PEqualNP.MetaComplexity.circuitFun x1 x3 = x2 →       (∀ (x7 : ℕ), PEqualNP.MetaComplexity.HasCircuitSize x1 x2 x7 → x3.size ≤ x7) →         (∃ (x8 : Fin x1 → Bool) (x9 : Fin x1 → Bool), x2 (Function.update x8 x4 Bool.false) ≠ x2 (Function.update x9 x4 Bool.false)) →           (have x9 : List PEqualNP.CircuitLowerBounds.Gate := List.filter (fun (x9 : PEqualNP.CircuitLowerBounds.Gate) => (List.take (bif x9.op.eval [Bool.false] then (1 : ℕ) else (2 : ℕ)) x9.inputs).contains ↑x4) x3.gates;             (4 : ℕ) ≤ x9.length ∨ x9.length = (3 : ℕ) ∧ ∃ x10 ∈ x9, x10.op ≠ PEqualNP.CircuitLowerBounds.GateOp.or) →             ∃ (x10 : ℕ), x10 + (4 : ℕ) ≤ x3.size ∧ PEqualNP.MetaComplexity.HasCircuitSize x1 (fun (x11 : Fin x1 → Bool) => x2 (Function.update x11 x4 Bool.false)) x10 := by
  intro x1 x2 x3 x4 hfan hfun hmin hnc hcnt
  obtain ⟨n, rfl⟩ : ∃ n, x1 = n + 1 := ⟨x1 - 1, by have := x4.isLt; omega⟩
  dsimp only at hcnt
  let gs := x3.gates.map normGate
  let o := x3.output
  have hok : ∀ g ∈ x3.gates, Ok g := fun g hg => hfan g hg
  have hnok : ∀ g ∈ gs, NOk g := by
    intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact normGate_nok g0 (hok g0 hg0)
  have hev : ∀ x : Fin (n + 1) → Bool, vl gs x o = x2 x := by
    intro x
    rw [← hfun]
    show (wiresFrom (x3.gates.map normGate) (List.ofFn x)).getD x3.output false
      = x3.eval (List.ofFn x)
    rw [wiresFrom_norm]; rfl
  have hfnc : ∃ y y' : Fin (n + 1) → Bool, x2 y ≠ x2 y' := by
    obtain ⟨y, y', h⟩ := hnc
    exact ⟨_, _, h⟩
  have hlen : gs.length = x3.size := by simp [gs, Circuit.size]
  have hcl : CleanL (n + 1) gs := by
    have hh := elim_has (n + 1) x2 gs o (fun g hg => (hnok g hg).1) hev hfnc
    have h1 := hmin _ hh
    rw [idStats_eq] at h1
    have hk := keep (n + 1) gs [] hnok
    simp only [List.length_nil, Nat.add_zero, Nat.zero_add] at hk
    intro p g hp
    exact hk (by rw [hlen]; exact h1) p g hp
  have L : Least (n + 1) x2 gs o := by
    refine ⟨hcl, hev, fun gs' o' hc' he' => ?_⟩
    have h := has_of_clean (n + 1) gs' o' hc'
    have e : (fun y => vl gs' y o') = x2 := funext he'
    rw [e] at h
    rw [hlen]
    exact hmin _ h
  have hread : ∀ p, (x3.gates[p]?.map fun (x9 : Gate) =>
      (List.take (bif x9.op.eval [false] then 1 else 2) x9.inputs).contains (x4 : ℕ))
        = some true → Reads gs p x4 := by
    intro p hp
    cases hq : x3.gates[p]? with
    | none => rw [hq] at hp; cases hp
    | some g =>
      rw [hq] at hp
      simp only [Option.map_some, Option.some.injEq] at hp
      refine ⟨normGate g, by simp [gs, hq], ?_⟩
      exact (reader_iff g (hok g (List.mem_iff_getElem?.2 ⟨p, hq⟩)) x4).1 hp
  set S := (Finset.range x3.gates.length).filter (fun p => (x3.gates[p]?.map fun (x9 : Gate) =>
      (List.take (bif x9.op.eval [false] then 1 else 2) x9.inputs).contains (x4 : ℕ))
        = some true) with hSdef
  have hS := card_pos x3.gates (fun (x9 : Gate) =>
      (List.take (bif x9.op.eval [false] then 1 else 2) x9.inputs).contains (x4 : ℕ))
  rw [← hSdef] at hS
  have hRC : ∀ p ∈ S, RC n gs x4 false p := by
    intro p hp
    exact rc_input false (hread p (Finset.mem_filter.1 hp).2)
  rcases hcnt with h4 | ⟨h3, x10, hx10, hop⟩
  · obtain ⟨T, hTS, hT⟩ := Finset.exists_subset_card_eq (show 4 ≤ S.card by rw [hS]; exact h4)
    obtain ⟨t, ht, hc⟩ := L.save x4 false hnc T (fun p hp => hRC p (hTS hp))
    rw [hT] at ht
    exact ⟨t, by rw [← hlen]; exact ht, hc⟩
  · obtain ⟨hx10m, hPx⟩ := List.mem_filter.1 hx10
    obtain ⟨r, hr0⟩ := List.mem_iff_getElem?.1 hx10m
    have hr : gs[r]? = some (normGate x10) := by simp [gs, hr0]
    have hrl : r < gs.length := (List.getElem?_eq_some_iff.1 hr).1
    have hir : (x4 : ℕ) ∈ (normGate x10).inputs := (reader_iff x10 (hok x10 hx10m) x4).1 hPx
    have hopr : (normGate x10).op ≠ GateOp.or := by rw [normGate_op]; exact hop
    have hfix : fixBit (normGate x10) = false := by
      unfold fixBit
      generalize (normGate x10).op = op at hopr ⊢
      cases op <;> simp_all
    have hC : IsC n gs x4 false (n + 1 + r) :=
      const_read n gs hcl x4 false r _ hr x4 hir (by rw [stF_self, hfix])
    obtain ⟨q, hrq, hRq, hRCq⟩ := L.next x4 false hnc r hrl hC
    have hqS : q ∉ S := by
      intro hqS
      exact not_both L hfnc x4 r q (normGate x10) hr hir hopr hrq hRq
        (hread q (Finset.mem_filter.1 hqS).2)
    have hcard : (insert q S).card = 4 := by
      rw [Finset.card_insert_of_notMem hqS, hS, h3]
    obtain ⟨t, ht, hc⟩ := L.save x4 false hnc (insert q S) (by
      intro p hp
      rcases Finset.mem_insert.1 hp with rfl | hp
      · exact hRCq
      · exact hRC p hp)
    rw [hcard] at ht
    exact ⟨t, by rw [← hlen]; exact ht, hc⟩
