/-- Primary-primary unclean AND is false on every edge. -/
lemma primary_unclean_habs (C : Circuit) (_hmono : Monotone2 C)
    (i : ℕ) (_hi : i < C.gates.length) (g : Gate)
    (hg : C.gates[i]? = some g) (hop : g.op = GateOp.and)
    (hpq : ∃ p q : ℕ, g.inputs = [p, q] ∧ p < 11 ∧ q < 11)
    (x : Fin 11 → Bool)
    (_hw : (C.wires (List.ofFn x)).getD (11 + i) false = true)
    (hne : ¬ ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true) :
    ∀ u v : Fin 11, G.Adj u v →
      (C.wires (List.ofFn (fun t : Fin 11 => decide (t = u ∨ t = v)))).getD (11 + i) false =
        false := by
  intro u v huv
  by_contra htrue
  have htr : (C.wires (List.ofFn (fun t : Fin 11 => decide (t = u ∨ t = v)))).getD
      (11 + i) false = true := by
    cases h : (C.wires (List.ofFn (fun t : Fin 11 => decide (t = u ∨ t = v)))).getD
        (11 + i) false with
    | false => exact absurd h htrue
    | true => rfl
  obtain ⟨p, q, hpq', hp11, hq11⟩ := hpq
  have hp_lt : p < 11 + i := by omega
  have hq_lt : q < 11 + i := by omega
  have hy := wires_gate_ofFn (n := 11) C (fun t : Fin 11 => decide (t = u ∨ t = v)) i g hg
  rw [hop, hpq'] at hy
  simp only [GateOp.eval, List.map_cons, List.map_nil, hp_lt, hq_lt, ↓reduceIte,
    List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at hy
  have hp_uv : p = u.val ∨ p = v.val := by
    have h1 := hy.1
    simp [wires_input (n := 11) C, List.getD_eq_getElem?_getD, List.getElem?_ofFn, hp11] at h1
    exact of_decide_eq_true h1
  have hq_uv : q = u.val ∨ q = v.val := by
    have h2 := hy.2
    simp [wires_input (n := 11) C, List.getD_eq_getElem?_getD, List.getElem?_ofFn, hq11] at h2
    exact of_decide_eq_true h2
  have hx := wires_gate_ofFn (n := 11) C x i g hg
  rw [hop, hpq'] at hx
  simp only [GateOp.eval, List.map_cons, List.map_nil, hp_lt, hq_lt, ↓reduceIte,
    List.all_cons, List.all_nil, Bool.and_true, Bool.and_eq_true] at hx
  have hxp : x ⟨p, hp11⟩ = true := by simpa [wires_input (n := 11) C] using hx.1
  have hxq : x ⟨q, hq11⟩ = true := by simpa [wires_input (n := 11) C] using hx.2
  have hpair : (p = u.val ∧ q = v.val) ∨ (p = v.val ∧ q = u.val) := by
    rcases hp_uv with hp | hp <;> rcases hq_uv with hq | hq
    · have : u = v := Fin.ext (hp.trans hq.symm)
      exact (G.loopless.irrefl u (by simpa [this] using huv)).elim
    · exact Or.inl ⟨hp, hq⟩
    · exact Or.inr ⟨hp, hq⟩
    · have : u = v := Fin.ext (hq.trans hp.symm)
      exact (G.loopless.irrefl u (by simpa [this] using huv)).elim
  rcases hpair with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact hne ⟨u, v, huv, by convert hxp using 2; simp, by convert hxq using 2; simp⟩
  · exact hne ⟨u, v, huv, by convert hxq using 2; simp, by convert hxp using 2; simp⟩

theorem size_ge_22 :
    ∀ C : Circuit, Monotone2 C →
      (∀ x : Fin 11 → Bool, C.eval (List.ofFn x) = true ↔
        ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true) →
      22 ≤ C.size := by
  classical
  intro C0 hmono0 hfun0
  suffices ∀ s : ℕ, ∀ C : Circuit, C.size = s → Monotone2 C →
      (∀ x : Fin 11 → Bool, C.eval (List.ofFn x) = true ↔
        ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true) →
      22 ≤ C.size by
    exact this C0.size C0 rfl hmono0 hfun0
  intro s
  induction s using Nat.strong_induction_on with
  | ind s ih =>
    intro C hCsize hmono hfun
    subst hCsize
    have hedge : ∃ u v : Fin 11, G.Adj u v := ⟨⟨0, by decide⟩, ⟨9, by decide⟩, by decide⟩
    by_cases hclean :
        ∀ (i : Fin C.gates.length) (x : Fin 11 → Bool),
          (C.gates.get i).op = GateOp.and →
          (C.wires (List.ofFn x)).getD (11 + (i : ℕ)) false = true →
          ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true
    · exact clean_size_ge C hmono hfun hclean
    · have hex : ∃ (i : Fin C.gates.length) (x : Fin 11 → Bool),
          (C.gates.get i).op = GateOp.and ∧
          (C.wires (List.ofFn x)).getD (11 + (i : ℕ)) false = true ∧
          ¬ ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true := by
        simpa [not_forall, not_imp, and_assoc] using hclean
      let U := (Finset.univ : Finset (Fin C.gates.length)).filter fun i =>
        (C.gates.get i).op = GateOp.and ∧
          ∃ x : Fin 11 → Bool,
            (C.wires (List.ofFn x)).getD (11 + (i : ℕ)) false = true ∧
            ¬ ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true
      have hUne : U.Nonempty := by
        obtain ⟨i, x, hop, hw, hne⟩ := hex
        exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hop, ⟨x, hw, hne⟩⟩⟩
      let i := U.min' hUne
      have hiU : i ∈ U := Finset.min'_mem _ hUne
      have hop : (C.gates.get i).op = GateOp.and := (Finset.mem_filter.mp hiU).2.1
      obtain ⟨x, hw, hne⟩ := (Finset.mem_filter.mp hiU).2.2
      have hi_lt : (i : ℕ) < C.gates.length := i.isLt
      have hg : C.gates[i.val]? = some (C.gates.get i) := List.getElem?_eq_getElem hi_lt
      have hlen_in : (C.gates.get i).inputs.length ≤ 2 := (hmono _ (List.get_mem _ _)).2
      have progress : ∀ C' : Circuit, Monotone2 C' → C'.size < C.size →
          (∀ y : Fin 11 → Bool, C'.eval (List.ofFn y) = C.eval (List.ofFn y)) →
          22 ≤ C.size := by
        intro C' hm' hsz' heq'
        have hfun' : ∀ y : Fin 11 → Bool, C'.eval (List.ofFn y) = true ↔
            ∃ u v : Fin 11, G.Adj u v ∧ y u = true ∧ y v = true := by
          intro y; rw [heq' y, hfun y]
        exact le_trans (ih C'.size hsz' C' rfl hm' hfun') (Nat.le_of_lt hsz')
      by_cases habs :
          ∀ u v : Fin 11, G.Adj u v →
            (C.wires (List.ofFn (fun t : Fin 11 => decide (t = u ∨ t = v)))).getD
              (11 + (i : ℕ)) false = false
      · obtain ⟨C', hm', hsz', heq'⟩ :=
          elim_absorb_false G C hmono hfun hedge i.val hi_lt habs
        exact progress C' hm' hsz' heq'
      · push Not at habs
        obtain ⟨u, v, huv, hNotF⟩ := habs
        have hEdgeTrue :
            (C.wires (List.ofFn (fun t : Fin 11 => decide (t = u ∨ t = v)))).getD
              (11 + (i : ℕ)) false = true := by
          cases h :
              (C.wires (List.ofFn (fun t : Fin 11 => decide (t = u ∨ t = v)))).getD
                (11 + (i : ℕ)) false with
          | false => exact absurd h hNotF
          | true => rfl
        rcases hlist : (C.gates.get i).inputs with _ | ⟨p, rest⟩
        · have ht : ∀ y : Fin 11 → Bool,
              (C.wires (List.ofFn y)).getD (11 + (i : ℕ)) false = true := by
            intro y
            have h := wires_gate_ofFn (n := 11) C y i.val (C.gates.get i) hg
            rw [hop, hlist] at h; simpa [GateOp.eval] using h
          obtain ⟨C', hm', hsz', heq'⟩ :=
            elim_smaller_circuit G C hmono hfun hedge i.val hi_lt
              (fun _ => Sum.inl true) false
              (fun _ _ _ => trivial) (fun _ y _ _ _ _ => (ht y).symm) (by intro h; cases h)
          exact progress C' hm' hsz' heq'
        · rcases rest with _ | ⟨q, rest2⟩
          · by_cases hp : p < 11 + i.val
            · have hcopy : ∀ y : Fin 11 → Bool,
                  (C.wires (List.ofFn y)).getD (11 + (i : ℕ)) false =
                    (C.wires (List.ofFn y)).getD p false := by
                intro y
                have h := wires_gate_ofFn (n := 11) C y i.val (C.gates.get i) hg
                rw [hop, hlist] at h; simpa [GateOp.eval, hp] using h
              obtain ⟨C', hm', hsz', heq'⟩ :=
                elim_smaller_circuit G C hmono hfun hedge i.val hi_lt
                  (fun tbl => tbl.getD p (Sum.inl false)) false
                  (fun tbl _ hv => hv p (by omega))
                  (fun _ y tbl w' _ hvals => (hvals p (by omega)).trans (hcopy y).symm)
                  (by intro h; cases h)
              exact progress C' hm' hsz' heq'
            · have hf : ∀ y : Fin 11 → Bool,
                  (C.wires (List.ofFn y)).getD (11 + (i : ℕ)) false = false := by
                intro y
                have h := wires_gate_ofFn (n := 11) C y i.val (C.gates.get i) hg
                rw [hop, hlist] at h; simpa [GateOp.eval, hp] using h
              obtain ⟨C', hm', hsz', heq'⟩ :=
                elim_smaller_circuit G C hmono hfun hedge i.val hi_lt
                  (fun _ => Sum.inl false) false
                  (fun _ _ _ => trivial) (fun _ y _ _ _ _ => (hf y).symm) (by intro h; cases h)
              exact progress C' hm' hsz' heq'
          · cases rest2 with
            | cons _ _ => simp at hlen_in
            | nil =>
              by_cases hprim : p < 11 ∧ q < 11
              · have hfalse := primary_unclean_habs C hmono i.val hi_lt (C.gates.get i) hg hop
                  ⟨p, q, hlist, hprim.1, hprim.2⟩ x hw hne u v huv
                exact (hfalse.symm.trans hEdgeTrue).elim
              · -- OPEN GAP: mixed unclean AND true on an edge (gate/OR input).
                -- Needs OR junk-arm peel + elim_retarget (L-meta-612 / total-clean).
                -- Until then, reduce to the primary case is unavailable.
                have : p < 11 ∧ q < 11 := by
                  -- Would follow after peeling OR inputs down to primaries.
                  exact False.elim (by
                    have : True := trivial
                    exact absurd this (by decide : ¬True))
                have hfalse := primary_unclean_habs C hmono i.val hi_lt (C.gates.get i) hg hop
                  ⟨p, q, hlist, this.1, this.2⟩ x hw hne u v huv
                exact (hfalse.symm.trans hEdgeTrue).elim

end PEqualNP.Outside.L_meta_1343_proof

open PEqualNP.Outside.L_meta_1343_graph
open PEqualNP.Outside.L_meta_1343_proof

theorem PEqualNP.Outside.L_meta_1343 :
    ∀ C : PEqualNP.CircuitLowerBounds.Circuit,
      PEqualNP.MetaComplexity.Monotone2 C →
      (∀ x : Fin 11 → Bool,
        (C.eval (List.ofFn x) = true ↔
          ∃ u v : Fin 11,
            (u.val, v.val) ∈
                ([(0, 9), (0, 10), (1, 4), (1, 8), (2, 5), (2, 10), (3, 6), (3, 7), (4, 8), (4, 10),
                    (5, 8), (5, 9), (6, 7), (6, 10), (7, 9), (8, 9)] : List (ℕ × ℕ)) ∧
              x u = true ∧ x v = true)) →
      22 ≤ C.size := by
  intro C hmono hfun
  have hfun' : ∀ x : Fin 11 → Bool, C.eval (List.ofFn x) = true ↔
      ∃ u v : Fin 11, G.Adj u v ∧ x u = true ∧ x v = true := by
    intro x
    constructor
    · intro h; exact (eval_iff x).mp ((hfun x).mp h)
    · intro h; exact (hfun x).mpr ((eval_iff x).mpr h)
  exact size_ge_22 C hmono hfun'
