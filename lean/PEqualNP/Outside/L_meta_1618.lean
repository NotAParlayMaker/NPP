-- a finite set covered by three sets has at most the sum of their sizes
theorem card3 {α : Type} [DecidableEq α] (S A B C : Finset α)
    (h : ∀ x ∈ S, x ∈ A ∨ x ∈ B ∨ x ∈ C) : S.card ≤ A.card + B.card + C.card := by
  have hsub : S ⊆ A ∪ B ∪ C := by
    intro x hx
    rcases h x hx with h1 | h1 | h1
    · exact Finset.mem_union_left _ (Finset.mem_union_left _ h1)
    · exact Finset.mem_union_left _ (Finset.mem_union_right _ h1)
    · exact Finset.mem_union_right _ h1
  calc S.card ≤ (A ∪ B ∪ C).card := Finset.card_le_card hsub
    _ ≤ (A ∪ B).card + C.card := Finset.card_union_le _ _
    _ ≤ A.card + B.card + C.card := Nat.add_le_add_right (Finset.card_union_le _ _) _

-- the three soundness classes exhaust the diagonal pairs
theorem classify {J U : Type} (Ta Tb Qa Qb : J → Prop) (Inc : U → Prop) (sA sB : J → U → Prop)
    {G : Prop}
    (hall : ∀ jk, Ta jk → Tb jk → Qa jk ∧ Qb jk)
    (hA : (∀ jk, Ta jk → Tb jk → Qa jk ∧ Qb jk ∧
      ∃ jt, Ta jt ∧ Tb jt ∧ ∃ ut, ¬ Inc ut ∧ (sA jt ut ∨ sB jt ut)) → G)
    (hB : (∀ jk, Ta jk → Tb jk → Qa jk ∧ Qb jk ∧
      (∀ jm, Ta jm → Tb jm → ∀ um, (sA jm um ∨ sB jm um) → Inc um) ∧
      ∃ jt, Ta jt ∧ Tb jt ∧ ∃ ut, (sA jt ut ∨ sB jt ut)) → G)
    (hC : (∀ jk, Ta jk → Tb jk → Qa jk ∧ Qb jk ∧
      ∀ jm, Ta jm → Tb jm → ∀ um, ¬ sA jm um ∧ ¬ sB jm um) → G) : G := by
  by_cases c1 : ∃ jt, Ta jt ∧ Tb jt ∧ ∃ ut, ¬ Inc ut ∧ (sA jt ut ∨ sB jt ut)
  · exact hA (fun jk ha hb => ⟨(hall jk ha hb).1, (hall jk ha hb).2, c1⟩)
  · by_cases c2 : ∃ jt, Ta jt ∧ Tb jt ∧ ∃ ut, (sA jt ut ∨ sB jt ut)
    · refine hB (fun jk ha hb => ⟨(hall jk ha hb).1, (hall jk ha hb).2, ?_, c2⟩)
      intro jm ha2 hb2 um hs
      by_contra hn
      exact c1 ⟨jm, ha2, hb2, um, hn, hs⟩
    · refine hC (fun jk ha hb => ⟨(hall jk ha hb).1, (hall jk ha hb).2, ?_⟩)
      intro jm ha2 hb2 um
      exact ⟨fun h => c2 ⟨jm, ha2, hb2, um, Or.inl h⟩, fun h => c2 ⟨jm, ha2, hb2, um, Or.inr h⟩⟩

