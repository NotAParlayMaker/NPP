    (residual : ∀ (x1 : List ℕ),   x1.length = (2 : ℕ) →     (∀ x3 ∈ x1, x3 = (1 : ℕ) ∨ x3 = (2 : ℕ) ∨ x3 = (3 : ℕ) ∨ x3 = (5 : ℕ) ∨ x3 = (8 : ℕ)) →       ((¬∀ x4 ∈ x1, x4 = (1 : ℕ) ∨ x4 = (5 : ℕ)) ∧ ¬∀ x4 ∈ x1, x4 = (2 : ℕ) ∨ x4 = (3 : ℕ) ∨ x4 = (8 : ℕ)) →         ∀ (x5 : PEqualNP.CircuitLowerBounds.Circuit),           PEqualNP.MetaComplexity.FanInTwo x5 →             x5.size = 13 →
            x5.gates.countP (fun gate =>
              GateOp.rec (motive := fun _ => Bool) false false true (fun _ => false) false gate.op) ≤ 1 →               ∃ (x8 : Fin (9 : ℕ) → Bool),                 have x9 : List Bool := List.ofFn x8 ++ [!x8 (0 : Fin (9 : ℕ))];                 x5.eval (x9 ++ [PEqualNP.CircuitLowerBounds.GateOp.or.eval (List.map (fun (x10 : ℕ) => x9.getD x10 Bool.false) x1)]) ≠ (x8 (0 : Fin (9 : ℕ)) && x8 (1 : Fin (9 : ℕ)) || x8 (1 : Fin (9 : ℕ)) && x8 (2 : Fin (9 : ℕ)) || x8 (2 : Fin (9 : ℕ)) && x8 (3 : Fin (9 : ℕ)) || x8 (3 : Fin (9 : ℕ)) && x8 (4 : Fin (9 : ℕ)) || x8 (4 : Fin (9 : ℕ)) && x8 (0 : Fin (9 : ℕ)) || x8 (0 : Fin (9 : ℕ)) && x8 (5 : Fin (9 : ℕ)) || x8 (1 : Fin (9 : ℕ)) && x8 (6 : Fin (9 : ℕ)) || x8 (2 : Fin (9 : ℕ)) && x8 (7 : Fin (9 : ℕ)) || x8 (3 : Fin (9 : ℕ)) && x8 (8 : Fin (9 : ℕ)) || x8 (5 : Fin (9 : ℕ)) && x8 (7 : Fin (9 : ℕ)) || x8 (6 : Fin (9 : ℕ)) && x8 (8 : Fin (9 : ℕ)) || x8 (8 : Fin (9 : ℕ)) && x8 (5 : Fin (9 : ℕ)))) :
    ∀ (x1 : List ℕ),   x1.length = (2 : ℕ) →     (∀ x3 ∈ x1, x3 = (1 : ℕ) ∨ x3 = (2 : ℕ) ∨ x3 = (3 : ℕ) ∨ x3 = (5 : ℕ) ∨ x3 = (8 : ℕ)) →       ((¬∀ x4 ∈ x1, x4 = (1 : ℕ) ∨ x4 = (5 : ℕ)) ∧ ¬∀ x4 ∈ x1, x4 = (2 : ℕ) ∨ x4 = (3 : ℕ) ∨ x4 = (8 : ℕ)) →         ∀ (x5 : PEqualNP.CircuitLowerBounds.Circuit),           PEqualNP.MetaComplexity.FanInTwo x5 →             x5.size ≤ (13 : ℕ) →               ∃ (x8 : Fin (9 : ℕ) → Bool),                 have x9 : List Bool := List.ofFn x8 ++ [!x8 (0 : Fin (9 : ℕ))];                 x5.eval (x9 ++ [PEqualNP.CircuitLowerBounds.GateOp.or.eval (List.map (fun (x10 : ℕ) => x9.getD x10 Bool.false) x1)]) ≠ (x8 (0 : Fin (9 : ℕ)) && x8 (1 : Fin (9 : ℕ)) || x8 (1 : Fin (9 : ℕ)) && x8 (2 : Fin (9 : ℕ)) || x8 (2 : Fin (9 : ℕ)) && x8 (3 : Fin (9 : ℕ)) || x8 (3 : Fin (9 : ℕ)) && x8 (4 : Fin (9 : ℕ)) || x8 (4 : Fin (9 : ℕ)) && x8 (0 : Fin (9 : ℕ)) || x8 (0 : Fin (9 : ℕ)) && x8 (5 : Fin (9 : ℕ)) || x8 (1 : Fin (9 : ℕ)) && x8 (6 : Fin (9 : ℕ)) || x8 (2 : Fin (9 : ℕ)) && x8 (7 : Fin (9 : ℕ)) || x8 (3 : Fin (9 : ℕ)) && x8 (8 : Fin (9 : ℕ)) || x8 (5 : Fin (9 : ℕ)) && x8 (7 : Fin (9 : ℕ)) || x8 (6 : Fin (9 : ℕ)) && x8 (8 : Fin (9 : ℕ)) || x8 (8 : Fin (9 : ℕ)) && x8 (5 : Fin (9 : ℕ))) := by
  intro ports portCount allowedPorts mixed tailCircuit fan size
  by_contra! computes
  let inverter : Gate := ⟨.not, [0]⟩
  let disjunction : Gate := ⟨.or, ports⟩
  let full : Circuit := ⟨inverter :: disjunction :: tailCircuit.gates, tailCircuit.output⟩
  let charged (gate : Gate) : Bool :=
    GateOp.rec (motive := fun _ => Bool) true true false (fun _ => true) true gate.op
  let negation (gate : Gate) : Bool :=
    GateOp.rec (motive := fun _ => Bool) false false true (fun _ => false) false gate.op
  let edge (x : Fin 9 → Bool) :=
    (x 0 && x 1) || (x 1 && x 2) || (x 2 && x 3) || (x 3 && x 4) ||
      (x 4 && x 0) || (x 0 && x 5) || (x 1 && x 6) || (x 2 && x 7) ||
      (x 3 && x 8) || (x 5 && x 7) || (x 6 && x 8) || (x 8 && x 5)
  let step (wires : List Bool) (gate : Gate) :=
    wires ++ [gate.op.eval (gate.inputs.map fun index => wires.getD index false)]
  have fanFull : FanInTwo full := by
    intro gate member
    change gate ∈ inverter :: disjunction :: tailCircuit.gates at member
    rcases List.mem_cons.mp member with rfl | rest
    · simp [inverter]
    rcases List.mem_cons.mp rest with rfl | existing
    · simp [disjunction, portCount]
    · exact fan gate existing
  have computesFull : circuitFun 9 full = edge := by
    funext x
    have firstBit : (List.ofFn x).getD 0 false = x 0 := by rw [List.ofFn_succ]; rfl
    have firstStep : step (List.ofFn x) inverter = List.ofFn x ++ [!x 0] := by
      change List.ofFn x ++ [!((List.ofFn x).getD 0 false)] = _
      rw [firstBit]
    change tailCircuit.eval (step (step (List.ofFn x) inverter) disjunction) = edge x
    rw [firstStep]
    exact Classical.not_not.mp (computes x)
  have fullSize : full.size = tailCircuit.size + 2 := by
    change (inverter :: disjunction :: tailCircuit.gates).length = tailCircuit.gates.length + 2
    simp
  have exactSize : tailCircuit.size = 13 := by
    have lower := totalLower full fanFull computesFull
    omega
  have fullCharged : full.gates.countP charged = tailCircuit.gates.countP charged + 1 := by
    change (inverter :: disjunction :: tailCircuit.gates).countP charged = _
    simp [inverter, disjunction, charged]
  have chargePartition (gates : List Gate) :
      gates.countP charged + gates.countP negation = gates.length := by
    induction gates with
    | nil => rfl
    | cons gate remaining inductionHypothesis =>
      cases operation : gate.op <;>
        simp [charged, negation, operation] at inductionHypothesis ⊢ <;> omega
  have fewNegations : tailCircuit.gates.countP negation ≤ 1 := by
    have lower := binaryLower full fanFull computesFull
    change 13 ≤ full.gates.countP charged at lower
    have partition := chargePartition tailCircuit.gates
    change tailCircuit.gates.length = 13 at exactSize
    omega
  obtain ⟨x, mismatch⟩ := residual ports portCount allowedPorts mixed tailCircuit fan exactSize fewNegations
  exact mismatch (Classical.not_not.mp (computes x))
