-- Reading the appended constant in an effective operand position makes this gate free in the signed representation. Count these savings throughout the second circuit.
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

def usesSlot (i : ℕ) (g : Gate) : Bool :=
  (if g.op.eval [false,false]=true then g.inputs.take 1 else g.inputs).contains i
lemma pairSimple (w : List Wire) (i j slot d : ℕ) (hd : d<4)
    (pin : (w.getD slot zero).2=0) (hit : i=slot ∨ j=slot) :
    simple w (combine d (w.getD i zero).2 (w.getD j zero).2) := by
  have deg : (w.getD i zero).2=0 ∨ (w.getD j zero).2=0 ∨ (w.getD i zero).2=(w.getD j zero).2 := by
    rcases hit with rfl|rfl
    · exact Or.inl pin
    · exact Or.inr (Or.inl pin)
  rcases combine_eq_cases _ _ _ hd deg with e|e|e
  · exact Or.inl e
  · rw [e];exact get_simple w i
  · rw [e];exact get_simple w j
lemma touchedSimple (w : List Wire) (slot : ℕ) (g : Gate) (arity : g.inputs.length≤2)
    (pin : (w.getD slot zero).2=0) (hit : usesSlot slot g=true) : simple w (gate w g).2 := by
  obtain ⟨op,xs⟩ := g
  change xs.length≤2 at arity
  cases op
  case and | or =>
    rcases xs with _|⟨i,_|⟨j,t⟩⟩
    · exact Or.inl rfl
    · exact get_simple w i
    · have e : t=[] := by cases t <;> simp_all
      subst t
      change [i,j].contains slot=true at hit
      have h' : slot=i ∨ slot=j := by simpa only [List.mem_cons,List.not_mem_nil,or_false] using (List.contains_iff_mem.mp hit)
      have readSlot : i=slot ∨ j=slot := h'.imp Eq.symm Eq.symm
      exact pairSimple w i j slot _ (op_lt _ _) pin readSlot
  all_goals first | exact get_simple w _ | exact Or.inl rfl
lemma canPay (w : List Wire) (g : Gate) : priced w true (gate w g).2 := by
  rcases gate_priced w g with early|⟨_,fresh⟩
  · exact Or.inl early
  · exact Or.inr ⟨rfl,fresh⟩
def admissible (pay : Gate→Bool) : List Gate → List Wire → Prop
  | [],_ => True
  | g::gs,w => priced w (pay g) (gate w g).2 ∧ admissible pay gs (w++[gate w g])
theorem paidPrefix (gs : List Gate) (w : List Wire) : admissible (fun _ => true) gs w := by
  induction gs generalizing w with
  | nil => trivial
  | cons g gs ih => exact ⟨canPay w g,ih _⟩
theorem paidSuffix (gs : List Gate) (w : List Wire) (slot : ℕ) (present : slot<w.length)
    (pin : (w.getD slot zero).2=0) (legal : ∀ g∈gs,g.inputs.length≤2) :
    admissible (fun g => !usesSlot slot g) gs w := by
  induction gs generalizing w with
  | nil => trivial
  | cons g gs ih =>
    constructor
    · cases e : usesSlot slot g
      · simpa only [e,Bool.not_false] using canPay w g
      · exact Or.inl (touchedSimple w slot g (legal g List.mem_cons_self) pin e)
    · apply ih _ (by simp;omega) _ (fun v hv => legal _ (.tail _ hv))
      simpa [List.getD_eq_getElem?_getD,List.getElem?_append_left present] using pin

theorem rewind {m k S} (live : Live m k S) (gs : List Gate) (w : List Wire) (pay : Gate→Bool)
    (legal : admissible pay gs w) (sub : ∀ a∈S,a∈reps (execute gs w)) :
    ∃ l T,l≤k+gs.countP pay ∧ Live m l T ∧ ∀ a∈T,a∈reps w := by
  induction gs generalizing w with
  | nil => exact ⟨k,S,by simp,live,sub⟩
  | cons g gs ih =>
    obtain ⟨n,U,lim,ht,raw⟩ := ih (w++[gate w g]) legal.2 sub
    have old : ∀ a∈U,a∈reps w++[(gate w g).2] := by simpa [reps] using raw
    obtain ⟨l,T,le,ok,base⟩ := pull ht legal.1 old
    refine ⟨l,T,?_,ok,base⟩
    cases e : pay g <;> simp [e,Bool.toNat] at le ⊢ <;> omega
lemma execute_size (gs : List Gate) (w : List Wire) : (execute gs w).length=w.length+gs.length := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (execute gs (w++[gate w g])).length = _
    rw [ih];simp;omega
lemma count_partition (gs : List Gate) (p : Gate→Bool) :
    gs.countP p + gs.countP (fun g => !p g)=gs.length := by
  induction gs with
  | nil => rfl
  | cons g gs ih => cases e : p g <;> simp [e] <;> omega
end PEqualNP.Outside.L_meta_3059_aux

