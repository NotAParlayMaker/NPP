-- After setting inputs 0 and 3 to zero, the remaining six vertices form a cycle. Its 48 pivotal pairs suffice to rule out seven binary gates. Two additional pairs force inputs 0 and 3 to be live before restriction.
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
def baseGraph (x : Fin 8 → Bool) := x 0 && x 1 || x 1 && x 2 || x 2 && x 3 || x 0 && x 4 || x 1 && x 5 || x 2 && x 6 || x 3 && x 7 || x 4 && x 6 || x 5 && x 7 || x 7 && x 4
def target (x : Fin 8 → Bool) := baseGraph x || x 0 || x 3
def posBits : ℕ := 0x801e2e0e0d2d0c6c4c4b4b0a4a4a2a0a0949492929090868674707064646262545252505046444436323226222216160606
def negBits : ℕ := 0xc2c060c2c0c2c08434308424828020841482128010848234603060246042144212401042400434301224200214120402
def sample (bank : ℕ) (i : Fin 50) (j : Fin 8) := bank.testBit (8*i.val+j.val)
def inputs : List ℕ := [0x1000000000000,0x25021881642549408660d93ff,0x6c61448192807b187321e4f,0x2000000000000,0x302a50a8e3018c1f9c3e38c,0x834807e00d80e0fe01fc03f0,0x3f80002b56000ff0001fffc00,0x37cb558000000fffffe000000]
def seeds : List Wire := inputs.map (fun a => (false,a))
theorem listed : ∀ i : Fin 50, seeds.map (read i.val)=List.ofFn (sample posBits i) ∧
    seeds.map (read (50+i.val))=List.ofFn (sample negBits i) := by decide +kernel
theorem labels : ∀ i : Fin 50, target (sample posBits i)=true ∧ target (sample negBits i)=false := by decide +kernel
theorem essential : ∀ a∈inputs, ∃ i : Fin 50, ∀ b∈inputs, b.testBit i.val≠b.testBit (50+i.val) → b=a := by decide +kernel
theorem initial {k S} (live : Live 50 k S) (sub : ∀ a∈S,a∈inputs) : S=inputs.toFinset := by
  apply Finset.Subset.antisymm (fun a ha => List.mem_toFinset.mpr (sub a ha))
  intro a ha
  obtain ⟨i,h⟩ := essential a (List.mem_toFinset.mp ha)
  obtain ⟨b,hb,sep⟩ := liveSeparates live i.val i.isLt
  exact h b (sub b hb) sep ▸ hb
set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
theorem noNine : cutSearch 50 0xffffffffffff 9 inputs=false := by decide +kernel
theorem atLeastTen {k S} (live : Live 50 k S) (sub : ∀ a∈S,a∈inputs) : 10≤k := by
  have S' := initial live sub
  by_contra small
  have hit := cut_complete (by decide) live inputs S'.symm (by decide +kernel) 0xffffffffffff 9 (by omega)
  exact Bool.noConfusion (noNine.symm.trans hit)
end PEqualNP.Outside.L_meta_3059_aux

