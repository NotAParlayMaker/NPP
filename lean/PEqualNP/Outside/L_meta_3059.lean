-- Run both circuits on both sides of each sampled pair and pull the live trace back across the appended constant.
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

theorem costBound (P S : Circuit) (b : Bool) (hp : FanInTwo P) (hs : FanInTwo S)
    (computes : ∀ x : Fin 8 → Bool,S.eval (P.wires (List.ofFn x)++[b])=target x) :
    10+S.gates.countP (usesSlot (8+P.size))≤P.size+S.size := by
  let A := execute P.gates seeds
  let slot := 8+P.size
  let B := A++[(b,0)]
  let F := execute S.gates B
  let out := F.getD S.output zero
  have sizeA : A.length=slot := by
