structure RegisterTable where
  word : Nat → Nat
  bankWidth : Nat
  banks : Nat → Nat
  metadata : Nat → Nat
  links : Nat → Nat

private def unpack (word : Nat → Nat) : Nat → Nat → List (Nat × Nat)
  | 0,_ => []
  | nk+1,w => if w ≤ 1 then [] else
    let t := w % 4096
    (word (t/4), t%4) :: unpack word nk (w >>> 12)

def bank (d : RegisterTable) (i : Nat) :=
  unpack d.word 12 ((d.banks (i/32) >>> (d.bankWidth*(i%32))) % (2^d.bankWidth))

def metaEntry (d : RegisterTable) (i : Nat) := (d.metadata (i/32) >>> (32*(i%32))) % (2^32)
def level (d : RegisterTable) (i : Nat) := metaEntry d i % 16
def next (d : RegisterTable) (i : Nat) :=
  (List.range' (metaEntry d i / 2048) ((metaEntry d i/16)%128)).map fun j =>
    (d.links (j/32) >>> (12*(j%32))) % 4096

