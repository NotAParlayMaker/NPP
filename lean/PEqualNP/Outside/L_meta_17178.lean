def petersen (x : Fin 10 → Bool) : Bool :=
  x 0 && x 1 || x 1 && x 2 || x 2 && x 3 || x 3 && x 4 || x 4 && x 0 || x 0 && x 5 || x 1 && x 6 || x 2 && x 7 || x 3 && x 8 || x 4 && x 9 || x 5 && x 7 || x 7 && x 9 || x 9 && x 6 || x 6 && x 8 || x 8 && x 5
def bitRow (n k : Nat) (i : Fin n) : Bool := k.testBit i.val
def f9 (b : Bool) (z : Fin 9 → Bool) := petersen (Fin.snoc z b)
def f8 (b c : Bool) (z : Fin 8 → Bool) := f9 b (Fin.snoc z c)
def witness (b c : Bool) (i : Fin 8) : Fin 8 → Bool :=
  bitRow 8 (([2, 1, 2, 4, 1, 1, 2, 4, 2, 1, 2, 0, 1, 0, 0, 4, 2, 1, 2, 4, 0, 1, 0, 0, 2, 1, 2, 0, 0, 0, 0, 0] : List Nat).getD (b.toNat*16+c.toNat*8+i.val) 0)

theorem dep8 : ∀ b c (i : Fin 8),
    f8 b c (Function.update (witness b c i) i (!(witness b c i i))) ≠ f8 b c (witness b c i) := by
  decide +kernel

theorem smallImpossible : ¬ HasCircuitSize 10 petersen 10 := by
  intro h
  have h9 : ∀ b, f9 b (bitRow 9 0) ≠ f9 b (bitRow 9 3) := by decide +kernel
  obtain ⟨b,s,hs,hb⟩ := gate_elim_two 9 petersen 10
    ⟨bitRow 10 16, by decide +kernel⟩ (fun b => ⟨bitRow 9 0,bitRow 9 3,h9 b⟩) h
  have de : ∀ b, f9 b (Function.update (bitRow 9 8) (Fin.last 8) (!(bitRow 9 8 (Fin.last 8)))) ≠ f9 b (bitRow 9 8) := by decide +kernel
  have c8 : ∀ b c, f8 b c (bitRow 8 0) ≠ f8 b c (bitRow 8 3) := by decide +kernel
  obtain ⟨c,t,ht,hc⟩ := gate_elim_two 8 (f9 b) s
    ⟨bitRow 9 8,de b⟩ (fun c => ⟨bitRow 8 0,bitRow 8 3,c8 b c⟩) hb
  have bound := dep_lower 8 (f8 b c) (fun i => ⟨witness b c i,dep8 b c i⟩) t hc
  omega

end PEqualNP.Outside.L_meta_17178_aux.Fast

