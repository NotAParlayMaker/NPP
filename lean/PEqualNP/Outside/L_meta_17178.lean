theorem payOr (f : (Fin 10 → Bool) → Bool) (D : Circuit) (hs : D.size ≤ 9)
    (hd : FanInTwo D)
    (ev : ∀ x : Fin 10 → Bool, D.eval (List.ofFn x ++ [x 0 || x 2]) = f x) :
    HasCircuitSize 10 f 10 := by
  let g : Gate := ⟨.or, [0,2]⟩
  let C : Circuit := ⟨g :: D.gates, D.output⟩
  refine ⟨C, ?_, ?_, ?_⟩
  · intro h hh
    change h ∈ g :: D.gates at hh
    rcases List.mem_cons.mp hh with rfl | hm
    · simp [g]
    · exact hd h hm
  · change D.gates.length + 1 ≤ 10
    change D.gates.length ≤ 9 at hs
    omega
  · intro x
    rw [← ev x]
    change (D.gates.foldl _ (List.ofFn x ++ [g.op.eval (g.inputs.map fun i => (List.ofFn x).getD i false)])).getD D.output false =
      (D.gates.foldl _ (List.ofFn x ++ [x 0 || x 2])).getD D.output false
    simp [g, GateOp.eval]

end PEqualNP.Outside.L_meta_17178.SmallInput

