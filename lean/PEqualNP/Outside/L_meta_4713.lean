def witness (s : ℕ) : ℕ × List ℕ :=
  let page := pages[s / 64]?.getD #[]
  page[s % 64]?.getD (0, [])

def vertices (m : ℕ) : Finset (Fin 11) := Finset.univ.filter fun i => m.testBit i.val = true

def enc (s : Finset (Fin 11)) : BitVec 11 :=
  (BitVec.ofBoolListLE (List.ofFn fun i : Fin 11 => decide (i ∈ s))).cast List.length_ofFn

theorem enc_bit (s : Finset (Fin 11)) (i : Fin 11) :
    (enc s).toNat.testBit i.val = decide (i ∈ s) := by
  change (enc s).getLsbD i.val = _
  rw [enc, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE]
  have h : i.val < (List.ofFn fun j : Fin 11 => decide (j ∈ s)).length := by
    simpa only [List.length_ofFn] using i.isLt
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_ofFn h

def spec (s y : ℕ) (ps : List ℕ) : Prop :=
  ps.Pairwise (fun a b => a &&& b = 0) ∧
  (∀ p ∈ ps, p ∈ patterns ∧ ∀ i : Fin 11, s.testBit i.val = true → p.testBit i.val = false) ∧
  (∀ e ∈ edges, (s.testBit e.1 = true ∨ y.testBit e.1 = true) ∨
               (s.testBit e.2 = true ∨ y.testBit e.2 = true)) ∧
  (vertices y).card ≤ (ps.map fun p => (p.bitIndices.length + 1) / 2).sum

def test (s : ℕ) : Bool :=
  let w := witness s
  @decide (spec s w.1 w.2) (by unfold spec; infer_instance)

