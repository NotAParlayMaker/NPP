theorem rows (i : Fin 2048) : test i.val = true := by
  have hk : i.val / 64 < 32 := by have hi := i.isLt; omega
  have hj : i.val % 64 < 64 := Nat.mod_lt _ (by decide)
  have h := blocks ⟨i.val / 64, hk⟩ ⟨i.val % 64, hj⟩
