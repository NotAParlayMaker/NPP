-- Section 3: Lower bound 7 and 7-gate monotone witness for 0xeaa8e8a8.

def target5 (x : Fin 5 → Bool) : Bool :=
  Nat.testBit 0xeaa8e8a8 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0)

def assign4 (k : Fin 16) (i : Fin 4) : Bool := bit4 k (ins4.getD i.val 0)

theorem lower4_of_safe (target : T4) (ht0 : target ≠ 0) (hsafe : safe4 target 4 ins4)
    (g : (Fin 4 → Bool) → Bool) (hmatch : ∀ k : Fin 16, g (assign4 k) = bit4 k target)
    (s : ℕ) (h : HasCircuitSize 4 g s) : 5 ≤ s := by
  by_contra hlt
  obtain ⟨C, hg, hsize, he⟩ := h
  have hlen : C.gates.length ≤ 4 := by
    change C.gates.length ≤ s at hsize
    omega
  apply exclude4 target ht0 C.gates C.output hg ins4 ins4 (fun _ hx => hx) 4 hlen hsafe
  intro k
  have hi : ∀ t : Fin 16, List.ofFn (assign4 t) = ins4.map (bit4 t) := by decide
  unfold step4
  simpa only [Circuit.eval, Circuit.wires, hi, hmatch] using he (assign4 k)

theorem dep_last : ∃ x : Fin 5 → Bool,
    target5 (Function.update x (Fin.last 4) (!x (Fin.last 4))) ≠ target5 x := by
  refine ⟨fun i => decide (i = 0 ∨ i = 3), ?_⟩
  decide +kernel

theorem nc_last : ∀ b : Bool, ∃ y y' : Fin 4 → Bool,
    target5 (Fin.snoc y b) ≠ target5 (Fin.snoc y' b) := by
  intro b
  cases b with
  | false => exact ⟨fun _ => false, fun _ => true, by decide +kernel⟩
  | true => exact ⟨fun _ => false, fun _ => true, by decide +kernel⟩

theorem lower5 (s : ℕ) (h : HasCircuitSize 5 target5 s) : 7 ≤ s := by
  obtain ⟨b, s', hle, hsub⟩ := gate_elim_two 4 target5 s dep_last nc_last h
  cases b with
  | false =>
    have h5 : 5 ≤ s' := lower4_of_safe 0xe8a8 (by decide) safe_e8a8 _ (by decide +kernel) s' hsub
    omega
  | true =>
    have h5 : 5 ≤ s' := lower4_of_safe 0xeaa8 (by decide) safe_eaa8 _ (by decide +kernel) s' hsub
    omega

def witness : Circuit :=
  { gates := [
      ⟨GateOp.or, [1, 2]⟩,
      ⟨GateOp.and, [1, 2]⟩,
      ⟨GateOp.and, [3, 4]⟩,
      ⟨GateOp.or, [5, 7]⟩,
      ⟨GateOp.and, [0, 8]⟩,
      ⟨GateOp.and, [6, 3]⟩,
      ⟨GateOp.or, [9, 10]⟩
    ],
    output := 11 }

theorem witness_mono : Monotone2 witness := by
  intro g hg
  simp only [witness, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem witness_eval : ∀ x : Fin 5 → Bool, witness.eval (List.ofFn x) = target5 x := by
  decide +kernel

theorem main_8655 : ∀ s : ℕ, HasCircuitSize 5 target5 s →
    ∃ C : Circuit, Monotone2 C ∧ C.size ≤ s ∧
      ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = target5 x :=
  fun s h => ⟨witness, witness_mono, le_trans (by decide : witness.size ≤ 7) (lower5 s h), witness_eval⟩

end PEqualNP.Outside.L_meta_8655

theorem PEqualNP.Outside.L_meta_8655 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 5 (fun x : Fin 5 → Bool => Nat.testBit 0xeaa8e8a8 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 5 → Bool, C.eval (List.ofFn x) = Nat.testBit 0xeaa8e8a8 (∑ i : Fin 5, if x i then 2 ^ (i : ℕ) else 0) :=
  PEqualNP.Outside.L_meta_8655.main_8655
