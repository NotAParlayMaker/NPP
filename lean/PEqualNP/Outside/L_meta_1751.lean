namespace PEqualNP.Outside.L_meta_1751

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity.NestedCover

def Lev : SimpleGraph (Fin 26) where
  Adj u v := adjB u v = true
  symm := ⟨fun u v h => adj_symm u v h⟩
  loopless := ⟨fun u h => by
    have h' : adjB u u = true := h
    rw [adj_irr u] at h'
    exact Bool.false_ne_true h'⟩

def pbit (p l : Fin 13) : Fin 26 → Bool :=
  Fin.append (fun x6 : Fin 13 => decide (x6 = p)) (fun x6 : Fin 13 => decide (x6 = l))

lemma pbit_true_all : ∀ p l : Fin 13, ∀ u : Fin 26, pbit p l u = true →
    u = Fin.castAdd 13 p ∨ u = Fin.natAdd 13 l := by
  decide +kernel

lemma pbit_true (p l : Fin 13) (u : Fin 26) (h : pbit p l u = true) :
    u = Fin.castAdd 13 p ∨ u = Fin.natAdd 13 l :=
  pbit_true_all p l u h

lemma castAdd_ne_natAdd (i j : Fin 13) : Fin.castAdd 13 i ≠ Fin.natAdd 13 j := by
  intro h
  have := congrArg Fin.val h
  simp only [Fin.val_castAdd, Fin.val_natAdd] at this
  have := i.isLt
  omega

lemma flag_meet {i j : Fin 13} {x y : Fin 26} (hi : x = Fin.castAdd 13 i ∨ x = Fin.natAdd 13 i)
    (hj : y = Fin.castAdd 13 j ∨ y = Fin.natAdd 13 j) (h : x = y) : i = j := by
  apply Fin.ext
  have hi' : x.val = i.val ∨ x.val = 13 + i.val := by
    rcases hi with rfl | rfl <;> simp <;> omega
  have hj' : y.val = j.val ∨ y.val = 13 + j.val := by
    rcases hj with rfl | rfl <;> simp <;> omega
  subst h
  have := i.isLt
  have := j.isLt
  omega

lemma sym_mem {a b c d : Fin 26} (h : s(a, b) = s(c, d)) : (c = a ∨ c = b) ∧ (d = a ∨ d = b) := by
  rw [Sym2.eq_iff] at h
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact ⟨Or.inl h1.symm, Or.inr h2.symm⟩
  · exact ⟨Or.inr h2.symm, Or.inl h1.symm⟩

theorem core (C : Circuit) (hmono : PEqualNP.MetaComplexity.Monotone2 C) (hrb : ReadsBack 26 C)
    (hacc : ∀ p l : Fin 13, p - l ∈ D13 → S90.val C (List.ofFn (pbit p l)) C.output = true)
    (hrej : ∀ Q ∈ QLst, S90.val C (List.ofFn (qbit Q)) C.output = false)
    (hno : ∀ i j, (gateAt C i).op = GateOp.and → (gateAt C j).op = GateOp.and →
      ¬ PEqualNP.EdgeOwnership.InCone 26 C i j) :
    64 ≤ C.size := by
  classical
  have hAO : ∀ k, k < C.gates.length →
      (gateAt C k).op = GateOp.and ∨ (gateAt C k).op = GateOp.or := by
    intro k hk
    exact (hmono _ (S90.gateAt_mem hk)).1
  have hlen2 : ∀ k, (gateAt C k).inputs.length ≤ 2 := by
    intro k
    by_cases hk : k < C.gates.length
    · exact (hmono _ (S90.gateAt_mem hk)).2
    · rw [gateAt_ge (by omega)]
      simp
  have hback : ∀ k, ∀ i ∈ (gateAt C k).inputs, i < 26 + k := by
    intro k i hi
    by_cases hk : k < C.gates.length
    · exact hrb k hk i hi
    · rw [gateAt_ge (by omega)] at hi
      simp at hi
  have hx : ∀ x : Fin 26 → Bool, (List.ofFn x).length = 26 := fun x => by simp
  have hnovar : ∀ v : Fin 26, ¬ Relation.ReflTransGen (S90.OrStep 26 C) C.output v.val := by
    intro v hv
    obtain ⟨Q, hQ, hb, -⟩ := QL_cover v v (adj_irr v)
    have h1 := S90.reach_var_val (qbit Q) C.output v hv hb
    rw [hrej Q hQ] at h1
    exact Bool.false_ne_true h1
  have hvar_up : ∀ w (u : Fin 26), u ∈ PEqualNP.TopForm.orIn 26 C w → ∀ x : Fin 26 → Bool,
