    intro w u hu x hxu
    exact S90.reach_var_val x w u (S90.mem_orIn_reach u hu) hxu
  obtain ⟨r, hr, hout⟩ : ∃ r, r < C.gates.length ∧ C.output = 26 + r := by
    by_cases h1 : C.output < 26
    · exact (hnovar ⟨C.output, h1⟩ Relation.ReflTransGen.refl).elim
    · by_cases h2 : 26 + C.gates.length ≤ C.output
      · have := hacc 0 0 (by decide)
        rw [S90.val_ge (hx _) h2] at this
        exact absurd this Bool.false_ne_true
      · exact ⟨C.output - 26, by omega, by omega⟩
  set R : Finset ℕ := (Finset.range C.gates.length).filter
    (fun k => Relation.ReflTransGen (S90.OrStep 26 C) C.output (26 + k)) with hRdef
  have hmemR : ∀ k, k ∈ R ↔ k < C.gates.length ∧
      Relation.ReflTransGen (S90.OrStep 26 C) C.output (26 + k) := by
    intro k
    rw [hRdef, Finset.mem_filter, Finset.mem_range]
