    have hop : (gateAt C a).op = GateOp.and := (Finset.mem_filter.1 haT).2
    have ha : a < C.gates.length := ((hmemR a).1 haR).1
    have hl := hlen2 a
    rcases hI : (gateAt C a).inputs with _ | ⟨w1, _ | ⟨w2, _ | ⟨w3, rest⟩⟩⟩
    · exfalso
