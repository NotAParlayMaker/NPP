      ∀ u ∈ PEqualNP.TopForm.orIn 26 C w1, ∀ v ∈ PEqualNP.TopForm.orIn 26 C w2, Lev.Adj u v := by
    intro a haT w1 w2 hI u hu v hv
    have haR : a ∈ R := (Finset.mem_filter.1 haT).1
    have hop : (gateAt C a).op = GateOp.and := (Finset.mem_filter.1 haT).2
    have ha : a < C.gates.length := ((hmemR a).1 haR).1
