    have hsub : R.erase r ⊆ Ror.biUnion (fun p => (Finset.univ : Finset (Fin 2)).image
        (fun b : Fin 2 => (gateAt C p).inputs.getD (b : ℕ) 0 - 26)) := by
      intro k hk
      rw [Finset.mem_erase] at hk
