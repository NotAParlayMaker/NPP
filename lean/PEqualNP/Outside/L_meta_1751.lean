      · exact absurd (by omega : k = r) hkr
      · obtain ⟨p, hp, rfl, hpor, hin, -⟩ := hstep
        rw [Finset.mem_biUnion]
        refine ⟨p, Finset.mem_filter.2 ⟨(hmemR p).2 ⟨hp, by rw [hout]; exact hc⟩, hpor⟩, ?_⟩
        rw [Finset.mem_image]
        have hl := hlen2 p
        rcases hI : (gateAt C p).inputs with _ | ⟨x, _ | ⟨y, _ | ⟨z, rest⟩⟩⟩
