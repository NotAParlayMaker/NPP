      · exact ⟨adj_symm _ _ h5, h3⟩
    have := (Finset.card_le_card hsub).trans (c4 a c hac)
    rw [Finset.card_pair hbd] at this
    omega
  have hop0 : ∀ a w1 w2, (gateAt C a).inputs = [w1, w2] → PEqualNP.TopForm.opnd C a 0 = w1 := by
    intro a w1 w2 hI
    simp [PEqualNP.TopForm.opnd, hI]
  have hop1 : ∀ a w1 w2, (gateAt C a).inputs = [w1, w2] → PEqualNP.TopForm.opnd C a 1 = w2 := by
    intro a w1 w2 hI
    simp [PEqualNP.TopForm.opnd, hI]
  have hstar : ∀ a, a ∈ T →
      (∀ u, u ∈ PEqualNP.TopForm.orIn 26 C (PEqualNP.TopForm.opnd C a 0) →
