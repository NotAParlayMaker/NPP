        · exact ⟨hback a _ (by rw [hI]; simp), hvar_up _ v hv _ hqv⟩
        · simp at hi
      rw [hRdead a haR Q hQ] at h1
      exact Bool.false_ne_true h1
    · rfl
  have h4 : ∀ a b c d : Fin 26, a ≠ c → b ≠ d →
      ¬ (Lev.Adj a b ∧ Lev.Adj b c ∧ Lev.Adj c d ∧ Lev.Adj d a) := by
    rintro a b c d hac hbd ⟨h1, h2, h3, h5⟩
    have hsub : ({b, d} : Finset (Fin 26)) ⊆ (Finset.univ : Finset (Fin 26)).filter
