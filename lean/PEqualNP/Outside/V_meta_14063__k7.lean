  ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (155 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t → 7 ≤ t :=
  ⟨⟨PEqualNP.Outside.V_meta_14063__k7.C, by simp [PEqualNP.Outside.V_meta_14063__k7.C, PEqualNP.MetaComplexity.FanInTwo], by decide, by decide +kernel⟩, PEqualNP.Outside.V_meta_14063__k7.lower⟩
