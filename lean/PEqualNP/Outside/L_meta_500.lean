theorem iterate_length_measure (g : List Bool → List Bool) (m : List Bool → ℕ)
    (hm : ∀ y : List Bool, m (g y) ≤ m y)
    (hg : ∀ y : List Bool, (g y).length ≤ y.length + m y) (y : List Bool) :
    ∀ j : ℕ, m (g^[j] y) ≤ m y ∧ (g^[j] y).length ≤ y.length + j * m y := by
  intro j
  induction j with
  | zero => simp
  | succ j ih =>
    rw [Function.iterate_succ_apply', Nat.succ_mul]
    have h1 := hm (g^[j] y)
    have h2 := hg (g^[j] y)
    obtain ⟨i1, i2⟩ := ih
    generalize j * m y = A at i2 ⊢
    exact ⟨by omega, by omega⟩

theorem measure_arith (A B L V y u : ℕ) (hLV : L ≤ V) (hAB : A ≤ B) :
    A + 2 * L + 2 * y + u + 5 ≤ B + 2 * V + 3 * (y + u) + 5 := by
  omega

theorem iter_polyTime_measure (g : List Bool → List Bool)
    (c : Turing.TM2ComputableInPolyTime (fun x : List Bool => x) (fun x : List Bool => x) g)
    (m : List Bool → ℕ) (a : ℕ)
    (hm : ∀ y : List Bool, m (g y) ≤ m y)
    (hg : ∀ y : List Bool, (g y).length ≤ y.length + m y)
    (ha : ∀ y : List Bool, m y ≤ a * y.length + a) :
    Nonempty (Turing.TM2ComputableInPolyTime PEqualNP.Library.encodePair
      (fun x : List Bool => x) (fun p : List Bool × List Bool => g^[p.2.length] p.1)) := by
  let e₀ : Bool → c.tm.Γ c.tm.k₀ := c.inputAlphabet.invFun
  let d₀ : c.tm.Γ c.tm.k₀ → Bool := c.inputAlphabet
  let e₁ : c.tm.Γ c.tm.k₁ → Bool := c.outputAlphabet
  let W : Polynomial ℕ :=
    Polynomial.X + Polynomial.X * (Polynomial.C a * Polynomial.X + Polynomial.C a)
  let T : Polynomial ℕ :=
    Polynomial.X * (c.time.comp W + Polynomial.C 2 * W + Polynomial.C 3) +
      Polynomial.C 2 * W + Polynomial.C 3 * Polynomial.X + Polynomial.C 5
  have hd : ∀ a, d₀ (e₀ a) = a := fun a => c.inputAlphabet.right_inv a
  have hrun : ∀ z : List Bool, ∃ (s : ℕ) (m : List (c.tm.Γ c.tm.k₁)),
      s ≤ c.time.eval z.length ∧
      (flip bind (TM2.step c.tm.m))^[s] (some (initList c.tm (z.map e₀))) =
        some (haltList c.tm m) ∧ m.map e₁ = g z := by
    intro z
    refine ⟨(c.outputsFun z).steps, List.map c.outputAlphabet.invFun (g z),
      (c.outputsFun z).steps_le_m, (c.outputsFun z).evals_in_steps, ?_⟩
    rw [List.map_map]
    conv_rhs => rw [← List.map_id (g z)]
    exact List.map_congr_left fun y _ => c.outputAlphabet.right_inv y
  have key : ∀ q : List Bool × List Bool, ∃ n, n ≤ T.eval (encodePair q).length ∧
      (flip bind (TM2.step (iterProg c.tm e₀ d₀ e₁)))^[n]
          (some (initList (iterM c.tm e₀ d₀ e₁) (encodePair q))) =
        some (haltList (iterM c.tm e₀ d₀ e₁) (g^[q.2.length] q.1)) := by
    rintro ⟨y, u⟩
    have hL : ∀ j ≤ u.length,
        (g^[j] y).length ≤ y.length + u.length * (a * y.length + a) := by
      intro j hj
      have h1 := (iterate_length_measure g m hm hg y j).2
      have h2 : j * m y ≤ u.length * (a * y.length + a) := Nat.mul_le_mul hj (ha y)
      omega
    obtain ⟨n, hn, hr⟩ := iter_run_bdd e₀ d₀ e₁ g c.time hd hrun y u
      (y.length + u.length * (a * y.length + a)) hL
    have hLV : y.length + u.length * (a * y.length + a) ≤
        (y.length + u.length) + (y.length + u.length) * (a * (y.length + u.length) + a) :=
      Nat.add_le_add (by omega) (Nat.mul_le_mul (by omega)
        (Nat.add_le_add_right (Nat.mul_le_mul_left _ (by omega)) _))
    have hp := eval_mono c.time hLV
    have hmul : u.length * (Polynomial.eval (y.length + u.length * (a * y.length + a)) c.time +
          2 * (y.length + u.length * (a * y.length + a)) + 3) ≤
        (y.length + u.length) * (Polynomial.eval
          ((y.length + u.length) + (y.length + u.length) * (a * (y.length + u.length) + a))
            c.time +
            2 * ((y.length + u.length) +
              (y.length + u.length) * (a * (y.length + u.length) + a)) + 3) :=
      Nat.mul_le_mul (by omega) (by omega)
    refine ⟨n, hn.trans ?_, hr⟩
    simp only [T, W, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_C,
      Polynomial.eval_X, Polynomial.eval_comp, encodePair_length]
    exact measure_arith _ _ _ _ _ _ hLV hmul
  exact ⟨{
    tm := iterM c.tm e₀ d₀ e₁
    inputAlphabet := Equiv.refl _
    outputAlphabet := Equiv.refl _
    time := T
    outputsFun := fun q =>
      { steps := Classical.choose (key q)
        evals_in_steps := by
          have hm : ∀ (γ : Type) (l : List γ), List.map (Equiv.refl γ).invFun l = l :=
            fun γ l => by simp
          exact (congrArg (fun l => (flip bind (TM2.step (iterProg c.tm e₀ d₀ e₁)))^[
            Classical.choose (key q)] (some (initList (iterM c.tm e₀ d₀ e₁) l)))
            (hm _ (encodePair q))).trans ((Classical.choose_spec (key q)).2.trans
            (congrArg (fun l => some (haltList (iterM c.tm e₀ d₀ e₁) l))
              (hm _ (g^[q.2.length] q.1)).symm))
        steps_le_m := (Classical.choose_spec (key q)).1 } }⟩

end PEqualNP.Outside.M500.Machines.Iter

namespace PEqualNP.Outside.M500.Machines
open PEqualNP.Library PEqualNP

theorem filterMap_map_some {α β γ : Type} (h : α → β) (φ : β → Option γ) (g : α → γ)
    (hφ : ∀ a, φ (h a) = some (g a)) (l : List α) : (l.map h).filterMap φ = l.map g := by
  induction l with
  | nil => rfl
  | cons a l ih => simp [hφ, ih]

theorem cpt_comp {α β γ αΓ βΓ γΓ : Type} {ea : α → List αΓ} {eb : β → List βΓ}
    {ec : γ → List γΓ} {f : α → β} {g : β → γ}
    (hf : PEqualNP.Library.ComputableInPolyTime ea eb f)
    (hg : PEqualNP.Library.ComputableInPolyTime eb ec g) :
    PEqualNP.Library.ComputableInPolyTime ea ec (fun a => g (f a)) := by
  obtain ⟨c1⟩ := hf
  obtain ⟨c2⟩ := hg
  exact comp_polyTime ea eb ec f g c1 c2

theorem cpt_dup :
    PEqualNP.Library.ComputableInPolyTime (fun x : List Bool => x)
      PEqualNP.Library.encodePair (fun x : List Bool => (x, x)) := by
  refine twoPass_polyTime _ _ _
    (fun b : Bool => some (Sum.inl b)) (fun b : Bool => some (Sum.inr b)) ?_
  intro x
  have h1 := filterMap_map_some (fun b : Bool => b) (fun b : Bool => some (Sum.inl (β := Bool) b))
    Sum.inl (fun _ => rfl) x
  have h2 := filterMap_map_some (fun b : Bool => b) (fun b : Bool => some (Sum.inr (α := Bool) b))
    Sum.inr (fun _ => rfl) x
  simp only [List.map_id'] at h1 h2
  simp only [encodePair, h1, h2]

end PEqualNP.Outside.M500.Machines

namespace PEqualNP.Outside.M500

open PEqualNP.Library PEqualNP.Outside.M500.Machines PEqualNP.Search

theorem cptc {α β αΓ βΓ : Type} {ea : α → List αΓ} {eb : β → List βΓ}
    {f f' : α → β} (h : ComputableInPolyTime ea eb f) (e : ∀ a, f a = f' a) :
    ComputableInPolyTime ea eb f' := by
  obtain rfl : f = f' := funext e
  exact h

section gen

variable {A B Q : Type} (δ : Q → A → Q × Option B × Option B) (fin : Q → Option B)

theorem run_cons (q : Q) (a : A) (l : List A) :
    fstRun2 δ fin q (a :: l) =
      (δ q a).2.1.toList ++ (δ q a).2.2.toList ++ fstRun2 δ fin (δ q a).1 l := rfl

theorem run_map (q : Q) {X : Type} (f : X → A) (g : X → B)
    (h : ∀ x, δ q (f x) = (q, some (g x), none)) (l : List X) (rest : List A) :
    fstRun2 δ fin q (l.map f ++ rest) = l.map g ++ fstRun2 δ fin q rest := by
  induction l with
  | nil => rfl
  | cons x l ih =>
    simp only [List.map_cons, List.cons_append, run_cons, h, ih, Option.toList_some,
      Option.toList_none, List.append_nil, List.nil_append]

theorem run_rep (q : Q) (a : A) (b : B) (h : δ q a = (q, some b, none)) (k : ℕ)
    (rest : List A) :
    fstRun2 δ fin q (List.replicate k a ++ rest) = List.replicate k b ++ fstRun2 δ fin q rest := by
  induction k with
  | zero => rfl
  | succ k ih =>
    simp only [List.replicate_succ, List.cons_append, run_cons, h, ih, Option.toList_some,
      Option.toList_none, List.append_nil, List.nil_append]

theorem run_len (cr : Q → ℕ) (w : A → ℕ)
    (h1 : ∀ q a, (δ q a).2.1.toList.length + (δ q a).2.2.toList.length + cr (δ q a).1 ≤
      1 + cr q + w a)
    (h2 : ∀ q, (fin q).toList.length ≤ cr q) (q : Q) (l : List A) :
    (fstRun2 δ fin q l).length ≤ l.length + cr q + (l.map w).sum := by
  induction l generalizing q with
  | nil => simpa [fstRun2] using h2 q
  | cons a l ih =>
    have e1 := ih (δ q a).1
    have e2 := h1 q a
    simp only [run_cons, List.length_append, List.length_cons, List.map_cons, List.sum_cons]
    omega

theorem run_w (wb : B → ℕ) (w : A → ℕ)
    (h1 : ∀ q a, ((δ q a).2.1.toList.map wb).sum + ((δ q a).2.2.toList.map wb).sum ≤ w a)
    (h2 : ∀ q, ((fin q).toList.map wb).sum = 0) (q : Q) (l : List A) :
    ((fstRun2 δ fin q l).map wb).sum ≤ (l.map w).sum := by
  induction l generalizing q with
  | nil => simp [fstRun2, h2 q]
  | cons a l ih =>
    have e1 := ih (δ q a).1
    have e2 := h1 q a
    simp only [run_cons, List.map_append, List.sum_append, List.map_cons, List.sum_cons]
    omega

end gen

def unp {X : Type} (l : List (X × X)) : List X := l.flatMap (fun p => [p.1, p.2])

def prD {X : Type} : Option X → X → Option X × Option (X × X)
  | none, x => (some x, none)
  | some y, x => (none, some (y, x))

def pr {X : Type} (l : List X) : List (X × X) := fstRun prD (fun _ => none) none l

theorem pr_unp {X : Type} (l : List (X × X)) : pr (unp l) = l := by
  induction l with
  | nil => rfl
  | cons p l ih =>
    have : pr (unp (p :: l)) = p :: pr (unp l) := by
      simp [pr, unp, fstRun, prD]
    rw [this, ih]

theorem pr_len_aux {X : Type} (l : List X) :
    2 * (fstRun (prD (X := X)) (fun _ => none) none l).length ≤ l.length ∧
      ∀ y, 2 * (fstRun (prD (X := X)) (fun _ => none) (some y) l).length ≤ l.length + 1 := by
  induction l with
  | nil => simp [fstRun]
  | cons a l ih =>
    refine ⟨?_, fun y => ?_⟩
    · have := ih.2 a
      simp only [fstRun, prD, Option.toList_none, List.nil_append, List.length_cons]
      omega
    · have := ih.1
      simp only [fstRun, prD, Option.toList_some, List.cons_append, List.nil_append,
        List.length_cons]
      omega

theorem pr_len {X : Type} (l : List X) : 2 * (pr l).length ≤ l.length := (pr_len_aux l).1

theorem unp_len {X : Type} (l : List (X × X)) : (unp l).length = 2 * l.length := by
  induction l with
  | nil => rfl
  | cons p l ih =>
    have : unp (p :: l) = p.1 :: p.2 :: unp l := rfl
    rw [this]
    simp only [List.length_cons, ih]
    omega

theorem cpt_pr {X : Type} [Fintype X] :
    ComputableInPolyTime (fun l : List X => l) (fun l : List (X × X) => l) pr :=
  fst_polyTime _ _ _ prD (fun _ => none) none (fun _ => rfl)

theorem cpt_unp {X : Type} [Fintype X] :
    ComputableInPolyTime (fun l : List (X × X) => l) (fun l : List X => l) unp := by
  refine fst2_polyTime _ _ _ (fun (_ : Unit) (p : X × X) => ((), some p.1, some p.2))
    (fun _ => none) () ?_
  intro l
  induction l with
  | nil => rfl
  | cons p l ih =>
    have e : unp (p :: l) = p.1 :: p.2 :: unp l := rfl
    simp only [e, run_cons, Option.toList_some, List.cons_append, List.nil_append]
    exact congrArg (fun t => p.1 :: p.2 :: t) ih

abbrev A : Type := (Bool × Bool) × (Bool × Bool)

def enc (s : List A) : List Bool := unp (unp s)

def dec (y : List Bool) : List A := pr (pr y)

theorem dec_enc (s : List A) : dec (enc s) = s := by
  simp [dec, enc, pr_unp]

theorem enc_len (s : List A) : (enc s).length = 4 * s.length := by
  simp only [enc, unp_len]
  omega

theorem dec_len (y : List Bool) : 4 * (dec y).length ≤ y.length := by
  have h1 := pr_len (pr y)
  have h2 := pr_len y
  simp only [dec]
  omega

theorem cpt_enc : ComputableInPolyTime (fun l : List A => l) (fun l : List Bool => l) enc :=
  cptc (cpt_comp cpt_unp cpt_unp) (fun _ => rfl)

theorem cpt_dec : ComputableInPolyTime (fun l : List Bool => l) (fun l : List A => l) dec :=
  cptc (cpt_comp cpt_pr cpt_pr) (fun _ => rfl)

def lift (T : List A → List A) (z : List Bool) : List Bool := enc (T (dec z))

theorem lift_iter (T : List A → List A) (k : ℕ) (s : List A) :
    (lift T)^[k] (enc s) = enc (T^[k] s) := by
  induction k generalizing s with
  | zero => rfl
  | succ k ih =>
    rw [Function.iterate_succ_apply, Function.iterate_succ_apply]
    have : lift T (enc s) = enc (T s) := by simp [lift, dec_enc]
    rw [this, ih]

theorem loop_cpt {Q : Type} [Fintype Q] (δ : Q → A → Q × Option A × Option A)
    (fin : Q → Option A) (q0 : Q) (cr : Q → ℕ) (w : A → ℕ) (h0 : cr q0 = 0)
    (h1 : ∀ q a, (δ q a).2.1.toList.length + (δ q a).2.2.toList.length + cr (δ q a).1 ≤
      1 + cr q + w a)
    (h2 : ∀ q, (fin q).toList.length ≤ cr q)
    (h3 : ∀ q a, ((δ q a).2.1.toList.map w).sum + ((δ q a).2.2.toList.map w).sum ≤ w a)
    (h4 : ∀ q, ((fin q).toList.map w).sum = 0) (hw : ∀ a, w a ≤ 1) :
    ComputableInPolyTime (fun x : List Bool => x) (fun x : List Bool => x)
      (fun y : List Bool => (lift (fstRun2 δ fin q0))^[y.length] y) := by
  have hT : ComputableInPolyTime (fun l : List A => l) (fun l : List A => l)
      (fstRun2 δ fin q0) := fst2_polyTime _ _ _ δ fin q0 (fun _ => rfl)
  have hg : ComputableInPolyTime (fun x : List Bool => x) (fun x : List Bool => x)
      (lift (fstRun2 δ fin q0)) :=
    cptc (cpt_comp (cpt_comp cpt_dec hT) cpt_enc) (fun _ => rfl)
  obtain ⟨c⟩ := hg
  have hsum : ∀ l : List A, (l.map w).sum ≤ l.length := by
    intro l
    induction l with
    | nil => simp
    | cons a l ih =>
      have := hw a
      simp only [List.map_cons, List.sum_cons, List.length_cons]
      omega
  have hI := Iter.iter_polyTime_measure (lift (fstRun2 δ fin q0)) c
    (fun y => 4 * ((dec y).map w).sum) 1
    (by
      intro y
      have := run_w δ fin w w h3 h4 q0 (dec y)
      simp only [lift, dec_enc]
      omega)
    (by
      intro y
      have e1 := run_len δ fin cr w h1 h2 q0 (dec y)
      have e2 := dec_len y
      simp only [lift, enc_len]
      omega)
    (by
      intro y
      have e1 := hsum (dec y)
      have e2 := dec_len y
      omega)
  exact cpt_comp cpt_dup hI

def cell (b a : Bool) : A := ((false, false), (b, a))
def st (r o : Bool) : A := ((false, true), (r, o))
def hd (p : Bool) : A := ((true, false), (false, p))
def mk : A := ((true, true), (false, false))
def cC : A := ((true, true), (false, true))
def kK : A := ((true, true), (true, false))

abbrev QM : Type := Fin 9 × Bool × Bool

def dPre (a : A) : QM × Option A × Option A :=
  if a = kK then ((1, false, false), none, none) else ((0, false, false), some a, none)

def dAfterK : A → QM × Option A × Option A
  | ((true, false), (false, p)) => ((2, p, false), none, none)
  | ((true, true), (false, true)) => ((7, false, false), some cC, none)
  | a => ((0, false, false), some a, none)

def dAfterKP (p : Bool) : A → QM × Option A × Option A
  | ((false, false), (b, _)) => ((3, b, false), some kK, some (hd p))
  | ((true, true), (false, false)) => ((6, false, false), some (hd p), some mk)
  | ((false, true), _) => ((7, true, false), some (hd p), some (st true true))
  | a => ((0, false, false), some (hd p), some a)

def dSrcRest (b : Bool) : A → QM × Option A × Option A
  | ((false, true), (r, o)) => ((4, b, false), some (st r o), none)
  | a => ((3, b, false), some a, none)

def dCmpStart (b : Bool) : A → QM × Option A × Option A
  | ((false, false), (d, false)) => ((4, b, false), some (cell d false), none)
  | ((false, false), (d, true)) => ((5, b, d == b), some (cell d false), none)
  | ((true, true), (false, false)) => ((5, b, false), some mk, none)
  | ((false, true), (r, _)) => ((4, b, false), some (st r false), none)
  | a => ((4, b, false), some a, none)

def dCmpPass (b g : Bool) : A → QM × Option A × Option A
  | ((false, true), (r, o)) => ((4, b, false), some (st r (o && g)), none)
  | a => ((5, b, g), some a, none)

def dFinSrc : A → QM × Option A × Option A
  | ((false, true), _) => ((7, true, false), some (st true true), none)
  | a => ((6, false, false), some a, none)

def dPendK (m : Bool) (a : A) : QM × Option A × Option A :=
  ((8, m, false), some kK, some a)

def dFin (m aa : Bool) : A → QM × Option A × Option A
  | ((false, false), (d, a)) => ((8, m, aa || a), some (cell d true), none)
  | ((false, true), (r, o)) =>
    if r || (m && o && !aa) then ((8, m, false), some (st true true), none)
    else ((8, m, false), some mk, some (st false true))
  | ((true, true), (false, true)) => ((8, m, false), some cC, none)
  | a => ((8, m, aa), some a, none)

def dM (q : QM) (a : A) : QM × Option A × Option A :=
  if q.1 = 0 then dPre a
  else if q.1 = 1 then dAfterK a
  else if q.1 = 2 then dAfterKP q.2.1 a
  else if q.1 = 3 then dSrcRest q.2.1 a
  else if q.1 = 4 then dCmpStart q.2.1 a
  else if q.1 = 5 then dCmpPass q.2.1 q.2.2 a
  else if q.1 = 6 then dFinSrc a
  else if q.1 = 7 then dPendK q.2.1 a
  else dFin q.2.1 q.2.2 a

def finM (q : QM) : Option A :=
  if q.1 = 1 ∨ q.1 = 2 ∨ q.1 = 7 then some kK else none

def crM (q : QM) : ℕ :=
  if q.1 = 1 then 1 else if q.1 = 2 then 2 else if q.1 = 6 then 1 else if q.1 = 7 then 1 else 0

def wS (a : A) : ℕ := if a.1 = (false, true) then 1 else 0

theorem dM_h1 : ∀ q a, (dM q a).2.1.toList.length + (dM q a).2.2.toList.length +
    crM (dM q a).1 ≤ 1 + crM q + wS a := by
  decide

theorem dM_h2 : ∀ q, (finM q).toList.length ≤ crM q := by
  decide

theorem dM_h3 : ∀ q a, ((dM q a).2.1.toList.map wS).sum + ((dM q a).2.2.toList.map wS).sum ≤
    wS a := by
  decide

theorem dM_h4 : ∀ q, ((finM q).toList.map wS).sum = 0 := by
  decide

theorem wS_le : ∀ a, wS a ≤ 1 := by
  decide

abbrev RM (q : QM) (l : List A) : List A := fstRun2 dM finM q l

abbrev Cand : Type := Bool × List Bool × List Bool × ℕ × Bool × Bool

def encW : Option Cand → List A
  | none => [cC]
  | some (p, ds, as, k, r, o) =>
    hd p :: (ds.map (fun d => cell d false) ++ (as.map (fun d => cell d true) ++
      (List.replicate k mk ++ [st r o])))

def cmpStep (b : Bool) : Option Cand → Option Cand
  | none => none
  | some (p, ds, [], k, r, _) => some (p, ds, [], k, r, false)
  | some (p, ds, d :: as, k, r, o) => some (p, ds ++ [d], as, k, r, o && (d == b))

def finStep (m : Bool) : Option Cand → Option Cand
  | none => none
  | some (p, ds, as, k, r, o) =>
    some (p, [], ds ++ as, if r || (m && o && as.isEmpty) then k else k + 1,
      r || (m && o && as.isEmpty), true)

theorem pre_pass (X : List A) (hX : kK ∉ X) (rest : List A) :
    RM (0, false, false) (X ++ rest) = X ++ RM (0, false, false) rest := by
  induction X with
  | nil => rfl
  | cons a X ih =>
    have ha : a ≠ kK := fun h => hX (h ▸ List.mem_cons_self)
    have hX' : kK ∉ X := fun h => hX (List.mem_cons_of_mem _ h)
    have e : dM (0, false, false) a = ((0, false, false), some a, none) := by
      simp [dM, dPre, ha]
    simp only [RM, List.cons_append, run_cons, e, Option.toList_some, Option.toList_none,
      List.append_nil, List.nil_append] at ih ⊢
    rw [ih hX']

theorem cs_dead (b : Bool) (ds : List Bool) (rest : List A) :
    RM (4, b, false) (ds.map (fun d => cell d false) ++ rest) =
      ds.map (fun d => cell d false) ++ RM (4, b, false) rest :=
  run_map dM finM _ _ _ (fun _ => rfl) _ _

theorem cp_alive (b g : Bool) (ds : List Bool) (rest : List A) :
    RM (5, b, g) (ds.map (fun d => cell d true) ++ rest) =
      ds.map (fun d => cell d true) ++ RM (5, b, g) rest :=
  run_map dM finM _ _ _ (fun _ => rfl) _ _

theorem cp_mk (b g : Bool) (k : ℕ) (rest : List A) :
    RM (5, b, g) (List.replicate k mk ++ rest) = List.replicate k mk ++ RM (5, b, g) rest :=
  run_rep dM finM _ _ _ rfl _ _

theorem cp_st (b g r o : Bool) (rest : List A) :
    RM (5, b, g) (st r o :: rest) = st r (o && g) :: RM (4, b, false) rest := rfl

theorem cs_hd (b p : Bool) (rest : List A) :
    RM (4, b, false) (hd p :: rest) = hd p :: RM (4, b, false) rest := rfl

theorem cs_cC (b : Bool) (rest : List A) :
    RM (4, b, false) (cC :: rest) = cC :: RM (4, b, false) rest := rfl

theorem cs_st (b r o : Bool) (rest : List A) :
    RM (4, b, false) (st r o :: rest) = st r false :: RM (4, b, false) rest := rfl

theorem cs_mk (b : Bool) (rest : List A) :
    RM (4, b, false) (mk :: rest) = mk :: RM (5, b, false) rest := rfl

theorem cs_alive (b d : Bool) (rest : List A) :
    RM (4, b, false) (cell d true :: rest) = cell d false :: RM (5, b, d == b) rest := rfl

theorem cmp_chunk (b : Bool) (wi : Option Cand) (rest : List A) :
    RM (4, b, false) (encW wi ++ rest) = encW (cmpStep b wi) ++ RM (4, b, false) rest := by
  rcases wi with _ | ⟨p, ds, as, k, r, o⟩
  · rfl
  · cases as with
    | nil =>
      cases k with
      | zero =>
        simp only [encW, cmpStep, List.cons_append, List.append_assoc, List.map_nil,
          List.nil_append, List.replicate_zero, cs_hd, cs_dead, cs_st]
      | succ k =>
        simp only [encW, cmpStep, List.cons_append, List.append_assoc, List.map_nil,
          List.nil_append, List.replicate_succ, cs_hd, cs_dead, cs_mk, cp_mk, cp_st,
          Bool.and_false]
    | cons d as =>
      simp only [encW, cmpStep, List.cons_append, List.append_assoc, List.map_cons,
        List.map_append, List.map_nil, List.nil_append, cs_hd, cs_dead, cs_alive, cp_alive,
        cp_mk, cp_st]

theorem cmp_list (b : Bool) (ws : List (Option Cand)) (rest : List A) :
    RM (4, b, false) (ws.flatMap encW ++ rest) =
      (ws.map (cmpStep b)).flatMap encW ++ RM (4, b, false) rest := by
  induction ws with
  | nil => rfl
  | cons wi ws ih =>
    simp only [List.flatMap_cons, List.map_cons, List.append_assoc, cmp_chunk, ih]

theorem fn_hd (m aa p : Bool) (rest : List A) :
    RM (8, m, aa) (hd p :: rest) = hd p :: RM (8, m, aa) rest := rfl

theorem fn_cC (m aa : Bool) (rest : List A) :
    RM (8, m, aa) (cC :: rest) = cC :: RM (8, m, false) rest := rfl

theorem fn_dead (m aa : Bool) (ds : List Bool) (rest : List A) :
    RM (8, m, aa) (ds.map (fun d => cell d false) ++ rest) =
      ds.map (fun d => cell d true) ++ RM (8, m, aa) rest :=
  run_map dM finM _ _ _ (fun _ => by cases aa <;> rfl) _ _

theorem fn_alive (m aa : Bool) (ds : List Bool) (rest : List A) :
    RM (8, m, aa) (ds.map (fun d => cell d true) ++ rest) =
      ds.map (fun d => cell d true) ++ RM (8, m, aa || !ds.isEmpty) rest := by
  induction ds generalizing aa with
  | nil => cases aa <;> rfl
  | cons d ds ih =>
    have e : RM (8, m, aa) (cell d true :: (ds.map (fun d => cell d true) ++ rest)) =
        cell d true :: RM (8, m, true) (ds.map (fun d => cell d true) ++ rest) := by
      cases aa <;> rfl
    simp only [List.map_cons, List.cons_append, e, ih, Bool.true_or, List.isEmpty_cons,
      Bool.not_false, Bool.or_true]

theorem fn_mk (m aa : Bool) (k : ℕ) (rest : List A) :
    RM (8, m, aa) (List.replicate k mk ++ rest) = List.replicate k mk ++ RM (8, m, aa) rest :=
  run_rep dM finM _ _ _ rfl _ _

theorem fn_st (m aa r o : Bool) (rest : List A) :
    RM (8, m, aa) (st r o :: rest) =
      (if r || (m && o && !aa) then [st true true] else [mk, st false true]) ++
        RM (8, m, false) rest := by
  cases r <;> cases m <;> cases o <;> cases aa <;> rfl

theorem fin_chunk (m : Bool) (wi : Option Cand) (rest : List A) :
    RM (8, m, false) (encW wi ++ rest) = encW (finStep m wi) ++ RM (8, m, false) rest := by
  rcases wi with _ | ⟨p, ds, as, k, r, o⟩
  · rfl
  · simp only [encW, finStep, List.cons_append, List.append_assoc, List.nil_append,
      List.map_nil, List.map_append, fn_hd, fn_dead, fn_alive, fn_mk, fn_st, Bool.false_or,
      Bool.not_not]
    cases h : (r || (m && o && as.isEmpty))
    · simp [List.replicate_succ']
    · simp

theorem fin_list (m : Bool) (ws : List (Option Cand)) (rest : List A) :
    RM (8, m, false) (ws.flatMap encW ++ rest) =
      (ws.map (finStep m)).flatMap encW ++ RM (8, m, false) rest := by
  induction ws with
  | nil => rfl
  | cons wi ws ih =>
    simp only [List.flatMap_cons, List.map_cons, List.append_assoc, fin_chunk, ih]

theorem pend_chunk (m x : Bool) (wi : Option Cand) (rest : List A) :
    RM (7, m, x) (encW wi ++ rest) = kK :: RM (8, m, false) (encW wi ++ rest) := by
  rcases wi with _ | ⟨p, ds, as, k, r, o⟩
  · rfl
  · rfl

theorem pend_list (m x : Bool) (ws : List (Option Cand)) :
    RM (7, m, x) (ws.flatMap encW) = kK :: (ws.map (finStep m)).flatMap encW := by
  cases ws with
  | nil => rfl
  | cons wi ws =>
    have h := fin_list m (wi :: ws) []
    simp only [List.append_nil] at h
    have e : RM (8, m, false) [] = [] := rfl
    rw [List.flatMap_cons, pend_chunk, ← List.flatMap_cons, h, e, List.append_nil]

abbrev TM (l : List A) : List A := RM (0, false, false) l

theorem pass_done (X : List A) (hX : kK ∉ X) : TM (X ++ [kK]) = X ++ [kK] := by
  simp only [TM, pre_pass X hX]
  rfl

theorem sr_alive (b : Bool) (ds : List Bool) (rest : List A) :
    RM (3, b, false) (ds.map (fun d => cell d true) ++ rest) =
      ds.map (fun d => cell d true) ++ RM (3, b, false) rest :=
  run_map dM finM _ _ _ (fun _ => rfl) _ _

theorem sr_mk (b : Bool) (k : ℕ) (rest : List A) :
    RM (3, b, false) (List.replicate k mk ++ rest) =
      List.replicate k mk ++ RM (3, b, false) rest :=
  run_rep dM finM _ _ _ rfl _ _

theorem fs_mk (k : ℕ) (rest : List A) :
    RM (6, false, false) (List.replicate k mk ++ rest) =
      List.replicate k mk ++ RM (6, false, false) rest :=
  run_rep dM finM _ _ _ rfl _ _

theorem pass_cmp (X : List A) (hX : kK ∉ X) (p b : Bool) (rem : List Bool) (k : ℕ) (r : Bool)
    (ws : List (Option Cand)) :
    TM (X ++ kK :: hd p :: cell b true :: (rem.map (fun d => cell d true) ++
        (List.replicate k mk ++ st r true :: ws.flatMap encW))) =
      X ++ kK :: hd p :: (rem.map (fun d => cell d true) ++
        (List.replicate k mk ++ st r true :: (ws.map (cmpStep b)).flatMap encW)) := by
  have e1 : ∀ l, RM (0, false, false) (kK :: hd p :: cell b true :: l) =
      kK :: hd p :: RM (3, b, false) l := fun _ => rfl
  have e2 : ∀ l, RM (3, b, false) (st r true :: l) = st r true :: RM (4, b, false) l :=
    fun _ => rfl
  have e3 := cmp_list b ws []
  have e4 : RM (4, b, false) [] = [] := rfl
  simp only [List.append_nil] at e3
  simp only [TM, pre_pass X hX, e1, sr_alive, sr_mk, e2, e3, e4, List.append_nil]

theorem pass_fin (X : List A) (hX : kK ∉ X) (p : Bool) (k : ℕ) (r o : Bool)
    (ws : List (Option Cand)) :
    TM (X ++ kK :: hd p :: (List.replicate k mk ++ st r o :: ws.flatMap encW)) =
      X ++ hd p :: (List.replicate k mk ++ st true true :: kK ::
        (ws.map (finStep true)).flatMap encW) := by
  cases k with
  | zero =>
    have e1 : ∀ l, RM (0, false, false) (kK :: hd p :: st r o :: l) =
        hd p :: st true true :: RM (7, true, false) l := fun _ => rfl
    simp only [TM, pre_pass X hX, List.replicate_zero, List.nil_append, e1, pend_list]
  | succ k =>
    have e1 : ∀ l, RM (0, false, false) (kK :: hd p :: mk :: l) =
        hd p :: mk :: RM (6, false, false) l := fun _ => rfl
    have e2 : ∀ l, RM (6, false, false) (st r o :: l) =
        st true true :: RM (7, true, false) l := fun _ => rfl
    simp only [TM, pre_pass X hX, List.replicate_succ, List.cons_append, e1, fs_mk, e2,
      pend_list]

theorem pass_C (X : List A) (hX : kK ∉ X) (ws : List (Option Cand)) :
    TM (X ++ kK :: cC :: ws.flatMap encW) =
      X ++ cC :: kK :: (ws.map (finStep false)).flatMap encW := by
  have e1 : ∀ l, RM (0, false, false) (kK :: cC :: l) = cC :: RM (7, false, false) l :=
    fun _ => rfl
  simp only [TM, pre_pass X hX, e1, pend_list]

def cmpAll (v : List Bool) (wi : Option Cand) : Option Cand :=
  v.foldl (fun c b => cmpStep b c) wi

theorem src_lit (X : List A) (hX : kK ∉ X) (p : Bool) (rem : List Bool) (k : ℕ) (r : Bool)
    (ws : List (Option Cand)) :
    TM^[rem.length + 1] (X ++ kK :: hd p :: (rem.map (fun d => cell d true) ++
        (List.replicate k mk ++ st r true :: ws.flatMap encW))) =
      X ++ hd p :: (List.replicate k mk ++ st true true :: kK ::
        (ws.map (fun wi => finStep true (cmpAll rem wi))).flatMap encW) := by
  induction rem generalizing ws with
  | nil =>
    simp only [List.length_nil, Nat.zero_add, Function.iterate_one, List.map_nil,
      List.nil_append, pass_fin X hX]
    rfl
  | cons b rem ih =>
    rw [List.length_cons, Function.iterate_succ_apply, List.map_cons, List.cons_append,
      pass_cmp X hX, ih, List.map_map]
    rfl

theorem cmpAll_fin (v : List Bool) (p : Bool) (ds as : List Bool) (k : ℕ) (r o : Bool) :
    finStep true (cmpAll v (some (p, ds, as, k, r, o))) =
      some (p, [], ds ++ as, if r || (o && decide (as = v)) then k else k + 1,
        r || (o && decide (as = v)), true) := by
  induction v generalizing ds as o with
  | nil =>
    cases as <;> simp [cmpAll, finStep]
  | cons b v ih =>
    have e : ∀ c, cmpAll (b :: v) c = cmpAll v (cmpStep b c) := fun _ => rfl
    cases as with
    | nil => rw [e, cmpStep, ih]; simp
    | cons d as =>
      rw [e, cmpStep, ih]
      have : ((o && d == b) && decide (as = v)) = (o && decide (d :: as = b :: v)) := by
        cases o <;> cases d <;> cases b <;> simp
      simp [this]

theorem cmpAll_none (v : List Bool) : cmpAll v none = none := by
  induction v with
  | nil => rfl
  | cons b v ih => exact ih

def mt (l : Literal) : Option Literal → Bool :=
  fun o => o.any (fun l' => l'.1 == l.1)

def cnt (pre : List (Option Literal)) (l : Literal) : ℕ := (pre ++ [some l]).findIdx (mt l)

def wk (pre : List (Option Literal)) : Option Literal → Option Cand :=
  fun o => o.map (fun l => (l.2, [], l.1.bits, cnt pre l, pre.any (mt l), true))

def dn (items : List (Option Literal)) : Option Literal → List A
  | none => [cC]
  | some l => hd l.2 :: (List.replicate (items.findIdx (mt l)) mk ++ [st true true])

def cost : Option Literal → ℕ
  | none => 1
  | some l => l.1.bits.length + 1

theorem fi_app {X : Type} (p : X → Bool) (l1 l2 : List X) :
    (l1 ++ l2).findIdx p = if l1.any p then l1.findIdx p else l1.length + l2.findIdx p := by
  induction l1 with
  | nil => simp
  | cons a l1 ih =>
    cases h : p a
    · cases h2 : l1.any p <;> simp [List.findIdx_cons, h, ih, h2] <;> omega
    · simp [List.findIdx_cons, h]

def bval : List Bool → ℕ
  | [] => 0
  | b :: l => 2 * bval l + (if b then 1 else 0)

theorem bval_bits (n : ℕ) : bval n.bits = n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
    · by_cases hk : k = 0
      · subst hk
        simp [bval]
      · rw [Nat.bit0_bits k hk]
        simp [bval, ih k (by omega)]
    · rw [Nat.bit1_bits]
      simp [bval, ih k (by omega)]

theorem mt_self (l : Literal) : mt l (some l) = true := by
  simp [mt]

theorem cnt_eq (pre : List (Option Literal)) (l : Literal) :
    cnt pre l = if pre.any (mt l) then pre.findIdx (mt l) else pre.length := by
  simp [cnt, fi_app, List.findIdx_cons, mt_self]

theorem idx_eq (pre post : List (Option Literal)) (l : Literal) :
    (pre ++ some l :: post).findIdx (mt l) = cnt pre l := by
  simp [cnt, fi_app, List.findIdx_cons, mt_self]

theorem cnt_step (pre : List (Option Literal)) (o : Option Literal) (l : Literal) :
    cnt (pre ++ [o]) l = if pre.any (mt l) || mt l o then cnt pre l else cnt pre l + 1 := by
  rw [cnt_eq, cnt_eq, fi_app]
  cases h1 : pre.any (mt l) <;> cases h2 : mt l o <;>
    simp [h1, h2, List.findIdx_cons]

theorem stepC (pre : List (Option Literal)) (o : Option Literal) :
    finStep false (wk pre o) = wk (pre ++ [none]) o := by
  rcases o with _ | l
  · rfl
  · have h : mt l none = false := rfl
    simp [wk, finStep, cnt_step, h]

theorem stepL (pre : List (Option Literal)) (l : Literal) (o : Option Literal) :
    finStep true (cmpAll l.1.bits (wk pre o)) = wk (pre ++ [some l]) o := by
  rcases o with _ | l'
  · simp [wk, cmpAll_none, finStep]
  · have h : mt l' (some l) = decide (l'.1.bits = l.1.bits) := by
      simp only [mt, Option.any_some]
      by_cases e : l.1 = l'.1
      · simp [e]
      · have e' : ¬ l'.1.bits = l.1.bits := fun hb => e (by
          have := congrArg bval hb
          simpa [bval_bits] using this.symm)
        simp [e, e']
    simp only [wk, Option.map_some, cmpAll_fin, cnt_step, h, List.any_append, List.any_cons,
      List.any_nil, Bool.or_false, Bool.true_and, List.nil_append]

theorem dn_noK (items part : List (Option Literal)) : kK ∉ part.flatMap (dn items) := by
  intro h
  rw [List.mem_flatMap] at h
  obtain ⟨o, -, ho⟩ := h
  rcases o with _ | l
  · simp [dn, kK, cC] at ho
  · simp [dn, kK, hd, mk, st, List.mem_replicate] at ho

theorem main_loop (items : List (Option Literal)) :
    ∀ post pre, items = pre ++ post →
      TM^[(post.map cost).sum] (pre.flatMap (dn items) ++ kK ::
        (post.map (wk pre)).flatMap encW) = items.flatMap (dn items) ++ [kK] := by
  intro post
  induction post with
  | nil =>
    intro pre h
    simp [h]
  | cons o post ih =>
    intro pre h
    have h' : items = (pre ++ [o]) ++ post := by simp [h]
    have IH := ih (pre ++ [o]) h'
    rw [List.map_cons, List.sum_cons, Nat.add_comm, Function.iterate_add_apply]
    rcases o with _ | l
    · have e : TM^[cost none] (pre.flatMap (dn items) ++ kK ::
          ((none :: post).map (wk pre)).flatMap encW) =
          (pre ++ [none]).flatMap (dn items) ++ kK ::
            (post.map (wk (pre ++ [none]))).flatMap encW := by
        have e0 : ((none :: post).map (wk pre)).flatMap encW =
            cC :: (post.map (wk pre)).flatMap encW := rfl
        rw [e0]
        simp only [cost, Function.iterate_one, pass_C _ (dn_noK items pre), List.map_map]
        have e1 : (finStep false ∘ wk pre) = wk (pre ++ [none]) := funext (stepC pre)
        rw [e1]
        simp [dn]
      rw [e]
      exact IH
    · have e : TM^[cost (some l)] (pre.flatMap (dn items) ++ kK ::
          ((some l :: post).map (wk pre)).flatMap encW) =
          (pre ++ [some l]).flatMap (dn items) ++ kK ::
            (post.map (wk (pre ++ [some l]))).flatMap encW := by
        have e0 : ((some l :: post).map (wk pre)).flatMap encW =
            hd l.2 :: (l.1.bits.map (fun d => cell d true) ++
              (List.replicate (cnt pre l) mk ++ st (pre.any (mt l)) true ::
                (post.map (wk pre)).flatMap encW)) := by
          simp [wk, encW]
        rw [e0]
        simp only [cost, src_lit _ (dn_noK items pre), List.map_map]
        have e1 : ((fun wi => finStep true (cmpAll l.1.bits wi)) ∘ wk pre) =
            wk (pre ++ [some l]) := funext (stepL pre l)
        rw [e1]
        have e2 : items.findIdx (mt l) = cnt pre l := by rw [h, idx_eq]
        simp [dn, e2]
      rw [e]
      exact IH

theorem loopM_cpt : ComputableInPolyTime (fun x : List Bool => x) (fun x : List Bool => x)
    (fun y : List Bool => (lift TM)^[y.length] y) :=
  loop_cpt dM finM (0, false, false) crM wS rfl dM_h1 dM_h2 dM_h3 dM_h4 wS_le

def dUc : A → Bool × Option A × Option A
  | ((true, true), (false, false)) => (true, some mk, none)
  | ((false, false), (true, x)) => (true, some (cell false x), none)
  | ((false, false), (false, x)) => (false, some (cell true x), none)
  | ((false, true), (r, o)) => (false, some (cell true true), some (st r o))
  | a => (false, some a, none)

def dUi : A → Bool × Option A × Option A
  | ((true, true), (false, false)) => (true, none, none)
  | a => (false, some a, none)

def dU (c : Bool) (a : A) : Bool × Option A × Option A := if c then dUc a else dUi a

def finU (_ : Bool) : Option A := none

def crU (c : Bool) : ℕ := if c then 1 else 0

def w0 (_ : A) : ℕ := 0

theorem dU_h1 : ∀ q a, (dU q a).2.1.toList.length + (dU q a).2.2.toList.length +
    crU (dU q a).1 ≤ 1 + crU q + w0 a := by
  decide

theorem dU_h2 : ∀ q, (finU q).toList.length ≤ crU q := by
  decide

theorem dU_h3 : ∀ q a, ((dU q a).2.1.toList.map w0).sum + ((dU q a).2.2.toList.map w0).sum ≤
    w0 a := by
  decide

theorem dU_h4 : ∀ q, ((finU q).toList.map w0).sum = 0 := by
  decide

abbrev RU (q : Bool) (l : List A) : List A := fstRun2 dU finU q l

abbrev TU (l : List A) : List A := RU false l

theorem loopU_cpt : ComputableInPolyTime (fun x : List Bool => x) (fun x : List Bool => x)
    (fun y : List Bool => (lift TU)^[y.length] y) :=
  loop_cpt dU finU false crU w0 rfl dU_h1 dU_h2 dU_h3 dU_h4 (fun _ => Nat.zero_le _)

def bsucc : List Bool → List Bool
  | [] => [true]
  | false :: l => true :: l
  | true :: l => false :: bsucc l

theorem bsucc_bits (n : ℕ) : bsucc n.bits = (n + 1).bits := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases Nat.even_or_odd' n with ⟨k, rfl | rfl⟩
    · by_cases hk : k = 0
      · subst hk
        simp [bsucc]
      · rw [Nat.bit0_bits k hk, Nat.bit1_bits]
        rfl
    · have e : 2 * k + 1 + 1 = 2 * (k + 1) := by omega
      rw [Nat.bit1_bits, e, Nat.bit0_bits (k + 1) (by omega), bsucc, ih k (by omega)]

abbrev UI : Type := Bool × ℕ × ℕ

def encU : Option UI → List A
  | none => [cC]
  | some (p, k, n) =>
    hd p :: (List.replicate k mk ++ (n.bits.map (fun d => cell d true) ++ [st true true]))

def uStep : Option UI → Option UI
  | none => none
  | some (p, 0, n) => some (p, 0, n)
  | some (p, k + 1, n) => some (p, k, n + 1)

theorem ui_alive (ds : List Bool) (rest : List A) :
    RU false (ds.map (fun d => cell d true) ++ rest) =
      ds.map (fun d => cell d true) ++ RU false rest :=
  run_map dU finU _ _ _ (fun _ => rfl) _ _

theorem uc_mk (k : ℕ) (rest : List A) :
    RU true (List.replicate k mk ++ rest) = List.replicate k mk ++ RU true rest :=
  run_rep dU finU _ _ _ rfl _ _

theorem u_carry (bs : List Bool) (r o : Bool) (rest : List A) :
    RU true (bs.map (fun d => cell d true) ++ st r o :: rest) =
      (bsucc bs).map (fun d => cell d true) ++ st r o :: RU false rest := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    cases b
    · have e : ∀ l, RU true (cell false true :: l) = cell true true :: RU false l := fun _ => rfl
      have e2 : ∀ l, RU false (st r o :: l) = st r o :: RU false l := fun _ => rfl
      simp only [List.map_cons, List.cons_append, e, ui_alive, e2, bsucc]
    · have e : ∀ l, RU true (cell true true :: l) = cell false true :: RU true l := fun _ => rfl
      simp only [List.map_cons, List.cons_append, e, ih, bsucc]

theorem u_chunk (ui : Option UI) (rest : List A) :
    RU false (encU ui ++ rest) = encU (uStep ui) ++ RU false rest := by
  rcases ui with _ | ⟨p, k, n⟩
  · rfl
  · have e1 : ∀ l, RU false (hd p :: l) = hd p :: RU false l := fun _ => rfl
    have e2 : ∀ l, RU false (st true true :: l) = st true true :: RU false l := fun _ => rfl
    cases k with
    | zero =>
      simp only [encU, uStep, List.cons_append, List.append_assoc, List.replicate_zero,
        List.nil_append, e1, ui_alive, e2]
    | succ k =>
      have e3 : ∀ l, RU false (mk :: l) = RU true l := fun _ => rfl
      simp only [encU, uStep, List.cons_append, List.append_assoc, List.replicate_succ,
        List.nil_append, e1, e3, uc_mk, u_carry, bsucc_bits]

theorem u_list (us : List (Option UI)) (rest : List A) :
    RU false (us.flatMap encU ++ rest) = (us.map uStep).flatMap encU ++ RU false rest := by
  induction us with
  | nil => rfl
  | cons ui us ih =>
    simp only [List.flatMap_cons, List.map_cons, List.append_assoc, u_chunk, ih]

theorem u_pass (us : List (Option UI)) :
    TU (us.flatMap encU ++ [kK]) = (us.map uStep).flatMap encU ++ [kK] := by
  simp only [TU, u_list]
  rfl

theorem u_iter (j : ℕ) (us : List (Option UI)) :
    TU^[j] (us.flatMap encU ++ [kK]) = (us.map (uStep^[j])).flatMap encU ++ [kK] := by
  induction j generalizing us with
  | zero => simp
  | succ j ih =>
    rw [Function.iterate_succ_apply, u_pass, ih, List.map_map]
    rfl

theorem uStep_iter (p : Bool) : ∀ (j k n : ℕ), k ≤ j →
    uStep^[j] (some (p, k, n)) = some (p, 0, n + k) := by
  intro j
  induction j with
  | zero =>
    intro k n h
    obtain rfl : k = 0 := by omega
    rfl
  | succ j ih =>
    intro k n h
    rw [Function.iterate_succ_apply]
    cases k with
    | zero => exact ih 0 n (by omega)
    | succ k =>
      have := ih k (n + 1) (by omega)
      rw [uStep, this]
      have e : n + 1 + k = n + (k + 1) := by omega
      rw [e]

def ui (items : List (Option Literal)) : Option Literal → Option UI :=
  fun o => o.map (fun l => (l.2, items.findIdx (mt l), 0))

def uo (items : List (Option Literal)) : Option Literal → Option UI :=
  fun o => o.map (fun l => (l.2, 0, items.findIdx (mt l)))

theorem dn_eq (items : List (Option Literal)) (o : Option Literal) :
    dn items o = encU (ui items o) := by
  rcases o with _ | l
  · rfl
  · simp [dn, ui, encU]

theorem ui_uo (items : List (Option Literal)) (j : ℕ) (hj : items.length ≤ j)
    (o : Option Literal) : uStep^[j] (ui items o) = uo items o := by
  rcases o with _ | l
  · have : ∀ j, uStep^[j] none = none := by
      intro j
      induction j with
      | zero => rfl
      | succ j ih => rw [Function.iterate_succ_apply]; exact ih
    exact this j
  · have h := List.findIdx_le_length (p := mt l) (xs := items)
    simp only [ui, uo, Option.map_some]
    rw [uStep_iter _ _ _ _ (by omega)]
    simp

def dW (_ : Unit) : A → Unit × Option Bool × Option Bool
  | ((true, false), (false, p)) => ((), some true, some p)
  | ((false, false), (b, _)) => ((), some true, some b)
  | ((false, true), _) => ((), some false, some true)
  | ((true, true), (false, true)) => ((), some false, some false)
  | _ => ((), none, none)

abbrev RW (l : List A) : List Bool := fstRun2 dW (fun _ => none) () l

def outI (items : List (Option Literal)) : Option Literal → List Bool
  | none => [false, false]
  | some l => encodeLiteral (items.findIdx (mt l), l.2)

theorem w_cells (bs : List Bool) (rest : List A) :
    RW (bs.map (fun d => cell d true) ++ rest) = bs.flatMap (fun d => [true, d]) ++ RW rest := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    have e : ∀ l, RW (cell b true :: l) = true :: b :: RW l := fun _ => rfl
    rw [List.map_cons, List.cons_append, e, ih, List.flatMap_cons]
    rfl

theorem w_chunk (items : List (Option Literal)) (o : Option Literal) (rest : List A) :
    RW (encU (uo items o) ++ rest) = outI items o ++ RW rest := by
  rcases o with _ | l
  · rfl
  · have e1 : ∀ l', RW (hd l.2 :: l') = true :: l.2 :: RW l' := fun _ => rfl
    have e2 : ∀ l', RW (st true true :: l') = false :: true :: RW l' := fun _ => rfl
    simp only [uo, Option.map_some, encU, List.replicate_zero, List.nil_append,
      List.cons_append, List.append_assoc, e1, w_cells, e2, outI, encodeLiteral]

theorem w_list (items part : List (Option Literal)) :
    RW ((part.map (uo items)).flatMap encU ++ [kK]) = part.flatMap (outI items) := by
  induction part with
  | nil => rfl
  | cons o part ih =>
    simp only [List.map_cons, List.flatMap_cons, List.append_assoc, w_chunk, ih]

def itemsOf (φ : CNF) : List (Option Literal) := φ.flatMap (fun c => c.map some ++ [none])

def encI : Option Literal → List Bool
  | none => [false, false]
  | some l => encodeLiteral l

theorem encodeCNF_items (ψ : CNF) : encodeCNF ψ = (itemsOf ψ).flatMap encI := by
  induction ψ with
  | nil => rfl
  | cons c ψ ih =>
    have e3 : ∀ c : Clause, (c.map some).flatMap encI = c.flatMap encodeLiteral := by
      intro c
      induction c with
      | nil => rfl
      | cons l c ihc => simp only [List.map_cons, List.flatMap_cons, ihc, encI]
    have e : encodeCNF (c :: ψ) = encodeClause c ++ encodeCNF ψ := by simp [encodeCNF]
    have e2 : itemsOf (c :: ψ) = c.map some ++ [none] ++ itemsOf ψ := by simp [itemsOf]
    rw [e, e2, ih, List.flatMap_append, List.flatMap_append, e3]
    simp [encodeClause, encI]

theorem itemsOf_map (g : Literal → Literal) (φ : CNF) :
    itemsOf (φ.map (fun c => c.map g)) = (itemsOf φ).map (Option.map g) := by
  induction φ with
  | nil => rfl
  | cons c φ ih =>
    have e : ∀ (c : Clause) (ψ : CNF), itemsOf (c :: ψ) = c.map some ++ [none] ++ itemsOf ψ := by
      intro c ψ
      simp [itemsOf]
    rw [List.map_cons, e, e, ih]
    simp

def prI : Option Literal → List (Bool × Bool)
  | none => [(false, false)]
  | some l => (true, l.2) :: (l.1.bits.map (fun d => (true, d)) ++ [(false, true)])

theorem unp_app {X : Type} (l1 l2 : List (X × X)) : unp (l1 ++ l2) = unp l1 ++ unp l2 := by
  simp [unp]

theorem encI_prI (o : Option Literal) : encI o = unp (prI o) := by
  rcases o with _ | l
  · rfl
  · have e : ∀ bs : List Bool, bs.flatMap (fun d => [true, d]) =
        unp (bs.map (fun d => (true, d))) := by
      intro bs
      induction bs with
      | nil => rfl
      | cons b bs ih => simpa [unp] using ih
    simp only [encI, encodeLiteral, prI, e]
    simp [unp]

theorem flat_unp (part : List (Option Literal)) :
    part.flatMap encI = unp (part.flatMap prI) := by
  induction part with
  | nil => rfl
  | cons o part ih => simp only [List.flatMap_cons, ih, unp_app, encI_prI]

def dP (q : Bool × Bool) (x : Bool × Bool) : (Bool × Bool) × Option A × Option A :=
  if q.1 then
    ((false, !x.1), some kK,
      some (if x.1 then (if q.2 then hd x.2 else cell x.2 true)
        else (if x.2 then st false true else cC)))
  else
    ((false, !x.1),
      some (if x.1 then (if q.2 then hd x.2 else cell x.2 true)
        else (if x.2 then st false true else cC)), none)

def finP (q : Bool × Bool) : Option A := if q.1 then some kK else none

abbrev RP (q : Bool × Bool) (l : List (Bool × Bool)) : List A := fstRun2 dP finP q l

theorem p_chunk (o : Option Literal) (rest : List (Bool × Bool)) :
    RP (false, true) (prI o ++ rest) = encW (wk [] o) ++ RP (false, true) rest := by
  rcases o with _ | l
  · rfl
  · have e1 : ∀ r, RP (false, true) ((true, l.2) :: r) = hd l.2 :: RP (false, false) r :=
      fun _ => rfl
    have e2 : ∀ (bs : List Bool) r, RP (false, false) (bs.map (fun d => (true, d)) ++ r) =
        bs.map (fun d => cell d true) ++ RP (false, false) r :=
      fun bs r => run_map dP finP _ _ _ (fun _ => rfl) _ _
    have e3 : ∀ r, RP (false, false) ((false, true) :: r) = st false true :: RP (false, true) r :=
      fun _ => rfl
    have e4 : cnt [] l = 0 := by simp [cnt, List.findIdx_cons, mt_self]
    simp only [prI, wk, Option.map_some, encW, List.cons_append, List.append_assoc, e1, e2, e3,
      e4, List.map_nil, List.nil_append, List.replicate_zero, List.any_nil]

theorem p_list (part : List (Option Literal)) (rest : List (Bool × Bool)) :
    RP (false, true) (part.flatMap prI ++ rest) =
      (part.map (wk [])).flatMap encW ++ RP (false, true) rest := by
  induction part with
  | nil => rfl
  | cons o part ih =>
    simp only [List.flatMap_cons, List.map_cons, List.append_assoc, p_chunk, ih]

theorem p_all (items : List (Option Literal)) :
    RP (true, true) (items.flatMap prI) = kK :: (items.map (wk [])).flatMap encW := by
  cases items with
  | nil => rfl
  | cons o part =>
    have e : RP (true, true) ((o :: part).flatMap prI) =
        kK :: RP (false, true) ((o :: part).flatMap prI) := by
      rcases o with _ | l
      · rfl
      · rfl
    have h := p_list (o :: part) []
    simp only [List.append_nil] at h
    have e2 : RP (false, true) [] = [] := rfl
    rw [e, h, e2, List.append_nil]

theorem cost_le (part : List (Option Literal)) :
    (part.map cost).sum ≤ ((part.map (wk [])).flatMap encW).length := by
  induction part with
  | nil => simp
  | cons o part ih =>
    have : cost o ≤ (encW (wk [] o)).length := by
      rcases o with _ | l
      · simp [cost, wk, encW]
      · simp [cost, wk, encW]
    simp only [List.map_cons, List.sum_cons, List.flatMap_cons, List.length_append]
    omega

theorem dn_len (items part : List (Option Literal)) :
    part.length ≤ (part.flatMap (dn items)).length := by
  induction part with
  | nil => simp
  | cons o part ih =>
    have : 1 ≤ (dn items o).length := by
      rcases o with _ | l
      · simp [dn]
      · simp [dn]
    simp only [List.flatMap_cons, List.length_append, List.length_cons]
    omega

theorem iter_ge (T : List A → List A) (s t : List A) (n N : ℕ) (h1 : T^[n] s = t)
    (h2 : T t = t) (hn : n ≤ N) : T^[N] s = t := by
  obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hn
  rw [Nat.add_comm, Function.iterate_add_apply, h1]
  exact Function.iterate_fixed h2 d

def FF (x : List Bool) : List Bool :=
  RW (dec ((fun y : List Bool => (lift TU)^[y.length] y)
    ((fun y : List Bool => (lift TM)^[y.length] y) (enc (RP (true, true) (pr x))))))

theorem FF_cpt : ComputableInPolyTime (fun x : List Bool => x) (fun x : List Bool => x) FF := by
  have hP : ComputableInPolyTime (fun l : List (Bool × Bool) => l) (fun l : List A => l)
      (RP (true, true)) := fst2_polyTime _ _ _ dP finP (true, true) (fun _ => rfl)
  have hW : ComputableInPolyTime (fun l : List A => l) (fun l : List Bool => l) RW :=
    fst2_polyTime _ _ _ dW (fun _ => none) () (fun _ => rfl)
  exact cptc (cpt_comp (cpt_comp (cpt_comp (cpt_comp (cpt_comp (cpt_comp cpt_pr hP) cpt_enc)
    loopM_cpt) loopU_cpt) cpt_dec) hW) (fun _ => rfl)

theorem FF_spec (φ : CNF) :
    FF (encodeCNF φ) = (itemsOf φ).flatMap (outI (itemsOf φ)) := by
  have hx : pr (encodeCNF φ) = (itemsOf φ).flatMap prI := by
    rw [encodeCNF_items, flat_unp, pr_unp]
  have h2 : TM^[(enc (kK :: ((itemsOf φ).map (wk [])).flatMap encW)).length]
      (kK :: ((itemsOf φ).map (wk [])).flatMap encW) =
      (itemsOf φ).flatMap (dn (itemsOf φ)) ++ [kK] := by
    have m := main_loop (itemsOf φ) (itemsOf φ) [] rfl
    simp only [List.flatMap_nil, List.nil_append] at m
    refine iter_ge TM _ _ _ _ m (pass_done _ (dn_noK _ _)) ?_
    have := cost_le (itemsOf φ)
    rw [enc_len, List.length_cons]
    omega
  have h3 : (itemsOf φ).flatMap (dn (itemsOf φ)) =
      ((itemsOf φ).map (ui (itemsOf φ))).flatMap encU := by
    have e : dn (itemsOf φ) = fun o => encU (ui (itemsOf φ) o) := funext (dn_eq _)
    rw [List.flatMap_map, ← e]
  have h4 : TU^[(enc ((itemsOf φ).flatMap (dn (itemsOf φ)) ++ [kK])).length]
      ((itemsOf φ).flatMap (dn (itemsOf φ)) ++ [kK]) =
      ((itemsOf φ).map (uo (itemsOf φ))).flatMap encU ++ [kK] := by
    have hl : (itemsOf φ).length ≤
        (enc ((itemsOf φ).flatMap (dn (itemsOf φ)) ++ [kK])).length := by
      have := dn_len (itemsOf φ) (itemsOf φ)
      rw [enc_len, List.length_append]
      omega
    rw [h3, u_iter, List.map_map]
    have e : (uStep^[(enc (((itemsOf φ).map (ui (itemsOf φ))).flatMap encU ++ [kK])).length] ∘
        ui (itemsOf φ)) = uo (itemsOf φ) := by
      funext o
      exact ui_uo _ _ (by rw [← h3]; exact hl) o
    rw [e]
  simp only [FF, hx, p_all, lift_iter, h2, h4, dec_enc, w_list]

theorem final_spec (φ : CNF) :
    (itemsOf φ).flatMap (outI (itemsOf φ)) =
      encodeCNF (φ.map (fun c : Clause => c.map (fun l : Literal =>
        ((φ.flatMap (fun c' : Clause => c'.map some ++ [none])).findIdx
          (fun o : Option Literal => o.any (fun l' : Literal => l'.1 == l.1)), l.2)))) := by
  have e := itemsOf_map (fun l : Literal => ((itemsOf φ).findIdx (mt l), l.2)) φ
  have e2 : encodeCNF (φ.map (fun c : Clause => c.map (fun l : Literal =>
        ((φ.flatMap (fun c' : Clause => c'.map some ++ [none])).findIdx
          (fun o : Option Literal => o.any (fun l' : Literal => l'.1 == l.1)), l.2)))) =
      encodeCNF (φ.map (fun c => c.map (fun l : Literal => ((itemsOf φ).findIdx (mt l), l.2)))) :=
    rfl
  rw [e2, encodeCNF_items, e, List.flatMap_map]
  congr 1
  funext o
  rcases o with _ | l
  · rfl
  · rfl

theorem main500 : PEqualNP.Library.ComputableInPolyTime PEqualNP.Search.encodeCNF PEqualNP.Search.encodeCNF (fun φ : PEqualNP.Search.CNF => φ.map (fun c : PEqualNP.Search.Clause => c.map (fun l : PEqualNP.Search.Literal => ((φ.flatMap (fun c' : PEqualNP.Search.Clause => c'.map some ++ [none])).findIdx (fun o : Option PEqualNP.Search.Literal => o.any (fun l' : PEqualNP.Search.Literal => l'.1 == l.1)), l.2)))) := by
  obtain ⟨c⟩ := FF_cpt
  refine ⟨⟨c.toTM2ComputableAux, c.time, fun φ => ?_⟩⟩
  have h := c.outputsFun (encodeCNF φ)
  rw [FF_spec, final_spec] at h
  exact h

end PEqualNP.Outside.M500

theorem PEqualNP.Outside.L_meta_500 : PEqualNP.Library.ComputableInPolyTime PEqualNP.Search.encodeCNF PEqualNP.Search.encodeCNF (fun φ : PEqualNP.Search.CNF => φ.map (fun c : PEqualNP.Search.Clause => c.map (fun l : PEqualNP.Search.Literal => ((φ.flatMap (fun c' : PEqualNP.Search.Clause => c'.map some ++ [none])).findIdx (fun o : Option PEqualNP.Search.Literal => o.any (fun l' : PEqualNP.Search.Literal => l'.1 == l.1)), l.2)))) :=
  PEqualNP.Outside.M500.main500
